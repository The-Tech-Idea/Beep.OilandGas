{
  "Repository": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=BeepOilGasRepository;Integrated Security=true;TrustServerCertificate=true"
  },
  "Diagnostics": {
    "//": "The failure store the API and the Web share (DIAG-01). This host owns its schema and applies it at startup.",
    "Provider": "SqlServer",
    "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=BeepOilGasDiagnostics;Integrated Security=true;TrustServerCertificate=true",
    "MigrateOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApiService": {
    "BaseUrl": "https://localhost:7001"
  },
  "IdentityServer": {
    "//": "Audience is this API's identifier, registered under Admin > APIs on the development identity server and permitted to the OilGas Web application there.",
    "Authority": "https://localhost:7062/",
    "Audience": "https://localhost:7001/api"
  }
}
