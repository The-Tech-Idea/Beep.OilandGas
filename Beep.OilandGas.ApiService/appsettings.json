{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Beep": {
    "ConfigPath": "Config",
    "ContainerName": "PPDM39ApiContainer",
    "LoadAssemblies": true,
    "EnableAutoMapping": true
  },
  "ConnectionStrings": {
    "PPDM39": "PPDM39"
  },
  "IdentityServer": {
    "Authority": "https://localhost:7062/",
    "Audience": "beep-api"
  },
  "DemoDatabase": {
    "StoragePath": "./demos",
    "RetentionDays": 7,
    "CleanupSchedule": "0 2 * * *",
    "Enabled": true,
    "DefaultSeedOption": "reference-sample"
  },
  "Exploration": {
    "LeadWorkflow": {
      "PromotedLeadStatusCode": "PROSPECT"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7001",
      "https://localhost:5001"
    ]
  },
  "BeepLogging": {
    "MinLevel": "Information",
    "Enabled": true,
    "StorageBudgetMegabytes": 500,
    "RetentionDays": 30,
    "RedactSensitiveData": true
  },
  "BeepAudit": {
    "Enabled": true,
    "HashChain": true,
    "StorageBudgetMegabytes": 2000,
    "RetentionDays": 365
  },
  "DataImport": {
    "MaxFileSizeMegabytes": 100,
    "TempDirectory": "Temp/DataImport",
    "QualityRules": {
      "NotNull": true,
      "Unique": false,
      "Range": true,
      "Regex": false,
      "AcceptedValues": true,
      "ReferentialIntegrity": false
    }
  },
  "Sync": {
    "SourceDataSourceName": "PPDM39_SOURCE",
    "DestDataSourceName": "PPDM39",
    "AutoInitializeSchemas": false,
    "SloTiers": {
      "GreenSuccessRate": 0.99,
      "YellowSuccessRate": 0.95
    }
  },
  "BeepOg": {
    "DatabaseConnectionName": "PPDM39"
  }
}
