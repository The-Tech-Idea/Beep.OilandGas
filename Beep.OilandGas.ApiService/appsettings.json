{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Beep": {
    "ConfigPath": "Config",
    "ContainerName": "PPDM39ApiContainer",
    "LoadAssemblies": true,
    "EnableAutoMapping": true
  },
  "SetupDrivers": {
    "Providers": {
      "SQLiteDataSource": { "Package": "Stub.System.Data.SQLite.Core.NetStandard", "Version": "1.0.119" },
      "SQLServerDataSource": { "Package": "System.Data.SqlClient", "Version": "4.9.1" },
      "PostgreDataSource": { "Package": "Npgsql", "Version": "10.0.1" },
      "MySQLDataSource": { "Package": "MySql.Data", "Version": "9.5.0" },
      "OracleDataSource": { "Package": "Oracle.ManagedDataAccess.Core", "Version": "23.26.0" }
    },
    "Connectors": {
      "SQLiteDataSource": { "Package": "TheTechIdea.Beep.SqliteDatasourceCore", "Version": "1.0.59" },
      "SQLServerDataSource": { "Package": "TheTechIdea.Beep.SqlServerDataSourceCore", "Version": "1.0.1" },
      "PostgreDataSource": { "Package": "TheTechIdea.Beep.PostgreDataSourceCore", "Version": "1.0.2" },
      "MySQLDataSource": { "Package": "TheTechIdea.Beep.MySqlDataSourceCore", "Version": "1.0.2" },
      "OracleDataSource": { "Package": "TheTechIdea.Beep.OracleDataSourceCore", "Version": "1.0.19" }
    }
  },
  "ConnectionStrings": {
    "PPDM39": "PPDM39"
  },
  "DemoDatabase": {
    "StoragePath": "./demos",
    "RetentionDays": 7,
    "CleanupSchedule": "0 2 * * *",
    "Enabled": true,
    "DefaultSeedOption": "reference-sample"
  },
  "Exploration": {
    "LeadWorkflow": {
      "PromotedLeadStatusCode": "PROSPECT"
    }
  },
  "BeepLogging": {
    "MinLevel": "Information",
    "Enabled": true,
    "StorageBudgetMegabytes": 500,
    "RetentionDays": 30,
    "RedactSensitiveData": true
  },
  "BeepAudit": {
    "Enabled": true,
    "HashChain": true,
    "StorageBudgetMegabytes": 2000,
    "RetentionDays": 365
  },
  "DataImport": {
    "MaxFileSizeMegabytes": 100,
    "TempDirectory": "Temp/DataImport",
    "QualityRules": {
      "NotNull": true,
      "Unique": false,
      "Range": true,
      "Regex": false,
      "AcceptedValues": true,
      "ReferentialIntegrity": false
    }
  },
  "Sync": {
    "SourceDataSourceName": "PPDM39_SOURCE",
    "DestDataSourceName": "PPDM39",
    "AutoInitializeSchemas": false,
    "SloTiers": {
      "GreenSuccessRate": 0.99,
      "YellowSuccessRate": 0.95
    }
  },
  "BeepOg": {
    "DatabaseConnectionName": "PPDM39"
  },
  "RateLimiting": {
    "Fixed": {
      "PermitLimit": 100,
      "WindowSeconds": 10,
      "QueueLimit": 10
    },
    "Setup": {
      "PermitLimit": 10,
      "WindowSeconds": 30,
      "QueueLimit": 2
    }
  }
}
