<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Send / to ASP.NET Core instead of selecting a host-provided default document. -->
      <defaultDocument enabled="false" />
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- The log is on by default: under IIS the console is the log file. Nothing else is set here: the SDK writes the
           process path, the hosting model and the arguments when it publishes. -->
      <aspNetCore stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" />
    </system.webServer>
  </location>
</configuration>
