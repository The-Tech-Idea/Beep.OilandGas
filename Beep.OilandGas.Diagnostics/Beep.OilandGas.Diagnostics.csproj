<Project Sdk="Microsoft.NET.Sdk">
  <!-- OilGas's failure store (DIAG-01, CLIENT-CATCH-01 stage 3): the shared TheTechIdeaWeb.Diagnostics table in an EF
       context of its own, for the Web and the API alike, on the same three database engines as the repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- A switch over an enum names every member and has no discard arm (ARM-01, ARM-02). -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
    <NoWarn>$(NoWarn);CS8524</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(DiagnosticsProject)" />
    <ProjectReference Include="$(IdentityContractsProject)" />
    <!-- SEC-BCL-01. The back-channel logout table the Web's sign-in keeps in this context. -->
    <ProjectReference Include="$(IdentitySharedProject)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <!-- 2026-10-20. Microsoft.Data.SqlClient, which the SQL Server provider brings in, resolves System.Security.Cryptography.Pkcs
         inside GHSA-846f-f764-76mx (CVE-2026-84008, high) and GHSA-2fmv-rv2c-59x7 (to 9.0.20 and 10.0.12). 10.0.13 is the
         patched release; a direct reference outranks the transitive one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="10.23.26300" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
