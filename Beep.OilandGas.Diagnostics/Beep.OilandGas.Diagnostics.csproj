<Project Sdk="Microsoft.NET.Sdk">
  <!-- OilGas's failure store (DIAG-01, CLIENT-CATCH-01 stage 3): the shared TheTechIdeaWeb.Diagnostics table in an EF
       context of its own, for the Web and the API alike, on the same three database engines as the repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- A switch over an enum names every member and has no discard arm (ARM-01, ARM-02). -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
    <NoWarn>$(NoWarn);CS8524</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(DiagnosticsProject)" />
    <ProjectReference Include="$(IdentityContractsProject)" />
    <ProjectReference Include="..\..\Beep.IdentityServer\Beep.IdentityServer.Analyzers\Beep.IdentityServer.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="10.23.26300" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
