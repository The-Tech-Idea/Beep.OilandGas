@inject BrowserScope Scope
<MudThemeProvider /><MudPopoverProvider /><MudDialogProvider /><MudSnackbarProvider />
<MudContainer Class="pa-4"><MudAlert Severity="Severity.Info">Qualification fixture: actual current UI with controlled identity and data services.</MudAlert>
<MudStack Row="true" Wrap="Wrap.Wrap"><MudButton OnClick='@(()=>Scope.ChangeRole("author"))'>Fixture author</MudButton><MudButton OnClick='@(()=>Scope.ChangeRole("reviewer"))'>Fixture reviewer</MudButton><MudButton OnClick='@(()=>Scope.ChangeRole("readonly"))'>Fixture read only</MudButton><MudButton OnClick='@(()=>Scope.ChangeField("B"))'>Fixture other FIELD</MudButton><MudButton OnClick='@(()=>Scope.ChangeField("A"))'>Fixture original FIELD</MudButton><MudButton OnClick='@(()=>Scope.Backend.LoseNext=true)'>Fixture lose next acknowledgement</MudButton><MudButton Href="/ppdm39/hse">HSE landing</MudButton><MudButton Href="/ppdm39/permits">Permit dashboard</MudButton></MudStack></MudContainer>
<CascadingAuthenticationState><Router AppAssembly="typeof(App).Assembly" AdditionalAssemblies="@(new[]{typeof(Beep.OilandGas.Web.Pages.PPDM39.Permits.PermitDashboard).Assembly})"><Found Context="route"><RouteView RouteData="route" /></Found><NotFound><MudText>Choose HSE landing or permit dashboard.</MudText></NotFound></Router></CascadingAuthenticationState>
