<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
	    <TargetFrameworks>net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>Latest</LangVersion>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Authors>The Tech Idea</Authors>
		<Company>The Tech Idea</Company>
		<Copyright>2022</Copyright>
		<PackageProjectUrl>https://github.com/The-Tech-Idea/</PackageProjectUrl>
		<PackageIcon>SimpleODM.png</PackageIcon>
		<RepositoryUrl>https://github.com/The-Tech-Idea/</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<NoWarn>$(NoWarn);CS0618;CS9191</NoWarn>
	    <Nullable>enable</Nullable>
  </PropertyGroup>
	<ItemGroup>
		<None Include="..\..\InstallationScripts\LogoGFx\128\SimpleODM.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<Target Name="CopyPackage" AfterTargets="Pack">
		<Copy SourceFiles="$(OutputPath)$(PackageId).$(PackageVersion).nupkg" DestinationFolder="..\..\..\LocalNugetFiles" />
	</Target>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Copy SourceFiles="$(TargetDir)$(PackageId).dll" DestinationFolder="$(ProjectDir)..\..\outputDLL\$(PackageId)\$(TargetFramework)" SkipUnchangedFiles="false" />
	</Target>
	<ItemGroup>
    <ProjectReference Include="..\Beep.OilandGas.PPDM.Models\Beep.OilandGas.PPDM.Models.csproj" />
	  <PackageReference Include="SkiaSharp" Version="3.119.4" />
	  <!-- OILGAS-CATCH-01: SkiaSharp.Svg 1.60 calls SkiaSharp 1.x APIs (SKMatrix.MakeTranslation) that SkiaSharp 3 does
	       not have, so every SVG load threw MissingMethodException, which catches turned into "no such symbol". Svg.Skia
	       is the maintained SVG renderer for SkiaSharp; 5.1.1 is its last release on SkiaSharp 3.119. -->
	  <PackageReference Include="Svg.Skia" Version="5.1.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Beep.OilandGas.Models\Beep.OilandGas.Models.csproj" />
	</ItemGroup>

	<ItemGroup>

		<Compile Remove="Builders\WellCorrelationBuilder.cs" />
		<EmbeddedResource Include="LithologySymbols\USGS-FGDC-master\SED\*.svg" />
		<EmbeddedResource Include="LithologySymbols\USGS-FGDC-master\IGM\*.svg" />
		<EmbeddedResource Include="Assets\WellSchematic\svg\*.svg" />
	</ItemGroup>

</Project>

