<Project>
  <PropertyGroup>
    <UseBeepDMSource Condition="'$(UseBeepDMSource)' == ''">true</UseBeepDMSource>
    <BeepDMSourceRoot Condition="'$(BeepDMSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\BeepDM</BeepDMSourceRoot>
    <BeepDataSourcesRoot Condition="'$(BeepDataSourcesRoot)' == ''">$(MSBuildThisFileDirectory)..\BeepDataSources</BeepDataSourcesRoot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseBeepDMSource)' == 'true'">
    <DefineConstants>$(DefineConstants);BEEP_SECURE_CONNECTIONS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseBeepDMSource)' == 'true'">
    <_BeepEngineReference Include="@(PackageReference->WithMetadataValue('Identity', 'TheTechIdea.Beep.DataManagementEngine'))" />
    <_BeepModelsReference Include="@(PackageReference->WithMetadataValue('Identity', 'TheTechIdea.Beep.DataManagementModels'))" />
    <_BeepRdbReference Include="@(PackageReference->WithMetadataValue('Identity', 'TheTechIdea.Beep.RDBDataSource'))" />
    <_BeepSqlServerReference Include="@(PackageReference->WithMetadataValue('Identity', 'TheTechIdea.Beep.SqlServerDataSourceCore'))" />
    <_BeepSqliteReference Include="@(PackageReference->WithMetadataValue('Identity', 'TheTechIdea.Beep.SqliteDatasourceCore'))" Condition="'$(MSBuildProjectName)' == 'Beep.OilandGas.ApiService'" />
    <PackageReference Remove="@(_BeepEngineReference);@(_BeepModelsReference);@(_BeepRdbReference);@(_BeepSqlServerReference);@(_BeepSqliteReference)" />
    <ProjectReference Include="$(BeepDMSourceRoot)\DataManagementEngineStandard\DataManagementEngine.csproj" Condition="'@(_BeepEngineReference)' != ''" AdditionalProperties="GeneratePackageOnBuild=false" />
    <ProjectReference Include="$(BeepDMSourceRoot)\DataManagementModelsStandard\DataManagementModels.csproj" Condition="'@(_BeepModelsReference)' != ''" AdditionalProperties="GeneratePackageOnBuild=false" />
    <ProjectReference Include="$(BeepDataSourcesRoot)\DataSourcesPlugins\RDBMSDataSource\RDBDataSource.csproj" Condition="'@(_BeepRdbReference)' != ''" AdditionalProperties="GeneratePackageOnBuild=false" />
    <ProjectReference Include="$(BeepDataSourcesRoot)\DataSourcesPluginsCore\SQlServerDataSourceCore\SqlServerDataSourceCore.csproj" Condition="'@(_BeepSqlServerReference)' != ''" AdditionalProperties="GeneratePackageOnBuild=false" />
    <ProjectReference Include="$(BeepDataSourcesRoot)\DataSourcesPluginsCore\SqliteDatasourceCore\SqliteDatasourceCore.csproj" Condition="'@(_BeepSqliteReference)' != ''" AdditionalProperties="GeneratePackageOnBuild=false" />
  </ItemGroup>
</Project>
