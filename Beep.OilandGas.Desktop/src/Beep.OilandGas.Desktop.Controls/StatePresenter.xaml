<UserControl x:Class="TheTechIdea.Beep.OilandGas.Desktop.Controls.StatePresenter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TheTechIdea.Beep.OilandGas.Desktop.Controls"
             Background="Transparent">
    <Grid>
        <!-- Ready: show content -->
        <ContentPresenter x:Name="ContentHost"
                          Visibility="Collapsed" />

        <!-- Non-ready states -->
        <Border x:Name="StateHost"
                Background="Transparent"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="520">
                <TextBlock x:Name="StateGlyph"
                           FontSize="28"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBlock x:Name="StateTitle"
                           Style="{DynamicResource OgHeadingText}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="StateMessage"
                           Style="{DynamicResource OgCaptionText}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
                <TextBlock x:Name="StateReference"
                           Style="{DynamicResource OgCaptionText}"
                           HorizontalAlignment="Center"
                           FontFamily="{DynamicResource BeepMonoFontFamily}"
                           Margin="0,8,0,0"
                           Visibility="Collapsed" />
                <Button x:Name="StateAction"
                        Content="{Binding ActionText, RelativeSource={RelativeSource AncestorType=controls:StatePresenter}}"
                        HorizontalAlignment="Center"
                        Margin="0,14,0,0"
                        Padding="14,6"
                        Visibility="Collapsed"
                        Click="OnActionClick" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
