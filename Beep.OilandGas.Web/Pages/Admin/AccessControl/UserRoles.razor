@page "/admin/access-control/user-roles"
@using Beep.OilandGas.Models.Data
@using Beep.OilandGas.Models.Data.AccessControl
@using Beep.OilandGas.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator")]
@inject PersonaClient Personas
@inject OilGasCallFailures Calls
@inject UserAdministrationClient Users
@inject ISnackbar Snackbar
@inject OilGasApiFailures Answers

<PageTitle>Assign User Roles</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
    <MudText Typo="Typo.h5" Class="mb-4">Assign User Roles</MudText>
    <MudButton Href="/admin/access-control/users" StartIcon="@Icons.Material.Filled.People" Class="mb-4">Users</MudButton>
    <MudTooltip Text="Reload user roles">
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="Reload user roles"
                       Disabled="@(_busy || string.IsNullOrEmpty(_selectedUserId))"
                       OnClick="@(() => SelectUserAsync(_selectedUserId))" />
    </MudTooltip>
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="4"><MudTextField T="string" Label="New role name" @bind-Value="_newRole" MaxLength="256" Disabled="_busy" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="6"><MudTextField T="string" Label="Role description" @bind-Value="_roleDescription" MaxLength="1000" Disabled="_busy" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="2"><MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="CreateRole" Disabled="@(_busy || string.IsNullOrWhiteSpace(_newRole) || _newRole.Contains(','))" Color="Color.Primary">Create Role</MudButton></MudItem>
    </MudGrid>
    
    <MudPaper Elevation="2" Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-4">Assign Roles to Users</MudText>
        
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSelect T="string" Value="@_selectedUserId" ValueChanged="SelectUserAsync" Label="User"
                           Variant="Variant.Outlined" Disabled="_busy">
                    @foreach (var user in _users)
                    {
                        <MudSelectItem T="string" Value="@user.UserId">@(user.FullName ?? user.UserName)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" 
                          @bind-Value="@_selectedRole"
                          Label="Role"
                          Disabled="_busy"
                          Variant="Variant.Outlined">
                    @foreach (var role in _availableRoles)
                    {
                        <MudSelectItem Value="@role">@role</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" 
                          Color="Color.Primary"
                          OnClick="AssignRole"
                          Disabled="@(_busy || !_rolesLoaded || string.IsNullOrEmpty(_selectedUserId) || string.IsNullOrEmpty(_selectedRole))"
                          StartIcon="@Icons.Material.Filled.Assignment">
                    Assign Role
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (_userRoles != null && _userRoles.Any())
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.h6" Class="mb-3">Current User Roles</MudText>
            <MudDataGrid T="string" Items="@_userRoles" Dense="true" Hover="true" Striped="true">
                <Columns>
                    <TemplateColumn Title="Role">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@context.Item</MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="" Sortable="false">
                        <CellTemplate>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                          Title="Remove role"
                                          Color="Color.Error"
                                          Size="Size.Small"
                                          Disabled="_busy"
                                          OnClick="@(() => RemoveRole(context.Item))" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        }
    </MudPaper>
    <MudPaper Elevation="2" Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">Role workspace navigation</MudText>
        <MudText Class="mb-3">These assignments choose landing pages for company-approved roles. They do not grant access to data or actions. Changes apply wherever this app role is assigned.</MudText>
        <MudSelect T="string" Label="Workspace role" Value="@_workspaceRoleId" ValueChanged="LoadWorkspaces" Disabled="@(_busy || _workspaceBusy)" Variant="Variant.Outlined">
            @foreach (var role in _roleCatalog)
            {
                <MudSelectItem T="string" Value="@role.RoleId">@role.RoleName</MudSelectItem>
            }
        </MudSelect>
        <MudButton OnClick="@(() => LoadWorkspaces(_workspaceRoleId))" Disabled="@(_workspaceBusy || string.IsNullOrEmpty(_workspaceRoleId))" StartIcon="@Icons.Material.Filled.Refresh">Reload workspace assignments</MudButton>
        @if (_workspaceBusy) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading workspace assignments" /> }
        @if (_workspaceError is not null) { <MudAlert Severity="Severity.Error" role="alert">@_workspaceError</MudAlert> }
        @if (_workspaceReview is { } review)
        {
            @if (review.Choices.Count == 0) { <MudAlert Severity="Severity.Info">No workspace catalog entries are available.</MudAlert> }
            <MudList T="string">
                @foreach (var choice in review.Choices)
                {
                    <MudListItem T="string">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudText>@choice.Persona.Name (@choice.Persona.Code) — @(choice.Enabled ? "Assigned" : "Unassigned") @(choice.Persona.IsActive ? "" : "· Inactive")</MudText>
                            <MudButton Variant="Variant.Outlined" Disabled="@(_workspaceBusy || (!choice.Enabled && !choice.Persona.IsActive))" OnClick="@(() => ChangeWorkspace(choice.Persona.Code, !choice.Enabled))">@(choice.Enabled ? "Remove assignment" : "Assign workspace")</MudButton>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }
    </MudPaper>
</MudContainer>

@code {
    private List<TheTechIdea.Data.OilGas.RepositoryRoleSummary> _roleCatalog = [];
    private TheTechIdea.Data.OilGas.RoleWorkspaceReview? _workspaceReview;
    private string _workspaceRoleId = "";
    private string? _workspaceError;
    private bool _workspaceBusy;
    private async Task LoadWorkspaces(string roleId)
    {
        if (_workspaceBusy || string.IsNullOrEmpty(roleId)) return;
        _workspaceRoleId = roleId; _workspaceReview = null; _workspaceError = null; _workspaceBusy = true;
        try
        {
            var review = await Personas.ReviewRoleWorkspacesAsync(roleId);
            if (review.RoleId != roleId) throw new InvalidOperationException("Workspace review names another role.");
            _workspaceReview = review;
        }
        catch (Exception ex) { _workspaceError = Calls.Explain(ex, "reviewing role workspace assignments", "Workspace assignments could not be loaded. Reload before editing"); }
        finally { _workspaceBusy = false; }
    }
    private async Task ChangeWorkspace(string code, bool enabled)
    {
        if (_workspaceBusy || _workspaceReview is not { } original) return;
        _workspaceBusy = true; _workspaceError = null;
        try
        {
            await Personas.SaveRoleWorkspaceAsync(original.RoleId, code, enabled, original.Revision);
            // Only recorded readback confirms success; a failed write is never automatically repeated.
            var recorded = await Personas.ReviewRoleWorkspacesAsync(original.RoleId);
            if (recorded.RoleId != original.RoleId || recorded.Choices.SingleOrDefault(row => row.Persona.Code == code)?.Enabled != enabled)
                throw new InvalidOperationException("Workspace assignment readback could not be confirmed.");
            _workspaceReview = recorded;
            Snackbar.Add("Workspace assignment confirmed.", Severity.Success);
        }
        catch (Exception ex)
        {
            _workspaceReview = null;
            _workspaceError = Calls.Explain(ex, "changing role workspace assignments", "The assignment outcome could not be confirmed. Reload assignments before deciding whether to try again");
        }
        finally { _workspaceBusy = false; }
    }

    private string _newRole = "";
    private string? _roleDescription;

    private async Task CreateRole()
    {
        if (_busy || string.IsNullOrWhiteSpace(_newRole)) return;
        _busy = true;
        try
        {
            await Users.CreateRoleAsync(_newRole.Trim(), _roleDescription);
            _roleCatalog = await Users.GetRolesAsync();
            _availableRoles = _roleCatalog.Select(role => role.RoleName).ToList();
            _newRole = "";
            _roleDescription = null;
            Snackbar.Add("Role created.", Severity.Success);
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "creating a role", "The role was not created"), Severity.Error);
        }
        catch { Snackbar.Add("Role creation could not be verified. Reload before retrying.", Severity.Error); }
        finally { _busy = false; }
    }

    private string _selectedUserId = string.Empty;
    private string _selectedRole = string.Empty;
    private List<string> _availableRoles = new();
    private List<string>? _userRoles;
    private List<TheTechIdea.Data.OilGas.RepositoryUserSummary> _users = new();
    private bool _busy;
    private bool _rolesLoaded;

    protected override async Task OnInitializedAsync()
    {
        _busy = true;
        try
        {
            _users = await Users.GetUsersAsync();
            _roleCatalog = await Users.GetRolesAsync();
            _availableRoles = _roleCatalog.Select(role => role.RoleName).ToList();
        }
        catch { Snackbar.Add("Could not load user administration.", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task SelectUserAsync(string userId)
    {
        if (_busy) return;
        _selectedUserId = userId;
        _userRoles = new();
        _busy = true;
        try { await LoadUserRoles(); }
        finally { _busy = false; }
    }

    private async Task LoadUserRoles()
    {
        _rolesLoaded = false;
        _userRoles = new();
        if (string.IsNullOrEmpty(_selectedUserId)) return;

        try
        {
            _userRoles = await Users.GetUserRolesAsync(_selectedUserId);
            _rolesLoaded = true;
        }
        catch (Exception)
        {
            Snackbar.Add("Error loading user roles.", Severity.Error);
        }
    }

    private async Task AssignRole()
    {
        if (_busy || !_rolesLoaded) return;
        if (string.IsNullOrEmpty(_selectedUserId) || string.IsNullOrEmpty(_selectedRole))
        {
            Snackbar.Add("Please select a user and role", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await Users.AssignRoleAsync(_selectedUserId, _selectedRole);
            Snackbar.Add($"Role {_selectedRole} assigned to user {_selectedUserId}", Severity.Success);
            await LoadUserRoles();
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "assigning a role to a user", "The role was not assigned"), Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Error assigning role.", Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task RemoveRole(string role)
    {
        if (_busy || !_rolesLoaded) return;
        _busy = true;
        try
        {
            await Users.RemoveRoleAsync(_selectedUserId, role);
            Snackbar.Add($"Role {role} removed from user {_selectedUserId}", Severity.Success);
            await LoadUserRoles();
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "removing a role from a user", "The role was not removed"), Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Error removing role.", Severity.Error);
        }
        finally { _busy = false; }
    }
}
