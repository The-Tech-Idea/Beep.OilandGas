        var snapshot = Company.Snapshot; var generation = ++_generation; var revision = _revision;
        if (snapshot.Selection is null || !_settingsLoaded || _pending is not null || string.IsNullOrEmpty(revision)) return;
        _busy = true; _message = null; _effective = null; _verification = null; _sources = null; _wellTest = null; _testSource = "";
        _ghgReview = null; _ghgFactors = null; if (_ghgSelection is not null) _ghgSelectionStatus = "Unconfirmed";
        try
        {
            var result = await Api.GetAsync<CompanyEnvironmentEffectiveReview>("/api/company-environment/effective");
            if (!Current(snapshot, generation)) return;
            if (result is null || result.Company != snapshot.Selection.Scope || result.CompanyRevision != revision || result.Settings is null ||
                result.Settings.Company != snapshot.Selection.Scope || result.Settings.CountryCode != _saved?.CountryCode || result.Settings.Warnings is null ||
                result.ReviewStatus == "Current" && result.Settings.Warnings.Length != 0 ||
                result.ReviewStatus is not ("Current" or "ReviewRequired") || !CompanyEnvironmentIdentity.IsRevision(result.SystemRevision) ||
                !CompanyEnvironmentIdentity.IsRevision(result.EffectiveRevision) || result.CountryRevision is not null && !CompanyEnvironmentIdentity.IsRevision(result.CountryRevision))
                throw new InvalidOperationException("The effective setup does not match the selected company and saved revision.");
            _effective = result;
        }
        catch (OperationCanceledException) { if (Current(snapshot, generation)) _message = "The effective settings request was cancelled. Try again."; }
        catch (Exception error)
        { if (Current(snapshot, generation)) { Logger.LogWarning(error, "Effective company environment could not be confirmed"); _message = "Effective settings could not be confirmed. Review shared TOOLS / DEFAULT and company setup."; } }
        finally { if (Current(snapshot, generation)) _busy = false; }
    }

    private async Task ReviewSources()
    {
        if (_busy) return;
        var snapshot = Company.Snapshot; var generation = ++_generation; var revision = _revision;
        if (snapshot.Selection is null || !_settingsLoaded || _pending is not null || string.IsNullOrEmpty(revision)) return;
        _busy = true; _message = null; _sources = null; _wellTest = null; _testSource = ""; _mappingDisplayCounts.Clear();
        try
        {
            var result = await Api.GetAsync<CompanyEnvironmentSourceReview>("/api/company-environment/sources");
            if (!Current(snapshot, generation)) return;
            CompanyEnvironmentSourceReviewValidator.RequireValid(result, snapshot.Selection.Scope, revision, _effective?.EffectiveRevision);
            RetainEvidenceFor(result!.EffectiveRevision);
            _sources = result;
        }
        catch (OperationCanceledException) { if (Current(snapshot, generation)) _message = "The source review was cancelled. Try again."; }
        catch (Exception error)
        { if (Current(snapshot, generation)) { Logger.LogWarning(error, "Company environment source review failed"); _message = "The saved source bindings could not be reviewed. Reload the company settings."; } }
        finally { if (Current(snapshot, generation)) _busy = false; }
    }
    private static string MappingOriginLabel(string origin) => origin switch { "System" => "shared defaults", "CountryPreset" => "country preset", "Country" => "country settings", "Company" => "company override", _ => "unconfirmed" };
    private int MappingDisplayCount(CompanyEnvironmentSource source) => Math.Min(source.CodeMappings.Length, _mappingDisplayCounts.GetValueOrDefault(source.Name, 25));
    private void ShowMoreMappings(CompanyEnvironmentSource source)
    {
        if (_busy || _sources?.Sources.Contains(source) != true) return;
        _mappingDisplayCounts[source.Name] = Math.Min(source.CodeMappings.Length, MappingDisplayCount(source) + 25);
    }

    private void RetainEvidenceFor(string effectiveRevision)
    {
        if (_verification is not null && _verification.EffectiveRevision != effectiveRevision) _verification = null;
        if (_sources is not null && _sources.EffectiveRevision != effectiveRevision)
        { _sources = null; _wellTest = null; _testSource = ""; }
        if (_ghgReview is not null && _ghgReview.EffectiveRevision != effectiveRevision)
        { _ghgReview = null; _ghgFactors = null; }
        if (_ghgSelection is not null && _ghgSelection.EnvironmentRevision != effectiveRevision)
            _ghgSelectionStatus = "ReviewRequired";
    }

    private async Task TestWell()
