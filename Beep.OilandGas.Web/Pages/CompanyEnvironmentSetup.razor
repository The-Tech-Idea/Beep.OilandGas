                result.RelatedTablesTested || result.EffectiveRevision != _sources.EffectiveRevision || string.IsNullOrWhiteSpace(result.LoaderVersion) || result.Status is not ("Found" or "NotVisible"))
                throw new InvalidOperationException("The well check did not match its original company, source and well.");
            _wellTest = result;
        }
        catch (OperationCanceledException) { if (Current(snapshot, generation)) _message = "The well check was cancelled. Try again."; }
        catch (Exception error)
        { if (Current(snapshot, generation)) { Logger.LogWarning(error, "Company environment well check failed"); _message = "The selected well header could not be checked. Review source binding and well access."; } }
        finally { if (Current(snapshot, generation)) _busy = false; }
    }

    private async Task BeginCompanySetup()
    {
        var snapshot = Company.Snapshot;
        if (_busy || !_environmentRecoveryReady || snapshot.Selection is null || _settingsLoaded || _pending is not null || _countries is not null) return;
        await LoadSaved();
        if (_disposed || snapshot != Company.Snapshot || !_settingsLoaded || _pending is not null) return;
        await LoadCountries();
        if (!_disposed && snapshot == Company.Snapshot && _countries is not null)
            _message = _saved is null ? "Choose a country and preview the company settings." : "Saved settings loaded. Review the country and preview changes before saving.";
    }

    private async Task LoadCountries()
    {
        if (_busy) return;
        var snapshot = Company.Snapshot; var generation = ++_generation;
        if (snapshot.Selection is null) return;
        _busy = true; _message = null; _countries = null; _preview = null;
        try
        {
            var result = await Api.GetAsync<CompanyEnvironmentCountry[]>("/api/company-environment/countries");
            if (!Current(snapshot, generation)) return;
            if (result is null || result.Length == 0 || result.Any(c => string.IsNullOrWhiteSpace(c.Code) || string.IsNullOrWhiteSpace(c.Name)) || result.Select(c => c.Code).Distinct(StringComparer.Ordinal).Count() != result.Length)
                throw new InvalidOperationException("The country catalog was not confirmed.");
            _countries = result;
        }
        catch (OperationCanceledException) { if (Current(snapshot, generation)) _message = "The country request was cancelled. Try again."; }
        catch (Exception error)
        { if (Current(snapshot, generation)) { Logger.LogWarning(error, "Country presets could not be loaded"); _message = "Country presets could not be loaded. Check company access and try again."; } }
        finally { if (Current(snapshot, generation)) _busy = false; }
    }

    private async Task Preview()
    {
        if (_busy) return;
        var snapshot = Company.Snapshot; var generation = ++_generation; var country = _country;
        if (snapshot.Selection is null || _countries?.Any(c => c.Code == country) != true) return;
        _busy = true; _message = null; _preview = null; _draftReview = null;
        try
        {
            var draft = new CompanyEnvironmentPreviewRequest(country, _overrides);
            var review = await Api.PostAsync<CompanyEnvironmentPreviewRequest, CompanyEnvironmentDraftReview>("/api/company-environment/preview", draft);
            if (!Current(snapshot, generation)) return;
            if (review is null || review.DraftRevision != CompanyEnvironmentDraftIdentity.ForReview(snapshot.Selection.Scope, draft, review.SystemRevision, review.CountryRevision, review.ToolsVersion))
                throw new InvalidOperationException("The reviewed setup layers do not match the company draft.");
            var result = review.Settings;
            if (result is null || result.Company != snapshot.Selection.Scope || result.CountryCode != country ||
                string.IsNullOrWhiteSpace(result.CountryName) || string.IsNullOrWhiteSpace(result.Culture) ||
                string.IsNullOrWhiteSpace(result.DepthUnit) || string.IsNullOrWhiteSpace(result.PressureUnit) ||
                string.IsNullOrWhiteSpace(result.DiameterUnit) || result.CoordinateSystems is null ||
                result.Regulators is null || result.Warnings is null)
                throw new InvalidOperationException("The preview does not match the selected company and country.");
            _draftReview = review; _preview = result;
        }
        catch (OperationCanceledException) { if (Current(snapshot, generation)) _message = "The preview request was cancelled. Try again."; }
        catch (OilGasApiException error) when (error.StatusCode == System.Net.HttpStatusCode.Conflict)
        { if (Current(snapshot, generation)) { Logger.LogWarning(error, "Combined setup could not be confirmed for company preview"); _message = "The combined settings could not be confirmed. Check shared system and country settings, then review the company draft again."; } }
        catch (Exception error)
        { if (Current(snapshot, generation)) { Logger.LogWarning(error, "Company environment preview failed"); _message = "The environment could not be previewed. Review the JSON, selected country and company access."; } }
        finally { if (Current(snapshot, generation)) _busy = false; }
    }
    private bool CurrentEnvironmentRecovery((long Version, CompanyClientSelection? Selection) snapshot, long generation) => !_disposed && generation == _environmentRecoveryGeneration && snapshot == Company.Snapshot;
    private bool CurrentRecovery((long Version, CompanyClientSelection? Selection) snapshot, long generation) => !_disposed && generation == _ghgRecoveryGeneration && snapshot == Company.Snapshot;
    private bool Current((long Version, CompanyClientSelection? Selection) snapshot, long generation) => !_disposed && generation == _generation && snapshot == Company.Snapshot;
    public void Dispose() { _disposed = true; ++_generation; Company.Changed -= CompanyChanged; }
