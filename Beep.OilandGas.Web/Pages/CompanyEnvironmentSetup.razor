@using Beep.OilandGas.Models.Data.AccessControl
@using Beep.OilandGas.Models.Data.Company
@using Beep.OilandGas.Models.Data.WorkOrder
@using Beep.OilandGas.Models.Data.DataManagement
@using Beep.OilandGas.PPDM39.DataManagement.Models
@using Beep.OilandGas.HSE.Models
@page "/setup/company-environment"
@using Beep.OilandGas.Client.App
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator")]
@inject ApiClient Api
@inject CompanyClientContext Company
@inject ILogger<CompanyEnvironmentSetup> Logger
@inject IGhgSelectionIntentStore GhgIntents
@inject ICompanyEnvironmentIntentStore EnvironmentIntents
@inject CompanyEnvironmentChangeSignal EnvironmentChanges
@implements IDisposable

<PageTitle>Company environment setup</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudText Typo="Typo.h4" HtmlTag="h1">Company environment setup</MudText>
    <MudText Class="my-3">Review an OilandGasTools country preset and optional company overrides. Country suggestions require your own operational review.</MudText>
    <MudAlert Severity="Severity.Info" Class="mb-3">The preview includes shared defaults, country settings and company overrides. Shared settings can change after review; check effective settings again after saving. Saving does not activate the configuration. Do not enter credentials or server file paths.</MudAlert>
    <MudText Typo="Typo.body2" Class="mb-2">Shared OilandGasTools defaults must be saved in the system setup repository before a company environment can be previewed.</MudText>
    <MudButton Href="/setup/system-repository" Variant="Variant.Outlined" Class="mb-3">Open shared system setup</MudButton>
    @if (_message is not null) { <MudAlert Severity="Severity.Warning" Class="mb-3">@_message</MudAlert> }
    @if (Company.Selection is null)
    { <MudText>Select a company in the top bar to continue.</MudText> }
    else
    {
        <MudText Class="mb-2">Company: @Company.Selection.Scope.BusinessAssociateId</MudText>
        @if (!_settingsLoaded && _pending is null && _countries is null)
        {
            <MudButton OnClick="BeginCompanySetup" Disabled="@(_busy || !_environmentRecoveryReady)" Variant="Variant.Filled" Color="Color.Primary">Start company environment setup</MudButton>
            <MudText Typo="Typo.body2" Class="my-2">Load this company's saved settings and the available country presets, then choose and preview the settings for review.</MudText>
        }
        <MudButton OnClick="ReviewOrganization" Disabled="@_busy" Variant="Variant.Outlined">Check company PPDM organization</MudButton>
        @if (_organization is not null) { <MudAlert Severity="Severity.Info" Class="my-2">At the last check: @(_organization.Status switch { "Active" => "The selected company has an active PPDM business-associate record.", "Inactive" => "The selected company business-associate record is inactive.", "NotFound" => "No business-associate record was found for the selected company.", _ => "The company business-associate status is unconfirmed." }) This does not verify source coverage or activate the environment.</MudAlert> }
        <MudButton OnClick="LoadSaved" Disabled="@(_busy || !_environmentRecoveryReady)" Variant="Variant.Outlined">Load saved settings</MudButton>
        @if (_pending is not null) { <MudAlert Severity="Severity.Warning" Class="my-2">A previous environment save is awaiting confirmation. Load the saved settings or retry the same save.</MudAlert> }
        <MudButton OnClick="LoadCountries" Disabled="@_busy" Variant="Variant.Outlined">Load available country presets</MudButton>
        <MudButton OnClick="Verify" Disabled="@(_busy || !_settingsLoaded || _pending is not null || string.IsNullOrEmpty(_revision))" Variant="Variant.Outlined">Verify saved revision</MudButton>
        <MudButton OnClick="ReviewEffective" Disabled="@(_busy || !_settingsLoaded || _pending is not null || string.IsNullOrEmpty(_revision))" Variant="Variant.Outlined">Review effective settings</MudButton>
        <MudButton OnClick="ReviewSources" Disabled="@(_busy || !_settingsLoaded || _pending is not null || string.IsNullOrEmpty(_revision))" Variant="Variant.Outlined">Review source bindings</MudButton>
        <MudTextField T="string" Value="@_ghgJurisdiction" ValueChanged="GhgJurisdictionChanged" Label="GHG jurisdiction key" Disabled="@(_busy || _pending is not null || _ghgPending is not null)" HelperText="Choose the catalog explicitly; a country preset does not select a regulator." />
        <MudButton OnClick="ReviewGhgCatalog" Disabled="@(_busy || !_settingsLoaded || _pending is not null || _ghgPending is not null || string.IsNullOrEmpty(_revision) || string.IsNullOrWhiteSpace(_ghgJurisdiction))" Variant="Variant.Outlined">Review GHG factor catalog</MudButton>
        <MudButton OnClick="LoadGhgSelection" Disabled="@_busy" Variant="Variant.Outlined">Load company catalog selection</MudButton>
        @if (_ghgPending is not null) { <MudAlert Severity="Severity.Warning" Class="my-2">A previous selection is awaiting confirmation. Load the saved selection or retry the same intent.</MudAlert> }
        @if (_ghgSelection is not null)
        {
            <MudText Typo="Typo.body2">Saved selection: @_ghgSelection.Jurisdiction, selected by @_ghgSelection.SelectedBy. This is not approval for reporting.</MudText>
            <MudText Typo="Typo.body2">@(_ghgSelectionStatus switch { "Current" => "The saved selection matches the current catalog and company environment.", "ReviewRequired" => "The catalog or company environment changed. Review the selection again.", _ => "The current catalog or company environment could not be confirmed." })</MudText>
        }
        @if (_ghgReview is not null && _ghgFactors is not null)
        {
            <MudAlert Severity="Severity.Info" Class="my-3">Catalog reviewed for this company. Applicability and approval have not been established; reporting remains unavailable.</MudAlert>
            <MudText>Jurisdiction @_ghgFactors.Jurisdiction; catalog version @_ghgReview.Catalog.Version.</MudText>
            @foreach (var factor in _ghgFactors.Factors)
            { <MudText Typo="Typo.body2">@factor.Id — @factor.SourceCategory: @factor.Factor @factor.OutputUnit / @factor.InputUnit; @factor.EffectiveFrom.ToString("yyyy-MM-dd") to @factor.EffectiveThrough.ToString("yyyy-MM-dd"); @factor.SourceReference</MudText> }
            <MudTextField T="string" @bind-Value="_ghgRationale" Label="Reason for selecting this catalog" Lines="3" Disabled="@(_busy || _ghgPending is not null)" />
        }
        @if (_ghgReview is not null || _ghgPending is not null)
        { <MudButton OnClick="SaveGhgSelection" Disabled="@(_busy || !_ghgSelectionLoaded || !_ghgRecoveryReady)" Variant="Variant.Filled" Color="Color.Primary">@(_ghgPending is null ? "Save company selection" : "Retry the same selection")</MudButton> }
        @if (_saved is not null)
        {
            <MudText Typo="Typo.body2" Class="my-2">Saved review: system @_saved.ReviewedSystemRevision; country @(_saved.ReviewedCountryRevision ?? "no country override"); tool build @_saved.ToolsVersion.</MudText>
        }
        @if (_countries is not null)
        {
            <MudSelect T="string" Value="@_country" ValueChanged="CountryChanged" Label="Country preset" Disabled="@(_busy || _pending is not null)" Class="my-3">
                @foreach (var country in _countries) { <MudSelectItem T="string" Value="@country.Code">@country.Name (@country.Code)</MudSelectItem> }
            </MudSelect>
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-3">Common company overrides</MudText>
            <MudText Typo="Typo.body2">Enter only values you want to change. Existing explicit units take precedence over a unit system; review the resolved values in the preview before saving.</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editCulture" Label="Culture, for example ar-KW" Disabled="@(_busy || _pending is not null)" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editTimeZone" Label="Time zone, for example Asia/Kuwait" Disabled="@(_busy || _pending is not null)" HelperText="An IANA or Windows time zone available on the API host." /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editUnitSystem" Label="Unit system, for example oilfield" Disabled="@(_busy || _pending is not null)" HelperText="A unit system defined in the tool settings." /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editDepth" Label="Depth unit" Disabled="@(_busy || _pending is not null)" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editPressure" Label="Pressure unit" Disabled="@(_busy || _pending is not null)" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editDiameter" Label="Diameter unit" Disabled="@(_busy || _pending is not null)" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editWeight" Label="Linear weight unit, for example kg/m" Disabled="@(_busy || _pending is not null)" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editForce" Label="Force unit, for example kN" Disabled="@(_busy || _pending is not null)" /></MudItem>
            </MudGrid>
            <MudButton OnClick="UseInheritedCommonSettings" Disabled="@(_busy || _pending is not null)" Variant="Variant.Outlined" Class="my-2">Use inherited culture, time zone and units</MudButton>
            <MudText Typo="Typo.body2">This removes explicit company culture, time zone and unit choices from the draft. Preview the inherited settings before saving.</MudText>
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-3">Display locale</MudText>
            <MudText Typo="Typo.body2">Display culture is separate from the environment culture. Enter .NET date patterns; an inherited or empty tool value can use the tool's default formatting.</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editDisplayCulture" Label="Display culture, for example ar-KW" Disabled="@(_busy || _pending is not null)" /></MudItem>
                <MudItem xs="12" sm="6"><MudSelect T="string" @bind-Value="_editCalendar" Label="Display calendar" Disabled="@(_busy || _pending is not null)">
                    <MudSelectItem T="string" Value="@string.Empty">Leave unchanged</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Gregorian")">Gregorian</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Culture")">Culture calendar</MudSelectItem>
                </MudSelect></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editDateFormat" Label="Display date pattern" Disabled="@(_busy || _pending is not null)" HelperText="For example dd/MM/yyyy" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editDateTimeFormat" Label="Display date and time pattern" Disabled="@(_busy || _pending is not null)" HelperText="For example dd/MM/yyyy HH:mm" /></MudItem>
            </MudGrid>
            <MudButton OnClick="ApplyCommonOverrides" Disabled="@(_busy || _pending is not null)" Variant="Variant.Outlined" Class="my-2">Apply entered locale and unit overrides</MudButton>
            <MudButton OnClick="UseInheritedDisplayFormats" Disabled="@(_busy || _pending is not null)" Variant="Variant.Outlined" Class="my-2">Use inherited display formats</MudButton>
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-3">Regional reference lists</MudText>
            <MudText Typo="Typo.body2">Enter one coordinate system or regulator per line. Each entered list replaces its inherited list for this company. These references are informational; confirm them with the responsible survey or regulatory team.</MudText>
            <MudTextField T="string" @bind-Value="_editCoordinateSystems" Label="Company coordinate systems" Lines="3" Disabled="@(_busy || _pending is not null)" />
            <MudTextField T="string" @bind-Value="_editRegulators" Label="Company regulators" Lines="3" Disabled="@(_busy || _pending is not null)" />
            <MudButton OnClick="ApplyRegionLists" Disabled="@(_busy || _pending is not null)" Variant="Variant.Outlined" Class="my-2">Apply entered regional lists</MudButton>
            <MudButton OnClick="UseInheritedCoordinateSystems" Disabled="@(_busy || _pending is not null)" Variant="Variant.Outlined" Class="my-2">Use inherited coordinate systems</MudButton>
            <MudButton OnClick="UseInheritedRegulators" Disabled="@(_busy || _pending is not null)" Variant="Variant.Outlined" Class="my-2">Use inherited regulators</MudButton>
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-3">Add a company data source</MudText>
            <MudText Typo="Typo.body2">Choose a source name and an existing Beep module. The PPDM mapping profile is used. A matching name in shared defaults can be overridden; review it before saving. Adding a source does not test the connection.</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editSourceName" Label="Source name" Disabled="@(_busy || _pending is not null)" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editSourceModule" Label="Beep module, for example PPDM_CORE" Disabled="@(_busy || _pending is not null)" /></MudItem>
            </MudGrid>
            <MudButton OnClick="AddCompanySource" Disabled="@(_busy || _pending is not null)" Variant="Variant.Outlined" Class="my-2">Add source to draft</MudButton>
            <MudButton OnClick="ChangeCompanySource" Disabled="@(_busy || _pending is not null)" Variant="Variant.Outlined" Class="my-2">Change module for existing draft source</MudButton>
            <MudButton OnClick="RemoveCompanySource" Disabled="@(_busy || _pending is not null)" Variant="Variant.Outlined" Class="my-2">Remove company source override</MudButton>
            <MudText Typo="Typo.body2">Changing or removing a source applies only to an explicit company override. Removing it restores the shared or country source if one exists. Preview the effective settings before saving.</MudText>
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-3">Company source code mapping</MudText>
            <MudText Typo="Typo.body2">Enter a source name, a PPDM profile entity and field, the source value and its canonical value. An inherited source can be customized without copying its module. The preview checks the resolved source and profile; your data steward must confirm the code meanings. Removing an override restores an inherited mapping when available.</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editMappingEntity" Label="PPDM profile entity" Disabled="@(_busy || _pending is not null)" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editMappingField" Label="PPDM profile field" Disabled="@(_busy || _pending is not null)" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editMappingSourceCode" Label="Source code" Disabled="@(_busy || _pending is not null)" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editMappingCanonicalCode" Label="Canonical code" Disabled="@(_busy || _pending is not null)" /></MudItem>
            </MudGrid>
            <MudButton OnClick="SetSourceMapping" Disabled="@(_busy || _pending is not null)" Variant="Variant.Outlined" Class="my-2">Set code mapping</MudButton>
            <MudButton OnClick="RemoveSourceMapping" Disabled="@(_busy || _pending is not null)" Variant="Variant.Outlined" Class="my-2">Remove company code mapping</MudButton>
            <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="mt-3">Explicit company mappings in this draft</MudText>
            @if (!_mappingRowsValid)
            { <MudAlert Severity="Severity.Warning" Class="my-2">Company mappings cannot be listed until the override JSON is valid. Review the draft before continuing.</MudAlert> }
            else if (_mappingRows.Count == 0)
            { <MudText Typo="Typo.body2">No explicit company mappings are in this draft. Inherited mappings are not listed here.</MudText> }
            else
            {
                @foreach (var mapping in _mappingRows)
                {
                    <MudPaper Outlined="true" Class="pa-2 my-2">
                        <MudText>@mapping.Source · @mapping.Entity.@mapping.Field: @mapping.SourceCode → @mapping.CanonicalCode</MudText>
                        <MudButton OnClick="@(() => SelectMapping(mapping))" Disabled="@(_busy || _pending is not null)" Variant="Variant.Outlined" aria-label="@($"Edit mapping {mapping.Source}, {mapping.Entity}.{mapping.Field}, {mapping.SourceCode}")">Edit mapping</MudButton>
                    </MudPaper>
                }
            }
            <MudTextField T="string" Value="@_overrides" ValueChanged="OverridesChanged" Label="Optional OilandGasTools overrides (JSON)" Lines="6" Disabled="@(_busy || _pending is not null)" />
            <MudText Typo="Typo.body2">For a named source use kind "beep", an uppercase Beep module in its path, and profile "ppdm39". Configure module bindings in database setup; never enter connection strings here.</MudText>
            <MudButton OnClick="Preview" Disabled="@(_busy || _pending is not null || string.IsNullOrWhiteSpace(_country))" Variant="Variant.Filled" Color="Color.Primary" Class="my-3">Preview settings</MudButton>
        }
        @if (_preview is not null)
        {
            <MudText Typo="Typo.h6" HtmlTag="h2">@_preview.CountryName (@_preview.CountryCode)</MudText>
            <MudText>Culture: @_preview.Culture; time zone: @(_preview.TimeZoneId ?? "not configured"); unit system: @(_preview.UnitSystem ?? "not specified")</MudText>
            <MudText>Depth: @_preview.DepthUnit; pressure: @_preview.PressureUnit; diameter: @_preview.DiameterUnit</MudText>
            <MudText>Linear weight: @(_preview.WeightUnit ?? "not confirmed"); force: @(_preview.ForceUnit ?? "not confirmed")</MudText>
            <MudText>Display culture: @(_preview.DisplayCulture is null ? "not confirmed" : _preview.DisplayCulture.Length == 0 ? "tool default" : _preview.DisplayCulture); calendar: @(_preview.Calendar ?? "not confirmed"); date: @(_preview.DateFormat ?? "not confirmed"); date and time: @(_preview.DateTimeFormat ?? "not confirmed")</MudText>
            <MudText>Regional coordinate systems (informational): @string.Join(", ", _preview.CoordinateSystems)</MudText>
            <MudText>Regional regulators (informational): @string.Join(", ", _preview.Regulators)</MudText>
            @foreach (var warning in _preview.Warnings) { <MudAlert Severity="Severity.Warning" Class="my-2">@warning</MudAlert> }
        }
        @if (_settingsLoaded && (_preview is not null && _preview.Warnings.Length == 0 || _pending is not null))
        { <MudButton OnClick="Save" Disabled="@(_busy || !_environmentRecoveryReady)" Variant="Variant.Filled" Color="Color.Primary">@(_pending is null ? "Save reviewed settings" : "Retry the same save")</MudButton> }
        @if (_verification is not null)
        {
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-4">Saved revision verification</MudText>
            <MudText Typo="Typo.body2">Effective system, country and company revision: @_verification.EffectiveRevision</MudText>
            <MudAlert Severity="Severity.Info">Data source connections and coverage were not verified by these checks. The environment is not activated.</MudAlert>
            @foreach (var issue in _verification.ValidationIssues) { <MudAlert Severity="Severity.Warning" Class="my-2">@issue</MudAlert> }
            @foreach (var check in _verification.ReferenceCases) { <MudText>@check.Name (@check.Kind): @check.Status @check.Detail</MudText> }
        }
        @if (_effective is not null)
        {
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-4">Effective saved settings</MudText>
            @if (_effective.ReviewStatus != "Current") { <MudAlert Severity="Severity.Warning">Settings need company review because of validation issues or changes to shared or country settings. Re-preview and save before relying on them.</MudAlert> }
            <MudText>@_effective.Settings.CountryName — @_effective.Settings.Culture; depth @_effective.Settings.DepthUnit; pressure @_effective.Settings.PressureUnit; diameter @_effective.Settings.DiameterUnit.</MudText>
            <MudText>Regional coordinate systems (informational): @string.Join(", ", _effective.Settings.CoordinateSystems)</MudText>
            <MudText>Regional regulators (informational): @string.Join(", ", _effective.Settings.Regulators)</MudText>
            <MudText>Time zone: @(_effective.Settings.TimeZoneId ?? "not configured"); unit system: @(_effective.Settings.UnitSystem ?? "not specified"); linear weight: @(_effective.Settings.WeightUnit ?? "not confirmed"); force: @(_effective.Settings.ForceUnit ?? "not confirmed").</MudText>
            <MudText>Display culture: @(_effective.Settings.DisplayCulture is null ? "not confirmed" : _effective.Settings.DisplayCulture.Length == 0 ? "tool default" : _effective.Settings.DisplayCulture); calendar: @(_effective.Settings.Calendar ?? "not confirmed"); date: @(_effective.Settings.DateFormat ?? "not confirmed"); date and time: @(_effective.Settings.DateTimeFormat ?? "not confirmed").</MudText>
            @foreach (var warning in _effective.Settings.Warnings) { <MudAlert Severity="Severity.Warning" Class="my-2">@warning</MudAlert> }
            <MudText Typo="Typo.body2">These combine the system default, country preset, optional country record and saved company overrides. Review revision: @_effective.EffectiveRevision</MudText>
        }
        @if (_sources is not null)
        {
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-4">Saved source bindings</MudText>
            <MudAlert Severity="Severity.Info">A bound module has an identified tenant-owned connection. The listed mappings are effective configured overrides; built-in profile mappings are not listed. Source data, connectivity and mapping coverage have not been tested.</MudAlert>
            @if (_sources.Sources.Length == 0) { <MudText>No source definitions are saved.</MudText> }
            @foreach (var source in _sources.Sources)
            {
                <MudText>@source.Name — @source.Module (@source.Profile): @source.BindingStatus; @source.MappedCodeValues mapped codes, @source.RowFilters filters; mapping: @source.MappingStatus</MudText>
                @foreach (var issue in source.MappingIssues) { <MudAlert Severity="Severity.Warning" Class="my-2">@issue</MudAlert> }
                @if (source.CodeMappings.Length > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-2">Effective configured code overrides for @source.Name</MudText>
                    @foreach (var mapping in source.CodeMappings.Take(MappingDisplayCount(source)))
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.body2">@mapping.Entity.@mapping.Field: @mapping.SourceCode → @mapping.CanonicalCode (@MappingOriginLabel(mapping.Origin))</MudText>
                            <MudButton OnClick="@(() => SelectEffectiveMapping(source, mapping))" Disabled="@(_busy || _pending is not null || !_settingsLoaded)" Variant="Variant.Text">Edit in company draft</MudButton>
                        </MudStack>
                    }
                    @if (source.MappedCodeValues > MappingDisplayCount(source))
                    {
                        <MudText Typo="Typo.body2">Showing @MappingDisplayCount(source) of @source.MappedCodeValues mappings.</MudText>
                        <MudButton OnClick="@(() => ShowMoreMappings(source))" Disabled="@_busy" Variant="Variant.Outlined">Show more mappings</MudButton>
                    }
                }
            }
            <MudText Typo="Typo.body2">Profile checks do not verify database columns, company code meanings or source coverage.</MudText>
            @if (_sources.Sources.Any(x => x.Module == "PPDM_CORE" && x.BindingStatus == "Bound" && x.MappingStatus == "ProfileChecked"))
            {
                <MudSelect T="string" Value="@_testSource" ValueChanged="TestSourceChanged" Label="Source to test" Disabled="@_busy">
                    @foreach (var source in _sources.Sources.Where(x => x.Module == "PPDM_CORE" && x.BindingStatus == "Bound" && x.MappingStatus == "ProfileChecked"))
                    { <MudSelectItem T="string" Value="@source.Name">@source.Name</MudSelectItem> }
                </MudSelect>
                <MudTextField T="string" Value="@_testWell" ValueChanged="TestWellChanged" Label="Exact well identifier (UWI)" Disabled="@_busy" />
                <MudButton OnClick="TestWell" Disabled="@(_busy || string.IsNullOrWhiteSpace(_testSource) || string.IsNullOrWhiteSpace(_testWell))" Variant="Variant.Outlined" Class="my-3">Test selected well header</MudButton>
            }
            @if (_wellTest is not null)
            {
                <MudAlert Severity="Severity.Info">@(_wellTest.Status == "Found" ? $"Authorized well header found: {_wellTest.WellName} ({_wellTest.WellId})." : "No well header is visible for this identifier and access.") Related equipment, surveys, source coverage and connectivity beyond this read were not tested.</MudAlert>
            }
        }
    }
    <MudButton Href="/setup/repository" Variant="Variant.Text" Class="mt-4">Back to setup</MudButton>
</MudContainer>

@code {
    private CompanyOrganizationReview? _organization;
    private CompanyEnvironmentCountry[]? _countries;
    private CompanyEnvironmentPreview? _preview;
    private CompanyEnvironmentConfiguration? _saved;
    private CompanyEnvironmentDraftReview? _draftReview;
    private CompanyEnvironmentVerification? _verification;
    private CompanyEnvironmentEffectiveReview? _effective;
    private CompanyEnvironmentSourceReview? _sources;
    private CompanyGhgCatalogReview? _ghgReview;
    private GhgFactorCatalog? _ghgFactors;
    private string _ghgJurisdiction = "";
    private string _ghgRationale = "";
    private CompanyGhgSelection? _ghgSelection;
    private string _ghgSelectionStatus = "NotSelected";
    private CompanyGhgSelectionRequest? _ghgPending;
    private bool _ghgSelectionLoaded;
    private bool _ghgRecoveryReady, _environmentRecoveryReady, _interactive;
    private CompanyEnvironmentWellTest? _wellTest;
    private string _testSource = "", _testWell = "";
    private string _country = "", _overrides = "{}";
    private string _editCulture = "", _editTimeZone = "", _editDepth = "", _editPressure = "", _editDiameter = "", _editUnitSystem = "", _editWeight = "", _editForce = "", _editDisplayCulture = "", _editDateFormat = "", _editDateTimeFormat = "", _editCalendar = "", _editSourceName = "", _editSourceModule = "";
    private string _editCoordinateSystems = "", _editRegulators = "";
    private string _editMappingEntity = "", _editMappingField = "", _editMappingSourceCode = "", _editMappingCanonicalCode = "";
    private IReadOnlyList<CompanySourceCodeMapping> _mappingRows = [];
    private bool _mappingRowsValid = true;
    private readonly Dictionary<string, int> _mappingDisplayCounts = new(StringComparer.Ordinal);
    private string? _message;
    private string _revision = "";
    private string _toolsVersion = "";
    private CompanyEnvironmentReviewedSaveRequest? _pending;
    private bool _busy, _disposed, _settingsLoaded;
    private long _generation, _ghgRecoveryGeneration, _environmentRecoveryGeneration;

    protected override void OnInitialized() => Company.Changed += CompanyChanged;
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) { _interactive = true; await Task.WhenAll(RestoreGhgIntent(), RestoreEnvironmentIntent()); } }
