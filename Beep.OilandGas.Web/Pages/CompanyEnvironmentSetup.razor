        if (snapshot.Selection is null || _pending is not null || _sources?.Sources.Any(x => x.Name == source && x.Module == "PPDM_CORE" && x.BindingStatus == "Bound" && x.MappingStatus == "ProfileChecked") != true || string.IsNullOrWhiteSpace(well)) return;
        _busy = true; _message = null; _wellTest = null;
