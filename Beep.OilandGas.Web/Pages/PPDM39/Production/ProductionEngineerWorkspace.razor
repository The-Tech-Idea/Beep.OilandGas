@page "/production/engineer-workspace"
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true"><MudIcon Icon="@Icons.Material.Filled.Engineering" Class="mr-2" Color="Color.Primary" />Production Engineer Workspace</MudText>

    <MudGrid>
        <MudItem xs="12" sm="6" md="3"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Nodal Analysis</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudButton Variant="Variant.Outlined" FullWidth="true" Href="/ppdm39/calculations/nodalanalysis">IPR / VLP</MudButton></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Gas Lift</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudButton Variant="Variant.Outlined" FullWidth="true" Href="/ppdm39/calculations/gaslift">Design & Optimize</MudButton></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Pumping</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudButton Variant="Variant.Outlined" FullWidth="true" Href="/ppdm39/pumps/suckerrodpumping">SRP · Plunger · ESP</MudButton></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Pipeline</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudButton Variant="Variant.Outlined" FullWidth="true" Href="/ppdm39/calculations/pipelineanalysis">Hydraulics</MudButton></MudCardContent></MudCard></MudItem>
    </MudGrid>
    <MudGrid Class="mt-2">
        <MudItem xs="12" sm="6" md="3"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Compressors</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudButton Variant="Variant.Outlined" FullWidth="true" Href="/ppdm39/calculations/compressor-analysis">Performance</MudButton></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Chokes</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudButton Variant="Variant.Outlined" FullWidth="true" Href="/ppdm39/calculations/choke-analysis">Flow Analysis</MudButton></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Well Testing</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudButton Variant="Variant.Outlined" FullWidth="true" Href="/ppdm39/calculations/well-test-analysis">PTA</MudButton></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Forecasting</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudButton Variant="Variant.Outlined" FullWidth="true" Href="/production/forecasting">DCA & Forecast</MudButton></MudCardContent></MudCard></MudItem>
    </MudGrid>
</MudContainer>
