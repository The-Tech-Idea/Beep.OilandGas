@page "/production/engineer-workspace"
@using Beep.OilandGas.Models.Data
@using Beep.OilandGas.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Production Engineer Workspace</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Production Engineer Workspace</MudText>
    <ProductionFieldOverview />
        @* Engineering tools remain available while field data loads. *@
        <MudGrid>
            <MudItem xs="12" md="5">
                <MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Build" Class="mr-1" Size="Size.Small"/>Analysis Tools</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent Class="pa-2">
                    <MudGrid>
                        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/ppdm39/calculations/nodalanalysis">Nodal Analysis</MudButton></MudItem>
                        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/ppdm39/calculations/gaslift">Gas Lift</MudButton></MudItem>
                        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/ppdm39/pumps/suckerrodpumping">Sucker Rod Pump</MudButton></MudItem>
                        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/ppdm39/pumps/plungerlift">Plunger Lift</MudButton></MudItem>
                        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/ppdm39/calculations/pipelineanalysis">Pipeline Hydraulics</MudButton></MudItem>
                        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/ppdm39/calculations/compressor-analysis">Compressor Perf</MudButton></MudItem>
                        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/ppdm39/calculations/choke-analysis">Choke Analysis</MudButton></MudItem>
                        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/ppdm39/calculations/well-test-analysis">Well Test PTA</MudButton></MudItem>
                    </MudGrid>
                </MudCardContent></MudCard>
            </MudItem>
            <MudItem xs="12" md="7">
                <MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.History" Class="mr-1" Size="Size.Small"/>Production Monitoring</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent>
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/production">Production Dashboard</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/production/well-performance">Well Performance</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/production/intervention">Intervention Decisions</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/production/forecasting">Forecasting</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/ppdm39/production/well-tests">Well Tests</MudButton>
                    </MudStack>
                </MudCardContent></MudCard>
            </MudItem>
        </MudGrid>
</MudContainer>
