@page "/ppdm39/production/well-tests"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Beep.OilandGas.Web.Services
@using Beep.OilandGas.Web.Components.BusinessProcess
@inject Beep.OilandGas.Client.App.CompanyClientContext Company
@inject IDataManagementService DataManagement
@inject OilGasCallFailures Calls
@implements IDisposable
@using Beep.OilandGas.Models.Data
@inject ApiClient ApiClient
@inject ILifeCycleService LifeCycleService
@inject ISnackbar Snackbar
@inject IProductionServiceClient ProductionService

<PageTitle>Analyse Well Test Results</PageTitle>
<FieldSelector />
@if(_error is not null){<MudAlert Severity="Severity.Error">@_error</MudAlert>}
<MudAlert Severity="Severity.Info">Flow amounts retain their recorded UOM. Missing units, source timezone and approval evidence remain unavailable; values are not converted.</MudAlert>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">

    @* ── Header ──────────────────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Analyse Well Test Results</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@(_state?.Field ?? "No confirmed FIELD") — Flow-rate test history per well</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success"
                         Icon="@Icons.Material.Filled.Science">Production</MudChip>
            </MudStack>
        </MudStack>
    </MudStack>

    @* ── Well Search ───────────────────────────────────────────────── *@
    <MudCard Elevation="1" Class="mb-4">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudTextField Value="_wellIdFilter" ValueChanged="WellChanged"
                              Label="Well UWI / ID"
                              Placeholder="Enter well identifier"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              OnAdornmentClick="LoadWellTests"
                              Immediate="true"
                              Class="og-grow" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="LoadWellTests" Disabled="@_isLoading">
                    Load Tests
                </MudButton>
            </MudStack>
            @if (!string.IsNullOrWhiteSpace(_state?.Well))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                    Showing tests for well <strong>@_state?.Well</strong>
                </MudText>
            }
        </MudCardContent>
    </MudCard>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    @* ── KPI Row (only when tests are loaded) ──────────────────────────── *@
    @if (_wellTests != null && _wellTests.Any())
    {
        <MudGrid Class="mb-4" Spacing="3">
            <MudItem xs="12" sm="6" md="3">
                <KpiCard OnClick="@(()=>SelectCoverage(WellTestCoverage.All))" Label="Total Tests" Value="@((_wellTests?.Count ?? 0).ToString())"
                         ValueColor="Color.Primary" Icon="@Icons.Material.Filled.Science"
                         TrendIcon="@Icons.Material.Filled.TrendingFlat" TrendColor="Color.Default"
                         TrendText="All test records" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <KpiCard OnClick="@(()=>SelectCoverage(WellTestCoverage.Oil))" Label="Oil values recorded"
                         Value="@_wellTests.Count(x=>x.OilFlowAmount.HasValue).ToString()"
                         ValueColor="Color.Success" Icon="@Icons.Material.Filled.OilBarrel"
                         TrendIcon="@Icons.Material.Filled.TrendingFlat" TrendColor="Color.Default"
                         TrendText="Count of returned rows; units unavailable" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <KpiCard OnClick="@(()=>SelectCoverage(WellTestCoverage.Gas))" Label="Gas values recorded"
                         Value="@_wellTests.Count(x=>x.GasFlowAmount.HasValue).ToString()"
                         ValueColor="Color.Info" Icon="@Icons.Material.Filled.LocalGasStation"
                         TrendIcon="@Icons.Material.Filled.TrendingFlat" TrendColor="Color.Default"
                         TrendText="Count of returned rows; units unavailable" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <KpiCard OnClick="@(()=>SelectCoverage(WellTestCoverage.Water))" Label="Water values recorded"
                         Value="@_wellTests.Count(x=>x.WaterFlowAmount.HasValue).ToString()"
                         ValueColor="Color.Warning" Icon="@Icons.Material.Filled.Water"
                         TrendIcon="@Icons.Material.Filled.TrendingFlat" TrendColor="Color.Default"
                         TrendText="Count of returned rows; units unavailable" />
            </MudItem>
        </MudGrid>

        <MudText>Company @Company.Selection?.Scope.BusinessAssociateId · FIELD @_state?.Field · Well @_state?.Well · Coverage @_state?.Coverage · @(_state?.VisibleRows.Count ?? 0) contributing records</MudText>
        <MudText>Retrieved (UTC): @_state?.RetrievedAtUtc?.ToString("u") · Retrieval time is not a committed source snapshot.</MudText>
        <WellTestRecordedDetail Source="_state?.Selected" />
        @* ── Tests Grid ────────────────────────────────────────────────── *@
        <MudCard Elevation="2">
            <MudCardContent Class="pa-0">
                <MudDataGrid T="WellTestResponse" Items="@(_state?.VisibleRows ?? [])" Dense="true" Hover="true" Striped="true"
                             SortMode="SortMode.Multiple" Filterable="false">
                    <Columns>
                        <TemplateColumn Title="Review"><CellTemplate><MudButton OnClick="@(()=>_state?.SelectRecord(context.Item.TestId))">Review recorded test</MudButton></CellTemplate></TemplateColumn>
                        <PropertyColumn Property="t => t.Uwi" Title="Well UWI" />
                        <PropertyColumn Property="t => t.TestType" Title="Test Type" />
                        <TemplateColumn Title="Test Date">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">
                                    @((context.Item.TestDate ?? context.Item.TestStartDate ?? context.Item.TestEndDate)?.ToString("dd MMM yyyy") ?? "—")
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Run No.">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@(context.Item.RunNumber ?? "Unavailable")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Recorded oil amount">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@FormatAmount(context.Item.OilFlowAmount,context.Item.OilFlowAmountUom)</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Recorded gas amount">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@FormatAmount(context.Item.GasFlowAmount,context.Item.GasFlowAmountUom)</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Recorded water amount">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@FormatAmount(context.Item.WaterFlowAmount,context.Item.WaterFlowAmountUom)</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="BSW (%)">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@FormatDecimal(context.Item.BswPercent)</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Water cut (%)"><CellTemplate>@FormatDecimal(context.Item.WaterCutPercent)</CellTemplate></TemplateColumn>
                        <PropertyColumn Property="t=>t.TestId" Title="Recorded test ID" />
                        <TemplateColumn Title="Original oil/gas/water units"><CellTemplate>@(context.Item.OilFlowAmountOuom ?? "Unavailable") / @(context.Item.GasFlowAmountOuom ?? "Unavailable") / @(context.Item.WaterFlowAmountOuom ?? "Unavailable")</CellTemplate></TemplateColumn>
                        <PropertyColumn Property="t=>t.Source" Title="Recorded source" />
                        <PropertyColumn Property="t=>t.TestNumber" Title="Test number" />
                        <PropertyColumn Property="t=>t.TestStatus" Title="Recorded status" />
                        <PropertyColumn Property="t=>t.CreateUser" Title="Recorded preparer" />
                    </Columns>
                    <NoRecordsContent>
                        <MudStack AlignItems="AlignItems.Center" Class="pa-6">
                            <MudIcon Icon="@Icons.Material.Filled.Science" Color="Color.Secondary"
                                     Class="og-icon-xl" />
                            <MudText Typo="Typo.body1">No tests match the current filter</MudText>
                        </MudStack>
                    </NoRecordsContent>
                </MudDataGrid>
            </MudCardContent>
        </MudCard>
    }
    else if (!_isLoading && _error is null)
    {
        <MudStack AlignItems="AlignItems.Center" Class="pa-8">
            <MudIcon Icon="@Icons.Material.Filled.Science" Color="Color.Secondary"
                     Class="og-icon-xl" />
            <MudText Typo="Typo.h6">
                @if (string.IsNullOrWhiteSpace(_state?.Well))
                {
                    <span>Enter a well UWI to load test history</span>
                }
                else
                {
                    <span>No recorded tests returned for well @_state?.Well</span>
                }
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Use the search box above to look up a specific well.
            </MudText>
        </MudStack>
    }

</MudContainer>

@code {
    private WellTestReviewState? _state;
    private IReadOnlyList<WellTestResponse> _wellTests=>_state?.Rows ?? [];
    private bool _isLoading,_disposed;
    private string? _wellIdFilter,_error;
    protected override void OnInitialized(){_state=new(Company);Company.Changed+=ContextChanged;DataManagement.CurrentFieldChanged+=FieldChanged;}
    private void FieldChanged(string _) => ContextChanged();
    private void ContextChanged(){_state?.Clear();_error=null;_wellIdFilter=null;if(!_disposed)_=InvokeAsync(StateHasChanged);}
    private void SelectCoverage(WellTestCoverage coverage)=>_state?.SelectCoverage(coverage);
    private void WellChanged(string? value){_wellIdFilter=value;_state?.Clear();_error=null;}
    public void Dispose(){_disposed=true;Company.Changed-=ContextChanged;DataManagement.CurrentFieldChanged-=FieldChanged;_state?.Dispose();}
    private async Task LoadWellTests()
    {
        if(_isLoading || _disposed)return;
        var well=_wellIdFilter?.Trim();if(string.IsNullOrWhiteSpace(well)){_error="Enter the recorded well identity.";return;}
        var scope=Company.Snapshot;var version=_state!.Version+1;_isLoading=true;_error=null;
        try{await _state.LoadAsync(well,()=>DataManagement.GetCurrentFieldIdAsync(),id=>ProductionService.GetWellTestReviewAsync(id));}
        catch(Exception ex){var message=Calls.Explain(ex,"reading recorded well observations","Well observations could not be confirmed");if(!_disposed && scope==Company.Snapshot && version==_state.Version)_error=message;}
        finally{_isLoading=false;}
    }
    private static string FormatAmount(decimal? value,string? uom)=>FormatDecimal(value)+" · "+(string.IsNullOrWhiteSpace(uom)?"Units unavailable":uom);
    private static string FormatDecimal(decimal? value)=>value?.ToString("F1") ?? "Unavailable";
}
