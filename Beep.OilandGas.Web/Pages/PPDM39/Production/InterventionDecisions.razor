@page "/production/intervention"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using TheTechIdea.Data.OilGas
@using Beep.OilandGas.Web.Components.BusinessProcess
@using Beep.OilandGas.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject Beep.OilandGas.Client.App.CompanyClientContext Company
@inject IFieldSelectionContext DataManagement
@inject OilGasCallFailures Calls
@implements IDisposable
@using Beep.OilandGas.Models.Data.WorkOrder
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IProductionServiceClient ProductionService
@inject ProductionInterventionDecisionState Decisions
@inject AuthenticationStateProvider Authentication

<PageTitle>Decide Well Interventions</PageTitle>
<FieldSelector />
@if(!string.IsNullOrWhiteSpace(_error)){<MudAlert Severity="Severity.Error">@_error</MudAlert>}
@if(!_confirmed){<MudAlert Severity="Severity.Info">Intervention source is unconfirmed. Select company/FIELD and reload.</MudAlert>}
<MudButton OnClick="LoadCandidatesAsync" Disabled="_isLoading">Reload recorded candidates</MudButton>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">

    @if (_isLoading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" /> }

    @* ── Header ──────────────────────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Decide Well Interventions</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_fieldName — Authorise workover and stimulation operations</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Build">Production</MudChip>
            </MudStack>
        </MudStack>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            @if (!string.IsNullOrWhiteSpace(ReturnTo))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           Href="@ReturnTo">
                    Back to Optimizer
                </MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenNewIntervention">
                New Intervention
            </MudButton>
        </MudStack>
    </MudStack>

    @* ── View: candidate list vs detail ─────────────────────────────────── *@
    @if (_selectedIntervention == null)
    {
        @* ── Candidate list ────────────────────────────────────────────── *@
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1">Active Intervention Candidates</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-0">
                        <MudDataGrid T="ProductionInterventionCandidateDto" Items="@_candidates" Dense="true"
                                     Hover="true" RowClick="@OnCandidateClick" ReadOnly="true">
                            <Columns>
                                <PropertyColumn Property="c => c.WellId" Title="Recorded well" />
                                <TemplateColumn Title="Type">
                                    <CellTemplate>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@TypeColor(context.Item.InterventionType)">
                                            @context.Item.InterventionType
                                        </MudChip>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="c => c.Problem" Title="Problem" />
                                <TemplateColumn Title="Deferred production"><CellTemplate>@(context.Item.DeferredBopd is {} rate ? rate.ToString("N2") + " BOPD" : "Unavailable")</CellTemplate></TemplateColumn>
                                <TemplateColumn Title="Est. Cost"><CellTemplate>@(context.Item.EstCostUsd is {} cost ? cost.ToString("N2") + " USD" : "Unavailable")</CellTemplate></TemplateColumn>
                                <TemplateColumn Title="Priority">
                                    <CellTemplate>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@PriorityColor(context.Item.Priority)">
                                            @(context.Item.Priority ?? "Unavailable")
                                        </MudChip>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Status">
                                    <CellTemplate>
                                        <StatusBadge Status="@context.Item.Status" />
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn>
                                    <CellTemplate>
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => SelectCandidateAsync(context.Item))">
                                            Review →
                                        </MudButton>
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
    else
    {
        @* ── Decision Page for selected intervention ─────────────────────── *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="BackToList">
                Back to List
            </MudButton>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                / @_selectedIntervention.WellId / @_selectedIntervention.InterventionType
            </MudText>
        </MudStack>

        <MudGrid Spacing="3">

            @* LEFT — Supporting data (8 cols) *@
            <MudItem xs="12" lg="8">
                <MudStack Spacing="3">

                    <ProductionInterventionEvidence Source="_selectedIntervention" OriginalDecision='@(_confirmed ? _decisions?.Original(_fieldName,_selectedIntervention.WellId) : null)' HasAcknowledgement='@(_confirmed && Decisions.HasAcknowledgement(_fieldName,_selectedIntervention.WellId))' Reviewing="_deciding" ReviewAcknowledgement="ReviewAcknowledgedDecisionAsync" NativeDecisionId="_recoveryId" ReviewNativeDecision="ReviewNativeDecisionAsync" NativeReviewMessage="@_recoveryMessage" />

                    @* Supporting data tabs *@
                    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true">
                        <MudTabPanel Text="Production History">
                            <MudPaper Elevation="0" Class="pa-3">
                                @if(_wellRateSeries.Count==0){<MudAlert Severity="Severity.Info">Recorded rate history is unavailable.</MudAlert>}
                                else
                                {
                                <MudChart ChartType="ChartType.Line"
                                          ChartSeries="@_wellRateSeries"
                                          ChartLabels="@_wellRateLabels"
                                          Width="100%" Height="220px" />
                                }
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                    Recorded well tests are supplemental evidence. Rate-drop onset and root cause are unavailable.
                                </MudText>
                            </MudPaper>
                        </MudTabPanel>
                        <MudTabPanel Text="Diagnostics">
                            <MudPaper Elevation="0" Class="pa-3">
                                @if(_diagnosticsError is not null){<MudAlert Severity="Severity.Warning">@_diagnosticsError</MudAlert>}
                                else if(_diagnostics.Count==0){<MudAlert Severity="Severity.Info">Recorded diagnostic metadata is unavailable.</MudAlert>}
                                <MudList T="DiagnosticItem" Dense="true">
                                    @foreach (var d in _diagnostics)
                                    {
                                        <MudListItem T="DiagnosticItem" Value="d">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2">@d.Parameter</MudText>
                                                <MudText Typo="Typo.body2">@d.Value</MudText>
                                            </MudStack>
                                        </MudListItem>
                                        <MudDivider />
                                    }
                                </MudList>
                            </MudPaper>
                        </MudTabPanel>
                        <MudTabPanel Text="Similar Past Cases">
                            <MudPaper Elevation="0" Class="pa-3">
                                @if(_historicalCases.Count==0){<MudAlert Severity="Severity.Info">Recorded comparable cases have not been returned.</MudAlert>}
                                <MudList T="HistoricalCase" Dense="true">
                                    @foreach (var c in _historicalCases)
                                    {
                                        <MudListItem T="HistoricalCase" Value="c">
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.body2">@c.Well — @c.InterventionType (@c.Date)</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    Uplift: @c.UpliftBopd BOPD · Cost: $@c.CostUsdK K · Success: @c.Outcome
                                                </MudText>
                                            </MudStack>
                                        </MudListItem>
                                        <MudDivider />
                                    }
                                </MudList>
                            </MudPaper>
                        </MudTabPanel>
                    </MudTabs>

                </MudStack>
            </MudItem>

            @* RIGHT — Recommendation + Decision (4 cols) *@
            <MudItem xs="12" lg="4">
                <MudStack Spacing="3">

                    @* Recommendation *@
                    <MudCard Elevation="2">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Color="Color.Warning" Size="Size.Small" />
                                    <MudText Typo="Typo.subtitle1">Recommendation</MudText>
                                </MudStack>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudAlert Severity="Severity.Info">An approved engineering recommendation, scope, duration and payout have not been returned. This activity type is not an instruction to proceed.</MudAlert>
                        </MudCardContent>
                    </MudCard>

                    @* Decision panel *@
                    @if (!string.IsNullOrWhiteSpace(_selectedIntervention.WorkOrderId) || !string.IsNullOrWhiteSpace(_selectedIntervention.AfeNumber))
                    {
                        <MudCard Elevation="2">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.subtitle1">Linked Downstream Records</MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudStack Spacing="2">
                                    @if (!string.IsNullOrWhiteSpace(_selectedIntervention.WorkOrderId))
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.BuildCircle"
                                                   Href="@GetLinkedWorkOrderHref(_selectedIntervention.WorkOrderId)">
                                            Open Work Order @_selectedIntervention.WorkOrderId
                                        </MudButton>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_selectedIntervention.AfeNumber))
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Success"
                                                   StartIcon="@Icons.Material.Filled.RequestQuote"
                                                   Href="/economics/afe">
                                            Choose AFE source
                                        </MudButton>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_selectedIntervention.AbandonmentId))
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                                   StartIcon="@Icons.Material.Filled.ArrowForward"
                                                   Href="@GetLinkedDecommissioningHref(_selectedIntervention.WellId, _selectedIntervention.AbandonmentId, _selectedIntervention.ProcessInstanceId)">
                                            Open P&amp;A Programme @_selectedIntervention.AbandonmentId
                                        </MudButton>
                                    }
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    }

                    <MudCard Elevation="3">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.subtitle1">Make Decision</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            @if(!ProductionInterventionDecisionChecks.IsIndependentApprover(_selectedIntervention.SourcePreparer,Company.Selection?.UserId))
                            {<MudAlert Severity="Severity.Warning">A disposition requires an identified source preparer and a different reviewer. Review source ownership before deciding.</MudAlert>}
                            <MudTextField @bind-Value="_decisionNote" Label="Decision Note / Rationale"
                                          Lines="3" Variant="Variant.Outlined" Class="mb-3"
                                          Placeholder="Required before approving or deferring…" />
                            <MudAlert Severity="Severity.Info">Create a maintenance header separately. An optional link requires a recorded corrective order with a component for this FIELD and well.</MudAlert>
                            <MudTextField @bind-Value="_linkedWorkOrderId" Label="Recorded work-order ID to link (optional)" HelperText="Checked against its recorded FIELD/well component when approving." />
                            <MudStack Spacing="2">
                                <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Success"
                                           StartIcon="@Icons.Material.Filled.CheckCircle"
                                           Disabled="@(!CanSubmitDecision)"
                                           OnClick="ApproveIntervention">
                                    Record Approval
                                </MudButton>
                                <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Warning"
                                           StartIcon="@Icons.Material.Filled.PauseCircle"
                                           Disabled="@(!CanSubmitDecision)"
                                           OnClick="DeferIntervention">
                                    Defer — Monitor
                                </MudButton>
                                @if (string.IsNullOrWhiteSpace(_selectedIntervention.AbandonmentId))
                                {
                                    <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.ArrowForward"
                                               Disabled="@(_deciding || !_confirmed || string.IsNullOrWhiteSpace(_decisionNote) || _decisions?.IsBlocked(_fieldName,_selectedIntervention.WellId)==true || (_recoveryId is not null && !_recoveryConfirmed))"
                                               OnClick="TransitionToDecommissioning">
                                        Transition to P&amp;A
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton FullWidth="true" Variant="Variant.Text" Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.OpenInNew"
                                               Href="@GetLinkedDecommissioningHref(_selectedIntervention.WellId, _selectedIntervention.AbandonmentId, _selectedIntervention.ProcessInstanceId)">
                                        Open Existing P&amp;A Programme
                                    </MudButton>
                                }
                                <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.Cancel"
                                           Disabled="@(!CanSubmitDecision)" OnClick="RejectIntervention">
                                    Reject / Close
                                </MudButton>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>

                </MudStack>
            </MudItem>

        </MudGrid>
    }

</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "wellId")]
    public string? WellId { get; set; }

    [SupplyParameterFromQuery(Name = "returnTo")]
    public string? ReturnTo { get; set; }
    [SupplyParameterFromQuery(Name = "decisionId")]
    public Guid? DecisionId { get; set; }

    private Guid? _recoveryId;
    private string? _recoveryMessage;
    private bool _recoveryConfirmed;
    private bool CanSubmitDecision => !_deciding && _confirmed && _selectedIntervention is {} source && source.SelectionContext is not null &&
        !ProductionInterventionActivityChecks.IsDecisionActivity(source.LatestActivityType) &&
        ProductionInterventionDecisionChecks.IsIndependentApprover(source.SourcePreparer,Company.Selection?.UserId) &&
        !string.IsNullOrWhiteSpace(_decisionNote) && _decisions?.IsBlocked(_fieldName,source.WellId)!=true && (_recoveryId is null || _recoveryConfirmed);

    private string _fieldName = string.Empty;
    private string _linkedWorkOrderId=string.Empty;
    private string? _error;
    private string? _diagnosticsError;
    private bool _confirmed,_deciding,_disposed;
    private long _loadVersion;
    private ProductionInterventionDecisionState? _decisions;
    private string _decisionNote = "";
    private ProductionInterventionCandidateDto? _selectedIntervention;

    private List<ProductionInterventionCandidateDto> _candidates = new();
    private List<DiagnosticItem>          _diagnostics = new();
    private List<HistoricalCase>          _historicalCases = new();
    private List<ChartSeries<double>>     _wellRateSeries = new();
    private string[]                      _wellRateLabels = Array.Empty<string>();
    private bool                          _isLoading;

    protected override async Task OnInitializedAsync()
    {
        _decisions=Decisions;Company.Changed+=ContextChanged;DataManagement.CurrentFieldChanged+=FieldChanged;Authentication.AuthenticationStateChanged+=AuthenticationChanged;
        await LoadCandidatesAsync();
    }
    private void FieldChanged(string _) => ContextChanged();
    private void ContextChanged()
    {
        ++_loadVersion;_confirmed=false;_fieldName=string.Empty;_candidates=[];BackToList();_error=null;
        if(!_disposed)_=InvokeAsync(StateHasChanged);
    }
    private void AuthenticationChanged(Task<AuthenticationState> state)=>ContextChanged();
    public void Dispose(){_disposed=true;++_loadVersion;Company.Changed-=ContextChanged;DataManagement.CurrentFieldChanged-=FieldChanged;Authentication.AuthenticationStateChanged-=AuthenticationChanged;}
    private async Task RequireAuthorityAsync()
    {
        var snapshot=Company.Snapshot;var user=(await Authentication.GetAuthenticationStateAsync()).User;
        if(_disposed || snapshot!=Company.Snapshot || snapshot.Selection is null || user.Identity?.IsAuthenticated!=true || !snapshot.Selection.Roles.Any(user.IsInRole))
            throw new UnauthorizedAccessException("Current company roles are required for the intervention workspace.");
    }
    private async Task LoadCandidatesAsync()
    {
        if(_isLoading || _disposed)return;
        BackToList();var scope=Company.Snapshot;var version=++_loadVersion;_confirmed=false;_fieldName=string.Empty;_candidates=[];_error=null;_isLoading=true;
        try
        {
            if(scope.Selection is null)return;
            await RequireAuthorityAsync();
            if(_disposed || version!=_loadVersion || scope!=Company.Snapshot)return;
            var field=await DataManagement.GetCurrentFieldIdAsync();
            if(_disposed || version!=_loadVersion || scope!=Company.Snapshot)return;
            if(string.IsNullOrWhiteSpace(field))throw new InvalidOperationException("Confirm a FIELD before reading intervention candidates.");
            var dtos=await ProductionService.GetInterventionCandidatesAsync();
            if(_disposed || version!=_loadVersion || scope!=Company.Snapshot)return;
            ProductionInterventionCandidateChecks.Require(dtos,scope.Selection.Scope,scope.Selection.UserId,field);
            await RequireAuthorityAsync();
            if(_disposed || version!=_loadVersion || scope!=Company.Snapshot)return;
            _fieldName=field;_confirmed=true;_candidates=dtos;
            var match=_candidates.FirstOrDefault(c=>c.WellId==WellId);if(match is not null)await SelectCandidateAsync(match);
        }
        catch(Exception ex){var message=Calls.Explain(ex,"loading recorded intervention candidates","Intervention candidates could not be confirmed");if(!_disposed && version==_loadVersion && scope==Company.Snapshot)_error=message;}
        finally{_isLoading=false;}
    }

    private void OnCandidateClick(DataGridRowClickEventArgs<ProductionInterventionCandidateDto> args) =>
        _ = SelectCandidateAsync(args.Item);

    private async Task SelectCandidateAsync(ProductionInterventionCandidateDto c)
    {
        if(!_confirmed || !_candidates.Contains(c))return;
        var version=++_loadVersion;var scope=Company.Snapshot;
        _selectedIntervention = c;
        _recoveryConfirmed=false;_recoveryMessage=null;
        var original=Decisions.Original(_fieldName,c.WellId);
        _recoveryId=original?.Request.IntentId is {} id && id!=Guid.Empty ? id :
            WellId==c.WellId && DecisionId is {} queryId && queryId!=Guid.Empty ? queryId :
            c.LatestRecordedBy==Company.Selection?.UserId ? c.LatestDecisionId : null;
        _decisionNote = "";_linkedWorkOrderId=string.Empty;
        _diagnostics = new();_diagnosticsError=null;
        _wellRateSeries = new();
        _wellRateLabels = Array.Empty<string>();
        try
        {
            var perf = await ProductionService.GetWellPerformanceAsync(c.WellId);
            if(_disposed || version!=_loadVersion || scope!=Company.Snapshot || _selectedIntervention?.WellId!=c.WellId)return;
            if (perf?.WellTests != null)
            {
                var latest = perf.WellTests
                    .OrderByDescending(t => t.TestDate ?? t.TestStartDate ?? t.TestEndDate ?? DateTime.MinValue)
                    .FirstOrDefault();
                if (latest != null)
                {
                    _diagnostics.Add(new("Test Date",  latest.TestDate?.ToString("yyyy-MM-dd") ?? "Unavailable"));
                    _diagnostics.Add(new("Test Type",  latest.TestType ?? "Unavailable"));
                    _diagnostics.Add(new("Well Status", string.IsNullOrWhiteSpace(perf.Status) ? "Unavailable" : perf.Status));
                }
            }
        }
        catch(Exception ex){var message=Calls.Explain(ex,"loading recorded intervention diagnostics","Diagnostic metadata could not be confirmed");if(!_disposed && version==_loadVersion && scope==Company.Snapshot)_diagnosticsError=message;}
        StateHasChanged();
    }

    private void BackToList()
    {
        ++_loadVersion;
        _selectedIntervention = null;
        _recoveryId=null;_recoveryMessage=null;_recoveryConfirmed=false;
        _decisionNote = "";_linkedWorkOrderId=string.Empty;
        _diagnostics = new();_diagnosticsError=null;
        _wellRateSeries = new();
    }

    private void OpenNewIntervention()
    {
        if(!_confirmed)return;
        var wellId = _selectedIntervention?.WellId ?? WellId;
        var title = "Intervention follow-up";
        var description = _selectedIntervention?.Problem ?? "Create an intervention work order for the selected well.";
        var query = new List<string> { "openCreate=true", $"subType={Uri.EscapeDataString(WorkOrderSubType.Corrective)}" };

        if (!string.IsNullOrWhiteSpace(wellId))
            query.Add($"wellId={Uri.EscapeDataString(wellId)}");

        if (!string.IsNullOrWhiteSpace(title))
            query.Add($"title={Uri.EscapeDataString(title)}");

        if (!string.IsNullOrWhiteSpace(description))
            query.Add($"description={Uri.EscapeDataString(description)}");

        if (!string.IsNullOrWhiteSpace(ReturnTo))
            query.Add($"returnTo={Uri.EscapeDataString(ReturnTo)}");

        NavigationManager.NavigateTo($"/ppdm39/workorder?{string.Join("&", query)}");
    }

    private Task ApproveIntervention()=>SubmitDecisionAsync("APPROVED");
    private async Task SubmitDecisionAsync(string decision)
    {
        var selected=_selectedIntervention;
        if(selected is null || !CanSubmitDecision)return;
        var scope=Company.Snapshot;var field=_fieldName;var version=_loadVersion;_deciding=true;
        try
        {
            await RequireAuthorityAsync();
            if(_disposed || scope!=Company.Snapshot || field!=_fieldName || version!=_loadVersion || !ReferenceEquals(selected,_selectedIntervention))return;
            var current=await DataManagement.GetCurrentFieldSelectionAsync();
            FieldSelectionReviewValidator.RequireCurrent(current,scope.Selection!.Scope,scope.Selection.UserId);
            if(current.SelectionContext!=selected.SelectionContext)throw new InvalidOperationException("The source FIELD review changed. Reload its original data before deciding.");
            await RequireAuthorityAsync();
            if(_disposed || scope!=Company.Snapshot || field!=_fieldName || version!=_loadVersion || !ReferenceEquals(selected,_selectedIntervention))return;
            var attempt=_decisions!.Begin(selected.WellId,new(){IntentId=Guid.NewGuid(),Context=selected.SelectionContext,ExpectedSourceRevision=selected.SourceRevision,FieldId=field,Decision=decision,Note=_decisionNote,
                InterventionType=selected.InterventionType,Problem=selected.Problem,CreateWorkOrder=false,LinkAfe=false,
                WorkOrderId=decision=="APPROVED" ? _linkedWorkOrderId : null});
            _recoveryId=attempt.Request.IntentId;DecisionId=_recoveryId;WellId=attempt.Well;
            NavigationManager.NavigateTo(GetNativeRecoveryHref(attempt.Well,attempt.Request.IntentId),replace:true);
            var result=await ProductionService.RecordInterventionDecisionAsync(attempt.Well,attempt.Request);
            _decisions.RetainAcknowledgement(attempt,result);
            if(_disposed || !_decisions.IsCurrent(attempt,_fieldName))return;
            var confirmed=await Decisions.RecoverNativeOutcomeAsync(field,attempt.Well,attempt.Request.IntentId,async()=>{
                var recovered=await ProductionService.RecoverInterventionDecisionAsync(attempt.Well,attempt.Request.IntentId);
                await RequireAuthorityAsync();
                if(_disposed || scope!=Company.Snapshot || field!=_fieldName || version!=_loadVersion || !ReferenceEquals(selected,_selectedIntervention))throw new OperationCanceledException("The displayed original decision context changed.");
                return recovered;
            });
            if(confirmed is null)throw new InvalidOperationException("The original reservation is retained but its decision result is not confirmed.");
            if(_disposed || !_decisions.IsCurrent(attempt,_fieldName) || version!=_loadVersion || !ReferenceEquals(selected,_selectedIntervention))return;
            Snackbar.Add(result.Message ?? $"Recorded {decision} decision returned for {attempt.Well}.",Severity.Success);
            if(!string.IsNullOrWhiteSpace(result.WorkOrderId)){NavigationManager.NavigateTo(GetLinkedWorkOrderHref(result.WorkOrderId));return;}
            BackToList();await LoadCandidatesAsync();
        }
        catch(Exception ex){var message=Calls.Explain(ex,"recording an intervention decision","Decision outcome could not be confirmed. Review recorded source before retrying");if(!_disposed && scope==Company.Snapshot && field==_fieldName)_error=message;}
        finally{_deciding=false;}
    }

    private async Task ReviewAcknowledgedDecisionAsync()
    {
        if(_recoveryId is not null){await ReviewNativeDecisionAsync();return;}
        if(_disposed || !_confirmed || _deciding || _selectedIntervention is not {} selected)return;
        var scope=Company.Snapshot;var field=_fieldName;var version=_loadVersion;_deciding=true;_error=null;
        try
        {
            await RequireAuthorityAsync();
            if(_disposed || scope!=Company.Snapshot || field!=_fieldName || version!=_loadVersion)return;
            var result=await Decisions.ReviewAcknowledgedOutcomeAsync(field,selected.WellId,async()=>{
                var recorded=await ProductionService.GetInterventionCandidatesAsync();
                await RequireAuthorityAsync();
                if(_disposed || scope!=Company.Snapshot || field!=_fieldName || version!=_loadVersion)throw new OperationCanceledException("The original displayed decision context changed.");
                return recorded;
            });
            if(_disposed || scope!=Company.Snapshot || field!=_fieldName || version!=_loadVersion)return;
            Snackbar.Add("The original acknowledged decision matches the recorded activity. No decision was submitted again.",Severity.Success);
            if(!string.IsNullOrWhiteSpace(result.WorkOrderId)){NavigationManager.NavigateTo(GetLinkedWorkOrderHref(result.WorkOrderId));return;}
            BackToList();await LoadCandidatesAsync();
        }
        catch(Exception ex){var message=Calls.Explain(ex,"reviewing the original acknowledged intervention decision","The original decision remains unconfirmed");if(!_disposed && scope==Company.Snapshot && field==_fieldName)_error=message;}
        finally{_deciding=false;}
    }
    private string GetNativeRecoveryHref(string well,Guid id)=>$"/production/intervention?wellId={Uri.EscapeDataString(well)}&decisionId={id:D}"+
        (string.IsNullOrWhiteSpace(ReturnTo)?string.Empty:$"&returnTo={Uri.EscapeDataString(ReturnTo)}");

    private async Task ReviewNativeDecisionAsync()
    {
        if(_disposed || !_confirmed || _deciding || _selectedIntervention is not {} selected || _recoveryId is not {} id)return;
        var scope=Company.Snapshot;var field=_fieldName;var version=_loadVersion;_deciding=true;_error=null;
        try
        {
            await RequireAuthorityAsync();
            var result=await Decisions.RecoverNativeOutcomeAsync(field,selected.WellId,id,async()=>{
                var recovery=await ProductionService.RecoverInterventionDecisionAsync(selected.WellId,id);
                await RequireAuthorityAsync();
                if(_disposed || scope!=Company.Snapshot || field!=_fieldName || version!=_loadVersion || !ReferenceEquals(selected,_selectedIntervention))throw new OperationCanceledException("The original displayed recovery context changed.");
                return recovery;
            });
            if(_disposed || scope!=Company.Snapshot || field!=_fieldName || version!=_loadVersion)return;
            _recoveryConfirmed=result is not null;
            _recoveryMessage=result is null ? "The original request is retained; its native decision is not yet confirmed. No decision was submitted again." :
                $"Original {result.Decision} decision confirmed for {result.WellId}. No decision was submitted again.";
        }
        catch(Exception ex){var message=Calls.Explain(ex,"recovering the original native intervention decision","The original decision remains unconfirmed");if(!_disposed && scope==Company.Snapshot && field==_fieldName)_error=message;}
        finally{_deciding=false;}
    }
    private async Task TransitionToDecommissioning()
    {
        if (_selectedIntervention == null || !_confirmed || _deciding || _decisions?.IsBlocked(_fieldName,_selectedIntervention.WellId)==true || (_recoveryId is not null && !_recoveryConfirmed)) return;

        try
        {
            var result = await ProductionService.TransitionToDecommissioningAsync(
                _selectedIntervention.WellId,
                new ProductionDecommissioningTriggerRequest
                {
                    Note = _decisionNote,
                    InterventionType = _selectedIntervention.InterventionType,
                    Problem = _selectedIntervention.Problem,
                    EstimatedCostUsd = _selectedIntervention.EstCostUsd,
                    AbandonmentType = "PERMANENTLY_ABANDONED",
                    AbandonmentMethod = "CEMENT_PLUG",
                    StartWorkflow = true
                });

            if (!result.Success || string.IsNullOrWhiteSpace(result.AbandonmentId))
            {
                Snackbar.Add("Decommissioning handoff failed.", Severity.Error);
                return;
            }

            Snackbar.Add(
                result.Message ?? $"Decommissioning handoff created for {_selectedIntervention.WellName}.",
                result.WorkflowStarted || result.AlreadyExists ? Severity.Success : Severity.Warning);

            NavigationManager.NavigateTo(
                GetLinkedDecommissioningHref(
                    _selectedIntervention.WellId,
                    result.AbandonmentId,
                    result.ProcessInstanceId,
                    _decisionNote));
        }
        catch (Exception)
        {
            Snackbar.Add("Decommissioning handoff failed.", Severity.Error);
        }
    }

    private Task DeferIntervention()=>SubmitDecisionAsync("DEFERRED");
    private Task RejectIntervention()=>SubmitDecisionAsync("REJECTED");

    private Color TypeColor(string t) => t switch
    {
        "Unplanned Shut-in" => Color.Error,
        "ESP Replacement"   => Color.Warning,
        "Acid Stimulation"  => Color.Info,
        _                   => Color.Default,
    };

    private Color PriorityColor(string? p) => p switch
    {
        "HIGH"   => Color.Error,
        "MEDIUM" => Color.Warning,
        _        => Color.Default,
    };

    private record DiagnosticItem(string Parameter, string Value);
    private record HistoricalCase(string Well, string InterventionType, string Date, int UpliftBopd, int CostUsdK, string Outcome);

    private string GetLinkedWorkOrderHref(string workOrderId) =>
        WorkOrderNavigation.Detail(workOrderId)+$"&returnTo={Uri.EscapeDataString(BuildInterventionReturnTo())}"+
        (DecisionId is {} id && !string.IsNullOrWhiteSpace(WellId)?$"&interventionId={id:D}&wellId={Uri.EscapeDataString(WellId)}":string.Empty);

    private string GetLinkedDecommissioningHref(string wellId, string? abandonmentId, string? processInstanceId, string? handoffReason = null)
    {
        var query = new List<string>
        {
            $"wellId={Uri.EscapeDataString(wellId)}",
            "sourceProcess=production-intervention",
            $"returnTo={Uri.EscapeDataString(BuildInterventionReturnTo())}"
        };

        if (!string.IsNullOrWhiteSpace(abandonmentId))
            query.Add($"abandonmentId={Uri.EscapeDataString(abandonmentId)}");

        if (!string.IsNullOrWhiteSpace(processInstanceId))
            query.Add($"processInstanceId={Uri.EscapeDataString(processInstanceId)}");

        if (!string.IsNullOrWhiteSpace(handoffReason))
            query.Add($"handoffReason={Uri.EscapeDataString(handoffReason)}");

        return "/decommissioning/well-pa?" + string.Join("&", query);
    }

    private string BuildInterventionReturnTo()
    {
        var query = new List<string>();
        var wellId = _selectedIntervention?.WellId ?? WellId;

        if (!string.IsNullOrWhiteSpace(wellId))
            query.Add($"wellId={Uri.EscapeDataString(wellId)}");

        if(DecisionId is {} decisionId)query.Add($"decisionId={decisionId:D}");
        if (!string.IsNullOrWhiteSpace(ReturnTo))
            query.Add($"returnTo={Uri.EscapeDataString(ReturnTo)}");

        return query.Count == 0
            ? "/production/intervention"
            : "/production/intervention?" + string.Join("&", query);
    }
}
