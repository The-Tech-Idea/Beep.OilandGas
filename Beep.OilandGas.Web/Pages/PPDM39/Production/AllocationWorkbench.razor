@page "/production/allocation"
@inject ApiClient ApiClient
@inject ILifeCycleService LifeCycleService
@inject ISnackbar Snackbar
@inject IDevelopmentServiceClient DevelopmentService
@inject IProductionServiceClient ProductionService
@inject IClientFileExportService ExportService
@inject OilGasCallFailures Calls

<PageTitle>Allocate Production Volumes</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">

    @if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" /> }

    @* ── Header ──────────────────────────────────────────────────────────── *@
    @* No allocation status is shown: the API keeps no allocation record with a status (draft, submitted, locked). *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Allocate Production Volumes</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_fieldName — Allocate measured production to wells and facilities</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CallSplit">Production</MudChip>
            </MudStack>
        </MudStack>
    </MudStack>

    @* ── Period selector ─────────────────────────────────────────────────── *@
    @* The period is the person's choice of calendar month: the API keeps no list of allocation periods, so the months
       offered are the current one and the eleven before it. Only the well-test ratio is calculated here — no metered or
       reservoir-model allocation exists in the codebase, so no method is offered. *@
    <MudPaper Elevation="1" Class="pa-3 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
            <MudSelect T="DateTime" Label="Allocation Period" @bind-Value="_periodMonth"
                       Variant="Variant.Outlined" Class="og-select-lg">
                @foreach (var month in PeriodMonths)
                {
                    <MudSelectItem T="DateTime" Value="@month">@month.ToString("MMMM yyyy", CultureInfo.InvariantCulture)</MudSelectItem>
                }
            </MudSelect>
            @* No field meter reading reaches this page: the field total is the sum of the wells' latest test rates, so it
               is not called "measured". *@
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Field total: <strong>@_fieldTotal.ToString("N0") BOPD</strong> from the wells' latest tests
            </MudText>
        </MudStack>
    </MudPaper>

    @* ── Allocation balance banner ────────────────────────────────────────── *@
    <MudPaper Elevation="2" Class="@AllocationBannerClass">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@(_isBalanced ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)"
                     Color="@(_isBalanced ? Color.Success : Color.Warning)" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.body1">
                    <strong>@(_isBalanced ? "Allocation Balanced" : "Allocation Imbalanced")</strong>
                    — Allocated: @_allocatedTotal.ToString("N0") BOPD vs Field total: @_fieldTotal.ToString("N0") BOPD
                </MudText>
                @if (!_isBalanced)
                {
                    <MudText Typo="Typo.body2" Color="Color.Warning">
                        Difference: @((_fieldTotal - _allocatedTotal).ToString("+N0;-N0")) BOPD —
                        adjust well ratios or check meter data before submitting.
                    </MudText>
                }
            </MudStack>
        </MudStack>
    </MudPaper>

    @* ── Main Content ─────────────────────────────────────────────────────── *@
    <MudGrid Spacing="3">

        @* LEFT — Allocation table (8 cols) *@
        <MudItem xs="12" lg="8">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle1">Well Allocation — @PeriodName</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Autorenew"
                                   OnClick="RecalculateAllocation">
                            Recalculate
                        </MudButton>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent Class="pa-0">
                    @* No allocation adjustment is stored: the API has no writer for a well's allocated volumes (PPDM's
                       PDEN_VOL_SUMMARY), and its endpoint had answered "saved" while keeping nothing — so the cells are
                       not offered for editing. *@
                    <MudDataGrid T="WellAllocation" Items="@_allocations" Dense="true" ReadOnly="true">
                        <Columns>
                            <PropertyColumn Property="a => a.WellName" Title="Well" Editable="false" />
                            <PropertyColumn Property="a => a.TestRateBopd" Title="Test Rate (BOPD)" Format="N0" Editable="false" />
                            <PropertyColumn Property="a => a.UptimeFraction" Title="Uptime" Format="P1" Editable="false" />
                            <PropertyColumn Property="a => a.AllocationFactor" Title="Factor %" Format="P1" Editable="false" />
                            <PropertyColumn Property="a => a.AllocatedOilBopd" Title="Allocated Oil (BOPD)" Format="N0" Editable="false" />
                            <PropertyColumn Property="a => a.AllocatedGasMmscfd" Title="Gas (MMSCFD)" Format="N2" Editable="false" />
                            <PropertyColumn Property="a => a.AllocatedWaterBopd" Title="Water (BWPD)" Format="N0" Editable="false" />
                            <TemplateColumn Title="">
                                <CellTemplate>
                                    @{
                                        var variance = context.Item.AllocatedOilBopd - context.Item.TestRateBopd * context.Item.UptimeFraction;
                                        var pctVar = context.Item.TestRateBopd > 0 ? variance / (context.Item.TestRateBopd * context.Item.UptimeFraction) : 0;
                                    }
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(Math.Abs(pctVar) < 0.05 ? Color.Success : Math.Abs(pctVar) < 0.10 ? Color.Warning : Color.Error)">
                                        @pctVar.ToString("+0%;-0%")
                                    </MudChip>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                </MudCardContent>
                <MudCardContent Class="pa-2">
                    <MudText Typo="Typo.caption" Class="mb-1">Adjusting a well's allocation by hand is not available yet; the allocation shown is calculated from the wells' latest tests.</MudText>
                    <MudStack Row="true" Spacing="4">
                        <MudText Typo="Typo.body2"><strong>TOTAL:</strong> Oil @_allocatedTotal.ToString("N0") BOPD &nbsp;|&nbsp; Gas @_allocations.Sum(a => a.AllocatedGasMmscfd).ToString("N2") MMSCFD &nbsp;|&nbsp; Water @_allocations.Sum(a => a.AllocatedWaterBopd).ToString("N0") BWPD</MudText>
                    </MudStack>
                </MudCardContent>
                <MudCardActions>
                    <MudStack Row="true" Spacing="2" Class="pa-2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        @* No allocation-approval endpoint in the API: submitting changed only this page's status and said it
                           was submitted. *@
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   Disabled="true"
                                   StartIcon="@Icons.Material.Filled.Save">
                            Submit for Approval
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.Autorenew"
                                   OnClick="RecalculateAllocation">
                            Reset to Calculated
                        </MudButton>
                        @* The table as shown, downloaded as CSV (Excel opens it): no spreadsheet writer is in the codebase. *@
                        <MudButton Variant="Variant.Outlined" Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   Disabled="@(_allocations.Count == 0)"
                                   OnClick="ExportAllocationAsync">
                            Export to CSV
                        </MudButton>
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Submitting an allocation for approval is not available yet.
                        </MudAlert>
                    </MudStack>
                </MudCardActions>
            </MudCard>
        </MudItem>

        @* RIGHT — Charts (4 cols) *@
        <MudItem xs="12" lg="4">
            <MudStack Spacing="3">

                @* Oil contribution donut *@
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1">Oil Contribution</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudChart ChartType="ChartType.Donut"
                                  ChartSeries="@_contributionSeries"
                                  ChartLabels="@_contributionLabels"
                                  Width="100%"
                                  Height="200px" />
                    </MudCardContent>
                </MudCard>

                @* Monthly summary *@
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1">Monthly Totals</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Allocated daily rates × @DaysInPeriod days in @PeriodName</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudList T="string" Dense="true">
                            <MudListItem T="string" Value="@("oil")">
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">Oil (MBBl)</MudText>
                                    <MudText Typo="Typo.body2"><strong>@((_allocatedTotal * DaysInPeriod / 1000).ToString("N0"))</strong></MudText>
                                </MudStack>
                            </MudListItem>
                            <MudDivider />
                            <MudListItem T="string" Value="@("gas")">
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">Gas (BSCF)</MudText>
                                    <MudText Typo="Typo.body2"><strong>@(_allocations.Sum(a => a.AllocatedGasMmscfd * DaysInPeriod / 1000).ToString("N3"))</strong></MudText>
                                </MudStack>
                            </MudListItem>
                            <MudDivider />
                            <MudListItem T="string" Value="@("water")">
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">Water (MBWl)</MudText>
                                    <MudText Typo="Typo.body2"><strong>@((_allocations.Sum(a => a.AllocatedWaterBopd) * DaysInPeriod / 1000).ToString("N0"))</strong></MudText>
                                </MudStack>
                            </MudListItem>
                            <MudDivider />
                            <MudListItem T="string" Value="@("wc")">
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">Avg Water Cut</MudText>
                                    <MudText Typo="Typo.body2"><strong>@WaterCutPct.ToString("N1")%</strong></MudText>
                                </MudStack>
                            </MudListItem>
                        </MudList>
                    </MudCardContent>
                </MudCard>

                @* No allocation history is shown: the API records no submitted or approved allocations (the list was never
                   filled). *@

            </MudStack>
        </MudItem>

    </MudGrid>

</MudContainer>

@code {
    private string _fieldName = string.Empty;
    private double _fieldTotal        = 0;
    private bool   _loading           = true;

    // The first day of the calendar month being allocated; the current month until the person picks another.
    private DateTime _periodMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);

    private List<WellAllocation> _allocations = new();

    // The current month and the eleven before it, newest first.
    private static IEnumerable<DateTime> PeriodMonths
    {
        get
        {
            var current = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            return Enumerable.Range(0, 12).Select(back => current.AddMonths(-back));
        }
    }

    // The period as the allocation API names it ("Oct 2026"), and as the page shows it.
    private string PeriodKey  => _periodMonth.ToString("MMM yyyy", CultureInfo.InvariantCulture);
    private string PeriodName => _periodMonth.ToString("MMMM yyyy", CultureInfo.InvariantCulture);
    private int    DaysInPeriod => DateTime.DaysInMonth(_periodMonth.Year, _periodMonth.Month);

    private double _allocatedTotal => _allocations.Sum(a => a.AllocatedOilBopd);
    private bool   _isBalanced     => _fieldTotal <= 0 || Math.Abs(_allocatedTotal - _fieldTotal) < 50;
    private double WaterCutPct =>
        (_allocations.Sum(a => a.AllocatedOilBopd + a.AllocatedWaterBopd)) > 0
            ? _allocations.Sum(a => a.AllocatedWaterBopd) /
              _allocations.Sum(a => a.AllocatedOilBopd + a.AllocatedWaterBopd) * 100
            : 0;

    private List<ChartSeries<double>> _contributionSeries =>
        new() { new ChartSeries<double> { Data = _allocations.Select(a => a.AllocatedOilBopd).ToArray() } };

    private string[] _contributionLabels =>
        _allocations.Select(a => a.WellName).ToArray();

    private string AllocationBannerClass => $"pa-3 mb-4 {(_isBalanced ? "allocation-balanced" : "allocation-unbalanced")}";

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            try
            {
                var summary = await LifeCycleService.GetFieldLifecycleSummaryAsync();
                if (summary != null)
                    _fieldName = summary.FieldName ?? _fieldName;
            }
            // The field name is supplemental: a failed call is said as a warning and the allocation still loads; anything
            // else reaches the page's error boundary.
            catch (Exception failure) when (OilGasCallFailures.IsCallFailure(failure))
            {
                Snackbar.Add(Calls.Explain(failure, "loading the field name for the allocation workbench", "The field name could not be loaded"), Severity.Warning);
            }

            // Load development wells
            var wells = await DevelopmentService.GetWellsAsync();
            if (wells.Count == 0)
            {
                _loading = false;
                return;
            }

            // Load performance for all wells in parallel
            var perfTasks = wells.Select(w => LoadWellPerfAsync(w.UWI ?? string.Empty)).ToList();
            var perfs = await Task.WhenAll(perfTasks);

            // A well whose performance did not load is allocated at zero: the page says how many, with the first one's
            // sentence and reference (each is recorded where it failed).
            var unloaded = perfs.Where(p => p.Failure is not null).ToList();
            if (unloaded.Count == 1)
                Snackbar.Add(unloaded[0].Failure!, Severity.Warning);
            else if (unloaded.Count > 1)
                Snackbar.Add($"The performance of {unloaded.Count} wells could not be loaded, so their rates show as zero. {unloaded[0].Failure}", Severity.Warning);

            // Build allocation rows
            _allocations = wells
                .Select((w, i) =>
                {
                    var perf = perfs[i].Performance;
                    return new WellAllocation(
                        wellName: w.WELL_NAME ?? w.UWI ?? "Unknown",
                        uwi:      w.UWI ?? string.Empty,
                        testRate: perf?.OilRate ?? 0,
                        uptime:   1.0,
                        factor:   0,
                        oil:      perf?.OilRate ?? 0,
                        gas:      perf?.GasRate ?? 0,
                        water:    perf?.WaterRate ?? 0);
                })
                .Where(a => !string.IsNullOrEmpty(a.Uwi))
                .ToList();

            // Compute field total as sum of well rates; allocation factor from ratios
            _fieldTotal = _allocations.Sum(a => a.TestRateBopd);
            ApplyCalculatedAllocation(showToast: false);
        }
        // A failed call says the allocation did not load; anything else reaches the page's error boundary.
        catch (Exception failure) when (OilGasCallFailures.IsCallFailure(failure))
        {
            Snackbar.Add(Calls.Explain(failure, "loading the allocation data", "Failed to load allocation data"), Severity.Warning);
        }
        finally { _loading = false; }
    }

    private async Task<WellPerformanceLoad> LoadWellPerfAsync(string uwi)
    {
        if (string.IsNullOrEmpty(uwi)) return new(null, null);
        try
        {
            return new(await ProductionService.GetWellPerformanceAsync(uwi), null);
        }
        // One well that does not load leaves its rates at zero and the others still load: the failure is recorded here and
        // its sentence returned for the page to say (it answered "no performance", silently).
        catch (Exception failure) when (OilGasCallFailures.IsCallFailure(failure))
        {
            return new(null, Calls.Explain(
                failure,
                "loading a well's performance for the allocation",
                $"The performance of well {uwi} could not be loaded, so its rates show as zero"));
        }
    }

    /// <summary>A well's performance, or the sentence saying why it did not load.</summary>
    private sealed record WellPerformanceLoad(ProductionWellPerformanceDto? Performance, string? Failure);

    private void RecalculateAllocation()
    {
        ApplyCalculatedAllocation(showToast: true);
    }

    private void ApplyCalculatedAllocation(bool showToast)
    {
        var totalTestWeighted = _allocations.Sum(a => a.TestRateBopd * a.UptimeFraction);
        foreach (var a in _allocations)
        {
            a.AllocationFactor = totalTestWeighted > 0
                ? a.TestRateBopd * a.UptimeFraction / totalTestWeighted
                : 0;
            a.AllocatedOilBopd = _fieldTotal > 0
                ? Math.Round(a.AllocationFactor * _fieldTotal)
                : a.TestRateBopd;
        }

        if (showToast)
        {
            Snackbar.Add("Allocation recalculated from well test ratios", Severity.Info);
        }
    }

    // The allocation table as the page shows it, one row per well, with a header row.
    private async Task ExportAllocationAsync()
    {
        var rows = new List<string[]>
        {
            new[] { "Period", "Well", "UWI", "Test Rate (BOPD)", "Uptime", "Factor", "Allocated Oil (BOPD)", "Gas (MMSCFD)", "Water (BWPD)" }
        };
        rows.AddRange(_allocations.Select(a => new[]
        {
            PeriodKey,
            a.WellName,
            a.Uwi,
            a.TestRateBopd.ToString("0.##", CultureInfo.InvariantCulture),
            a.UptimeFraction.ToString("0.####", CultureInfo.InvariantCulture),
            a.AllocationFactor.ToString("0.####", CultureInfo.InvariantCulture),
            a.AllocatedOilBopd.ToString("0.##", CultureInfo.InvariantCulture),
            a.AllocatedGasMmscfd.ToString("0.####", CultureInfo.InvariantCulture),
            a.AllocatedWaterBopd.ToString("0.##", CultureInfo.InvariantCulture),
        }));

        await ExportService.DownloadCsvAsync(
            $"allocation-{_periodMonth:yyyy-MM}",
            row => row,
            rows);
        Snackbar.Add($"The allocation table for {PeriodName} was downloaded.", Severity.Success);
    }

    private class WellAllocation
    {
        public string WellName           { get; set; }
        public string Uwi                { get; set; }
        public double TestRateBopd       { get; set; }
        public double UptimeFraction     { get; set; }
        public double AllocationFactor   { get; set; }
        public double AllocatedOilBopd   { get; set; }
        public double AllocatedGasMmscfd { get; set; }
        public double AllocatedWaterBopd { get; set; }

        public WellAllocation(string wellName, string uwi, double testRate, double uptime,
            double factor, double oil, double gas, double water)
        {
            WellName = wellName; Uwi = uwi; TestRateBopd = testRate;
            UptimeFraction = uptime; AllocationFactor = factor;
            AllocatedOilBopd = oil; AllocatedGasMmscfd = gas; AllocatedWaterBopd = water;
        }
    }
}
