@page "/production/operations"
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true"><MudIcon Icon="@Icons.Material.Filled.Speed" Class="mr-2" Color="Color.Primary"/>Production Operations</MudText>
    @if(_loading){<MudProgressLinear Indeterminate="true" Class="my-4"/>}else{
    <MudGrid>
        <MudItem xs="6" md="3"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">Daily Production</MudText><MudText Typo="Typo.h4" Color="Color.Primary">@FormatVolume(_kpi?.DailyBoe??0)</MudText><MudText Typo="Typo.caption">BOE/d</MudText></div><MudIcon Icon="@Icons.Material.Filled.OilBarrel" Color="Color.Primary" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
        <MudItem xs="6" md="3"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">Uptime</MudText><MudText Typo="Typo.h4" Color="@(_kpi?.Uptime<90?Color.Error:Color.Success)">@($"{_kpi?.Uptime:F1}%")</MudText><MudText Typo="Typo.caption">producing wells</MudText></div><MudIcon Icon="@Icons.Material.Filled.Timer" Color="Color.Success" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
        <MudItem xs="6" md="3"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">Intervention Candidates</MudText><MudText Typo="Typo.h4" Color="Color.Warning">@_kpi?.InterventionCandidates</MudText><MudText Typo="Typo.caption">wells flagged</MudText></div><MudIcon Icon="@Icons.Material.Filled.Build" Color="Color.Warning" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
        <MudItem xs="6" md="3"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">Gas Lift Efficiency</MudText><MudText Typo="Typo.h4" Color="Color.Info">@($"{_kpi?.GasLiftEfficiency:F0}%")</MudText><MudText Typo="Typo.caption">target GLR</MudText></div><MudIcon Icon="@Icons.Material.Filled.Air" Color="Color.Info" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
    </MudGrid>
    <MudGrid>
        <MudItem xs="12" md="5"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Production Tools</MudText></CardHeaderContent></MudCardHeader><MudCardContent Class="pa-2"><MudGrid>
        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/production">Production Dashboard</MudButton></MudItem>
        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/production/well-performance">Well Performance</MudButton></MudItem>
        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/production/intervention">Intervention Decisions</MudButton></MudItem>
        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/production/forecasting">Forecasting</MudButton></MudItem>
    </MudGrid></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" md="7"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Monitoring & Planning</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap"><MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/production/allocation">Allocation</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/ppdm39/production/well-tests">Well Tests</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/ppdm39/production/reporting">Reporting</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/ppdm39/production/reserves">Reserves</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/ppdm39/operations/enhancedrecovery">EOR</MudButton></MudStack></MudCardContent></MudCard>
        <MudCard Elevation="2" Class="mt-2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Attention Required</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudAlert Severity="Severity.Error" Dense="true">WELL-042: Gas lift efficiency below 60% — optimize injection rate.</MudAlert><MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">3 wells flagged as intervention candidates — review workover economics.</MudAlert></MudCardContent></MudCard></MudItem></MudGrid>}
</MudContainer>

@code{private bool _loading=true;private ProductionMgrKpi? _kpi;
protected override async Task OnInitializedAsync(){try{_kpi=await Http.GetFromJsonAsync<ProductionMgrKpi>("/api/production/engineer/kpi")??new();}catch{_kpi=new();}_loading=false;}
private static string FormatVolume(decimal v)=>v>=1_000_000?$"{v/1_000_000m:F2}M":v>=1_000?$"{v/1_000m:F1}K":$"{v:F0}";
public class ProductionMgrKpi{public decimal DailyBoe{get;set;}public decimal Uptime{get;set;}public int InterventionCandidates{get;set;}public decimal GasLiftEfficiency{get;set;}}}
