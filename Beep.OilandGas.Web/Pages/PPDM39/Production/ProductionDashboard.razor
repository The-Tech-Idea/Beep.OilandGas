@page "/production"
@using Beep.OilandGas.Models.Data.Production
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@inject IDataManagementService DataManagementService
@inject IProductionServiceClient ProductionService

<PageTitle>Production Dashboard</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5">Production Dashboard</MudText>
        <MudButton OnClick="Reload" Disabled="@(_state?.Loading == true)" StartIcon="@Icons.Material.Filled.Refresh">Refresh</MudButton>
    </MudStack>
    @if (_state?.Loading == true)
    {
        <MudProgressLinear Indeterminate="true" aria-label="Loading production data" Class="mb-4" />
    }
    @if (_state?.Error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_state.Error</MudAlert>
    }
    @if (_state?.NeedsField == true)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">Choose an active field above to load production data.</MudAlert>
    }
    @if (_state?.Summary is { } summary)
    {
        <MudText Typo="Typo.h6" Class="mb-3">Field: @summary.FieldId</MudText>
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6"><KpiCard Label="Active well records" Value="@summary.TotalWells.ToString("N0")" Icon="@Icons.Material.Filled.OilBarrel" /></MudItem>
            <MudItem xs="12" sm="6"><KpiCard Label="Active activity records" Value="@summary.OpenWorkOrders.ToString("N0")" Icon="@Icons.Material.Filled.Build" /></MudItem>
        </MudGrid>
        <MudText Typo="Typo.subtitle1">Recorded well status</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">Status comes from well records. Water cut is from the latest dated well test; these are not live production readings.</MudText>
        @if (_state.Wells.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">No well-status records were returned for this field.</MudAlert>
        }
        else
        {
            <MudDataGrid T="ProductionWellStatusDto" Items="@_state.Wells" Dense="true" Hover="true" ReadOnly="true" Class="mb-4">
                <Columns>
                    <PropertyColumn Property="w => w.WellName" Title="Well" />
                    <PropertyColumn Property="w => w.WellId" Title="UWI" />
                    <TemplateColumn Title="Recorded status"><CellTemplate><StatusBadge Status="@context.Item.Status" /></CellTemplate></TemplateColumn>
                    <TemplateColumn Title="Water cut (%)"><CellTemplate>@(context.Item.LastTestDate.HasValue ? context.Item.WaterCut.ToString("N1") : "Not available")</CellTemplate></TemplateColumn>
                    <TemplateColumn Title="Latest test date"><CellTemplate>@(context.Item.LastTestDate?.ToString("yyyy-MM-dd") ?? "Not available")</CellTemplate></TemplateColumn>
                    <TemplateColumn Title="Review">
                        <CellTemplate>
                            <MudButton Size="Size.Small" Href="@($"/production/well-performance?wellId={Uri.EscapeDataString(context.Item.WellId)}")">Performance</MudButton>
                            <MudButton Size="Size.Small" Href="@($"/production/intervention?wellId={Uri.EscapeDataString(context.Item.WellId)}")">Interventions</MudButton>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent><MudDataGridPager T="ProductionWellStatusDto" /></PagerContent>
            </MudDataGrid>
        }
    }
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
        <MudButton Variant="Variant.Outlined" Href="/production/intervention">Review interventions</MudButton>
        <MudButton Variant="Variant.Outlined" Href="/production/allocation">Allocate production</MudButton>
        <MudButton Variant="Variant.Outlined" Href="/production/forecasting">Review forecast</MudButton>
        <MudButton Variant="Variant.Outlined" Href="/ppdm39/production/well-tests">Well tests</MudButton>
        <MudButton Variant="Variant.Outlined" Href="/production/operations">Field metrics and alerts</MudButton>
    </MudStack>
</MudContainer>

@code {
    private ProductionDashboardState? _state;
    private bool _disposed;
    protected override async Task OnInitializedAsync()
    {
        _state = new(fieldId => ProductionService.GetDashboardAsync(fieldId));
        DataManagementService.CurrentFieldChanged += FieldChanged;
        await Reload();
    }
    private Task Reload() => _state!.LoadAsync(DataManagementService.GetCurrentFieldIdAsync);
    private void FieldChanged(string fieldId)
    {
        if (!_disposed) _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            var load = Reload();
            StateHasChanged(); await load;
            if (!_disposed) StateHasChanged();
        });
    }
    public void Dispose()
    {
        _disposed = true;
        DataManagementService.CurrentFieldChanged -= FieldChanged;
        _state?.Dispose();
    }
}
