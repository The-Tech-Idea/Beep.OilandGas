@page "/executive/dashboard"
@using MudBlazor
@inject ApiClient ApiClient
@inject NavigationManager Nav
@inject OilGasApiFailures Answers
@inject FailureNotifier Notifier

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.Insights" Class="mr-2" Color="Color.Primary" />
        Executive Dashboard
    </MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="my-4">@_loadError</MudAlert>
    }
    else
    {
        @* ── Top KPI Row ── *@
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="3">
                    <MudCardContent>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Production</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Primary">@FormatVolume(_kpi?.TotalProductionBoe ?? 0) BOE/d</MudText>
                        <MudText Typo="Typo.caption" Color="@(_kpi?.ProductionTrend > 0 ? Color.Success : Color.Error)">@(_kpi?.ProductionTrend > 0 ? "↑" : "↓") @($"{Math.Abs(_kpi?.ProductionTrend ?? 0):F1}%") vs prior period</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="3">
                    <MudCardContent>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Active Wells</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Primary">@(_kpi?.ActiveWells ?? 0) / @(_kpi?.TotalWells ?? 0)</MudText>
                        <MudText Typo="Typo.caption">@(_kpi?.TotalIncidentsYtd ?? 0) HSE incidents YTD</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="3">
                    <MudCardContent>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Production Trend</MudText>
                        <MudText Typo="Typo.h4" Color="@(_kpi?.ProductionTrend > 0 ? Color.Success : Color.Warning)">@($"{_kpi?.ProductionTrend ?? 0:F1}%")</MudText>
                        <MudText Typo="Typo.caption">vs prior month</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="3">
                    <MudCardContent>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">HSE Tier 1 Events</MudText>
                        <MudText Typo="Typo.h4" Color="@(_kpi?.Tier1Events > 0 ? Color.Error : Color.Success)">@(_kpi?.Tier1Events ?? 0)</MudText>
                        <MudText Typo="Typo.caption">YTD</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        @* ── Asset Overview Table ── *@
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.h6">Asset Performance</MudText></CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudTable Items="@_assets" Hover="true" Striped="true" Dense="true">
                            <HeaderContent>
                                <MudTh>Field</MudTh>
                                <MudTh>Field ID</MudTh>
                                <MudTh>Phase</MudTh>
                                <MudTh>Active Wells</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.FieldName</MudTd>
                                <MudTd>@context.FieldId</MudTd>
                                <MudTd><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.LifecyclePhase)">@context.LifecyclePhase</MudChip></MudTd>
                                <MudTd>@context.ActiveWells</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.h6">Quick Actions</MudText></CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudStack Row="false" Spacing="2">
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Href="/reservoir/reserves">Reserves Report</MudButton>
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Href="/economics/evaluation">Economic Analysis</MudButton>
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Href="/hse/incidents">HSE Incidents</MudButton>
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Href="/production/intervention">Intervention Candidates</MudButton>
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Href="/ppdm39/process/gates">Pending Gate Reviews</MudButton>
                        </MudStack>
                    </MudCardContent>
                </MudCard>

                <MudCard Elevation="2" Class="mt-3">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.h6">Upcoming Deadlines</MudText></CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_deadlines?.Count > 0)
                        {
                            @foreach (var d in _deadlines)
                            {
                                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-2">
                                    <MudText Typo="Typo.body2">@d.Description</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@(d.DaysUntil < 7 ? Color.Error : d.DaysUntil < 30 ? Color.Warning : Color.Default)">@d.DaysUntil d</MudChip>
                                </MudStack>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No upcoming deadlines</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private string? _loadError;
    private ExecutiveKpi? _kpi;
    private List<AssetSummary>? _assets = new();
    private List<DeadlineItem>? _deadlines = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _kpi = await ApiClient.GetAsync<ExecutiveKpi>("/api/executive/kpi");
            if (_kpi == null) _kpi = new ExecutiveKpi();

            var assets = await ApiClient.GetAsync<List<AssetSummary>>("/api/executive/assets");
            _assets = assets ?? new();
        }
        // The page says the dashboard did not load. It showed zero production, wells and incidents in its place, which
        // read as the portfolio's figures.
        catch (OilGasApiException answer)
        {
            _loadError = Answers.Explain(answer, "loading the executive dashboard", "The executive dashboard could not be loaded");
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            _loadError = Notifier.FailureText(ex, "loading the executive dashboard", "The executive dashboard could not be loaded");
        }
        _loading = false;
    }

    private static string FormatVolume(decimal v) => v >= 1_000_000 ? $"{v / 1_000_000m:F2}M" : v >= 1_000 ? $"{v / 1_000m:F1}K" : $"{v:F0}";
    private static string FormatCurrency(decimal v) => v >= 1_000_000_000 ? $"${v / 1_000_000_000m:F1}B" : v >= 1_000_000 ? $"${v / 1_000_000m:F1}M" : $"${v:N0}";
    private static Color StatusColor(string? phase) => phase switch
    {
        "PRODUCTION" => Color.Success,
        "DEVELOPMENT" => Color.Primary,
        "DECLINE" => Color.Warning,
        "DECOMMISSIONING" => Color.Error,
        "EXPLORATION" => Color.Info,
        _ => Color.Default
    };

    public class ExecutiveKpi
    {
        public decimal TotalProductionBoe { get; set; }
        public decimal ProductionTrend { get; set; }
        public int TotalWells { get; set; }
        public int ActiveWells { get; set; }
        public int Tier1Events { get; set; }
        public int TotalIncidentsYtd { get; set; }
    }

    public class AssetSummary
    {
        public string FieldId { get; set; } = string.Empty;
        public string FieldName { get; set; } = string.Empty;
        public string LifecyclePhase { get; set; } = string.Empty;
        public int ActiveWells { get; set; }
    }

    public class DeadlineItem
    {
        public string Description { get; set; } = string.Empty;
        public int DaysUntil { get; set; }
    }
}
