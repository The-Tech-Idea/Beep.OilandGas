@page "/executive/dashboard"
@page "/lifecycle/asset/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Beep.OilandGas.Web.Components.Workflow
@using Beep.OilandGas.Web.Services
@inject Beep.OilandGas.Client.App.CompanyClientContext Company
@inject IExecutiveServiceClient Executive
@inject OilGasCallFailures Calls
@inject AuthenticationStateProvider Authentication
@implements IDisposable
@if(_authorized){<PersonaTaskInbox WorkspaceRoutes='@(new[]{"/executive/dashboard","/lifecycle/asset/dashboard"})' />}
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h3">Company portfolio</MudText>
    <MudButton OnClick="LoadAsync" Disabled="_loading">Reload company evidence</MudButton>
    @if(_loading){<MudProgressLinear Indeterminate="true" aria-label="Loading current company executive evidence" />}
    @if(_error is not null){<MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>}
    <MudAlert Severity="Severity.Info">Production, financial and HSE KPIs are unavailable until approved period, units, source and consolidation evidence is provided.</MudAlert>
    @if(_state?.Current is {} review)
    {
        <MudText>Company @review.Company.BusinessAssociateId · Source @review.Source · Retrieved (UTC) @review.RetrievedAtUtc.ToString("u")</MudText>
        <MudText>@review.Assets.Count authorized FIELD records returned. This is not a complete company/group portfolio or an approved performance total.</MudText>
        @if(review.Assets.Count==0){<MudAlert Severity="Severity.Info">No authorized FIELD records were returned.</MudAlert>}
        else
        {
            <MudTable Items="review.Assets" Dense="true" Hover="true">
                <HeaderContent><MudTh>FIELD identity</MudTh><MudTh>Recorded name</MudTh><MudTh>Evidence</MudTh></HeaderContent>
                <RowTemplate><MudTd DataLabel="FIELD identity">@context.FieldId</MudTd><MudTd DataLabel="Recorded name">@(context.FieldName ?? "Unavailable")</MudTd><MudTd DataLabel="Evidence"><MudButton OnClick="@(()=>_state.Select(context.FieldId))">Review recorded FIELD</MudButton></MudTd></RowTemplate>
            </MudTable>
        }
        @if(_state.Selected is {} field){<MudPaper Class="pa-4"><MudText>Recorded FIELD @field.FieldId · @(field.FieldName ?? "Name unavailable")</MudText><MudText>Lifecycle phase: @(field.LifecyclePhase ?? "Unavailable") · Active-well count: @(field.ActiveWells?.ToString() ?? "Unavailable")</MudText></MudPaper>}
    }
    else if(!_loading && _error is null){<MudAlert Severity="Severity.Info">Select a company and reload its recorded portfolio evidence.</MudAlert>}
    <MudStack Class="mt-4"><MudButton Href="/reservoir/reserves">Reserves Report</MudButton><MudButton Href="/economics/evaluation">Economics</MudButton><MudButton Href="/accounting/dashboard">Accounting</MudButton><MudButton Href="/hse/dashboard">HSE</MudButton></MudStack>
</MudContainer>
@code{
    private ExecutivePortfolioState? _state;private bool _loading,_disposed,_authorized;private string? _error;private int _generation;
    protected override async Task OnInitializedAsync(){_state=new(Company);Company.Changed+=Invalidate;Authentication.AuthenticationStateChanged+=AuthenticationChanged;await LoadAsync();}
    private void Invalidate(){_generation++;_state?.Clear();_error=null;_loading=false;_authorized=false;if(!_disposed)_=InvokeAsync(StateHasChanged);}
    private void AuthenticationChanged(Task<AuthenticationState> _) => Invalidate();
    public void Dispose(){if(_disposed)return;_disposed=true;_generation++;Company.Changed-=Invalidate;Authentication.AuthenticationStateChanged-=AuthenticationChanged;_state?.Dispose();}
    private async Task LoadAsync()
    {
        if(_loading || _disposed)return;var scope=Company.Snapshot;var generation=++_generation;_state!.Clear();_loading=true;_authorized=false;_error=null;
        try
        {
            if(scope.Selection is not {} selected)return;
            var user=(await Authentication.GetAuthenticationStateAsync()).User;
            if(_disposed || scope!=Company.Snapshot || generation!=_generation)return;
            if(user.Identity?.IsAuthenticated!=true || user.FindFirst("party_id")?.Value!=selected.UserId || !selected.Roles.Any(user.IsInRole))throw new UnauthorizedAccessException("Current selected company/account and standard app roles are required for executive evidence.");
            _authorized=true;
            await _state.LoadAsync(()=>Executive.GetPortfolioAsync());
        }
        catch(Exception ex){var message=Calls.Explain(ex,"reading executive company evidence","Executive evidence could not be confirmed");if(!_disposed && scope==Company.Snapshot && generation==_generation)_error=message;}
        finally{if(!_disposed && generation==_generation)_loading=false;}
    }
}
