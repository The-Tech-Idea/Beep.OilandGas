@page "/executive/dashboard"
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.Insights" Class="mr-2" Color="Color.Primary" />
        Executive Dashboard
    </MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else
    {
        @* ── Top KPI Row ── *@
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="3">
                    <MudCardContent>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Production</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Primary">@FormatVolume(_kpi?.TotalProductionBoe ?? 0) BOE/d</MudText>
                        <MudText Typo="Typo.caption" Color="@(_kpi?.ProductionTrend > 0 ? Color.Success : Color.Error)">@(_kpi?.ProductionTrend > 0 ? "↑" : "↓") @($"{Math.Abs(_kpi?.ProductionTrend ?? 0):F1}%") vs prior period</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="3">
                    <MudCardContent>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Revenue (MTD)</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Primary">@FormatCurrency(_kpi?.RevenueMtd ?? 0)</MudText>
                        <MudText Typo="Typo.caption" Color="@(_kpi?.RevenueTrend > 0 ? Color.Success : Color.Error)">@(_kpi?.RevenueTrend > 0 ? "↑" : "↓") @($"{Math.Abs(_kpi?.RevenueTrend ?? 0):F1}%") vs prior</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="3">
                    <MudCardContent>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Reserves (2P)</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Primary">@FormatVolume(_kpi?.TotalReservesMmboe * 1000 ?? 0) MMBOE</MudText>
                        <MudText Typo="Typo.caption">@(_kpi?.ReserveReplacementRatio ?? 0):F0% replacement</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="3">
                    <MudCardContent>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">HSE (LTIF)</MudText>
                        <MudText Typo="Typo.h4" Color="@(_kpi?.Ltif > 0.5 ? Color.Error : Color.Success)">@($"{_kpi?.Ltif ?? 0:F2}")</MudText>
                        <MudText Typo="Typo.caption">@(_kpi?.Tier1Events ?? 0) Tier 1 events YTD</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        @* ── Asset Overview Table ── *@
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.h6">Asset Performance</MudText></CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudTable Items="@_assets" Hover="true" Striped="true" Dense="true">
                            <HeaderContent>
                                <MudTh>Field</MudTh>
                                <MudTh>Production (BOE/d)</MudTh>
                                <MudTh>OpEx ($/BOE)</MudTh>
                                <MudTh>Reserves (MMBOE)</MudTh>
                                <MudTh>Active Wells</MudTh>
                                <MudTh>Status</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.FieldName</MudTd>
                                <MudTd>@FormatVolume(context.ProductionBoePerDay)</MudTd>
                                <MudTd>@($"${context.OpExPerBoe:F1}")</MudTd>
                                <MudTd>@($"{context.ReservesMmboe:F1}")</MudTd>
                                <MudTd>@context.ActiveWells</MudTd>
                                <MudTd><MudChip Size="Size.Small" Color="@StatusColor(context.LifecyclePhase)">@context.LifecyclePhase</MudChip></MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.h6">Quick Actions</MudText></CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudStack Row="false" Spacing="2">
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Href="/reservoir/reserves">Reserves Report</MudButton>
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Href="/economics/evaluation">Economic Analysis</MudButton>
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Href="/hse/incidents">HSE Incidents</MudButton>
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Href="/production/intervention">Intervention Candidates</MudButton>
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Href="/ppdm39/process/gates">Pending Gate Reviews</MudButton>
                        </MudStack>
                    </MudCardContent>
                </MudCard>

                <MudCard Elevation="2" Class="mt-3">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.h6">Upcoming Deadlines</MudText></CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_deadlines?.Count > 0)
                        {
                            @foreach (var d in _deadlines)
                            {
                                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-2">
                                    <MudText Typo="Typo.body2">@d.Description</MudText>
                                    <MudChip Size="Size.Small" Color="@(d.DaysUntil < 7 ? Color.Error : d.DaysUntil < 30 ? Color.Warning : Color.Default)">@d.DaysUntil d</MudChip>
                                </MudStack>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No upcoming deadlines</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private ExecutiveKpi? _kpi;
    private List<AssetSummary>? _assets = new();
    private List<DeadlineItem>? _deadlines = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _kpi = await Http.GetFromJsonAsync<ExecutiveKpi>("/api/executive/kpi");
            if (_kpi == null) _kpi = new ExecutiveKpi();

            var assets = await Http.GetFromJsonAsync<List<AssetSummary>>("/api/executive/assets");
            _assets = assets?.OrderByDescending(f => f.ActiveWells).Take(10).ToList() ?? new();
        }
        catch
        {
            _kpi = new ExecutiveKpi();
            _assets = new();
        }
        _loading = false;
    }

    private static string FormatVolume(decimal v) => v >= 1_000_000 ? $"{v / 1_000_000m:F2}M" : v >= 1_000 ? $"{v / 1_000m:F1}K" : $"{v:F0}";
    private static string FormatCurrency(decimal v) => v >= 1_000_000_000 ? $"${v / 1_000_000_000m:F1}B" : v >= 1_000_000 ? $"${v / 1_000_000m:F1}M" : $"${v:N0}";
    private static Color StatusColor(string? phase) => phase switch
    {
        "PRODUCTION" => Color.Success,
        "DEVELOPMENT" => Color.Primary,
        "DECLINE" => Color.Warning,
        "DECOMMISSIONING" => Color.Error,
        "EXPLORATION" => Color.Info,
        _ => Color.Default
    };

    public class ExecutiveKpi
    {
        public decimal TotalProductionBoe { get; set; }
        public decimal ProductionTrend { get; set; }
        public decimal RevenueMtd { get; set; }
        public decimal RevenueTrend { get; set; }
        public decimal TotalReservesMmboe { get; set; }
        public decimal ReserveReplacementRatio { get; set; }
        public decimal Ltif { get; set; }
        public int Tier1Events { get; set; }
    }

    public class AssetSummary
    {
        public string? FieldName { get; set; }
        public decimal ProductionBoePerDay { get; set; }
        public decimal OpExPerBoe { get; set; }
        public decimal ReservesMmboe { get; set; }
        public int ActiveWells { get; set; }
        public string? LifecyclePhase { get; set; }
    }

    public class DeadlineItem
    {
        public string Description { get; set; } = string.Empty;
        public int DaysUntil { get; set; }
    }
}
