@using Beep.OilandGas.Models.Data.Company
@page "/reservoir/workspace"
@page "/reservoir/dashboard"
@using MudBlazor
@using Beep.OilandGas.Web.Components.Workflow
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Reservoir engineer workspace</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">Reservoir engineer workspace</MudText>
    <MudText Class="mb-4">Review assigned work, inspect reservoir evidence and compare analysis before reviewing reserves and recovery options.</MudText>

    <PersonaTaskInbox WorkspaceRoutes='@(new[]{"/reservoir/workspace","/reservoir/dashboard"})' />

    <MudAlert Severity="Severity.Info" Class="mb-4">Reservoir performance and recovery totals are unavailable here. Open the source screens to review recorded values, reporting periods, units and assumptions.</MudAlert>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="4">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Inspect reservoir evidence</MudText>
                    <MudText Class="mb-3">Start with recorded reservoir, characterization and well-test evidence for the area under review.</MudText>
                    <MudStack Spacing="2">
                        <MudButton Href="/reservoir" Variant="Variant.Outlined">Open reservoir overview</MudButton>
                        <MudButton Href="/reservoir/characterization" Variant="Variant.Outlined">Review characterization</MudButton>
                        <MudButton Href="/ppdm39/production/well-tests" Variant="Variant.Outlined">Review well tests</MudButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Compare analysis and scenarios</MudText>
                    <MudText Class="mb-3">Review inputs, units and assumptions with the results before using an analysis in a decision.</MudText>
                    <MudStack Spacing="2">
                        <MudButton Href="/analysis/decline-curve" Variant="Variant.Outlined">Open decline curve analysis</MudButton>
                        <MudButton Href="/analysis/well-test" Variant="Variant.Outlined">Open pressure transient analysis</MudButton>
                        <MudButton Href="/analysis/flash-calculations" Variant="Variant.Outlined">Open PVT and flash calculations</MudButton>
                        <MudButton Href="/ppdm39/calculations/nodalanalysis" Variant="Variant.Outlined">Open nodal analysis</MudButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Review reserves and recovery</MudText>
                    <MudText Class="mb-3">Inspect classification and recovery evidence, then open the assigned process for independent review.</MudText>
                    <MudStack Spacing="2">
                        <MudButton Href="/reservoir/reserves" Variant="Variant.Outlined">Review reserves classification</MudButton>
                        <MudButton Href="/ppdm39/production/reserves" Variant="Variant.Outlined">Open reserves report</MudButton>
                        <MudButton Href="/reservoir/eor" Variant="Variant.Outlined">Open EOR screening</MudButton>
                        <MudButton Href="/ppdm39/operations/enhancedrecovery" Variant="Variant.Outlined">Review enhanced recovery</MudButton>
                        <MudButton Href="/tasks/inbox" Variant="Variant.Outlined">Open task inbox</MudButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>
