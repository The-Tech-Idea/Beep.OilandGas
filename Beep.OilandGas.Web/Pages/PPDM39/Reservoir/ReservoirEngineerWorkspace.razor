@page "/reservoir/workspace"
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true"><MudIcon Icon="@Icons.Material.Filled.Science" Class="mr-2" Color="Color.Primary" />Reservoir Engineer Workspace</MudText>
    @if (_loading) { <MudProgressLinear Indeterminate="true" Class="my-4" /> }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Pools</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent>
                    @if (_pools?.Count > 0)
                    {
                        <MudTable Items="@_pools" Hover="true" Dense="true">
                            <HeaderContent><MudTh>Pool</MudTh><MudTh>Status</MudTh><MudTh>Discovered</MudTh></HeaderContent>
                            <RowTemplate><MudTd>@context.PoolName</MudTd><MudTd>@context.Status</MudTd><MudTd>@context.DiscoveryDate?.ToString("yyyy-MM-dd")</MudTd></RowTemplate>
                        </MudTable>
                    }
                    else { <MudAlert Severity="Severity.Info">No pool data</MudAlert> }
                </MudCardContent></MudCard>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Quick Actions</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent>
                    <MudStack Row="false" Spacing="2">
                        <MudButton Variant="Variant.Outlined" FullWidth="true" Href="/reservoir/reserves">Reserves Classification</MudButton>
                        <MudButton Variant="Variant.Outlined" FullWidth="true" Href="/reservoir/eor">EOR Screening</MudButton>
                        <MudButton Variant="Variant.Outlined" FullWidth="true" Href="/reservoir/characterization">Reservoir Characterization</MudButton>
                        <MudButton Variant="Variant.Outlined" FullWidth="true" Href="/analysis/well-test">Well Test Analysis</MudButton>
                        <MudButton Variant="Variant.Outlined" FullWidth="true" Href="/analysis/flash-calculations">PVT / Flash</MudButton>
                    </MudStack>
                </MudCardContent></MudCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private List<PoolSummary>? _pools;
    protected override async Task OnInitializedAsync()
    { try { _pools = await Http.GetFromJsonAsync<List<PoolSummary>>("/api/reservoir/aggregation/pools") ?? new(); } catch { _pools = new(); } _loading = false; }
    public class PoolSummary { public string PoolId { get; set; } = string.Empty; public string PoolName { get; set; } = string.Empty; public DateTime? DiscoveryDate { get; set; } public string Status { get; set; } = string.Empty; }
}
