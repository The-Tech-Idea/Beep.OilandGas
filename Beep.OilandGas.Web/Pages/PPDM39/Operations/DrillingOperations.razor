@page "/ppdm39/operations/drillingoperations"
@using Beep.OilandGas.Web.Components.Workflow
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<PageTitle>Drilling programs</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
    <MudText Typo="Typo.h4" HtmlTag="h1">Drilling programs and approved funding</MudText>
    <MudText Class="my-3">Review recorded programs for the exact well and approved investment source. Follow the recorded review and execution links to actual start, then open observed drilling progress for dated measurements, units, source provenance and report history. Construction acceptance and production handover require their own recorded evidence.</MudText>
    <DrillingProgramDraftPanel WellUwi="@WellUwi" />
</MudContainer>
@code{
    [Parameter,SupplyParameterFromQuery(Name="wellUwi")]public string? WellUwi{get;set;}
}
