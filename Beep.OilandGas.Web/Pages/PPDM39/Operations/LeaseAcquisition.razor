@using Beep.OilandGas.PermitsAndApplications.Models
@using Beep.OilandGas.PPDM39.DataManagement.Models
@using Beep.OilandGas.Models.Core.Interfaces
@using Beep.OilandGas.Models.Data.Company
@page "/ppdm39/operations/leaseacquisition"
@using Beep.OilandGas.Models.Data.Lease
@using Beep.OilandGas.Client.App
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject Beep.OilandGas.Models.Core.Interfaces.IFieldSelectionContext FieldSelection
@inject LeasePortfolioState Portfolio
@inject LeaseCreationState Creation

<PageTitle>Manage Lease Acquisitions</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">

    @* ─── Header *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Manage Lease Acquisitions</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">FIELD @_fieldId — Recorded lease portfolio</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                         Icon="@Icons.Material.Filled.Assignment">Operations</MudChip>
            </MudStack>
        </MudStack>
        <AuthorizeView Roles="Administrator" Context="leaseAdmin">
        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@(!Portfolio.Current || Portfolio.Busy || Creation.Busy)"
                   OnClick="OpenCreateDialog">Create Lease Acquisition</MudButton>
        </AuthorizeView>
    </MudStack>

    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadLeases" Disabled="@(Portfolio.Loading || Portfolio.Busy)">Reload selected FIELD</MudButton>
    @if (Portfolio.NeedsCompany)
    {
        <MudAlert Severity="Severity.Info" role="status">Select an available company before reading lease records.</MudAlert>
    }
    else if (Portfolio.NeedsField)
    {
        <MudAlert Severity="Severity.Info" role="status">Choose an available FIELD using the existing field selector.</MudAlert>
    }
    else if (Portfolio.Error is not null)
    {
        <MudAlert Severity="Severity.Error" role="alert">@Portfolio.Error</MudAlert>
    }
    @if (Portfolio.Loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" aria-label="Loading lease records" />
    }
    @if (Portfolio.CommandError is not null)
    {
        <MudAlert Severity="Severity.Error" role="alert">@Portfolio.CommandError</MudAlert>
    }
    @if (Portfolio.Confirmation is not null)
    {
        <MudAlert Severity="Severity.Info" role="status">@Portfolio.Confirmation</MudAlert>
    }
    @if (Portfolio.HasUnconfirmedStatus)
    {
        <MudAlert Severity="Severity.Warning" role="status">A status write for this FIELD is unconfirmed. Its lease remains unavailable for another status write in this session; reloading records does not resolve that command.</MudAlert>
    }
    @if (Portfolio.Current)
    {
        <MudGrid Class="mb-4" Spacing="3">
            <MudItem xs="12" sm="6" md="3">
                <KpiCard Label="Recorded Leases" Value="@_leases.Count.ToString(CultureInfo.CurrentCulture)"
                         ValueColor="Color.Primary" Icon="@Icons.Material.Filled.Assignment"
                         TrendIcon="@Icons.Material.Filled.TrendingFlat" TrendColor="Color.Default"
                         TrendText="Current FIELD response" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <KpiCard Label="Recorded ACTIVE Status" Value="@_leases.Count(row => row.Status == "ACTIVE").ToString(CultureInfo.CurrentCulture)"
                         ValueColor="Color.Success" Icon="@Icons.Material.Filled.CheckCircle"
                         TrendIcon="@Icons.Material.Filled.TrendingFlat" TrendColor="Color.Default"
                         TrendText="Stored code; no legal approval inferred" />
            </MudItem>
        </MudGrid>
    }
    @if (Portfolio.Evaluation is { } evaluated)
    {
        <MudPaper Outlined="true" Class="pa-3 mb-4">
            <MudText Typo="Typo.subtitle2">Recorded lease @evaluated.LandRightSubtype / @evaluated.LeaseId</MudText>
            <MudText>FIELD @evaluated.FieldId — Date zone @evaluated.DateZoneId</MudText>
            <MudText>Recorded calculated interest: @evaluated.CalculatedInterest.ToString(CultureInfo.CurrentCulture)</MudText>
            <MudText>Stored status: @(string.IsNullOrEmpty(evaluated.Status) ? "Not recorded" : evaluated.Status)</MudText>
        </MudPaper>
    }
    @* ─── Leases Grid *@
    <MudCard Elevation="2">
        <MudCardContent Class="pa-0">
            @if (Portfolio.Current && _leases.Any())
            {
                <MudDataGrid T="LeaseSummary" Items="@_leases" Dense="true" Hover="true" Striped="true"
                             SortMode="SortMode.Multiple" Filterable="true">
                    <Columns>
                        <PropertyColumn Property="l => l.LandRightSubtype" Title="Land Right Subtype" />
                        <PropertyColumn Property="l => l.LeaseId" Title="Land Right ID" />
                        <PropertyColumn Property="l => l.DateZoneId" Title="Date Zone" />
                        <PropertyColumn Property="l => l.LeaseNumber" Title="Lease Number" />
                        <PropertyColumn Property="l => l.LeaseName" Title="Lease Name" />
                        <PropertyColumn Property="l => l.LeaseType" Title="Lease Type" />
                        <TemplateColumn Title="Effective">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@FormatLeaseDate(context.Item.EffectiveDate)</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Expires">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@FormatLeaseDate(context.Item.ExpirationDate)</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Term (Months)">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@FormatLeaseTerm(context.Item.PrimaryTermMonths)</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Recorded Calculated Interest">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@context.Item.CalculatedInterest.ToString(CultureInfo.CurrentCulture)</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Status">
                            <CellTemplate>
                                <StatusBadge Status="@(context.Item.Status ?? "Unknown")" />
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="" Sortable="false">
                            <CellTemplate>
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Info"
                                               StartIcon="@Icons.Material.Filled.Info"
                                               Disabled="@(Portfolio.Busy || !Portfolio.Owns(context.Item))"
                                               OnClick="@(() => EvaluateLease(context.Item))">Read Record</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Gavel"
                                               Disabled="@(Portfolio.Busy || !Portfolio.Owns(context.Item))" Href="@GetComplianceHandoffHref(context.Item)">Review FIELD obligations</MudButton>
                                    <AuthorizeView Roles="Administrator" Context="leaseRowAdmin">
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                               StartIcon="@Icons.Material.Filled.Edit"
                                               Disabled="@(!Portfolio.CanUpdate(context.Item))"
                                               OnClick="@(() => UpdateLeaseStatus(context.Item))">Update Status</MudButton>
                                    </AuthorizeView>
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudStack AlignItems="AlignItems.Center" Class="pa-6">
                            <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Secondary" Class="og-icon-xl" />
                            <MudText Typo="Typo.body1">No leases match the current filter</MudText>
                        </MudStack>
                    </NoRecordsContent>
                </MudDataGrid>
            }
            else if (Portfolio.Current)
            {
                <MudStack AlignItems="AlignItems.Center" Class="pa-8">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Secondary" Class="og-icon-xl" />
                    <MudText Typo="Typo.h6">No leases found</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Create the first lease acquisition for this field.</MudText>
                    <AuthorizeView Roles="Administrator" Context="leaseEmptyAdmin">
                    <MudButton Variant="Variant.Filled" Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Add"
                               Disabled="@(!Portfolio.Current || Portfolio.Busy || Creation.Busy)"
                               OnClick="OpenCreateDialog" Class="mt-2">Create Lease Acquisition</MudButton>
                    </AuthorizeView>
                </MudStack>
            }
        </MudCardContent>
    </MudCard>

    <MudDialog @bind-Visible="_createDialogVisible" Options="_createDialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" /> Create Lease Acquisition
            </MudText>
        </TitleContent>
        <DialogContent>
            @if (Creation.Error is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert">@Creation.Error</MudAlert>
            }
            @if (Creation.Message is not null)
            {
                <MudAlert Severity="Severity.Info" role="status">@Creation.Message</MudAlert>
            }
            @if (Creation.CanView)
            {
            <MudText Typo="Typo.body2">FIELD @_createLeaseRequest.PropertyId — Date zone @_createLeaseRequest.Context?.DateZoneId</MudText>
            @if (_createLeaseRequest.PropertyId != _fieldId)
            {
                <MudAlert Severity="Severity.Info" role="status">Return to FIELD @_createLeaseRequest.PropertyId to continue this original creation intent.</MudAlert>
            }
            <MudForm @ref="_createForm" @bind-IsValid="_isCreateFormValid" Disabled="@(!Portfolio.Current || Portfolio.Busy || !Creation.CanEdit || _createLeaseRequest.PropertyId != _fieldId)">
                <MudStack Spacing="2" Class="mt-2">
                    <MudTextField T="string" Value="@_createLeaseRequest.PropertyId" Label="Reviewed FIELD ID" Variant="Variant.Outlined" ReadOnly="true" />
                    <MudTextField T="string"
                                  @bind-Value="_createLeaseRequest.LeaseNumber"
                                  Label="Lease Number"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Lease number is required" />
                    <MudTextField T="string"
                                  @bind-Value="_createLeaseRequest.LeaseName"
                                  Label="Lease Name"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Lease name is required" />
                    <MudTextField T="string"
                               @bind-Value="_createLeaseRequest.LeaseType"
                               Label="Reviewed Agreement Type Code"
                               Variant="Variant.Outlined"
                               FullWidth="true"
                               Required="true"
                               RequiredError="Agreement type code is required"
                               HelperText="Enter the exact reviewed R_LAND_AGREE_TYPE code." />
                    <MudDatePicker @bind-Date="_createEffectiveDate"
                                   Label="Effective Date"
                                   Variant="Variant.Outlined"
                                   PickerVariant="PickerVariant.Dialog"
                                   DateFormat="yyyy-MM-dd"
                                   Required="true"
                                   RequiredError="Effective date is required" />
                    <MudDatePicker @bind-Date="_createExpirationDate"
                                   Label="Expiration Date"
                                   Variant="Variant.Outlined"
                                   PickerVariant="PickerVariant.Dialog"
                                   DateFormat="yyyy-MM-dd"
                                   MinDate="@_createEffectiveDate" />
                    <MudNumericField T="int?"
                                     @bind-Value="_createLeaseRequest.PrimaryTermMonths"
                                     Label="Primary Term (Months)"
                                     Variant="Variant.Outlined"
                                     Min="1" />
                    <MudNumericField T="decimal?"
                                     @bind-Value="_createLeaseRequest.CalculatedInterest"
                                     Label="Recorded Calculated Interest"
                                     Variant="Variant.Outlined"
                                     Required="true"
                                     HelperText="Explicit recorded LAND_RIGHT value; financial working interest uses its own workflow." />
                </MudStack>
            </MudForm>
            }
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseCreateDialog">
                Cancel
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                       Disabled="@(!Portfolio.Current || Portfolio.Busy || !Creation.CanSubmit || _createLeaseRequest.PropertyId != _fieldId)"
                       OnClick="SubmitCreateLeaseAsync">
                @if (_isCreating)
                {
                    <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    <MudText>Creating</MudText>
                }
                else
                {
                    <MudText>@(Creation.RetryAvailable ? "Retry Same Intent" : "Create Lease")</MudText>
                }
            </MudButton>
            @if (Creation.HasPending)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="@(!Portfolio.Current || Portfolio.Busy || !Creation.CanReconcile || _createLeaseRequest.PropertyId != _fieldId)" OnClick="ReconcileCreationAsync">Check Registration</MudButton>
            }
        </DialogActions>
    </MudDialog>

</MudContainer>

@code {
    private readonly DialogOptions _createDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
    private CreateLeaseAcquisition _createLeaseRequest => Creation.DisplayDraft;
    private MudForm _createForm = null!;

    private string _fieldId => Portfolio.FieldId;
    private IReadOnlyList<LeaseSummary> _leases => Portfolio.Leases;
    private DateTime? _createEffectiveDate;
    private DateTime? _createExpirationDate;

    private bool _createDialogVisible;
    private bool _isCreating => Creation.Busy;
    private bool _isCreateFormValid;

    protected override async Task OnInitializedAsync()
    {
        Creation.Changed += CreationChanged;
        Portfolio.Changed += CreationChanged;
        FieldSelection.CurrentFieldChanged += FieldChanged;
        await LoadLeases();
    }
    private bool _disposed;
    private void CreationChanged() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private void FieldChanged(string field)
    {
        if (_disposed) return;
        var load = Portfolio.LoadAsync(() => Task.FromResult<string?>(field));
        _ = InvokeAsync(async () => { if (_disposed) return; StateHasChanged(); await load; if (!_disposed) StateHasChanged(); });
    }
    private async Task LoadLeases()
    {
        var load = Portfolio.LoadAsync(FieldSelection.GetCurrentFieldIdAsync);
        StateHasChanged(); await load;
    }
    public void Dispose()
    {
        _disposed = true;
        FieldSelection.CurrentFieldChanged -= FieldChanged;
        Creation.Changed -= CreationChanged; Portfolio.Changed -= CreationChanged;
        Creation.Dispose(); Portfolio.Dispose();
    }
    private async Task OpenCreateDialog()
    {
        if (!Portfolio.Current || Portfolio.Busy || string.IsNullOrWhiteSpace(_fieldId))
        {
            Snackbar.Add("Select an active field before reviewing a lease registration.", Severity.Warning);
            return;
        }
        if (!Creation.HasPending) { _createEffectiveDate = null; _createExpirationDate = null; }
        await Creation.ReviewAsync(_fieldId);
        _createDialogVisible = true;
    }

    private void CloseCreateDialog() => _createDialogVisible = false;

    private async Task SubmitCreateLeaseAsync()
    {
        if (!Portfolio.Current || Portfolio.Busy || !Creation.CanSubmit) return;
        if (!Creation.HasPending)
        {
            await _createForm.ValidateAsync();
            if (!_createForm.IsValid) return;
            if (!_createEffectiveDate.HasValue) { Snackbar.Add("Effective date is required.", Severity.Warning); return; }
            if (_createExpirationDate.HasValue && _createExpirationDate.Value <= _createEffectiveDate.Value)
            { Snackbar.Add("Expiration date must follow the effective date.", Severity.Warning); return; }
            _createLeaseRequest.EffectiveDate = _createEffectiveDate.Value;
            _createLeaseRequest.ExpirationDate = _createExpirationDate;
        }
        await Creation.SubmitAsync(_fieldId);
        await ShowConfirmedCreationAsync();
    }

    private async Task ReconcileCreationAsync()
    {
        if (!Portfolio.Current || Portfolio.Busy || !Creation.CanReconcile) return;
        await Creation.ReconcileAsync(_fieldId);
        await ShowConfirmedCreationAsync();
    }

    private async Task ShowConfirmedCreationAsync()
    {
        if (Creation.ConfirmedLeaseId is null) return;
        _createDialogVisible = false;
        Snackbar.Add("Lease registration confirmed.", Severity.Success);
        await LoadLeases();
    }
    private Task EvaluateLease(LeaseSummary row) => Portfolio.EvaluateAsync(row);

    private async Task UpdateLeaseStatus(LeaseSummary row)
    {
        if (!Portfolio.CanUpdate(row)) return;
        var result = await DialogService.ShowMessageBoxAsync("Update Recorded Lease Status",
            "Record the ACTIVE operational code for this lease?", yesText: "Record ACTIVE", cancelText: "Cancel");
        if (result == true) await Portfolio.UpdateStatusAsync(row, "ACTIVE");
    }
    private string GetComplianceHandoffHref(LeaseSummary lease)
    {
        var query = new List<string>
        {
            "openCreate=true",
            "obligType=Permit",
            $"description={Uri.EscapeDataString(BuildLeaseObligationDescription(lease))}",
            $"sourceProcess={Uri.EscapeDataString("LEASE_ACQUISITION")}",
            $"returnTo={Uri.EscapeDataString("/ppdm39/operations/leaseacquisition")}"
        };

        if (!string.IsNullOrWhiteSpace(lease.LeaseId))
            query.Add($"leaseId={Uri.EscapeDataString(lease.LeaseId)}");

        if (!string.IsNullOrWhiteSpace(lease.LeaseNumber))
            query.Add($"leaseNumber={Uri.EscapeDataString(lease.LeaseNumber)}");

        if (!string.IsNullOrWhiteSpace(lease.LeaseName))
            query.Add($"leaseName={Uri.EscapeDataString(lease.LeaseName)}");

        return "/hse/compliance?" + string.Join("&", query);
    }

    private static string BuildLeaseObligationDescription(LeaseSummary lease)
    {
        var label = !string.IsNullOrWhiteSpace(lease.LeaseNumber)
            ? lease.LeaseNumber
            : lease.LeaseId;

        if (!string.IsNullOrWhiteSpace(lease.LeaseName) && !string.IsNullOrWhiteSpace(label))
            return $"Regulatory review and permit setup for lease {label} - {lease.LeaseName}";

        if (!string.IsNullOrWhiteSpace(lease.LeaseName))
            return $"Regulatory review and permit setup for lease {lease.LeaseName}";

        if (!string.IsNullOrWhiteSpace(label))
            return $"Regulatory review and permit setup for lease {label}";

        return "Regulatory review and permit setup for lease acquisition";
    }

    private static string FormatLeaseDate(DateTime? value)
        => value?.ToString("yyyy-MM-dd") ?? "Not set";

    private static string FormatLeaseTerm(int? value)
        => value.HasValue ? value.Value.ToString() : "Not set";

}
