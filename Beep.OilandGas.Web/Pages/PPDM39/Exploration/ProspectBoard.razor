@page "/exploration/prospect-board"
@page "/lifecycle/exploration/dashboard"
@using Beep.OilandGas.Web.Components.Workflow
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Exploration workspace</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-3">Exploration workspace</MudText>
    <MudText Class="mb-3">Review assigned exploration work and open the original records for the current company and field.</MudText>
    <PersonaTaskInbox WorkspaceRoutes='@(new[]{"/exploration/prospect-board","/lifecycle/exploration/dashboard"})' />
    <MudAlert Severity="Severity.Info" Class="mb-4">A qualified prospect maturation summary is not available here. Area is not a resource volume, and recorded prospect status does not establish drilling approval.</MudAlert>
    <MudGrid Spacing="3">
        <MudItem xs="12" md="4"><MudCard Outlined="true"><MudCardContent>
            <MudText Typo="Typo.h6" HtmlTag="h2">Prospect records</MudText>
            <MudText Class="my-3">Review recorded prospects and their source details.</MudText>
            <MudButton Href="/ppdm39/exploration/prospects" Variant="Variant.Outlined">Open prospects</MudButton>
        </MudCardContent></MudCard></MudItem>
        <MudItem xs="12" md="4"><MudCard Outlined="true"><MudCardContent>
            <MudText Typo="Typo.h6" HtmlTag="h2">Seismic evidence</MudText>
            <MudText Class="my-3">Inspect survey and line records used to assess prospects.</MudText>
            <MudButton Href="/ppdm39/exploration/seismic-surveys" Variant="Variant.Outlined">Open seismic surveys</MudButton>
        </MudCardContent></MudCard></MudItem>
        <MudItem xs="12" md="4"><MudCard Outlined="true"><MudCardContent>
            <MudText Typo="Typo.h6" HtmlTag="h2">Program and assigned work</MudText>
            <MudText Class="my-3">Review the well program and the original processes for assigned decisions.</MudText>
            <MudStack Spacing="2"><MudButton Href="/exploration/well-program" Variant="Variant.Outlined">Open well program</MudButton><MudButton Href="/tasks/inbox" Variant="Variant.Outlined">Company inbox</MudButton></MudStack>
        </MudCardContent></MudCard></MudItem>
    </MudGrid>
</MudContainer>
