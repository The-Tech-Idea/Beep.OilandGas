@using Beep.OilandGas.Models.Data.Company
@page "/exploration/prospect/{Id}"
@page "/exploration/prospect/new"
@inject ApiClient ApiClient
@inject IExplorationServiceClient ExplorationService
@inject ILifeCycleService LifeCycleService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject OilGasApiFailures Answers
@inject FailureNotifier Notifier

<PageTitle>@_prospect.Name — Prospect Detail</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">

    @* ── Header ──────────────────────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudTooltip Text="Back to Board">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           OnClick='() => NavigationManager.NavigateTo("/exploration/prospect-board")'
                           aria-label="Back to Board" />
        </MudTooltip>
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">@_prospect.Name</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                @* No basin: a prospect record carries none (the header showed its responsible business associate's id as one). *@
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_fieldName — @_prospect.PlayType</MudText>
                <StatusBadge Status="@_prospect.Status" />
            </MudStack>
        </MudStack>
    </MudStack>

    @* ── Two-column layout ────────────────────────────────────────────────── *@
    <MudGrid Spacing="3">

        @* LEFT — Detail tabs (8 cols) *@
        <MudItem xs="12" md="8">
            <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" @bind-ActivePanelIndex="_activeTab">

                @* Tab 1: Summary *@
                <MudTabPanel Text="Summary" Icon="@Icons.Material.Filled.Summarize">
                    <MudGrid Spacing="3" Class="pa-4">
                        @if (_prospect.EstimatedOilVolume.HasValue)
                        {
                            <MudItem xs="12" sm="6">
                                <KpiCard Label="Estimated Oil Volume" Value="@_prospect.EstimatedOilVolume.Value.ToString("N0")" Unit="@_prospect.VolumeUnit" ValueColor="Color.Primary" />
                            </MudItem>
                        }
                        @if (_prospect.EstimatedGasVolume.HasValue)
                        {
                            <MudItem xs="12" sm="6">
                                <KpiCard Label="Estimated Gas Volume" Value="@_prospect.EstimatedGasVolume.Value.ToString("N0")" Unit="@_prospect.VolumeUnit" ValueColor="Color.Primary" />
                            </MudItem>
                        }
                        <MudItem xs="12">
                            @* The prospect's latest recorded volume estimate (PROSPECT_VOLUME_ESTIMATE), as the API reads it; a
                               volume is shown only for the fluid the estimate gives one for. *@
                            @if (_volumeEstimateError is not null)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true">@_volumeEstimateError</MudAlert>
                            }
                            else if (_volumeEstimatesLoaded && _volumeEstimate is null)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">No probabilistic resource estimate (P90, P50, P10) is recorded for this prospect.</MudAlert>
                            }
                            else if (_volumeEstimate is { } estimate)
                            {
                                <MudText Typo="Typo.subtitle2" Class="mb-2">@EstimateHeading(estimate)</MudText>
                                <MudSimpleTable Dense="true" Elevation="0">
                                    <thead>
                                        <tr><th></th><th>P90</th><th>P50</th><th>P10</th><th>Unit</th></tr>
                                    </thead>
                                    <tbody>
                                        @if (estimate.OIL_VOLUME_P90 != 0m || estimate.OIL_VOLUME_P50 != 0m || estimate.OIL_VOLUME_P10 != 0m)
                                        {
                                            <tr><td>Oil</td><td>@estimate.OIL_VOLUME_P90.ToString("N0")</td><td>@estimate.OIL_VOLUME_P50.ToString("N0")</td><td>@estimate.OIL_VOLUME_P10.ToString("N0")</td><td>@estimate.VOLUME_OUOM</td></tr>
                                        }
                                        @if (estimate.GAS_VOLUME_P90 != 0m || estimate.GAS_VOLUME_P50 != 0m || estimate.GAS_VOLUME_P10 != 0m)
                                        {
                                            <tr><td>Gas</td><td>@estimate.GAS_VOLUME_P90.ToString("N0")</td><td>@estimate.GAS_VOLUME_P50.ToString("N0")</td><td>@estimate.GAS_VOLUME_P10.ToString("N0")</td><td>@estimate.VOLUME_OUOM</td></tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                        </MudItem>
                        <MudItem xs="12">
                            <MudPaper Elevation="0" Class="pa-3">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">Description</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@_prospect.Description</MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                @* Tab 2: Geology *@
                <MudTabPanel Text="Geology" Icon="@Icons.Material.Filled.Landscape">
                    <MudPaper Elevation="0" Class="pa-4">
                        <MudStack Spacing="2">
                            <MudStack Row="true" Spacing="2">
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-lg">Play Type</MudText>
                                <MudText Typo="Typo.body2">@_prospect.PlayType</MudText>
                            </MudStack>
                            @* No "Basin" row: the prospect record has no basin; the row showed RESPONSIBLE_BA_ID, a business
                               associate's id. *@
                            <MudStack Row="true" Spacing="2">
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-lg">Target Formation</MudText>
                                <MudText Typo="Typo.body2">@_prospect.TargetFormation</MudText>
                            </MudStack>
                            <MudStack Row="true" Spacing="2">
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-lg">Structural Style</MudText>
                                <MudText Typo="Typo.body2">@_prospect.StructuralStyle</MudText>
                            </MudStack>
                            <MudStack Row="true" Spacing="2">
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-lg">Seismic Coverage</MudText>
                                <MudText Typo="Typo.body2">@_prospect.SeismicCoverage</MudText>
                            </MudStack>
                            <MudStack Row="true" Spacing="2">
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-lg">Vintage</MudText>
                                <MudText Typo="Typo.body2">@_prospect.SeismicVintage</MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudTabPanel>

                @* Tab 3: Risk *@
                <MudTabPanel Text="Risk" Icon="@Icons.Material.Filled.Warning">
                    <MudPaper Elevation="0" Class="pa-4">
                        <MudText Typo="Typo.subtitle2" Class="mb-3">Chance of Success Breakdown</MudText>
                        <MudDataGrid T="RiskElement" Items="@_prospect.RiskElements" Dense="true" Hover="true" Striped="true">
                            <Columns>
                                <PropertyColumn Property="r => r.Element" Title="Risk Element" />
                                <TemplateColumn Title="Probability" SortBy="r => r.Probability">
                                    <CellTemplate>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudProgressLinear Value="@context.Item.Probability"
                                                               Color="@(context.Item.Probability >= 60 ? Color.Success : context.Item.Probability >= 40 ? Color.Warning : Color.Error)"
                                                               Class="flex-grow-1" />
                                            <MudText Typo="Typo.caption">@context.Item.Probability%</MudText>
                                        </MudStack>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="r => r.Confidence" Title="Confidence" />
                            </Columns>
                        </MudDataGrid>
                        <MudDivider Class="my-3" />
                        @if (_prospect.RiskElements.Count > 0)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudText Typo="Typo.subtitle2">Overall Pg (Chance of Success):</MudText>
                                <MudText Typo="Typo.h5" Color="@((_prospect.RiskElements.Aggregate(1.0, (acc, r) => acc * r.Probability / 100) * 100) >= 25 ? Color.Success : Color.Warning)">
                                    @((_prospect.RiskElements.Aggregate(1.0, (acc, r) => acc * r.Probability / 100) * 100).ToString("F1"))%
                                </MudText>
                            </MudStack>
                        }
                        else
                        {
                            @* The prospect API carries no risk-element breakdown; a product over no elements would read as a 100% chance of success. *@
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No chance-of-success breakdown is recorded for this prospect.</MudText>
                        }
                    </MudPaper>
                </MudTabPanel>

                @* Tab 4: History *@
                <MudTabPanel Text="History" Icon="@Icons.Material.Filled.History">
                    <MudPaper Elevation="0" Class="pa-4">
                        <ProcessTimeline Steps="@_stageHistory" />
                    </MudPaper>
                </MudTabPanel>

                @* Tab 5: Related Wells *@
                <MudTabPanel Text="Related Wells" Icon="@Icons.Material.Filled.OilBarrel">
                    <MudPaper Elevation="0" Class="pa-4">
                        @if (_prospect.RelatedWells.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info">No wells drilled on this prospect yet.</MudAlert>
                        }
                        else
                        {
                            <MudDataGrid T="WellReference" Items="@_prospect.RelatedWells" Dense="true" Hover="true" Striped="true">
                                <Columns>
                                    <PropertyColumn Property="w => w.Uwi" Title="UWI" />
                                    <PropertyColumn Property="w => w.Name" Title="Well Name" />
                                    <PropertyColumn Property="w => w.Type" Title="Type" />
                                    <TemplateColumn Title="Status">
                                        <CellTemplate><StatusBadge Status="@context.Item.Status" /></CellTemplate>
                                    </TemplateColumn>
                                    <PropertyColumn Property="w => w.Td" Title="TD (m)" />
                                </Columns>
                            </MudDataGrid>
                        }
                    </MudPaper>
                </MudTabPanel>

            </MudTabs>
        </MudItem>

        @* RIGHT — Stage & Actions (4 cols) *@
        <MudItem xs="12" md="4">
            <MudStack Spacing="3">

                @* Stage timeline *@
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1">Maturation Stage</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <ProcessTimeline Steps="@_stageHistory" />
                    </MudCardContent>
                </MudCard>

                @* Actions *@
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1">Actions</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudStack Spacing="2">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.TrendingUp"
                                       FullWidth="true"
                                       OnClick="AdvanceStage">
                                Advance Stage
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Assignment"
                                       FullWidth="true"
                                       OnClick='() => NavigationManager.NavigateTo($"/exploration/well-program/new?prospectId={Uri.EscapeDataString(_loadedId)}")'>
                                Request Well Program
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Archive"
                                       FullWidth="true"
                                       OnClick="DropProspect">
                                Drop Prospect
                            </MudButton>
                        </MudStack>
                    </MudCardContent>
                </MudCard>

            </MudStack>
        </MudItem>
    </MudGrid>

</MudContainer>

@code {
    [Parameter] public string? Id { get; set; }

    private string _loadedId  = string.Empty;
    private string _fieldName = string.Empty;
    private int _activeTab;
    private ProspectViewModel _prospect = new();
    private List<ProcessStep> _stageHistory = new();
    private Beep.OilandGas.Models.Data.ProspectIdentification.PROSPECT_VOLUME_ESTIMATE? _volumeEstimate;
    private bool _volumeEstimatesLoaded;
    private string? _volumeEstimateError;

    protected override async Task OnInitializedAsync()
    {
        _loadedId = Id ?? string.Empty;
        try
        {
            var summary = await LifeCycleService.GetFieldLifecycleSummaryAsync();
            if (summary != null)
                _fieldName = summary.FieldName ?? _fieldName;
        }
        // Only the field's name in the header depends on it; the person is told it could not be read.
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "loading the active field's name for a prospect", "The field's name could not be loaded"), Severity.Warning);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "loading the active field's name for a prospect", "The field's name could not be loaded", FailureSeverity.Degraded);
        }

        await LoadProspectAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if ((Id ?? string.Empty) == _loadedId) return;
        _loadedId = Id ?? string.Empty;
        await LoadProspectAsync();
    }

    private async Task LoadProspectAsync()
    {
        _volumeEstimate = null;
        _volumeEstimateError = null;
        _volumeEstimatesLoaded = false;
        if (string.IsNullOrEmpty(Id) || Id == "new")
        {
            _prospect = new ProspectViewModel { Name = "New Prospect", Status = "DRAFT" };
            return;
        }
        var loaded = false;
        try
        {
            var p = await ExplorationService.GetProspectAsync(Id);
            if (p != null)
            {
                _prospect = new ProspectViewModel
                {
                    Name            = p.PROSPECT_NAME ?? p.PROSPECT_ID ?? string.Empty,
                    PlayType        = p.PROSPECT_TYPE ?? string.Empty,
                    Status          = p.PROSPECT_STATUS ?? "ACTIVE",
                    Description     = p.REMARK ?? string.Empty,
                    TargetFormation = string.Empty,
                    StructuralStyle = string.Empty,
                    SeismicCoverage = string.Empty,
                    SeismicVintage  = string.Empty,
                    EstimatedOilVolume = p.ESTIMATED_OIL_VOLUME,
                    EstimatedGasVolume = p.ESTIMATED_GAS_VOLUME,
                    VolumeUnit         = p.ESTIMATED_VOLUME_OUOM ?? string.Empty,
                };
                _stageHistory = BuildStageHistory(p.PROSPECT_STATUS);
                loaded = true;
            }
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "loading a prospect", "The prospect could not be loaded"), Severity.Warning);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "loading a prospect", "The prospect could not be loaded", FailureSeverity.Degraded);
        }

        if (loaded)
            await LoadVolumeEstimateAsync(Id);
    }

    private async Task LoadVolumeEstimateAsync(string prospectId)
    {
        try
        {
            var estimates = await ApiClient.GetAsync<List<Beep.OilandGas.Models.Data.ProspectIdentification.PROSPECT_VOLUME_ESTIMATE>>(
                $"/api/prospect/{Uri.EscapeDataString(prospectId)}/volume-estimates");
            // The API answers newest first.
            _volumeEstimate = estimates?.FirstOrDefault();
            _volumeEstimatesLoaded = true;
        }
        // The rest of the prospect shows; the summary says the estimate could not be read rather than that none exists.
        catch (OilGasApiException answer)
        {
            _volumeEstimateError = Answers.Explain(answer, "loading a prospect's volume estimate", "The prospect's volume estimate could not be loaded");
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            _volumeEstimateError = Notifier.FailureText(ex, "loading a prospect's volume estimate", "The prospect's volume estimate could not be loaded", FailureSeverity.Degraded);
        }
    }

    private static string EstimateHeading(Beep.OilandGas.Models.Data.ProspectIdentification.PROSPECT_VOLUME_ESTIMATE estimate)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(estimate.ESTIMATE_METHOD)) parts.Add(estimate.ESTIMATE_METHOD);
        if (estimate.ESTIMATE_DATE is DateTime date) parts.Add(date.ToString("d MMM yyyy", CultureInfo.InvariantCulture));
        if (!string.IsNullOrWhiteSpace(estimate.ESTIMATOR)) parts.Add($"by {estimate.ESTIMATOR}");
        return parts.Count == 0 ? "Volume estimate" : $"Volume estimate ({string.Join(", ", parts)})";
    }

    private static List<ProcessStep> BuildStageHistory(string? status)
    {
        var stages = new[] { "Lead Identified", "Screening", "Prospect", "Ranking", "Drill Candidate", "Drilled" };
        var activeIdx = status?.ToUpperInvariant() switch
        {
            "LEAD"      => 0,
            "SCREENING" => 1,
            "REVIEW"    => 3,
            "APPROVED"  => 4,
            "DRILLED" or "COMPLETE" => 5,
            _           => 2,
        };
        return stages.Select((s, i) => new ProcessStep(
            s, i < activeIdx ? "Completed" : string.Empty,
            IsCompleted: i < activeIdx,
            IsActive: i == activeIdx)).ToList();
    }

    private async Task AdvanceStage()
    {
        if (string.IsNullOrWhiteSpace(_loadedId) || _loadedId == "new")
        {
            Snackbar.Add("Save the prospect before advancing stage.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<StageAdvanceDialog>
        {
            { x => x.ProspectName, _prospect.Name },
            { x => x.ToStageName, "Drill Candidate" }
        };
        var dialog = await DialogService.ShowAsync<StageAdvanceDialog>("Advance Stage", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            try
            {
                await ExplorationService.RecordProspectDecisionAsync(_loadedId, "APPROVED", "Advanced from prospect detail.");
                Snackbar.Add("Prospect advanced to Drill Candidate.", Severity.Success);
                await LoadProspectAsync();
            }
            catch (OilGasApiException answer)
            {
                Snackbar.Add(Answers.Explain(answer, "advancing a prospect to drill candidate", "The prospect was not advanced"), Severity.Error);
            }
            // A page answers every failure it meets with a sentence; the store keeps the exception.
            catch (Exception ex)
            {
                Notifier.Failure(ex, "advancing a prospect to drill candidate", "The prospect was not advanced");
            }
        }
    }

    private async Task DropProspect()
    {
        if (string.IsNullOrWhiteSpace(_loadedId) || _loadedId == "new")
        {
            NavigationManager.NavigateTo("/exploration/prospect-board");
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Drop Prospect",
            $"Are you sure you want to drop prospect {_prospect.Name}?",
            yesText: "Drop",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        try
        {
            await ExplorationService.DeleteProspectAsync(_loadedId);
            Snackbar.Add($"'{_prospect.Name}' has been dropped.", Severity.Warning);
            NavigationManager.NavigateTo("/exploration/prospect-board");
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "dropping a prospect", "The prospect was not dropped"), Severity.Error);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "dropping a prospect", "The prospect was not dropped");
        }
    }

    private class ProspectViewModel
    {
        public string Name { get; set; } = string.Empty;
        public string PlayType { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string TargetFormation { get; set; } = string.Empty;
        public string StructuralStyle { get; set; } = string.Empty;
        public string SeismicCoverage { get; set; } = string.Empty;
        public string SeismicVintage { get; set; } = string.Empty;
        public decimal? EstimatedOilVolume { get; set; }
        public decimal? EstimatedGasVolume { get; set; }
        public string VolumeUnit { get; set; } = string.Empty;
        public List<RiskElement> RiskElements { get; set; } = new();
        public List<WellReference> RelatedWells { get; set; } = new();
    }

    private record RiskElement(string Element, double Probability, string Confidence);
    internal record WellReference(string Uwi, string Name, string Type, string Status, string Td);
}
