@using Beep.OilandGas.Models.Data.Company
@page "/hse/compliance"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Beep.OilandGas.Web.Pages.PPDM39.BusinessProcess

@if (OpenCreate)
{
    <MudAlert Severity="Severity.Info" Class="ma-4">This handoff has not created an obligation. Review the selected FIELD and enter the recorded details in the creation form.</MudAlert>
    <MudButton Href="/ppdm39/compliance/obligations/new" Variant="Variant.Outlined" Class="mx-4">Record a FIELD obligation</MudButton>
}
@if (SafeReturnTo is not null)
{
    <MudButton Href="@SafeReturnTo" Variant="Variant.Outlined" Class="mx-4">Back to the originating workspace</MudButton>
}
<ComplianceObligations />

@code {
    [SupplyParameterFromQuery(Name = "openCreate")] public bool OpenCreate { get; set; }
    [SupplyParameterFromQuery(Name = "returnTo")] public string? ReturnTo { get; set; }
    private string? SafeReturnTo => ReturnTo is { Length: > 0 and <= 2048 } path && path.StartsWith('/') &&
        !path.StartsWith("//", StringComparison.Ordinal) && !path.Contains('\\') && !path.Any(char.IsControl) ? path : null;
}
