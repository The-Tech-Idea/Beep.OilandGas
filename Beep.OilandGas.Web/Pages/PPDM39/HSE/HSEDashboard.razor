@page "/hse/dashboard"
@page "/ppdm39/hse"
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true"><MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" Class="mr-2" Color="Color.Primary"/>HSE Dashboard</MudText>
    @if(_loading){<MudProgressLinear Indeterminate="true" Class="my-4"/>}else{
    <MudGrid>
        <MudItem xs="6" md="3"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">Total Incidents YTD</MudText><MudText Typo="Typo.h4" Color="@(_kpi?.TotalIncidents>10?Color.Error:Color.Primary)">@_kpi?.TotalIncidents.ToString("N0")</MudText><MudText Typo="Typo.caption">reported</MudText></div><MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Primary" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
        <MudItem xs="6" md="3"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">Open Incidents</MudText><MudText Typo="Typo.h4" Color="Color.Warning">@_kpi?.OpenIncidents.ToString("N0")</MudText><MudText Typo="Typo.caption">pending</MudText></div><MudIcon Icon="@Icons.Material.Filled.Pending" Color="Color.Warning" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
        <MudItem xs="6" md="3"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">Overdue Actions</MudText><MudText Typo="Typo.h4" Color="@(_kpi?.OverdueActions>0?Color.Error:Color.Success)">@_kpi?.OverdueActions.ToString("N0")</MudText><MudText Typo="Typo.caption">corrective</MudText></div><MudIcon Icon="@Icons.Material.Filled.Alarm" Color="Color.Error" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
        <MudItem xs="6" md="3"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">Active Permits</MudText><MudText Typo="Typo.h4" Color="Color.Info">@_kpi?.ActivePermits.ToString("N0")</MudText><MudText Typo="Typo.caption">issued</MudText></div><MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Info" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
    </MudGrid>
    <MudGrid>
        <MudItem xs="12" md="5"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Build" Class="mr-1" Size="Size.Small"/>HSE Tools</MudText></CardHeaderContent></MudCardHeader><MudCardContent Class="pa-2"><MudGrid>
        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/hse/incidents">Incident Management</MudButton></MudItem>
        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/ppdm39/hse/hazop/new">New HAZOP Study</MudButton></MudItem>
        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/hse/compliance">Compliance Calendar</MudButton></MudItem>
        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/ppdm39/permits">Permit Dashboard</MudButton></MudItem>
    </MudGrid></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" md="7"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Campaign" Class="mr-1" Size="Size.Small"/>Attention Required</MudText></CardHeaderContent></MudCardHeader><MudCardContent>
        <MudAlert Severity="Severity.Error" Dense="true">2 Tier 1 incidents this quarter — API RP 754 notification required within 48 hours.</MudAlert>
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">3 HAZOP studies overdue for management sign-off.</MudAlert>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">5 permits expiring within 30 days — review and renew.</MudAlert>
    </MudCardContent></MudCard></MudItem></MudGrid>}
</MudContainer>

@code{private bool _loading=true;private HseKpi? _kpi;
protected override async Task OnInitializedAsync(){try{_kpi=await Http.GetFromJsonAsync<HseKpi>("/api/hse/engineer/kpi")??new();}catch{_kpi=new();}_loading=false;}
public class HseKpi{public int TotalIncidents{get;set;}public int OpenIncidents{get;set;}public int OverdueActions{get;set;}public int ActivePermits{get;set;}}}
