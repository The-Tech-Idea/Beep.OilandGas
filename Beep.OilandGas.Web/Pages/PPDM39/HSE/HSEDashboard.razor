@page "/hse/dashboard"
@page "/ppdm39/hse"
@using MudBlazor
@inject ApiClient ApiClient
@inject OilGasCallFailures Calls
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true"><MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" Class="mr-2" Color="Color.Primary"/>HSE Dashboard</MudText>
    @if(_loadError is not null){<MudAlert Severity="Severity.Warning" Class="mb-4">@_loadError</MudAlert>}
    @if(_loading){<MudProgressLinear Indeterminate="true" Class="my-4"/>}else{
    <MudGrid>
        <MudItem xs="6" md="6"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">Total Incidents YTD</MudText><MudText Typo="Typo.h4" Color="@(_kpi?.TotalIncidents>10?Color.Error:Color.Primary)">@_kpi?.TotalIncidents.ToString("N0")</MudText><MudText Typo="Typo.caption">reported</MudText></div><MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Primary" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
        <MudItem xs="6" md="6"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">Open Incidents</MudText><MudText Typo="Typo.h4" Color="Color.Warning">@_kpi?.OpenIncidents.ToString("N0")</MudText><MudText Typo="Typo.caption">pending</MudText></div><MudIcon Icon="@Icons.Material.Filled.Pending" Color="Color.Warning" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
        @* No "Overdue Actions" or "Active Permits" cards: the API's HSE KPI (HseEngineerAggregationService.GetKpiAsync) counts
           neither (it answered both as 0, "0 overdue" in green). "Open Incidents" is the incidents whose investigation is
           neither closed nor cancelled. *@
    </MudGrid>
    <MudGrid>
        <MudItem xs="12" md="5"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Build" Class="mr-1" Size="Size.Small"/>HSE Tools</MudText></CardHeaderContent></MudCardHeader><MudCardContent Class="pa-2"><MudGrid>
        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/hse/incidents">Incident Management</MudButton></MudItem>
        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/ppdm39/hse/hazop/new">New HAZOP Study</MudButton></MudItem>
        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/hse/compliance">Compliance Calendar</MudButton></MudItem>
        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/ppdm39/permits">Permit Dashboard</MudButton></MudItem>
    </MudGrid></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" md="7"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Campaign" Class="mr-1" Size="Size.Small"/>Attention Required</MudText></CardHeaderContent></MudCardHeader><MudCardContent>
        @* The alerts were fixed sentences ("2 Tier 1 incidents…", "3 HAZOP studies overdue…", "5 permits expiring…"). The Tier 1
           count is the API's incident summary for this quarter. No HAZOP alert: a HAZOP study records no sign-off or due date.
           No permit-expiry alert: a permit application records no expiry date. *@
        @if(_tier1Error is not null){<MudAlert Severity="Severity.Warning" Dense="true">@_tier1Error</MudAlert>}
        else if(_tier1ThisQuarter>0){<MudAlert Severity="Severity.Error" Dense="true">@(_tier1ThisQuarter==1?"1 Tier 1 incident":$"{_tier1ThisQuarter:N0} Tier 1 incidents") recorded this quarter (since @QuarterStart.ToString("d MMMM yyyy",CultureInfo.InvariantCulture)).</MudAlert>}
        else{<MudAlert Severity="Severity.Success" Dense="true">No Tier 1 incidents recorded this quarter (since @QuarterStart.ToString("d MMMM yyyy",CultureInfo.InvariantCulture)).</MudAlert>}
    </MudCardContent></MudCard></MudItem></MudGrid>}
</MudContainer>

@code{private bool _loading=true;private HseKpi? _kpi;private string? _loadError;
private int _tier1ThisQuarter;private string? _tier1Error;
// The first day of the current calendar quarter.
private static DateTime QuarterStart=>new(DateTime.Today.Year,(DateTime.Today.Month-1)/3*3+1,1);
protected override async Task OnInitializedAsync()
{
    // Through ApiClient, which carries the API's address and the person's token: the unnamed HttpClient this page used
    // has neither, so every load failed and the catch showed zeros.
    try{_kpi=await ApiClient.GetAsync<HseKpi>("/api/hse/engineer/kpi")??new();}
    // A failed call says the figures did not load, rather than showing zeros; anything else reaches the page's error boundary.
    catch(Exception failure) when (OilGasCallFailures.IsCallFailure(failure)){_loadError=Calls.Explain(failure,"loading the HSE dashboard figures","The HSE figures could not be loaded");}
    // This quarter's Tier 1 incidents, from the API's incident summary: the tier recorded on each incident's primary detail.
    try
    {
        var query=$"start={QuarterStart:yyyy-MM-dd}&end={DateTime.Today:yyyy-MM-dd}";
        var summary=await ApiClient.GetAsync<HseIncidentSummary>($"/api/hse/aggregation/incidents?{query}");
        _tier1ThisQuarter=summary?.Tier1??0;
    }
    // The alert says the count did not load rather than that there were none; anything else reaches the error boundary.
    catch(Exception failure) when (OilGasCallFailures.IsCallFailure(failure)){_tier1Error=Calls.Explain(failure,"loading this quarter's Tier 1 incidents for the HSE dashboard","This quarter's Tier 1 incidents could not be loaded");}
    finally{_loading=false;}
}
public class HseKpi{public int TotalIncidents{get;set;}public int OpenIncidents{get;set;}}
// The API's incident summary (HseAggregationService.IncidentSummary); only the Tier 1 count is read here.
public class HseIncidentSummary{public int Tier1{get;set;}}}
