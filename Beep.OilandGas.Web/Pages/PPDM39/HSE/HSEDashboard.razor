@page "/hse/dashboard"
@page "/ppdm39/hse"
@using MudBlazor
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true"><MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" Class="mr-2" Color="Color.Primary" />HSE Dashboard</MudText>

    <MudGrid>
        <MudItem xs="12" sm="6" md="3"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Incidents</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudButton Variant="Variant.Outlined" FullWidth="true" Href="/hse/incidents">Incident Management</MudButton><MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-2" Href="/ppdm39/hse/incident/new">Report Incident</MudButton></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">HAZOP & Studies</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudButton Variant="Variant.Outlined" FullWidth="true" Href="/ppdm39/hse/hazop/new">New HAZOP Study</MudButton><MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-2" Href="/ppdm39/hse/incidents">All Incidents</MudButton></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Compliance</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudButton Variant="Variant.Outlined" FullWidth="true" Href="/hse/compliance">Compliance Calendar</MudButton><MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-2" Href="/compliance/dashboard">Regulatory</MudButton></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Permits</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudButton Variant="Variant.Outlined" FullWidth="true" Href="/ppdm39/permits">Permit Dashboard</MudButton><MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-2" Href="/ppdm39/permits/new">New Permit</MudButton></MudCardContent></MudCard></MudItem>
    </MudGrid>
</MudContainer>
