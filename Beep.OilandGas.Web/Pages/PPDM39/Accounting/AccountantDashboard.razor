@page "/accounting/dashboard"
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Class="mr-2" Color="Color.Primary" />
        Accounting Dashboard
    </MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else
    {
        @* ── KPI Row ── *@
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="3">
                    <MudCardContent>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Revenue (MTD)</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Primary">@FormatCurrency(_revenue?.TotalRevenue ?? 0)</MudText>
                        <MudText Typo="Typo.caption" Color="@(_revenue?.Trend > 0 ? Color.Success : Color.Error)">
                            @(_revenue?.Trend > 0 ? "↑" : "↓") @($"{Math.Abs(_revenue?.Trend ?? 0):F1}%")
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="3">
                    <MudCardContent>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">LOE / CAPEX</MudText>
                        <MudText Typo="Typo.h4">@FormatCurrency(_costs?.LOE ?? 0) / @FormatCurrency(_costs?.CAPEX ?? 0)</MudText>
                        <MudText Typo="Typo.caption">@(_costs?.TransactionCount ?? 0) transactions</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="3">
                    <MudCardContent>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Royalties</MudText>
                        <MudText Typo="Typo.h4">@FormatCurrency(_royalties?.TotalRoyalties ?? 0)</MudText>
                        <MudChip Color="@(_royalties?.PendingPayments > 0 ? Color.Warning : Color.Success)" Size="Size.Small">
                            @(_royalties?.PendingPayments ?? 0) pending
                        </MudChip>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="3">
                    <MudCardContent>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Period Close</MudText>
                        <MudText Typo="Typo.h4" Color="@(_period?.DaysSinceLastClose > 45 ? Color.Error : Color.Success)">
                            @(_period?.DaysSinceLastClose ?? 0) days
                        </MudText>
                        <MudText Typo="Typo.caption">@(_period?.OpenPeriods ?? 0) open periods</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        @* ── Revenue + AFE side-by-side ── *@
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.h6">Revenue by Product</MudText></CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_revenue?.ByProduct?.Count > 0)
                        {
                            <MudTable Items="@_revenue.ByProduct.Select(kvp => new { Product = kvp.Key, Amount = kvp.Value })"
                                      Hover="true" Dense="true">
                                <HeaderContent>
                                    <MudTh>Product</MudTh>
                                    <MudTh>Revenue</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.Product</MudTd>
                                    <MudTd>@FormatCurrency(context.Amount)</MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        else { <MudAlert Severity="Severity.Info">No revenue data</MudAlert> }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.h6">AFE Status</MudText></CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_afes?.Count > 0)
                        {
                            <MudTable Items="@_afes.OrderByDescending(a => a.Budget).Take(5)" Hover="true" Dense="true">
                                <HeaderContent>
                                    <MudTh>AFE</MudTh>
                                    <MudTh>Budget</MudTh>
                                    <MudTh>Spent</MudTh>
                                    <MudTh>Status</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd Class="og-label-sm">@context.AfeId</MudTd>
                                    <MudTd>@FormatCurrency(context.Budget)</MudTd>
                                    <MudTd>@FormatCurrency(context.Spent)</MudTd>
                                    <MudTd><MudChip Size="Size.Small" Color="@AfeColor(context.Status)">@context.Status</MudChip></MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        else { <MudAlert Severity="Severity.Info">No AFE data</MudAlert> }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        @* ── Quick Actions ── *@
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent><MudText Typo="Typo.h6">Quick Actions</MudText></CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Outlined" Href="/accounting/production">Production Accounting</MudButton>
                    <MudButton Variant="Variant.Outlined" Href="/accounting/revenue-workbench">Revenue Workbench</MudButton>
                    <MudButton Variant="Variant.Outlined" Href="/accounting/cost-workbench">Cost Workbench</MudButton>
                    <MudButton Variant="Variant.Outlined" Href="/accounting/tax-workbench">Tax Workbench</MudButton>
                    <MudButton Variant="Variant.Outlined" Href="/ppdm39/accounting/dashboard">Advanced</MudButton>
                </MudStack>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private RevenueSummary? _revenue;
    private CostSummary? _costs;
    private RoyaltySummary? _royalties;
    private List<AfeSummary>? _afes;
    private PeriodCloseStatus? _period;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var revenueTask = Http.GetFromJsonAsync<RevenueSummary>("/api/accounting/aggregation/revenue");
            var costsTask = Http.GetFromJsonAsync<CostSummary>("/api/accounting/aggregation/costs");
            var royaltiesTask = Http.GetFromJsonAsync<RoyaltySummary>("/api/accounting/aggregation/royalties");
            var afeTask = Http.GetFromJsonAsync<List<AfeSummary>>("/api/accounting/aggregation/afe");
            var periodTask = Http.GetFromJsonAsync<PeriodCloseStatus>("/api/accounting/aggregation/period-close");

            await Task.WhenAll(revenueTask, costsTask, royaltiesTask, afeTask, periodTask);

            _revenue = revenueTask.Result;
            _costs = costsTask.Result;
            _royalties = royaltiesTask.Result;
            _afes = afeTask.Result;
            _period = periodTask.Result;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load accounting data: {ex.Message}", Severity.Error);
        }
        _loading = false;
    }

    private static string FormatCurrency(decimal v) =>
        Math.Abs(v) >= 1_000_000_000 ? $"${v / 1_000_000_000m:F1}B" :
        Math.Abs(v) >= 1_000_000 ? $"${v / 1_000_000m:F1}M" :
        $"${v:N0}";

    private static Color AfeColor(string? status) => status?.ToUpperInvariant() switch
    {
        "APPROVED" or "ACTIVE" => Color.Success,
        "PENDING" or "SUBMITTED" => Color.Warning,
        "OVERSPENT" or "REJECTED" => Color.Error,
        _ => Color.Default
    };

    // DTOs match AccountingAggregationService
    public class RevenueSummary { public decimal TotalRevenue { get; set; } public int TransactionCount { get; set; } public Dictionary<string, decimal> ByProduct { get; set; } = new(); public decimal AveragePrice { get; set; } public decimal Trend { get; set; } }
    public class CostSummary { public decimal TotalCost { get; set; } public decimal LOE { get; set; } public decimal CAPEX { get; set; } public int TransactionCount { get; set; } }
    public class RoyaltySummary { public decimal TotalRoyalties { get; set; } public int PendingPayments { get; set; } }
    public class AfeSummary { public string AfeId { get; set; } = string.Empty; public string Description { get; set; } = string.Empty; public decimal Budget { get; set; } public decimal Spent { get; set; } public decimal Remaining { get; set; } public string Status { get; set; } = string.Empty; public DateTime? ApprovedDate { get; set; } }
    public class PeriodCloseStatus { public DateTime? LastCloseDate { get; set; } public int DaysSinceLastClose { get; set; } public int OpenPeriods { get; set; } public int ClosedPeriods { get; set; } }
}
