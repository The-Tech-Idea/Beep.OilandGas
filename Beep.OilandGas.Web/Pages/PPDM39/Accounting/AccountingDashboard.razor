@page "/accounting/dashboard"
@page "/ppdm39/accounting"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Beep.OilandGas.Web.Services
@inject IAccountingServiceClient Accounting
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider Authentication
@inject IBusinessProcessServiceClient BusinessProcessClient
@inject TheTechIdea.Data.OilGas.IFieldSelectionContext DataManagement
@inject Beep.OilandGas.Client.App.CompanyClientContext Company
@inject OilGasCallFailures Calls
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Large">
    <MudText Typo="Typo.h3" GutterBottom>
        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Class="mr-2" Color="Color.Primary" />
        Oil & Gas Accounting
    </MudText>

    <MudText>Selected company: @(Company.Selection?.Scope.BusinessAssociateId ?? "Unavailable")</MudText>
    <FieldSelector />
    <PersonaTaskInbox WorkspaceRoutes='@(new[]{"/accounting/dashboard","/ppdm39/accounting"})' />
    <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-4">
        <AuthorizeView><Authorized Context="warehouseUser">
            @if(Company.Selection is {} warehouseCompany && warehouseCompany.Roles.Any(warehouseUser.User.IsInRole) && warehouseCompany.Permissions.Contains("Inventory.View",StringComparer.Ordinal))
            {<MudButton Href="/warehouse" Variant="Variant.Outlined">Company warehouse evidence</MudButton>}
        </Authorized></AuthorizeView>
        <AuthorizeView><Authorized Context="procurementUser">
            @if(Company.Selection is {} selected && selected.Roles.Any(procurementUser.User.IsInRole) && selected.Permissions.Contains("Procurement.View",StringComparer.Ordinal))
            {<MudButton Href="/procurement" Variant="Variant.Outlined">Company-owned purchase-order sources</MudButton>}
        </Authorized></AuthorizeView>
        <AuthorizeView><Authorized Context="payablesUser">
            @if(Company.Selection is {} selectedAP && selectedAP.Roles.Any(payablesUser.User.IsInRole) && selectedAP.Permissions.Contains("Accounting.View",StringComparer.Ordinal))
            {<MudButton Href="/accounting/payables" Variant="Variant.Outlined">Company-owned vendor invoice sources</MudButton>
             <MudButton Href="/accounting/ledger-accounts" Variant="Variant.Outlined">Company ledger account configuration</MudButton>}
        </Authorized></AuthorizeView>
        <AuthorizeView><Authorized Context="investmentUser">
            @if(Company.Selection is {} investmentCompany && investmentCompany.Roles.Any(investmentUser.User.IsInRole) && new[]{"Accounting.View","DevelopmentPlanning.View","Workflow.View"}.All(permission=>investmentCompany.Permissions.Contains(permission,StringComparer.Ordinal)))
            {<MudButton Href="/economics/afe" Variant="Variant.Outlined">Company development investment work</MudButton>}
        </Authorized></AuthorizeView>
        <MudButton Href="/accounting/cost-workbench" Variant="Variant.Outlined">Cost source workbench</MudButton>
        <MudButton Href="/accounting/revenue-workbench" Variant="Variant.Outlined">Revenue source workbench</MudButton>
        <AuthorizeView Roles="Accountant,Administrator"><MudButton Href="/ppdm39/accounting/period-close" Variant="Variant.Outlined">Executed period checks</MudButton></AuthorizeView>
    </MudStack>
    <SalesInvoiceQueue />
    <AuthorizeView><Authorized Context="financialUser">
        @if(Company.Selection is {} financialCompany && financialCompany.Roles.Any(financialUser.User.IsInRole) && financialCompany.Permissions.Contains("Accounting.View",StringComparer.Ordinal))
        {<Beep.OilandGas.Web.Components.Workflow.WorkOrderFinancialWorkbench />}
    </Authorized></AuthorizeView>
    <MudText Typo="Typo.h5">Company supplier invoice source queue</MudText>
    <MudAlert Severity="Severity.Info">This queue covers the selected company's recorded active invoices across suppliers. FIELD selection does not filter these company-owned headers. Status counts do not verify aging, unmatched work, approval, posting, payment or liability.</MudAlert>
    <MudButton OnClick="ReloadSources" Disabled="_sourceBusy">Reload recorded invoice queue</MudButton>
    @if(_sourceBusy){<MudProgressLinear Indeterminate="true" aria-label="Loading company invoice source queue" />}
    @if(_sourceError is not null){<MudAlert Severity="Severity.Error">@_sourceError</MudAlert>}
    @if(!_sourceBusy && _sourceError is null){<APInvoiceSourcePanel Review="_apSources" />}
    <MudButton OnClick="Reload" Disabled="_busy">Reload configured financial processes</MudButton>
    @if(_busy){<MudProgressLinear Indeterminate="true" />}
    @if(_error is not null){<MudAlert Severity="Severity.Error">@_error</MudAlert>}
    @if(!_busy && _error is null){<FinancialProcessCatalogPanel Review="@_catalog" />}
    <MudButton Href="/tasks/inbox" Variant="Variant.Outlined" Class="mt-3">Open assigned accounting work</MudButton>
</MudContainer>
@code {
    private FinancialProcessCatalogState? _catalog;
    private APInvoiceWorkspaceState? _apSources;
    private bool _sourceBusy,_sourceReloadRequested;
    private string? _sourceError;
    private bool _busy,_disposed,_reloadRequested;
    private string? _error;
    protected override async Task OnInitializedAsync(){_catalog=new(Company);_apSources=new(Company);Company.Changed+=ContextChanged;DataManagement.CurrentFieldChanged+=FieldChanged;await Reload();await ReloadSources();}
    private async Task Reload()
    {
        if(_disposed)return;if(_busy){_catalog?.Clear();_reloadRequested=true;return;}_busy=true;
        try{do{
            _reloadRequested=false;_error=null;var scope=Company.Snapshot;var version=_catalog!.Version+1;
            try{await _catalog.LoadAsync(()=>DataManagement.GetCurrentFieldIdAsync(),()=>BusinessProcessClient.GetDefinitionsAsync());}
            catch(Exception ex){var message=Calls.Explain(ex,"loading configured financial processes","The financial catalog could not be confirmed. Reload before continuing");if(!_disposed && scope==Company.Snapshot && version==_catalog.Version)_error=message;}
        }while(_reloadRequested && !_disposed);}finally{_busy=false;}
    }
    private async Task ReloadSources()
    {
        if(_disposed)return;
        if(_sourceBusy){_apSources?.Clear();_sourceReloadRequested=true;return;}_sourceBusy=true;
        try{do{
            _sourceReloadRequested=false;_apSources!.Clear();_sourceError=null;var scope=Company.Snapshot;var version=_apSources.Version;
            if(scope.Selection is null)continue;
            try
            {
                var user=(await Authentication.GetAuthenticationStateAsync()).User;
                if(_disposed || scope!=Company.Snapshot || version!=_apSources.Version)continue;
                if(user.Identity?.IsAuthenticated!=true || !scope.Selection.Roles.Any(user.IsInRole) || !scope.Selection.Permissions.Contains("Accounting.View",StringComparer.Ordinal))
                    throw new UnauthorizedAccessException("Current app-owned company roles and Accounting.View are required.");
                version++;await _apSources.LoadCompanyAsync(Accounting.GetCompanyAPInvoicesAsync);
            }
            catch(Exception ex){var message=Calls.Explain(ex,"loading the company invoice source queue","Company invoice sources could not be confirmed. Review company accounting access, ownership and the PRODUCTION schema");if(!_disposed && scope==Company.Snapshot && version==_apSources.Version)_sourceError=message;}
        }while(_sourceReloadRequested && !_disposed);}finally{_sourceBusy=false;}
    }
    private void FieldChanged(string _)=>ContextChanged();
    private void ContextChanged(){_catalog?.Clear();_apSources?.Clear();_error=null;_sourceError=null;if(!_disposed)_=InvokeAsync(async()=>{await Reload();await ReloadSources();if(!_disposed)StateHasChanged();});}
    public void Dispose(){_disposed=true;Company.Changed-=ContextChanged;DataManagement.CurrentFieldChanged-=FieldChanged;_catalog?.Dispose();_apSources?.Dispose();}
}
