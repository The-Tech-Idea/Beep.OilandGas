@page "/accounting/dashboard"
@page "/ppdm39/accounting"

<MudContainer MaxWidth="MaxWidth.Large">
    <MudText Typo="Typo.h3" GutterBottom>
        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Class="mr-2" Color="Color.Primary" />
        Oil & Gas Accounting
    </MudText>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudCard Elevation="3">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">FASB / SEC Compliance</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent><MudList T="string">
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_DDA_CALCULATION" Icon="@Icons.Material.Filled.Calculate">DD&A Calculation (ASC 932)</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_CEILING_TEST" Icon="@Icons.Material.Filled.Assessment">Ceiling Test (SEC Reg S-X)</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_ARO_ACCOUNTING" Icon="@Icons.Material.Filled.DeleteForever">ARO (ASC 410)</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_IMPAIRMENT" Icon="@Icons.Material.Filled.TrendingDown">Impairment (ASC 360)</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_ASC606_REVENUE" Icon="@Icons.Material.Filled.Receipt">Revenue Recognition (ASC 606)</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_HEDGE_EFFECTIVENESS" Icon="@Icons.Material.Filled.ShowChart">Hedge Effectiveness (ASC 815)</MudListItem>
                </MudList></MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudCard Elevation="3">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">COPAS / Joint Operations</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent><MudList T="string">
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_AFE_COST_TRACKING" Icon="@Icons.Material.Filled.AccountBalance">AFE Cost Tracking (MRP 1)</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_JIB_COPAS_OVERHEAD" Icon="@Icons.Material.Filled.Group">JIB + COPAS (MRP 2)</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_NONCONSENT" Icon="@Icons.Material.Filled.Block">Non-Consent Penalty</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_ROYALTY_CALCULATION" Icon="@Icons.Material.Filled.Percent">Royalty Calculation (MRP 3)</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_PRODUCTION_IMBALANCE" Icon="@Icons.Material.Filled.Balance">Production Imbalance</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_COPAS_AUDIT" Icon="@Icons.Material.Filled.Gavel">COPAS Audit (MFI-22)</MudListItem>
                </MudList></MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudCard Elevation="3">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Inventory & Contracts</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent><MudList T="string">
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_INVENTORY_LCM" Icon="@Icons.Material.Filled.Inventory2">Inventory LCM (ASC 330)</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_TAKE_OR_PAY" Icon="@Icons.Material.Filled.Handshake">Take-or-Pay (ASC 440)</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_PSC_ACCOUNTING" Icon="@Icons.Material.Filled.Public">PSC Accounting (IFRS 6)</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_CAPITAL_VS_EXPENSE" Icon="@Icons.Material.Filled.Category">Capital vs Expense</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_PRODUCTION_TAX_FILING" Icon="@Icons.Material.Filled.Description">Production Tax Filing</MudListItem>
                </MudList></MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudCard Elevation="3">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Period Close & Reporting</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent><MudList T="string">
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_PERIOD_CLOSE" Icon="@Icons.Material.Filled.EventAvailable">Period Close (SOX 404)</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_BUDGET_VS_ACTUALS" Icon="@Icons.Material.Filled.CompareArrows">Budget vs Actuals</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_DECOM_ESTIMATE_REVISION" Icon="@Icons.Material.Filled.Update">Decom Estimate Revision</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_RBL_REDETERMINATION" Icon="@Icons.Material.Filled.AccountBalanceWallet">RBL Redetermination</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/CRW_PRODUCTION_TO_REVENUE" Icon="@Icons.Material.Filled.OilBarrel">Production to Revenue</MudListItem>
                </MudList></MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudCard Elevation="3" Class="mt-4">
        <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Quick Actions</MudText></CardHeaderContent></MudCardHeader>
        <MudCardContent>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/ppdm39/process">All Processes</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/tasks/inbox">Task Inbox</MudButton>
            </MudStack>
        </MudCardContent>
    </MudCard>

    @* ── Accounting Operations ── *@
    <MudText Typo="Typo.h5" Class="mt-4 mb-2">Accounting Operations</MudText>
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudCard Elevation="3">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Core Financial Processes</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent><MudList T="string">
                    <MudListItem T="string" Href="/ppdm39/process/definitions/ACCT_PROCURE_TO_PAY" Icon="@Icons.Material.Filled.ShoppingCart">Procure-to-Pay (P2P)</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/ACCT_ORDER_TO_CASH" Icon="@Icons.Material.Filled.PointOfSale">Order-to-Cash (O2C)</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/ACCT_RECORD_TO_REPORT" Icon="@Icons.Material.Filled.Description">Record-to-Report (R2R)</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/ACCT_JOURNAL_ENTRY_APPROVAL" Icon="@Icons.Material.Filled.EditNote">Journal Entry Approval</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/ACCT_EXPENSE_MANAGEMENT" Icon="@Icons.Material.Filled.ReceiptLong">Expense Management</MudListItem>
                </MudList></MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudCard Elevation="3">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Treasury & Master Data</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent><MudList T="string">
                    <MudListItem T="string" Href="/ppdm39/process/definitions/ACCT_BANK_RECONCILIATION" Icon="@Icons.Material.Filled.AccountBalance">Bank Reconciliation</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/ACCT_CASH_MANAGEMENT" Icon="@Icons.Material.Filled.Savings">Cash Management</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/ACCT_FIXED_ASSET_LIFECYCLE" Icon="@Icons.Material.Filled.PrecisionManufacturing">Fixed Asset Lifecycle</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/ACCT_VENDOR_MANAGEMENT" Icon="@Icons.Material.Filled.Business">Vendor Management</MudListItem>
                    <MudListItem T="string" Href="/ppdm39/process/definitions/ACCT_CUSTOMER_MANAGEMENT" Icon="@Icons.Material.Filled.People">Customer Management</MudListItem>
                </MudList></MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>
