@page "/ppdm39/accounting/revenue-recognition"
@using System.Globalization
@using Beep.OilandGas.Web.Services
@using Beep.OilandGas.Models.Data.Accounting
@inject IAccountingServiceClient AccountingClient
@inject ISnackbar Snackbar
@inject OilGasApiFailures Answers
@inject FailureNotifier Notifier

<PageTitle>Track Revenue Recognition</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">

    @* ─── Header *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Track Revenue Recognition</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Revenue recorded for the current field this year, by well, product and month</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.TrendingUp">Revenue</MudChip>
            </MudStack>
        </MudStack>
        @* It said "Revenue recalculation initiated" and recalculated nothing: it reads the revenue again. *@
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="RefreshAsync" Disabled="@_isLoading">
            Refresh
        </MudButton>
    </MudStack>

    @* No revenue recognition status in the API: nothing records whether revenue is recognized or deferred under ASC 606 /
       IFRS 15, so the "Unrecognized (Deferred)" figure and the "Recognized %" column were removed. *@
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Recognition status (recognized versus deferred revenue under ASC 606 / IFRS 15) is not available yet.
    </MudAlert>

    @* A load under way or failed shows no figures: zeros there would read as the field's revenue. *@
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    }
    else if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_loadError</MudAlert>
    }
    else
    {
        @* ─── Summary Cards. The oil and gas revenue figures were removed: the API's revenue lines label a transaction with
           both oil and gas as oil and carry its whole amount, so revenue cannot be split by product. They read
           /api/accounting/revenue/summary, a route the API does not have. *@
        <MudGrid Class="mb-4" Spacing="3">
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="2" Class="pa-4 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="Color.Success" Size="Size.Large" />
                    <MudText Typo="Typo.h4">@_totalRevenue.ToString("C0")</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Default">Total Revenue (YTD)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="2" Class="pa-4 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.h4">@_revenueLines.Count.ToString("N0")</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Default">Revenue Transactions (YTD)</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    
        @* ─── Revenue transactions, each with its well, product and date. The per-well summary it replaced came from the same
           missing route; the grid filters and sorts by well. *@
        <MudPaper Elevation="2" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">Revenue Transactions</MudText>
            <MudDataGrid T="RevenueLine" Items="@_revenueLines" Filterable="true" SortMode="SortMode.Multiple"
                         Hover="true" Dense="true">
                <Columns>
                    <PropertyColumn Property="x => x.TransactionDate" Title="Date" Format="yyyy-MM-dd" />
                    <PropertyColumn Property="x => x.WellId" Title="Well" />
                    <PropertyColumn Property="x => x.Description" Title="Description" />
                    <PropertyColumn Property="x => x.Product" Title="Product" />
                    <PropertyColumn Property="x => x.Volume" Title="Volume" Format="N0" />
                    <PropertyColumn Property="x => x.Unit" Title="Unit" />
                    <PropertyColumn Property="x => x.Price" Title="Price" Format="C2" />
                    <PropertyColumn Property="x => x.AmountUsd" Title="Revenue" Format="C2" />
                </Columns>
            </MudDataGrid>
        </MudPaper>
    
        @* ─── Revenue by Month *@
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Monthly Revenue Trend</MudText>
            <MudChart T="double" ChartType="ChartType.Line"
                      ChartSeries="@_monthlyRevenueSeries"
                      ChartLabels="@_monthLabels"
                      Width="100%" Height="300px" />
            @if (_undatedCount > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @_undatedCount revenue transaction(s) carry no date and are counted in the total but not in any month.
                </MudText>
            }
        </MudPaper>
    }
</MudContainer>

@code {
    private bool _isLoading = true;
    private string? _loadError;
    private decimal _totalRevenue;
    private int _undatedCount;
    private List<RevenueLine> _revenueLines = new();
    private List<ChartSeries<double>> _monthlyRevenueSeries = new();
    private string[] _monthLabels = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        await LoadRevenueDataAsync();
    }

    /// <returns>Whether the revenue data was loaded; when it was not, the person has been told why.</returns>
    private async Task<bool> LoadRevenueDataAsync()
    {
        _isLoading = true;
        _loadError = null;
        var today = DateTime.UtcNow.Date;
        var yearStart = new DateTime(today.Year, 1, 1);
        try
        {
            _revenueLines = await AccountingClient.GetRevenueLinesAsync(yearStart, today);
            Summarize(today);
            return true;
        }
        catch (OilGasApiException answer)
        {
            Clear();
            _loadError = Answers.Explain(answer, "loading the revenue for the current field", "The revenue data could not be loaded");
            return false;
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Clear();
            _loadError = Notifier.FailureText(ex, "loading the revenue for the current field", "The revenue data could not be loaded");
            return false;
        }
        finally { _isLoading = false; }
    }

    /// <summary>The year's total and its months, from the revenue lines the API answered.</summary>
    private void Summarize(DateTime today)
    {
        _totalRevenue = _revenueLines.Sum(line => line.AmountUsd);
        _undatedCount = _revenueLines.Count(line => !line.TransactionDate.HasValue);
        var months = Enumerable.Range(1, today.Month).ToArray();
        _monthLabels = months
            .Select(month => CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(month))
            .ToArray();
        _monthlyRevenueSeries =
        [
            new ChartSeries<double>
            {
                Name = "Revenue",
                Data = months
                    .Select(month => (double)_revenueLines
                        .Where(line => line.TransactionDate is { } date && date.Year == today.Year && date.Month == month)
                        .Sum(line => line.AmountUsd))
                    .ToArray()
            }
        ];
    }

    private void Clear()
    {
        _revenueLines = new();
        _totalRevenue = 0m;
        _undatedCount = 0;
        _monthlyRevenueSeries = new();
        _monthLabels = Array.Empty<string>();
    }

    private async Task RefreshAsync()
    {
        if (await LoadRevenueDataAsync())
        {
            Snackbar.Add("Revenue data refreshed.", Severity.Success);
        }
    }
}
