@page "/ppdm39/accounting/royalties"
@attribute [Authorize]
@using Beep.OilandGas.Models.Data.ProductionAccounting
@inject IAccountingServiceClient AccountingServiceClient
@inject ILifeCycleService LifeCycleService
@inject IDataManagementService DataManagement
@implements IDisposable
@inject IDialogService DialogService

<PageTitle>Field Royalty Records</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">

    @* ─── Header *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Field Royalty Records</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_fieldName — Production royalty obligations</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                         Icon="@Icons.Material.Filled.AccountBalance">Accounting</MudChip>
            </MudStack>
        </MudStack>
        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Calculate"
                   Disabled="@(string.IsNullOrWhiteSpace(_fieldId))" OnClick="OpenPreviewDialog">Preview Royalties</MudButton>
    </MudStack>

    @* ─── Date Filter *@
    <MudCard Elevation="1" Class="mb-4">
        <MudCardContent>
            <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                <MudItem xs="12" sm="5">
                    <MudDatePicker @bind-Date="@_filterStartDate" Label="Calculated From" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudDatePicker @bind-Date="@_filterEndDate" Label="Calculated Through" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="LoadRoyalties" FullWidth="true">Filter</MudButton>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    @* ─── KPI Row *@
    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-2">@_loadError</MudAlert>
        <MudButton OnClick="LoadRoyalties" Disabled="@_isLoading" Class="mb-4">Retry records</MudButton>
    }
    @if (_royalties is not null && !_isLoading)
    {
    <MudGrid Class="mb-4" Spacing="3">
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Total Records" Value="@((_royalties?.Count ?? 0).ToString())"
                     ValueColor="Color.Primary" Icon="@Icons.Material.Filled.AccountBalance"
                     TrendIcon="@Icons.Material.Filled.TrendingFlat" TrendColor="Color.Default"
                     TrendText="All royalty calculations" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Total Royalty"
                     Value="@((_royalties?.Sum(r => r.ROYALTY_AMOUNT ?? 0m) ?? 0m).ToString("C0"))"
                     ValueColor="Color.Warning" Icon="@Icons.Material.Filled.MonetizationOn"
                     TrendIcon="@Icons.Material.Filled.TrendingFlat" TrendColor="Color.Default"
                     TrendText="Sum of royalty amounts" />
        </MudItem>
    </MudGrid>
    }

    @* ─── Royalties Grid *@
    <MudCard Elevation="2">
        <MudCardContent Class="pa-0">
            @if (_royalties != null && _royalties.Any())
            {
                <MudDataGrid T="ROYALTY_CALCULATION" Items="@_royalties" Dense="true" Hover="true" Striped="true"
                             SortMode="SortMode.Multiple" Filterable="true">
                    <Columns>
                        <TemplateColumn Title="Calculation Date">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@(context.Item.CALCULATION_DATE?.ToString("dd MMM yyyy") ?? "\u2014")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="r => r.PROPERTY_OR_LEASE_ID" Title="Property / Lease" />
                        <PropertyColumn Property="r => r.ROYALTY_OWNER_ID" Title="Royalty Owner" />
                        <TemplateColumn Title="Gross Revenue">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@(context.Item.GROSS_REVENUE?.ToString("C2") ?? "\u2014")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Net Revenue">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@(context.Item.NET_REVENUE?.ToString("C2") ?? "\u2014")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Royalty Amount">
                            <CellTemplate>
                                <MudText Typo="Typo.body2" Color="Color.Warning">@(context.Item.ROYALTY_AMOUNT?.ToString("C2") ?? "\u2014")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Status">
                            <CellTemplate>
                                <StatusBadge Status="@(context.Item.ROYALTY_STATUS ?? "\u2014")" />
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Details" Sortable="false" Filterable="false">
                            <CellTemplate>
                                <MudButton Href="@($"/ppdm39/accounting/royalties/{Uri.EscapeDataString(context.Item.ROYALTY_CALCULATION_ID)}")"
                                           Color="Color.Primary" Size="Size.Small">View details</MudButton>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudStack AlignItems="AlignItems.Center" Class="pa-6">
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Secondary" Class="og-icon-xl" />
                            <MudText Typo="Typo.body1">No records match the current filter</MudText>
                        </MudStack>
                    </NoRecordsContent>
                </MudDataGrid>
            }
            else if (!_isLoading && _loadError is null)
            {
                <MudStack AlignItems="AlignItems.Center" Class="pa-8">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Secondary" Class="og-icon-xl" />
                    <MudText Typo="Typo.h6">No royalty records found</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No recorded obligations match these calculation dates. Previewing does not create records.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Calculate"
                               OnClick="OpenPreviewDialog" Class="mt-2">Preview Royalties</MudButton>
                </MudStack>
            }
        </MudCardContent>
    </MudCard>

</MudContainer>

@code {
    private string _fieldId = string.Empty;
    private string _fieldName = string.Empty;
    private List<ROYALTY_CALCULATION>? _royalties;
    private bool _isLoading = false;
    private string? _loadError;
    private int _loadVersion;
    private bool _disposed;
    private DateTime? _filterStartDate;
    private DateTime? _filterEndDate;

    protected override async Task OnInitializedAsync()
    {
        DataManagement.CurrentFieldChanged += FieldChanged;
        var version = _loadVersion;
        try
        {
            var fieldId = await DataManagement.GetCurrentFieldIdAsync() ?? string.Empty;
            if (_disposed || version != _loadVersion) return;
            _fieldId = fieldId;
            _fieldName = _fieldId;
        }
        catch
        {
            _loadError = "The current field could not be loaded. Select a field and retry.";
            return;
        }

        await LoadRoyalties();
    }

    private async Task LoadRoyalties()
    {
        var version = ++_loadVersion;
        _isLoading = true;
        _royalties = null;
        _loadError = null;
        StateHasChanged();
        try
        {
            if (string.IsNullOrWhiteSpace(_fieldId))
            {
                _loadError = "Select a field before loading royalty records.";
                return;
            }
            if (_filterStartDate.HasValue && _filterEndDate.HasValue && _filterStartDate.Value.Date > _filterEndDate.Value.Date)
            {
                _loadError = "Calculated From must be on or before Calculated Through.";
                return;
            }
            var records = await AccountingServiceClient.GetRoyaltyCalculationsAsync(_fieldId, _filterStartDate, _filterEndDate);
            if (!_disposed && version == _loadVersion) _royalties = records;
        }
        catch (Exception)
        {
            if (!_disposed && version == _loadVersion)
                _loadError = "Royalty records could not be loaded. Check field access and the selected dates, then retry.";
        }
        finally
        {
            if (!_disposed && version == _loadVersion) _isLoading = false;
        }
    }

    private void FieldChanged(string fieldId) => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        _fieldId = fieldId;
        _fieldName = fieldId;
        await LoadRoyalties();
        if (!_disposed) StateHasChanged();
    });

    public void Dispose()
    {
        _disposed = true;
        ++_loadVersion;
        DataManagement.CurrentFieldChanged -= FieldChanged;
    }

    private async Task OpenPreviewDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var parameters = new DialogParameters
        {
            [nameof(RoyaltyCalculationDialog.FieldId)] = _fieldId
        };
        var dialog = await DialogService.ShowAsync<RoyaltyCalculationDialog>("Preview Royalties", parameters, options);
        var result = await dialog.Result;

        if (result?.Canceled == false)
        {
            await LoadRoyalties();
        }
    }

}
