@using Beep.OilandGas.Models.Data.Company
@page "/ppdm39/accounting/joint-interest-billing"
@using Beep.OilandGas.Web.Services
@using Beep.OilandGas.Models.Data.ProductionAccounting
@using Beep.OilandGas.Models.Data.Reporting
@inject IAccountingServiceClient AccountingClient
@inject ISnackbar Snackbar
@inject OilGasApiFailures Answers
@inject FailureNotifier Notifier

<PageTitle>Manage Joint Interest Billing</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">

    @* ─── Header *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Manage Joint Interest Billing</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Generate joint interest billing statements for working interest partners, by lease</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.AccountBalanceWallet">JIB</MudChip>
            </MudStack>
        </MudStack>
    </MudStack>

    @* ─── Generate a JIB statement (POST api/accounting/reporting/jib-statement). The button announced "JIB run generation
       initiated" and called nothing. *@
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">Generate JIB Statement</MudText>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudTextField T="string" @bind-Value="_leaseId" Immediate="true" Label="Lease ID" Variant="Variant.Outlined"
                              HelperText="The lease the run tickets, costs and revenue are recorded against" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudDatePicker @bind-Date="_periodEnd" Label="Period End Date" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="GenerateStatementAsync"
                           Disabled="@(_generating || string.IsNullOrWhiteSpace(_leaseId) || !_periodEnd.HasValue)"
                           StartIcon="@Icons.Material.Filled.ReceiptLong">
                    @(_generating ? "Generating..." : "Generate JIB Statement")
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (_statement is not null)
        {
            <MudText Typo="Typo.subtitle1" Class="mt-4">
                Statement for lease @_statement.JIB_ID, @PeriodText(_statement)
            </MudText>
            <MudGrid Class="mt-1" Spacing="3">
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="1" Class="pa-4 text-center">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Color="Color.Warning" Size="Size.Large" />
                        <MudText Typo="Typo.h5">@_statement.TOTAL_CHARGES.ToString("C2")</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Default">Charges (costs and overhead)</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="1" Class="pa-4 text-center">
                        <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Success" Size="Size.Large" />
                        <MudText Typo="Typo.h5">@_statement.TOTAL_CREDITS.ToString("C2")</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Default">Credits (revenue)</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="1" Class="pa-4 text-center">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h5">@_statement.NET_AMOUNT.ToString("C2")</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Default">Net</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
            @if (_statement.GENERATION_DATE.HasValue)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                    Generated @_statement.GENERATION_DATE.Value.ToString("yyyy-MM-dd HH:mm") UTC
                </MudText>
            }
        }
    </MudPaper>

    @* ─── JIB invoices. No JIB invoice endpoint in the API: nothing writes JOINT_INTEREST_BILL, and nothing records a
       partner's payment, due date, overdue state or dispute. The invoice table (which loaded /api/accounting/jib/invoices, a
       route the API does not have), its status filter and search (never sent), its row link (to a page that does not
       exist) and the open/paid/overdue/partner counts drawn from it were removed. *@
    <MudPaper Elevation="2" Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-3">JIB Invoices</MudText>
        <MudAlert Severity="Severity.Info">
            Listing JIB invoices and tracking partner payments, overdue invoices and disputes is not available yet.
        </MudAlert>
    </MudPaper>
</MudContainer>

@code {
    private string _leaseId = "";
    private DateTime? _periodEnd = new DateTime(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1).AddDays(-1);
    private bool _generating;
    private JOINT_INTEREST_STATEMENT? _statement;

    private async Task GenerateStatementAsync()
    {
        if (string.IsNullOrWhiteSpace(_leaseId) || !_periodEnd.HasValue) return;

        var leaseId = _leaseId.Trim();
        var periodEnd = _periodEnd.Value.Date;
        _generating = true;
        _statement = null;
        try
        {
            // The request names the period end alone: the billing service states the lease from its earliest allocation to
            // it, and the statement says which period it covers (shown below). A month start was sent and read by nothing.
            _statement = await AccountingClient.GenerateJibStatementAsync(new GenerateJIBStatementRequest
            {
                LeaseId = leaseId,
                PeriodEnd = periodEnd
            });
            Snackbar.Add($"JIB statement generated for lease {leaseId}, period ending {periodEnd:yyyy-MM-dd}.", Severity.Success);
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "generating a JIB statement", "The JIB statement was not generated"), Severity.Error);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "generating a JIB statement", "The JIB statement was not generated");
        }
        finally
        {
            _generating = false;
        }
    }

    /// <summary>The period the statement covers, as the billing service recorded it.</summary>
    private static string PeriodText(JOINT_INTEREST_STATEMENT statement) =>
        (statement.REPORT_PERIOD_START, statement.REPORT_PERIOD_END) switch
        {
            ({ } start, { } end) => $"{start:yyyy-MM-dd} to {end:yyyy-MM-dd}",
            (null, { } end) => $"period ending {end:yyyy-MM-dd}",
            _ => "period not recorded"
        };
}
