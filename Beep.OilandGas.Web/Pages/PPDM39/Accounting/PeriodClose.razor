@page "/ppdm39/accounting/period-close"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles="Accountant,Administrator")]
@using Beep.OilandGas.Web.Services
@inject IAccountingServiceClient AccountingClient
@inject IDataManagementService DataManagement
@inject Beep.OilandGas.Client.App.CompanyClientContext Company
@inject OilGasCallFailures Calls
@implements IDisposable
<PageTitle>Accounting period checks</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    <MudButton Href="/accounting/dashboard">Accounting workspace</MudButton>
    <MudText Typo="Typo.h5">Accounting period checks</MudText>
    <FieldSelector />
    <MudDatePicker Date="@_end" DateChanged="EndChanged" Label="Period end date" Disabled="@_busy" />
    <MudTextField T="string" Value="@_book" ValueChanged="BookChanged" Label="Accounting book ID" Disabled="@_busy" />
    <MudButton OnClick="Load" Disabled="@(_busy || !_end.HasValue || string.IsNullOrWhiteSpace(_book))" Variant="Variant.Filled">Run recorded-data checks</MudButton>
    @if(_busy){<MudProgressLinear Indeterminate="true" aria-label="Running accounting period checks" />}
    @if(_error is not null){<MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>}
    @if(Company.Selection is null){<MudAlert Severity="Severity.Info">Select a company on the company landing page.</MudAlert>}
    @if(_state.Current is { } review)
    {
        <MudText>Company: @review.Company.TenantId / @review.Company.BusinessAssociateId · FIELD context: @review.FieldId</MudText>
        <MudText>Book: @review.BookId · Period end: @review.PeriodEnd.ToString("yyyy-MM-dd") · Checks generated: @review.GeneratedAtUtc.ToString("O")</MudText>
        @foreach(var check in review.Checks)
        {
            <MudPaper Outlined="true" Class="pa-3 my-2">
                <MudText>@check.Name · @check.Module · @(check.Passed ? "Passed" : "Blocked")</MudText>
                <MudText>@check.Description</MudText>
                <MudText Typo="Typo.caption">Scope: @check.Scope · @(check.Mandatory ? "Mandatory check" : "Supporting check")</MudText>
            </MudPaper>
        }
        <MudText role="status">@review.Checks.Count(row=>row.Mandatory && !row.Passed) mandatory checks blocked. These are executed checks; a persisted period close or lock is unconfirmed.</MudText>
    }
    else if(!_busy && _error is null){<MudAlert Severity="Severity.Info">Choose the exact book and period end, then run checks. No readiness results are confirmed.</MudAlert>}
    <MudAlert Severity="Severity.Info" Class="mt-3">GL checks use the selected book; AP/AR checks cover the company accounting database. Persisted close history, a period lock, and the remaining close checks are unavailable. Passing the displayed checks does not confirm close readiness or completion.</MudAlert>
</MudContainer>
@code {
    private AccountingPeriodCheckState _state=null!;private DateTime? _end;private string _book="";private string? _error;private bool _busy,_disposed;
    protected override void OnInitialized(){_state=new(Company);Company.Changed+=ContextChanged;DataManagement.CurrentFieldChanged+=FieldChanged;}
    private void EndChanged(DateTime? value){_end=value;_state.Clear();_error=null;}
    private void BookChanged(string value){_book=value;_state.Clear();_error=null;}
    private async Task Load()
    {
        if(_busy || !_end.HasValue)return;_busy=true;_error=null;var scope=Company.Snapshot;var version=_state.Version+1;
        try{await _state.LoadAsync(_end.Value,_book,()=>DataManagement.GetCurrentFieldIdAsync(),(date,book)=>AccountingClient.GetPeriodChecksAsync(date,book));}
        catch(Exception ex){var message=Calls.Explain(ex,"running accounting period checks","Executed checks could not be confirmed. Reload before continuing");if(!_disposed && scope==Company.Snapshot && version==_state.Version)_error=message;}
        finally{_busy=false;}
    }
    private void FieldChanged(string _) => ContextChanged();
    private void ContextChanged(){_state.Clear();_error=null;if(!_disposed)_=InvokeAsync(StateHasChanged);}
    public void Dispose(){_disposed=true;Company.Changed-=ContextChanged;DataManagement.CurrentFieldChanged-=FieldChanged;_state.Dispose();}
}
