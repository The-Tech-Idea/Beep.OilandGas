@page "/ppdm39/accounting/period-close"
@using Beep.OilandGas.Web.Services
@using Beep.OilandGas.Models.Data.Accounting
@using Beep.OilandGas.ProductionAccounting.Constants
@inject IAccountingServiceClient AccountingClient
@inject ApiClient ApiClient
@inject ISnackbar Snackbar
@inject OilGasApiFailures Answers
@inject FailureNotifier Notifier

<PageTitle>Close Accounting Period</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">

    @* ─── Header. It said the close locks the period: nothing refuses a posting dated in a closed period yet. *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Close Accounting Period</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Run the period-end close for the current field and post its closing journal</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Lock">Period Close</MudChip>
            </MudStack>
        </MudStack>
    </MudStack>

    @* ─── Period Selection. The "Closing Notes" field was removed: the close request carries the period end alone, so
       notes were typed and sent nowhere. *@
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">Select Period to Close</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_periodEnd" @bind-Date:after="LoadReadinessAsync" Label="Period End Date" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true"
                           OnClick="ExecutePeriodClose"
                           Disabled="@(_closing || _checking || !_periodEnd.HasValue || _readiness is not { Ready: true })"
                           StartIcon="@Icons.Material.Filled.Lock">
                    @(_closing ? "Closing..." : "Execute Period Close")
                </MudButton>
            </MudItem>
        </MudGrid>
        @* No closed-period guard on postings: no journal, allocation or revenue writer asks whether its period is closed. *@
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
            Closing posts the period's closing journal. It does not yet prevent later postings dated in the period.
        </MudText>
    </MudPaper>

    @* ─── Pre-Close Checklist: the checks the close makes before it will run (GET close-readiness). It was six fixed items,
       three of them always pending, so the close could never be started. *@
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.h6">Pre-Close Checklist</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadReadinessAsync" Disabled="@(_checking || _closing || !_periodEnd.HasValue)">
                Check again
            </MudButton>
        </MudStack>
        @if (_checking)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_readinessError is not null)
        {
            <MudAlert Severity="Severity.Error">@_readinessError</MudAlert>
        }
        else if (_readiness is null)
        {
            <MudText Typo="Typo.body2" Color="Color.Default">Choose a period end date to check whether it can be closed.</MudText>
        }
        else if (_readiness.PeriodStatus == PeriodCloseStatusCodes.Closed)
        {
            @* No reopen: re-closing a reopened period would post depletion, accretion and the other period-end adjustments
               a second time (see the period close service). *@
            <MudAlert Severity="Severity.Info">
                The period ending @_readiness.PeriodEnd.ToString("yyyy-MM-dd") is closed: its closing journal is posted.
                Reopening a closed period is not available yet.
            </MudAlert>
        }
        else if (_readiness.Ready)
        {
            <MudAlert Severity="Severity.Success">
                The period ending @_readiness.PeriodEnd.ToString("yyyy-MM-dd") is ready to close: allocations have their
                details, royalties are accrued or paid, revenue is allocated, production matches revenue, and journal entries
                balance.
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">
                The period ending @_readiness.PeriodEnd.ToString("yyyy-MM-dd") cannot be closed until these are resolved:
            </MudAlert>
            <MudList T="string" Dense="true">
                @foreach (var item in _readiness.OutstandingItems)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.PendingActions">@item</MudListItem>
                }
            </MudList>
        }
    </MudPaper>

    @* ─── Close History: every close of the current field's periods, read from the closing journals the close posts
       (GET period-closes). It said the history was not available, and before that showed invented rows. *@
    <MudPaper Elevation="2" Class="pa-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.h6">Period Close History</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadHistoryAsync" Disabled="@_loadingHistory">
                Refresh
            </MudButton>
        </MudStack>
        @if (_loadingHistory)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_historyError is not null)
        {
            <MudAlert Severity="Severity.Error">@_historyError</MudAlert>
        }
        else if (_history.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Default">No period of the current field has been closed yet.</MudText>
        }
        else
        {
            <MudDataGrid T="Beep.OilandGas.Models.Data.ProductionAccounting.PeriodCloseSummary" Items="@_history"
                         Dense="true" Hover="true" Striped="true">
                <Columns>
                    <PropertyColumn Property="x => x.PeriodEnd" Title="Period End" Format="yyyy-MM-dd" />
                    <TemplateColumn Title="Status">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">@StatusText(context.Item.Status)</MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.JournalEntryNumber" Title="Closing Journal" />
                    <PropertyColumn Property="x => x.ClosedBy" Title="Closed By" />
                    <TemplateColumn Title="Closed At (UTC)">
                        <CellTemplate>@(context.Item.ClosedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Not recorded")</CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        }
    </MudPaper>
</MudContainer>

@code {
    private bool _closing;
    private bool _checking;
    private bool _loadingHistory;
    private DateTime? _periodEnd = new DateTime(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1).AddDays(-1);
    private PeriodCloseReadinessResult? _readiness;
    private string? _readinessError;
    private List<Beep.OilandGas.Models.Data.ProductionAccounting.PeriodCloseSummary> _history = new();
    private string? _historyError;

    protected override async Task OnInitializedAsync()
    {
        await LoadReadinessAsync();
        await LoadHistoryAsync();
    }

    private async Task LoadReadinessAsync()
    {
        _readiness = null;
        _readinessError = null;
        if (!_periodEnd.HasValue) return;

        _checking = true;
        try
        {
            _readiness = await AccountingClient.GetCloseReadinessAsync(_periodEnd.Value.Date);
        }
        catch (OilGasApiException answer)
        {
            _readinessError = Answers.Explain(answer, "checking whether the accounting period can be closed", "Whether the period can be closed could not be checked");
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            _readinessError = Notifier.FailureText(ex, "checking whether the accounting period can be closed", "Whether the period can be closed could not be checked");
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task LoadHistoryAsync()
    {
        _history = new();
        _historyError = null;
        _loadingHistory = true;
        try
        {
            _history =await ApiClient.GetAsync<List<Beep.OilandGas.Models.Data.ProductionAccounting.PeriodCloseSummary>>(
                "/api/field/current/accounting/period-closes") ?? new();
        }
        catch (OilGasApiException answer)
        {
            _historyError = Answers.Explain(answer, "loading the period close history", "The period close history could not be loaded");
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            _historyError = Notifier.FailureText(ex, "loading the period close history", "The period close history could not be loaded");
        }
        finally
        {
            _loadingHistory = false;
        }
    }

    private async Task ExecutePeriodClose()
    {
        if (!_periodEnd.HasValue) return;

        var periodEnd = _periodEnd.Value.Date;
        _closing = true;
        try
        {
            await AccountingClient.ClosePeriodAsync(new CloseAccountingPeriodRequest { PeriodEnd = periodEnd });
            Snackbar.Add($"Period ending {periodEnd:yyyy-MM-dd} closed successfully.", Severity.Success);
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "closing the accounting period", "The accounting period was not closed"), Severity.Error);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "closing the accounting period", "The accounting period was not closed");
        }
        finally
        {
            _closing = false;
        }

        // What the close left behind, read again rather than assumed.
        await LoadReadinessAsync();
        await LoadHistoryAsync();
    }

    /// <summary>A close's status, as the close history words it.</summary>
    private static string StatusText(string status) => status switch
    {
        PeriodCloseStatusCodes.Closed => "Closed",
        PeriodCloseStatusCodes.Reopened => "Reopened (closing journal reversed)",
        PeriodCloseStatusCodes.Closing => "Unfinished (closing journal not posted)",
        _ => status
    };

    private static Color StatusColor(string status) => status switch
    {
        PeriodCloseStatusCodes.Closed => Color.Success,
        PeriodCloseStatusCodes.Closing => Color.Warning,
        _ => Color.Default
    };
}
