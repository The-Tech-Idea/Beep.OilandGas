@using Beep.OilandGas.Models.Data.Company
@page "/ppdm39/sync"
@using System.Text.Json.Serialization
@using MudBlazor
@inject ApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject OilGasApiFailures Answers
@inject FailureNotifier Notifier
@inject IFailureReporter Failures

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.Sync" Class="mr-2" />
        Data Synchronization
    </MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        PPDM 3.9 multi-instance sync powered by BeepDM BeepSyncManager.
        Full/C incremental sync with conflict resolution, data quality gates, and reconciliation.
    </MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Sync Schemas</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       OnClick="InitializeSchemas" Disabled="_syncing">
                                Init Schemas
                            </MudButton>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_schemasError is not null)
                        {
                            <MudAlert Severity="Severity.Error">@_schemasError</MudAlert>
                        }
                        else if (_schemas?.Count > 0)
                        {
                            <MudTable Items="@_schemas" Hover="true" Striped="true" Dense="true">
                                <HeaderContent>
                                    <MudTh>Entity</MudTh>
                                    <MudTh>Mode</MudTh>
                                    <MudTh>Actions</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.SchemaName</MudTd>
                                    <MudTd>@context.SyncMode</MudTd>
                                    <MudTd>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                                   OnClick="() => SyncEntity(context.SchemaId)" Disabled="_syncing">
                                            Sync Now
                                        </MudButton>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">No sync schemas configured. Click "Init Schemas" to create the standard PPDM39 schemas.</MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Reconciliation Report</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="LoadReconciliation">
                                Refresh
                            </MudButton>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_reconciliationError is not null)
                        {
                            <MudAlert Severity="Severity.Error">@_reconciliationError</MudAlert>
                        }
                        else if (_reconciliation != null)
                        {
                            <MudStack Row="true" Justify="Justify.SpaceAround" Class="mb-4">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Source</MudText>
                                    <MudText Typo="Typo.h5">@_reconciliation.SourceRows.ToString("N0")</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Destination</MudText>
                                    <MudText Typo="Typo.h5">@_reconciliation.DestRows.ToString("N0")</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Rejects</MudText>
                                    <MudText Typo="Typo.h5" Color="@(_reconciliation.Rejects > 0 ? Color.Error : Color.Default)">@_reconciliation.Rejects.ToString("N0")</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Conflicts</MudText>
                                    <MudText Typo="Typo.h5" Color="@(_reconciliation.Conflicts > 0 ? Color.Warning : Color.Default)">@_reconciliation.Conflicts.ToString("N0")</MudText>
                                </div>
                            </MudStack>
                            <MudText Typo="Typo.body2"><strong>Quality Band:</strong> @_reconciliation.MappingQualityBand</MudText>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">No reconciliation data available. Run a sync first.</MudAlert>
                        }
                    </MudCardContent>
                </MudCard>

                <MudCard Elevation="2" Class="mt-4">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.h6">SLO Status</MudText></CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_lastResult != null)
                        {
                            <MudStack Row="true" Justify="Justify.SpaceAround">
                                <div>
                                    <MudText Typo="Typo.caption">Records Read</MudText>
                                    <MudText Typo="Typo.h6">@_lastResult.RecordsRead.ToString("N0")</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption">Inserted</MudText>
                                    <MudText Typo="Typo.h6" Color="Color.Success">@_lastResult.RecordsInserted.ToString("N0")</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption">Failed</MudText>
                                    <MudText Typo="Typo.h6" Color="@(_lastResult.RecordsFailed > 0 ? Color.Error : Color.Default)">@_lastResult.RecordsFailed.ToString("N0")</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption">Duration</MudText>
                                    <MudText Typo="Typo.h6">@_lastResult.Duration</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption">SLO</MudText>
                                    <MudChip T="string" Color="@SloColor(_lastResult.SloTier)" Size="Size.Small">@_lastResult.SloTier</MudChip>
                                </div>
                            </MudStack>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">Run a sync to see SLO metrics.</MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        if (_syncing)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                       OnClick="SyncAll" FullWidth="true" Disabled="true">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                Syncing all schemas...
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                       OnClick="SyncAll" FullWidth="true">
                Sync All Schemas
            </MudButton>
        }
    }
</MudContainer>

@code {
    private bool _loading = true;
    private bool _syncing;
    private List<SyncSchemaDto>? _schemas;
    private string? _schemasError;
    private SyncRunDto? _lastResult;
    private ReconciliationDto? _reconciliation;
    private string? _reconciliationError;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _loading = false;
    }

    private async Task LoadData()
    {
        _schemasError = null;
        try
        {
            var answer = await ApiClient.GetAsync<SyncSchemasAnswer>("/api/sync/schemas");
            _schemas = answer?.Schemas ?? new List<SyncSchemaDto>();
        }
        // The card says the schemas did not load, rather than that none are configured.
        catch (OilGasApiException answer)
        {
            _schemas = null;
            _schemasError = Answers.Explain(answer, "loading the sync schemas", "The sync schemas could not be loaded");
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            _schemas = null;
            _schemasError = Notifier.FailureText(ex, "loading the sync schemas", "The sync schemas could not be loaded");
        }
        await LoadReconciliation();
    }

    private async Task LoadReconciliation()
    {
        _reconciliationError = null;
        try
        {
            _reconciliation = await ApiClient.GetAsync<ReconciliationDto>("/api/sync/reconciliation");
        }
        // The endpoint answers 404 until a sync has run: that is "no report yet", which the card says, and is recorded.
        catch (OilGasApiException noReport) when (noReport.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Failures.ReportHandled(
                noReport,
                "reading the last sync reconciliation report",
                consequence: "the API holds no report until a sync has run; the page says there is none yet",
                FailureSeverity.Degraded);
            _reconciliation = null;
        }
        catch (OilGasApiException answer)
        {
            _reconciliation = null;
            _reconciliationError = Answers.Explain(answer, "reading the last sync reconciliation report", "The reconciliation report could not be loaded");
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            _reconciliation = null;
            _reconciliationError = Notifier.FailureText(ex, "reading the last sync reconciliation report", "The reconciliation report could not be loaded");
        }
    }

    private async Task InitializeSchemas()
    {
        try
        {
            await ApiClient.PostAsync<JsonElement>("/api/sync/init-schemas", (HttpContent?)null);
            Snackbar.Add("Schemas initialized", Severity.Success);
            await LoadData();
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "initializing the standard PPDM39 sync schemas", "The sync schemas were not initialized"), Severity.Error);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "initializing the standard PPDM39 sync schemas", "The sync schemas were not initialized");
        }
    }

    private async Task SyncEntity(string schemaId)
    {
        _syncing = true;
        StateHasChanged();
        try
        {
            _lastResult = await ApiClient.PostAsync<SyncRunDto>($"/api/sync/run/{Uri.EscapeDataString(schemaId)}", (HttpContent?)null);
            Snackbar.Add($"Synced {schemaId}: {_lastResult?.RecordsRead ?? 0:N0} records", Severity.Success);
            await LoadReconciliation();
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "synchronizing one PPDM39 sync schema", $"{schemaId} was not synchronized"), Severity.Error);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "synchronizing one PPDM39 sync schema", $"{schemaId} was not synchronized");
        }
        finally { _syncing = false; }
    }

    private async Task SyncAll()
    {
        _syncing = true;
        StateHasChanged();
        try
        {
            var answer = await ApiClient.PostAsync<SyncAllAnswer>("/api/sync/run-all", (HttpContent?)null);
            // The API answers every schema's outcome; the person is told how many did not synchronize, not "completed".
            if (answer is { Failed: > 0 })
                Snackbar.Add($"Sync-all finished: {answer.Succeeded} of {answer.TotalSchemas} schemas synchronized, {answer.Failed} did not.", Severity.Warning);
            else
                Snackbar.Add("Sync-all completed", Severity.Success);
            await LoadReconciliation();
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "synchronizing all PPDM39 sync schemas", "The schemas were not synchronized"), Severity.Error);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "synchronizing all PPDM39 sync schemas", "The schemas were not synchronized");
        }
        finally { _syncing = false; }
    }

    private Color SloColor(string? tier) => tier switch
    {
        "Green" => Color.Success,
        "Yellow" => Color.Warning,
        "Red" => Color.Error,
        _ => Color.Default
    };

    // DTOs for API deserialization, in the shapes SyncController answers with. The schema list arrives as
    // { count, schemas } of BeepDM DataSyncSchema (id, entityName, syncType); the page read a bare list of members no
    // schema has, so the list could never load. A schema has no enabled flag (sync-all runs every schema), so the
    // column that always said "No" is gone.
    public class SyncSchemasAnswer
    {
        public List<SyncSchemaDto> Schemas { get; set; } = new();
    }
    public class SyncSchemaDto
    {
        [JsonPropertyName("id")]
        public string SchemaId { get; set; } = string.Empty;
        [JsonPropertyName("entityName")]
        public string SchemaName { get; set; } = string.Empty;
        [JsonPropertyName("syncType")]
        public string SyncMode { get; set; } = string.Empty;
    }
    public class SyncAllAnswer
    {
        public int TotalSchemas { get; set; }
        public int Succeeded { get; set; }
        public int Failed { get; set; }
    }
    public class SyncRunDto
    {
        public string SchemaId { get; set; } = string.Empty;
        public int RecordsRead { get; set; }
        public int RecordsInserted { get; set; }
        public int RecordsFailed { get; set; }
        public string Duration { get; set; } = string.Empty;
        public string? SloTier { get; set; }
    }
    // The reconciliation endpoint answers BeepDM's SyncReconciliationReport under its own member names.
    public class ReconciliationDto
    {
        [JsonPropertyName("sourceRowsScanned")]
        public int SourceRows { get; set; }
        [JsonPropertyName("destRowsWritten")]
        public int DestRows { get; set; }
        [JsonPropertyName("rejectCount")]
        public int Rejects { get; set; }
        [JsonPropertyName("conflictCount")]
        public int Conflicts { get; set; }
        public string? MappingQualityBand { get; set; }
    }
}
