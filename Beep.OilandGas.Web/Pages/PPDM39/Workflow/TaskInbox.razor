@page "/ppdm39/tasks/inbox"
@page "/tasks/inbox"
@using Beep.OilandGas.Web.Services
@using TheTechIdea.Data.OilGas
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IUnifiedTaskInboxService InboxService
@inject NavigationManager Nav
@inject OilGasCallFailures Calls
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Large">
    <MudText Typo="Typo.h3" GutterBottom>
        <MudIcon Icon="@Icons.Material.Filled.Inbox" Class="mr-2" />
        Task Inbox
        @if (_counts.TotalPending > 0)
        {
            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="ml-2">
                @_counts.TotalPending pending
            </MudChip>
        }
    </MudText>

    @* ── Filter Bar ── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4" Wrap="Wrap.Wrap">
        @* Choosing a type narrows the list at once; the bound value was read only by the next refresh, so a chip changed nothing. *@
        <MudChipSet T="string" SelectedValue="_selectedTaskType" SelectedValueChanged="SelectTaskType" CheckMark="true">
            <MudChip T="string" Value="@(string.Empty)">All</MudChip>
            <MudChip T="string" Value='@("APPROVAL")'>
                Approvals
                @if (_counts.Approvals > 0)
                {
                    <MudBadge Content="@_counts.Approvals" Color="Color.Primary" />
                }
            </MudChip>
            <MudChip T="string" Value='@("REVIEW")'>
                Reviews
                @if (_counts.Reviews > 0)
                {
                    <MudBadge Content="@_counts.Reviews" Color="Color.Secondary" />
                }
            </MudChip>
            <MudChip T="string" Value='@("DATA_ENTRY")'>
                Data Entry
                @if (_counts.DataEntry > 0)
                {
                    <MudBadge Content="@_counts.DataEntry" Color="Color.Tertiary" />
                }
            </MudChip>
        </MudChipSet>

        <MudSpacer />

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            @if (_counts.Critical > 0)
            {
                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">
                    @_counts.Critical critical
                </MudChip>
            }
            @if (_counts.Overdue > 0)
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">
                    @_counts.Overdue overdue
                </MudChip>
            }
            <MudTooltip Text="Refresh">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Size="Size.Small"
                               OnClick="RefreshAsync"
                               Disabled="@_isLoading"
                               aria-label="Refresh" />
            </MudTooltip>
        </MudStack>
    </MudStack>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" />
    }

    @* ── Critical / Overdue Section ── *@
    @if (_criticalTasks.Any())
    {
        <MudText Typo="Typo.h6" Color="Color.Error" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.PriorityHigh" /> Requires Immediate Attention
        </MudText>
        @foreach (var task in _criticalTasks)
        {
            <TaskInboxCard Task="task" OnAction="HandleTaskAction" />
        }
        <MudDivider Class="my-4" />
    }

    @* ── Main Task List ── *@
    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="my-2">@_loadError</MudAlert>
    }
    else if (!_allTasks.Any() && !_isLoading)
    {
        <MudPaper Elevation="1" Class="pa-6" Style="text-align:center">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                     Size="Size.Large" Color="Color.Success" Class="mb-2" />
            <MudText Typo="Typo.h6">All caught up!</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                You have no pending tasks in your inbox.
            </MudText>
        </MudPaper>
    }
    else
    {
        @foreach (var task in _allTasks)
        {
            <TaskInboxCard Task="task" OnAction="HandleTaskAction" />
        }
    }
</MudContainer>

@code {
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private INotificationService? NotificationService { get; set; }

    private List<UnifiedTask> _allTasks = new();
    private List<UnifiedTask> _loadedTasks = new();
    private List<UnifiedTask> _criticalTasks = new();
    private InboxCounts _counts = new();
    private string? _selectedTaskType;
    private bool _isLoading;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        if (NotificationService is not null)
        {
            NotificationService.OnTaskCountsUpdated += OnCountsUpdated;
        }
    }

    private async Task RefreshAsync()
    {
        _isLoading = true;
        _loadError = null;
        StateHasChanged();

        try
        {
            // No persona is named: the API answers for the signed-in person's own persona, which it reads from their
            // account (WorkflowTasksController), and refuses one that is not theirs. The page kept a persona field that
            // nothing ever set, and the API is the one owner of that answer, so it is gone rather than wired.
            var inbox = await InboxService.GetInboxAsync(string.Empty);
            _criticalTasks = inbox.CriticalTasks;
            _loadedTasks = inbox.HighPriorityTasks.Concat(inbox.NormalTasks).ToList();
            _counts = inbox.Counts;
            ApplyTaskTypeFilter();
        }
        // The inbox service refuses an empty task answer with InvalidOperationException. An inbox that did not load is not
        // shown as "all caught up": the page says it did not load.
        catch (Exception failure) when (OilGasCallFailures.IsCallFailure(failure) || failure is InvalidOperationException)
        {
            _criticalTasks.Clear();
            _loadedTasks.Clear();
            _allTasks.Clear();
            _counts = new();
            _loadError = Calls.Explain(failure, "loading the task inbox", "The tasks could not be loaded");
            Snackbar.Add(_loadError, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectTaskType(string? taskType)
    {
        _selectedTaskType = taskType;
        ApplyTaskTypeFilter();
    }

    private void ApplyTaskTypeFilter()
    {
        _allTasks = string.IsNullOrWhiteSpace(_selectedTaskType)
            ? _loadedTasks.ToList()
            : _loadedTasks
                .Where(t => string.Equals(t.TaskType, _selectedTaskType, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    private async Task HandleTaskAction(UnifiedTask task)
    {
        if (!string.IsNullOrWhiteSpace(task.Route))
        {
            Nav.NavigateTo(task.Route);
        }
        await Task.CompletedTask;
    }

    // The notification service raises a plain event from its SignalR connection, outside every lifecycle method. An async
    // void handler's failure reached nothing; the update now runs on the renderer, and a fault is handed to the error boundary.
    private void OnCountsUpdated(InboxCounts counts) => _ = ShowCountsAsync(counts);

    private async Task ShowCountsAsync(InboxCounts counts)
    {
        try
        {
            await InvokeAsync(() =>
            {
                _counts = counts;
                StateHasChanged();
            });
        }
        catch (Exception failure)
        {
            // Deliberately broad: this runs outside every lifecycle method, so a fault reaches no error boundary unless it is
            // handed over. DispatchExceptionAsync is the framework's route there, and the boundary reports it.
            await DispatchExceptionAsync(failure);
        }
    }

    public void Dispose()
    {
        if (NotificationService is not null)
        {
            NotificationService.OnTaskCountsUpdated -= OnCountsUpdated;
        }
    }
}
