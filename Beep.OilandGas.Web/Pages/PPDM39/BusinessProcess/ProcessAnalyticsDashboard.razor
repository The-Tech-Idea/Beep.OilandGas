@using Beep.OilandGas.Models.Data.Company
@page "/ppdm39/analytics"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Beep.OilandGas.Web.Components.Workflow

<PageTitle>Process analytics</PageTitle>
<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    <MudText Typo="Typo.h4" HtmlTag="h1">Process analytics</MudText>
    <MudAlert Severity="Severity.Info" Class="my-3">Process performance and safety totals are unavailable until their company, field, source records and reporting period can be confirmed.</MudAlert>
    <MudText Class="my-3">Review your assigned work or inspect selected well data while source-backed analytics are being established.</MudText>
    <PersonaTaskInbox WorkspaceRoutes='@(new[]{"/analytics/dashboard"})' />
    <RecordedWorkOrderOverview />
    <MudButton Href="/tasks/inbox" Variant="Variant.Outlined">Open company inbox</MudButton>
    <MudButton Href="/ppdm39/data-quality" Variant="Variant.Outlined" Class="mx-2">Review well data</MudButton>
    <MudButton Href="/analytics/dashboard" Variant="Variant.Text">Data analyst workspace</MudButton>
</MudContainer>
