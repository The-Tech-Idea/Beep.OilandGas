@using Beep.OilandGas.Models.Data.Process
@using Beep.OilandGas.Models.Data.WorkOrder
@using Beep.OilandGas.PPDM39.DataManagement.Models
@using Beep.OilandGas.Models.Core.Interfaces
@using Beep.OilandGas.Models.Data.Company
@page "/ppdm39/process/instances/{Id}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Beep.OilandGas.Web.Services
@inject IRecordedProcessClient BusinessProcessClient
@inject IFieldSelectionContext Fields
@inject Beep.OilandGas.Client.App.CompanyClientContext Company
@inject OilGasCallFailures Calls
@implements IDisposable
<PageTitle>Source process — @Id</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    <MudButton Href="/tasks/inbox" StartIcon="@Icons.Material.Filled.ArrowBack">Assigned work</MudButton>
    <MudText Typo="Typo.h5">Source process</MudText>
    <FieldSelector />
    <MudButton OnClick="Reload" Disabled="@_busy" StartIcon="@Icons.Material.Filled.Refresh">Reload recorded process</MudButton>
    @if (_busy) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading source process" /> }
    else if (_error is not null) { <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert> }
    else if (Company.Selection is null) { <MudAlert Severity="Severity.Info">Select a company to open its process records.</MudAlert><MudButton Href="/landing">Company workspace</MudButton> }
    else if (_state?.Instance is { } source)
    {
        <RecordedProcessSourcePanel State="_state" />
        @if(source.InstanceId.StartsWith(CompanyMaintenanceProcessStart.InstancePrefix,StringComparison.Ordinal) && source.EntityType=="WORK_ORDER")
        {
            @if(AcceptanceId is null && source.StepInstances.Any(step=>step.Status==Beep.OilandGas.Models.Processes.StepStatus.COMPLETED))
            {
                <CompanyMaintenanceAssignedStage Task="@(new CompanyMaintenanceReceivingQuery(source.InstanceId,source.FieldId,source.EntityId))" SourceRevision="@ProcessDefinitionRevision.FromJson(System.Text.Json.JsonSerializer.Serialize(source))" PermitIssueReference="PermitIssueId" PermitReviewReference="PermitReviewId" PermitDecisionReference="PermitDecisionId" MaterialAllocationReference="MaterialAllocationId" MaterialReleaseReference="MaterialReleaseId" MaterialAcceptanceReference="MaterialAcceptanceId" MaterialAcceptanceInspection="@MaterialInspectionId" />
            }
            else
            {
                <CompanyMaintenanceReceiving Task="@(new CompanyMaintenanceReceivingQuery(source.InstanceId,source.FieldId,source.EntityId))" SourceRevision="@ProcessDefinitionRevision.FromJson(System.Text.Json.JsonSerializer.Serialize(source))" AcceptanceReference="AcceptanceId" />
            }
        }
        else if (_state.IsHseIncident)
        {
            <MudText>Generic state actions are unavailable for an incident. Use its recorded incident workflow for the assigned reviewed stage.</MudText>
        }
        else
        {
        @if (_state.HasUnconfirmedAttempt)
        {
            <MudAlert Severity="Severity.Warning" role="alert">An action was submitted, but its outcome is unconfirmed. Reload recorded history and ask a workflow administrator to investigate. Further actions for this record are blocked on this page. This protection does not survive leaving the page or reconnecting.</MudAlert>
        }
        <MudText Typo="Typo.h6" Class="mt-4">Reviewed actions</MudText>
        <MudButton OnClick="ReviewActions" Disabled="@(_busy || _reviewing)">Review source and available actions</MudButton>
        @if (_actionError is not null) { <MudAlert Severity="Severity.Error">@_actionError</MudAlert> }
        @if (_state.ActionReview is { } review)
        {
            @if (review.Journal is not null)
            {
                <JournalSourceReviewPanel Review="@review" />
            }
            @if(review.WorkOrder is not null){<WorkOrderSourceReviewPanel Review="@review" />}
            <StateTransitionPanel DetailState="@_state" Review="@review" InstanceId="@review.InstanceId" CurrentState="@review.CurrentState" ExpectedRevision="@review.Revision" Transitions="@review.Choices" OnTransitioned="Reload" OnAttemptChanged="AttemptChanged" />
        }
        }
    }
    else { <MudAlert Severity="Severity.Info">Choose the source record's FIELD and reload. No process details are confirmed yet.</MudAlert> }
</MudContainer>
@code {
    [Parameter] public string Id { get; set; }="";
    [SupplyParameterFromQuery(Name="materialAcceptanceId")] public Guid? MaterialAcceptanceId {get;set;}
    [SupplyParameterFromQuery(Name="materialInspectionId")] public string? MaterialInspectionId {get;set;}
    [SupplyParameterFromQuery(Name="materialReleaseId")] public Guid? MaterialReleaseId {get;set;}
    [SupplyParameterFromQuery(Name="materialAllocationId")] public Guid? MaterialAllocationId {get;set;}
    [SupplyParameterFromQuery(Name="acceptanceId")] public Guid? AcceptanceId {get;set;}
    [SupplyParameterFromQuery(Name="permitIssueId")] public Guid? PermitIssueId {get;set;}
    [SupplyParameterFromQuery(Name="permitReviewId")] public Guid? PermitReviewId {get;set;}
    [SupplyParameterFromQuery(Name="permitDecisionId")] public Guid? PermitDecisionId {get;set;}
    private ProcessInstanceDetailState? _state;
    private bool _busy,_disposed,_reloadRequested;
    private string? _loadedId;
        private string? _error, _actionError;
    private bool _reviewing;
    private void AttemptChanged(){if(!_disposed)StateHasChanged();}
    private async Task ReviewActions()
    {
        if(_reviewing || _busy)return;_reviewing=true;_actionError=null;var source=_state?.Instance;var scope=Company.Snapshot;
        try { await _state!.LoadActionsAsync(BusinessProcessClient.GetTransitionReviewAsync); }
        catch(Exception ex){var sentence=Calls.Explain(ex,"reviewing source actions","Source actions could not be confirmed. Reload source details before continuing");if(!_disposed && scope==Company.Snapshot && ReferenceEquals(source,_state?.Instance))_actionError=sentence;}
        finally{_reviewing=false;}
    }
    protected override void OnInitialized()
    {
        _state=new(Company,id=>BusinessProcessClient.GetInstanceAsync(id),id=>BusinessProcessClient.GetHistoryAsync(id));
        Company.Changed+=ContextChanged;Fields.CurrentFieldChanged+=FieldChanged;
    }
    protected override Task OnParametersSetAsync(){if(_loadedId==Id)return Task.CompletedTask;_loadedId=Id;return Reload();}
    private async Task Reload()
    {
        if(_disposed)return;
        if(_busy){_state?.Clear();_reloadRequested=true;return;}
        _busy=true;
        try { do {
            _reloadRequested=false;_error=null;_actionError=null;var scope=Company.Snapshot;var id=Id;
            if(scope.Selection is null){_state?.Clear();break;}
            try { await _state!.LoadAsync(id, () => Fields.GetCurrentFieldIdAsync()); }
            catch(Exception ex){var message=Calls.Explain(ex,"loading the recorded source process","The source process could not be confirmed. Reload before continuing");if(!_disposed && scope==Company.Snapshot && id==Id)_error=message;}
        } while(_reloadRequested && !_disposed); }
        finally{_busy=false;}
    }
    private void FieldChanged(string _) { _state?.Clear();ContextChanged(); }
    private void ContextChanged(){if(!_disposed)_=InvokeAsync(async()=>{await Reload();if(!_disposed)StateHasChanged();});}
    public void Dispose(){_disposed=true;Company.Changed-=ContextChanged;Fields.CurrentFieldChanged-=FieldChanged;_state?.Dispose();}
}
