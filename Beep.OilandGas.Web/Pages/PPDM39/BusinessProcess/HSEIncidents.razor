@page "/ppdm39/hse/incidents"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Beep.OilandGas.Models.Data
@using Beep.OilandGas.Models.Data.HSE
@using Beep.OilandGas.Models.Data.Process
@using Beep.OilandGas.Client.App
@using TheTechIdea.Data.OilGas
@implements IDisposable
@inject CompanyClientContext Company
@inject IFieldSelectionContext Fields
@inject Beep.OilandGas.Web.Services.IBusinessProcessServiceClient BusinessProcessClient
@inject Beep.OilandGas.Web.Services.IHSEServiceClient HSEClient
@inject Beep.OilandGas.Web.Services.IIncidentReportIntentStore ReportIntents
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject ILogger<HSEIncidents> Logger
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider Authentication

<PageTitle>Manage HSE Incidents</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">

    @* ── Header ──────────────────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Manage HSE Incidents</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@_fieldName — Report, track, and close-out field incidents</MudText>
        </MudStack>
        <MudButton OnClick="LoadIncidentsAsync" Variant="Variant.Outlined">Reload incidents</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.AddAlert"
                   Disabled="@(!_loaded || !_canReport || _reporting || _optionsLoading || ReportOutcomeUnconfirmed())"
                   OnClick="OpenReportDialogAsync">
            Report Incident
        </MudButton>
    </MudStack>
    @if (_retainedReport is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            A previous report submission could not be confirmed. Reconcile the original report before preparing another.
            <MudButton OnClick="RetryReportAsync" Disabled="@(_reporting || !_loaded || !_canReport)" Variant="Variant.Outlined">Reconcile original report</MudButton>
        </MudAlert>
    }
    else if (_retentionUnavailable)
    { <MudAlert Severity="Severity.Warning" Class="mb-3">The saved report state is unavailable. Reload this page before reporting an incident.</MudAlert> }


    @if (!string.IsNullOrWhiteSpace(_loadWarning))
    {
        <MudAlert Severity="@(_requiresLogin ? Severity.Info : Severity.Warning)"
                  Variant="Variant.Outlined"
                  Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.body2">@_loadWarning</MudText>
                @if (_requiresLogin)
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Login"
                               Href="@BuildLoginUrl()">
                        Sign In
                    </MudButton>
                }
            </MudStack>
        </MudAlert>
    }

    @if (_loaded)
    {
    @* ── KPI chips ───────────────────────────────────────────────────── *@
    <MudStack Row="true" Spacing="2" Class="mb-4" Wrap="Wrap.Wrap">
        <MudChip T="string" Color="Color.Error"    Icon="@Icons.Material.Filled.Error">Recorded tier 1: @_tier1Count</MudChip>
        <MudChip T="string" Color="Color.Warning"  Icon="@Icons.Material.Filled.Warning">Recorded tier 2: @_tier2Count</MudChip>
        <MudChip T="string" Color="Color.Info"     Icon="@Icons.Material.Filled.Info">Recorded tier 3: @_tier3Count</MudChip>
        <MudChip T="string" Color="Color.Success"  Icon="@Icons.Material.Filled.CheckCircle">Recorded tier 4: @_tier4Count</MudChip>
        <MudDivider Vertical="true" FlexItem="true" />
        <MudChip T="string" Color="Color.Default">Open: @_openCount</MudChip>
        <MudChip T="string" Color="Color.Success">Closed: @_closedCount</MudChip>
        <MudChip T="string" Color="Color.Default">Cancelled: @_cancelledCount</MudChip>
        @if (_unknownStateCount > 0)
        {
            <MudChip T="string" Color="Color.Warning">Other or unrecorded state: @_unknownStateCount</MudChip>
        }
        @if (_missingWorkflowCount > 0)
        {
            <MudChip T="string" Color="Color.Warning" Icon="@Icons.Material.Filled.SyncProblem">
                Missing Workflow: @_missingWorkflowCount
            </MudChip>
        }
    </MudStack>

    @* ── Severity filter ─────────────────────────────────────────────── *@
    <MudPaper Elevation="1" Class="pa-3 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search" Placeholder="Search incidents…"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" />
            <MudSelect T="string" @bind-Value="_tierFilter" Label="Recorded tier">
                <MudSelectItem Value='""'>All Tiers</MudSelectItem>
                <MudSelectItem Value='"1"'>Tier 1</MudSelectItem>
                <MudSelectItem Value='"2"'>Tier 2</MudSelectItem>
                <MudSelectItem Value='"3"'>Tier 3</MudSelectItem>
                <MudSelectItem Value='"4"'>Tier 4</MudSelectItem>
            </MudSelect>
            <MudSelect T="string" @bind-Value="_statusFilter" Label="Status">
                <MudSelectItem Value='""'>All</MudSelectItem>
                <MudSelectItem Value='@IncidentState.Reported'>Reported</MudSelectItem>
                <MudSelectItem Value='@IncidentState.UnderInvestigation'>Under investigation</MudSelectItem>
                <MudSelectItem Value='@IncidentState.PendingRCA'>Pending RCA</MudSelectItem>
                <MudSelectItem Value='@IncidentState.PendingCorrectiveAction'>Pending corrective action</MudSelectItem>
                <MudSelectItem Value='@IncidentState.PendingCloseOut'>Pending close-out</MudSelectItem>
                <MudSelectItem Value='@IncidentState.Closed'>Closed</MudSelectItem>
                <MudSelectItem Value='@IncidentState.Cancelled'>Cancelled</MudSelectItem>
            </MudSelect>
        </MudStack>
    </MudPaper>

    @* ── Grid ────────────────────────────────────────────────────────── *@
    <MudDataGrid T="IncidentRow"
                 Items="@FilteredIncidents"
                 Dense="true"
                 Hover="true"
                 Striped="true"
                 Sortable="true"
                 RowClick="@(e => NavigationManager.NavigateTo($"/ppdm39/hse/incident-detail?incidentId={Uri.EscapeDataString(e.Item.IncidentId)}"))">
        <Columns>
            <PropertyColumn Property="r => r.IncidentDate" Title="Date"         Format="dd-MMM-yy" />
            <PropertyColumn Property="r => r.IncidentType" Title="Type" />
            <PropertyColumn Property="r => r.Description"  Title="Description" />
            <PropertyColumn Property="r => r.Location"     Title="Location" />
            <PropertyColumn Property="r => r.Jurisdiction" Title="Reported jurisdiction" />
            <TemplateColumn Title="Tier" Sortable="false">
                <CellTemplate>
                    <HSEIncidentSeverityBadge Tier="@context.Item.Tier" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Status" Sortable="false">
                <CellTemplate>
                    <StatusBadge Status="@context.Item.Status" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Workflow" Sortable="false">
                <CellTemplate>
                    <MudChip T="string"
                             Variant="Variant.Outlined"
                             Size="Size.Small"
                             Color="@(context.Item.HasWorkflow ? Color.Success : Color.Warning)">
                        @context.Item.WorkflowStatus
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="r => r.ReportedBy"  Title="Reported By" />
            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        @if (_review is not null && _canManage)
                        {
                            <HseWorkflowStart CanStart="@IsOpen(context.Item.Status)" Context="_review" IncidentId="@context.Item.IncidentId" HasWorkflow="@context.Item.HasWorkflow" CanManage="_canManage" OnConfirmed="LoadIncidentsAsync" />
                        }

                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                       Size="Size.Small" Color="Color.Primary"
                                       OnClick='@(() => NavigationManager.NavigateTo($"/ppdm39/hse/incident-detail?incidentId={Uri.EscapeDataString(context.Item.IncidentId)}"))' />
                        <div @onclick:stopPropagation="true"><MudButton Href='@($"/hse/incidents/investigator?incidentId={Uri.EscapeDataString(context.Item.IncidentId)}")' Size="Size.Small" Variant="Variant.Outlined">Review investigator</MudButton></div>
                        <div @onclick:stopPropagation="true"><MudButton Href='@($"/hse/incidents/corrective-plan?incidentId={Uri.EscapeDataString(context.Item.IncidentId)}")' Size="Size.Small" Variant="Variant.Outlined">Corrective action plan</MudButton></div>
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="IncidentRow" />
        </PagerContent>
    </MudDataGrid>
    }

</MudContainer>

@* ── Report Incident dialog ───────────────────────────────────────────────── *@
<MudDialog @bind-IsVisible="_showReportDialog">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.AddAlert" Color="Color.Error" />
            <MudText Typo="Typo.h6">Report Incident</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (_optionsLoading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
            @if (_optionsMessage is not null) { <MudAlert Severity="Severity.Warning">@_optionsMessage</MudAlert> }
            <MudSelect T="IncidentReportOption" @bind-Value="_rOption" ToStringFunc="FormatReportOption" Label="Recorded incident set, type and tier" Variant="Variant.Outlined" Required="true" Disabled="@(_optionsLoading || _reportOptions is null)">
                @if (_reportOptions is not null)
                {
                    @foreach (var option in _reportOptions.Options)
                    { <MudSelectItem T="IncidentReportOption" Value="@option">@option.IncidentSetId · @option.IncidentTypeId · @option.SeverityId</MudSelectItem> }
                }
            </MudSelect>
            <MudTextField @bind-Value="_rIncidentTimestamp" Label="Incident time with UTC offset" HelperText="Use ISO 8601, for example 2026-10-27T15:30+03:00 or 2026-10-27T12:30Z." Variant="Variant.Outlined" Required="true" />
            <MudTextField @bind-Value="_rLocation" Label="Location" Variant="Variant.Outlined" Required="true" />
            <MudTextField @bind-Value="_rJurisdiction" Label="Jurisdiction" Variant="Variant.Outlined" Required="true" MaxLength="128" />
            <MudTextField @bind-Value="_rDescription" Label="Description" Variant="Variant.Outlined"
                          Lines="3" Required="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showReportDialog = false)" Disabled="@_reporting">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Send"
                   Disabled="@(_reporting || _optionsLoading || _reportOptions is null || _rOption is null)"
                   OnClick="SubmitReportAsync">
            @(_reporting ? "Submitting…" : "Submit Report")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string _fieldName = string.Empty;
    private string _search       = string.Empty;
    private string _tierFilter   = string.Empty;
    private string _statusFilter = string.Empty;

    private int _tier1Count = 0;
    private int _tier2Count = 0;
    private int _tier3Count = 0;
    private int _tier4Count = 0;
    private int _openCount  = 0;
    private int _closedCount = 0;
    private int _cancelledCount = 0;
    private int _unknownStateCount = 0;
    private int _missingWorkflowCount = 0;
    private string? _loadWarning;
    private bool _requiresLogin;
    private bool _loaded;
    private bool _canManage;
    private bool _canReport;
    private bool _disposed;
    private long _generation;
    private FieldSelectionReview? _review;
    private IncidentReportIntent? _retainedReport;
    private bool _storageReady, _retentionChecked, _retentionUnavailable;

    private List<IncidentRow> _incidents = new();

    private IEnumerable<IncidentRow> FilteredIncidents => _incidents.Where(i =>
        (string.IsNullOrWhiteSpace(_search) ||
            i.IncidentId.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            i.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true ||
            i.IncidentType?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true ||
            i.Location?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true ||
            i.Jurisdiction?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true ||
            i.WorkflowStatus.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_tierFilter)   || i.Tier   == _tierFilter) &&
        (string.IsNullOrWhiteSpace(_statusFilter) || string.Equals(i.Status, _statusFilter, StringComparison.OrdinalIgnoreCase)));

    private static bool IsOpen(string? status) => status is IncidentState.Reported or IncidentState.UnderInvestigation or
        IncidentState.PendingRCA or IncidentState.PendingCorrectiveAction or IncidentState.PendingCloseOut;

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += ContextChanged;
        Fields.CurrentFieldChanged += FieldChanged;
        Authentication.AuthenticationStateChanged += AuthenticationChanged;
        await LoadIncidentsAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _storageReady = true;
        await RefreshRetainedReportAsync();
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }
    private void FieldChanged(string _) => ContextChanged();
    private void AuthenticationChanged(Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState> _) => ContextChanged();
    private void ContextChanged()
    {
        ++_generation; _loaded=false; _canManage=false; _canReport=false; _review=null; _incidents=new(); _fieldName=string.Empty; _requiresLogin=false;
        _showReportDialog=false; _reportOptions=null; _rOption=null; _retainedReport=null; _retentionChecked=false; _retentionUnavailable=false; _loadWarning="Company or FIELD changed. Reload incidents for the current selection.";
        if(!_disposed) _=InvokeAsync(StateHasChanged);
    }
    public void Dispose()
    {
        _disposed=true; ++_generation; Company.Changed-=ContextChanged; Fields.CurrentFieldChanged-=FieldChanged; Authentication.AuthenticationStateChanged-=AuthenticationChanged;
    }

    private async Task LoadIncidentsAsync()
    {
        _loaded = false;
        _canManage = false;
        _canReport = false;
        _review = null;
        _retainedReport = null; _retentionChecked = false; _retentionUnavailable = false;
        _incidents = new();
        var generation=++_generation; var selected=Company.Snapshot;
        bool Current()=>!_disposed && generation==_generation && selected==Company.Snapshot;
        try
        {
            if(selected.Selection is null){_loadWarning="Choose a company, then reload incidents.";return;}
            var before=await Fields.GetCurrentFieldSelectionAsync();
            if(!Current())return;
            FieldSelectionReviewValidator.RequireCurrent(before,selected.Selection.Scope,selected.Selection.UserId);
            if(!before.SelectionAvailable){_loadWarning="Choose an available FIELD, then reload incidents.";return;}
            var original=before.SelectionContext!;
            var incidentsTask = HSEClient.GetIncidentsAsync();
            var workflowsTask = BusinessProcessClient.GetHseIncidentsAsync();

            await Task.WhenAll(incidentsTask, workflowsTask);

            if(!Current())return;
            var incidents = await incidentsTask ?? throw new InvalidOperationException("The incident population was unavailable.");
            if(incidents.Any(incident=>incident is null || string.IsNullOrWhiteSpace(incident.IncidentId) || incident.FieldId!=original.FieldId) || incidents.Select(incident=>incident.IncidentId).Distinct(StringComparer.Ordinal).Count()!=incidents.Count)
                throw new InvalidOperationException("Incident identities or FIELD could not be confirmed.");
            var after=await Fields.GetCurrentFieldSelectionAsync();if(!Current())return;
            FieldSelectionReviewValidator.RequireCurrent(after,selected.Selection.Scope,selected.Selection.UserId);
            if(!after.SelectionAvailable || after.SelectionContext!=original || after.FieldId!=before.FieldId)throw new InvalidOperationException("The selected FIELD changed during the incident read.");
            _fieldName=before.FieldName ?? before.FieldId;
            var workflowRows=await workflowsTask ?? throw new InvalidOperationException("The incident workflow population was unavailable.");
            if(workflowRows.Count!=incidents.Count || workflowRows.Any(workflow=>workflow is null || workflow.EntityType!="HSE_INCIDENT" || string.IsNullOrWhiteSpace(workflow.EntityId)) ||
                workflowRows.Select(workflow=>workflow.EntityId).Distinct(StringComparer.Ordinal).Count()!=workflowRows.Count ||
                workflowRows.Any(workflow=>!incidents.Any(incident=>incident.IncidentId==workflow.EntityId)))
                throw new InvalidOperationException("The incident and workflow populations could not be correlated.");
            var workflows=workflowRows.ToDictionary(workflow=>workflow.EntityId,StringComparer.Ordinal);

            _incidents = incidents
                .Select(incident =>
                {
                    workflows.TryGetValue(incident.IncidentId, out var workflow);
                    var hasWorkflow = workflow is not null && !string.IsNullOrWhiteSpace(workflow.InstanceId);
                    var reportedBy = hasWorkflow && !string.IsNullOrWhiteSpace(workflow?.StartedBy)
                        ? workflow.StartedBy
                        : "Not recorded";

                    return new IncidentRow(
                        incident.IncidentId,
                        incident.IncidentDate,
                        incident.IncidentType,
                        incident.Description,
                        incident.Location,
                        incident.Jurisdiction,
                        incident.Tier.ToString(),
                        incident.CurrentState,
                        hasWorkflow,
                        hasWorkflow ? "Linked" : "Missing",
                        reportedBy);
                })
                .OrderByDescending(incident => incident.IncidentDate)
                .ToList();

            _tier1Count = _incidents.Count(i => i.Tier == "1");
            _tier2Count = _incidents.Count(i => i.Tier == "2");
            _tier3Count = _incidents.Count(i => i.Tier == "3");
            _tier4Count = _incidents.Count(i => i.Tier == "4");
            _openCount   = _incidents.Count(i => IsOpen(i.Status));
            _closedCount = _incidents.Count(i => i.Status == IncidentState.Closed);
            _cancelledCount = _incidents.Count(i => i.Status == IncidentState.Cancelled);
            _unknownStateCount = _incidents.Count(i => !IsOpen(i.Status) && i.Status != IncidentState.Closed && i.Status != IncidentState.Cancelled);
            _missingWorkflowCount = _incidents.Count(i => !i.HasWorkflow);
            _loadWarning = null;
            _requiresLogin = false;
            var user = (await Authentication.GetAuthenticationStateAsync()).User; if (!Current()) return;
            _canManage = CanManage(user, selected.Selection);
            _canReport = CanReport(user, selected.Selection);
            _review = original;
            _loaded = true;
            if (_storageReady) await RefreshRetainedReportAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
        {
            if(!Current())return;
            _incidents = new();
            _tier1Count = 0;
            _tier2Count = 0;
            _tier3Count = 0;
            _tier4Count = 0;
            _openCount = 0;
            _closedCount = 0;
            _missingWorkflowCount = 0;
            _requiresLogin = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized;
            _loadWarning = _requiresLogin ? "Sign in to load HSE incidents and workflow status for the current field." : "Your current account cannot view incidents for this field.";
        }
        catch (Exception exception)
        {
            if(!Current())return;
            // Failed reads are not an empty incident population.
            Logger.LogWarning(exception, "HSE incidents could not be loaded.");
            _requiresLogin = false;
            _loadWarning = "Could not load HSE incidents.";
            Snackbar.Add("Could not load HSE incidents.", Severity.Warning);
        }
    }

    private async Task RefreshRetainedReportAsync()
    {
        if (!_storageReady || !_loaded || _review is not { } review) return;
        var generation = _generation; var snapshot = Company.Snapshot;
        _retentionChecked = false; _retentionUnavailable = false;
        try
        {
            var retained = await ReportIntents.ReadAsync(review);
            if (_disposed || generation != _generation || snapshot != Company.Snapshot) return;
            _retainedReport = retained; _retentionChecked = true;
        }
        catch (Exception error)
        {
            Logger.LogWarning(error, "Retained incident report could not be loaded");
            if (!_disposed && generation == _generation && snapshot == Company.Snapshot) _retentionUnavailable = true;
        }
    }

    // Sign-in starts at the identity server's client library and comes back here; it went to /login, a page that no
    // longer exists.
    private string BuildLoginUrl() => BeepClientEndpoints.LoginWithReturn(new Uri(NavigationManager.Uri).PathAndQuery);

    // ── Report-incident dialog state ─────────────────────────────────────
    private bool     _showReportDialog  = false;
    private bool     _reporting         = false;
    private bool _optionsLoading;
    private string? _optionsMessage;
    private IncidentReportOptions? _reportOptions;
    private IncidentReportOption? _rOption;
    private static string FormatReportOption(IncidentReportOption? option) => option is null ? string.Empty : $"{option.IncidentSetId} · {option.IncidentTypeId} · {option.SeverityId}";
    private string   _rIncidentTimestamp = string.Empty;
    private string   _rLocation         = string.Empty;
    private string   _rDescription      = string.Empty;
    private string   _rJurisdiction     = string.Empty;

    private async Task OpenReportDialogAsync()
    {
        if (!_loaded || !_canReport || _reporting || _optionsLoading || _review is null || ReportOutcomeUnconfirmed()) return;
        var original = _review; var generation = _generation; var scope = Company.Snapshot;
        _reportOptions = null; _rOption = null; _optionsMessage = null;
        _rIncidentTimestamp = string.Empty;
        _rLocation     = string.Empty;
        _rDescription  = string.Empty;
        _rJurisdiction = string.Empty;
        _showReportDialog = true;
        _optionsLoading = true;
        try
        {
            var options = await BusinessProcessClient.GetHseReportOptionsAsync();
            if (_disposed || generation != _generation || scope != Company.Snapshot) return;
            var current = await Fields.GetCurrentFieldSelectionAsync();
            if (_disposed || generation != _generation || scope != Company.Snapshot) return;
            FieldSelectionReviewValidator.RequireCurrent(current, original.Company, original.ActorUserId);
            if (!current.SelectionAvailable || current.SelectionContext != original || options.Context != original ||
                options.Revision is not { Length: 64 } || options.Revision.Any(c => !char.IsAsciiHexDigit(c) || char.IsAsciiLetterLower(c)) ||
                options.Options is null || options.Options.Any(o => o is null || string.IsNullOrWhiteSpace(o.IncidentSetId) || string.IsNullOrWhiteSpace(o.IncidentTypeId) || o.SeverityId is not ("TIER_1" or "TIER_2" or "TIER_3" or "TIER_4")) ||
                options.Options.Distinct().Count() != options.Options.Count)
                throw new InvalidOperationException("The recorded incident options could not be confirmed.");
            _reportOptions = options;
            if (options.Options.Count == 0) _optionsMessage = "No current incident type and tier combinations are configured for this database.";
        }
        catch (Exception error)
        {
            Logger.LogWarning(error, "Incident report options could not be reviewed");
            if (!_disposed && generation == _generation && scope == Company.Snapshot) _optionsMessage = "Could not review recorded incident options. Close and try again.";
        }
        finally { _optionsLoading = false; }
    }

    private async Task SubmitReportAsync()
    {
        if (_reporting || !_loaded || !_canReport || _review is not { } review || ReportOutcomeUnconfirmed() ||
            Company.Selection is not { } selected || selected.Scope != review.Company || selected.UserId != review.ActorUserId) return;
        if (_reportOptions is null || _reportOptions.Context != review || _rOption is null || !_reportOptions.Options.Contains(_rOption) ||
            string.IsNullOrWhiteSpace(_rDescription) || string.IsNullOrWhiteSpace(_rLocation) || string.IsNullOrWhiteSpace(_rJurisdiction) ||
            !IncidentReportTime.TryParseIncidentTime(_rIncidentTimestamp, out var incidentUtc))
        {
            Snackbar.Add("Choose an incident type and tier, enter the time with its UTC offset, and provide description, location and jurisdiction.", Severity.Warning);
            return;
        }
        var original = new IncidentReportIntent(Guid.NewGuid(), review, _rOption, _reportOptions.Revision,
            incidentUtc, _rLocation.Trim(), _rDescription.Trim(), _rJurisdiction.Trim());
        try { original.Require(); }
        catch (InvalidOperationException) { Snackbar.Add("Check the report details and try again.", Severity.Warning); return; }
        var generation = _generation; var snapshot = Company.Snapshot;
        _reporting = true;
        try
        {
            await RequireReportContextAsync(review, selected, generation, snapshot);
            await ReportIntents.RetainAsync(original);
            if (_disposed || generation != _generation || snapshot != Company.Snapshot) return;
            _retainedReport = original;
            await SendRetainedReportAsync(original, selected, generation, snapshot);
        }
        catch (Exception error)
        {
            Logger.LogWarning(error, "Incident report submission was not confirmed");
            if (!_disposed && generation == _generation && snapshot == Company.Snapshot)
            {
                await RefreshRetainedReportAsync();
                if (!_disposed && generation == _generation && snapshot == Company.Snapshot)
                    Snackbar.Add("Incident submission could not be confirmed. Reconcile the original report before another submission.", Severity.Warning);
            }
        }
        finally { _reporting = false; }
    }

    private async Task RetryReportAsync()
    {
        if (_reporting || !_loaded || !_canReport || _review is not { } review || _retainedReport is not { } original ||
            Company.Selection is not { } selected || selected.Scope != review.Company || selected.UserId != review.ActorUserId) return;
        var generation = _generation; var snapshot = Company.Snapshot; _reporting = true;
        try { await SendRetainedReportAsync(original, selected, generation, snapshot); }
        catch (Exception error)
        {
            Logger.LogWarning(error, "Original incident report could not be reconciled");
            if (!_disposed && generation == _generation && snapshot == Company.Snapshot)
                Snackbar.Add("The original report could not be reconciled. Review the current company, FIELD and incident options.", Severity.Warning);
        }
        finally { _reporting = false; }
    }

    private async Task RequireReportContextAsync(FieldSelectionReview review, CompanyClientSelection selected, long generation,
        (long Version, CompanyClientSelection? Selection) snapshot)
    {
        void Current() { if (_disposed || generation != _generation || snapshot != Company.Snapshot) throw new InvalidOperationException("The reporting context changed."); }
        Current(); var user = (await Authentication.GetAuthenticationStateAsync()).User; Current();
        if (!CanReport(user, selected)) throw new UnauthorizedAccessException();
        var current = await Fields.GetCurrentFieldSelectionAsync(); Current();
        FieldSelectionReviewValidator.RequireCurrent(current, selected.Scope, selected.UserId);
        if (!current.SelectionAvailable || current.SelectionContext != review) throw new InvalidOperationException("The reviewed FIELD changed.");
    }

    private async Task SendRetainedReportAsync(IncidentReportIntent original, CompanyClientSelection selected, long generation,
        (long Version, CompanyClientSelection? Selection) snapshot)
    {
        await RequireReportContextAsync(original.Context, selected, generation, snapshot);
        var receipt = await BusinessProcessClient.RecordHseIncidentAsync(original);
        await RequireReportContextAsync(original.Context, selected, generation, snapshot);
        receipt.Require(original);
        await ReportIntents.ClearAsync(original);
        if (_disposed || generation != _generation || snapshot != Company.Snapshot) return;
        _retainedReport = null; _showReportDialog = false;
        Snackbar.Add("Incident records saved. The workflow has not started; review the incident and start its workflow separately.", Severity.Success);
        await LoadIncidentsAsync();
    }

    private static bool CanManage(System.Security.Claims.ClaimsPrincipal user, CompanyClientSelection selected) =>
        CanUse(user, selected, Beep.OilandGas.Models.Data.Security.PermissionConstants.HSE.ManageIncidents);
    private static bool CanReport(System.Security.Claims.ClaimsPrincipal user, CompanyClientSelection selected) =>
        CanUse(user, selected, Beep.OilandGas.Models.Data.Security.PermissionConstants.HSE.ReportIncident);
    private static bool CanUse(System.Security.Claims.ClaimsPrincipal user, CompanyClientSelection selected, string permission) =>
        user.Identity?.IsAuthenticated == true && user.FindFirst("party_id")?.Value == selected.UserId &&
        selected.Roles.Any(user.IsInRole) && selected.Permissions.Contains(permission, StringComparer.Ordinal);
    private bool ReportOutcomeUnconfirmed() => !_storageReady || !_retentionChecked || _retentionUnavailable || _retainedReport is not null;

    private record IncidentRow(
        string IncidentId, DateTime IncidentDate, string IncidentType,
        string Description, string Location, string Jurisdiction, string Tier,
        string Status, bool HasWorkflow, string WorkflowStatus, string ReportedBy);
}
