@using Beep.OilandGas.Models.Data.Company
@page "/ppdm39/process"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Beep.OilandGas.Web.Components.Workflow

<PageTitle>Company process workspace</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudText Typo="Typo.h4" HtmlTag="h1">Company process workspace</MudText>
    <MudText Class="my-3">Review assigned work, recorded work orders and FIELD obligations for the current company.</MudText>
    <MudAlert Severity="Severity.Info" Class="my-3">Company-wide process, incident and compliance totals are unavailable until their source records and reporting scope are verified.</MudAlert>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="my-3">
        <MudButton Href="/tasks/inbox" Variant="Variant.Filled" Color="Color.Primary">Open assigned work</MudButton>
        <MudButton Href="/ppdm39/process/definitions" Variant="Variant.Outlined">Review process definitions</MudButton>
        <MudButton Href="/ppdm39/compliance/obligations" Variant="Variant.Outlined">Review FIELD obligations</MudButton>
        <MudButton Href="/ppdm39/hse/incidents" Variant="Variant.Outlined">Review incidents</MudButton>
    </MudStack>
    <RecordedWorkOrderOverview />
</MudContainer>
