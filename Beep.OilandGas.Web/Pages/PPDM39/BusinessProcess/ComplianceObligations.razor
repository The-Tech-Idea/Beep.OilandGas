@page "/ppdm39/compliance/obligations"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Beep.OilandGas.Client.App
@using Beep.OilandGas.Web.Services
@using TheTechIdea.Data.OilGas
@implements IDisposable
@inject CompanyClientContext Company
@inject IFieldSelectionContext Fields
@inject IComplianceServiceClient ComplianceClient
@inject ILogger<ComplianceObligations> Logger

<PageTitle>Recorded compliance obligations</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
    <MudText Typo="Typo.h5" HtmlTag="h1">Recorded FIELD obligations</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">Review obligation records explicitly linked to the selected FIELD.</MudText>
    <MudStack Row="true" Spacing="2" Class="mb-3">
        <MudButton OnClick="LoadAsync" Disabled="@_loading" Variant="Variant.Outlined">Refresh records</MudButton>
        <MudButton Href="/ppdm39/compliance/obligations/new" Variant="Variant.Outlined">Record a FIELD obligation</MudButton>
        <MudButton Href="/ppdm39/compliance/report" Variant="Variant.Outlined">Open report workspace</MudButton>
    </MudStack>
    <MudAlert Severity="Severity.Info" Class="mb-3">These are recorded PPDM facts. Critical dates, fulfilled indicators and component types are shown as recorded; they are not a determination of regulatory deadlines, legal status or jurisdiction.</MudAlert>
    @if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
    else if (_review is null) { <MudAlert Severity="Severity.Warning">@_message</MudAlert> }
    else
    {
        <MudText Class="mb-3">@_fieldName · @_review.Obligations.Count recorded obligation(s)</MudText>
        @if (_review.Obligations.Count == 0) { <MudText>No active FIELD-linked obligation records were returned.</MudText> }
        else
        {
            <MudTextField @bind-Value="_search" Label="Search recorded ID, type or description" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-3" />
            @if (!FilteredObligations.Any()) { <MudText>No recorded obligations match the search.</MudText> }
            <MudExpansionPanels MultiExpansion="true">
                @foreach (var row in FilteredObligations)
                {
                    <MudExpansionPanel @key="(row.ObligationId, row.ObligationSequence)">
                        <TitleContent><MudText>@row.ObligationId / @row.ObligationSequence · @(row.ObligationType ?? "Type not recorded")</MudText></TitleContent>
                        <ChildContent>
                            <MudText>Description: @(row.Description ?? "Not recorded")</MudText>
                            <MudText>Recorded critical date: @(row.CriticalDate?.ToString("yyyy-MM-dd") ?? "Not recorded")</MudText>
                            <MudText>Recorded fulfilled indicator: @(row.FulfilledIndicator ?? "Not recorded")</MudText>
                            <MudText>Recorded fulfilled date: @(row.FulfilledDate?.ToString("yyyy-MM-dd") ?? "Not recorded")</MudText>
                            <MudTable T="RecordedObligationComponent" Items="@row.Components" Dense="true">
                                <HeaderContent><MudTh>Component</MudTh><MudTh>Type</MudTh><MudTh>Critical date</MudTh><MudTh>Fulfilled indicator</MudTh><MudTh>Fulfilled date</MudTh><MudTh>Description</MudTh></HeaderContent>
                                <RowTemplate><MudTd>@context.Observation</MudTd><MudTd>@context.ComponentType</MudTd><MudTd>@context.CriticalDate?.ToString("yyyy-MM-dd")</MudTd><MudTd>@context.FulfilledIndicator</MudTd><MudTd>@context.FulfilledDate?.ToString("yyyy-MM-dd")</MudTd><MudTd>@context.Description</MudTd></RowTemplate>
                            </MudTable>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    }
</MudContainer>
@code {
    private FieldObligationSourceReview? _review;
    private string _fieldName = "", _message = "Choose a company and FIELD, then load obligations.";
    private string _search = "";
    private IEnumerable<RecordedFieldObligation> FilteredObligations => _review?.Obligations.Where(row => string.IsNullOrWhiteSpace(_search) || row.ObligationId.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) || (row.ObligationType?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false) || (row.Description?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)) ?? [];
    private static bool ValidObservation(decimal value) => value >= 0 && decimal.Truncate(value) == value;
    private bool _loading, _disposed;
    private long _generation;
    protected override async Task OnInitializedAsync() { Company.Changed += ContextChanged; Fields.CurrentFieldChanged += FieldChanged; await LoadAsync(); }
    private async Task LoadAsync()
    {
        _review = null; _fieldName = ""; _loading = true; var generation = ++_generation; var selected = Company.Snapshot;
        bool Current() => !_disposed && generation == _generation && selected == Company.Snapshot;
        try
        {
            if (selected.Selection is null) { _message = "Choose a company and FIELD, then load obligations."; return; }
            var before = await Fields.GetCurrentFieldSelectionAsync(); if (!Current()) return;
            FieldSelectionReviewValidator.RequireCurrent(before, selected.Selection.Scope, selected.Selection.UserId);
            if (!before.SelectionAvailable) { _message = "Choose an available FIELD, then load obligations."; return; }
            var source = await ComplianceClient.GetRecordedFieldObligationsAsync(); if (!Current()) return;
            var after = await Fields.GetCurrentFieldSelectionAsync(); if (!Current()) return;
            FieldSelectionReviewValidator.RequireCurrent(after, selected.Selection.Scope, selected.Selection.UserId);
            if (!after.SelectionAvailable || after.SelectionContext != before.SelectionContext || source is null || source.Context != before.SelectionContext || source.Obligations is null ||
                source.Obligations.Any(row => row is null || !LeaseSummaryValidator.Identifier(row.ObligationId) || !ValidObservation(row.ObligationSequence) || row.Components is null || row.Components.Count == 0 || row.Components.Any(link => link is null || !ValidObservation(link.Observation)) || row.Components.Select(link => link.Observation).Distinct().Count() != row.Components.Count) ||
                source.Obligations.Select(row => (row.ObligationId, row.ObligationSequence)).Distinct().Count() != source.Obligations.Count)
                throw new InvalidOperationException("The recorded obligation evidence or selected FIELD could not be confirmed.");
            _review = source; _fieldName = string.IsNullOrWhiteSpace(before.FieldName) ? before.FieldId : before.FieldName;
        }
        catch (Exception error) { if (Current()) { Logger.LogWarning(error, "Could not confirm FIELD obligation evidence"); _message = "Obligations could not be confirmed for the current company and FIELD."; } }
        finally { if (Current()) _loading = false; }
    }
    private void FieldChanged(string _) => ContextChanged();
    private void ContextChanged() { ++_generation; _review = null; _loading = false; _fieldName = ""; _search = ""; _message = "Company or FIELD changed. Refresh obligations for the current selection."; if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    public void Dispose() { _disposed = true; ++_generation; Company.Changed -= ContextChanged; Fields.CurrentFieldChanged -= FieldChanged; }
}
