@page "/ppdm39/analytics/reserves"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "ReservesEngineer,Manager,Admin")]

<PageTitle>Reserves maturation</PageTitle>
<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    <MudText Typo="Typo.h4" HtmlTag="h1">Reserves maturation</MudText>
    <MudAlert Severity="Severity.Info" Class="my-3">Reserves maturation is unavailable until reviewed company and field reserves records, categories and reporting dates are available.</MudAlert>
    <MudButton Href="/tasks/inbox" Variant="Variant.Outlined">Open company inbox</MudButton>
</MudContainer>
