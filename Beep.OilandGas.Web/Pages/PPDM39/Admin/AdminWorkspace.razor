@page "/admin/dashboard"
@using MudBlazor
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true"><MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Class="mr-2" Color="Color.Primary" />System Administration</MudText>

    <MudGrid>
        <MudItem xs="12" sm="6" md="3"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Users & Access</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudButton Variant="Variant.Outlined" FullWidth="true" Href="/admin/access-control/user-roles">User Roles</MudButton><MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-2" Href="/admin/access-control/asset-access">Asset Access</MudButton><MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-2" Href="/admin/access-control/hierarchy-config">Hierarchy Config</MudButton></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Data Management</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudButton Variant="Variant.Outlined" FullWidth="true" Href="/ppdm39/data-management">Data Hub</MudButton><MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-2" Href="/ppdm39/data-management/schema">Schema Management</MudButton><MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-2" Href="/ppdm39/data-quality">Data Quality</MudButton></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Database Setup</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudButton Variant="Variant.Outlined" FullWidth="true" Href="/ppdm39/setup">Setup Wizard</MudButton><MudButton Variant="Variant.Filled" FullWidth="true" Class="mt-2" Color="Color.Primary" Href="/ppdm39/setup/beep-wizard">BeepDM Setup (NEW)</MudButton><MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-2" Href="/ppdm39/database-management">Database Management</MudButton><MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-2" Href="/ppdm39/sync">Sync Dashboard</MudButton><MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-2" Href="/uc_dataset_studio">DataSet Studio Hub</MudButton></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Process & Audit</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudButton Variant="Variant.Outlined" FullWidth="true" Href="/ppdm39/process">Process Dashboard</MudButton><MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-2" Href="/ppdm39/process/definitions">Process Definitions</MudButton><MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-2" Href="/data/audit">Audit Trail</MudButton></MudCardContent></MudCard></MudItem>
    </MudGrid>
</MudContainer>
