@page "/ppdm39/workorder"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Beep.OilandGas.Models.Data.WorkOrder
@using Beep.OilandGas.Web.Services
@inject TheTechIdea.Data.OilGas.IFieldSelectionContext DataManagement
@inject Beep.OilandGas.Client.App.CompanyClientContext Company
@inject OilGasCallFailures Calls
@implements IDisposable
@inject IWorkOrderServiceClient WorkOrderService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Work Order Dashboard</PageTitle>

<MudStack Spacing="3">

    @* ── Header ──────────────────────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Manage Work Orders</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @(_state?.FieldId ?? "No confirmed FIELD")
            </MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2">
            @if (!string.IsNullOrWhiteSpace(ReturnTo))
            {
                <MudButton StartIcon="@Icons.Material.Outlined.ArrowBack"
                           Variant="Variant.Outlined" Color="Color.Secondary"
                           Href="@ReturnTo">
                    Back to Optimizer
                </MudButton>
            }
            <MudIconButton Icon="@Icons.Material.Outlined.CalendarMonth"
                           Href="/ppdm39/workorder/calendar"
                           Title="Calendar view" Color="Color.Default" />
            <MudButton StartIcon="@Icons.Material.Outlined.AddCircleOutline"
                       Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="OpenCreateDialog">
                New Work Order
            </MudButton>
        </MudStack>
    </MudStack>

    <PersonaTaskInbox WorkspaceRoutes='@(new[]{"/ppdm39/workorder"})' />

    <FieldSelector />

    @* ── Filter row ───────────────────────────────────────────────────────── *@
    <MudStack Class="pa-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
            <MudSelect T="string?" Label="Sub-type" Value="@_filterSubType" ValueChanged="FilterChanged"
                       Clearable="true" Dense="true" Margin="Margin.Dense">
                <MudSelectItem Value="@((string?)null)">All types</MudSelectItem>
                <MudSelectItem Value="@WorkOrderSubType.Preventive">Preventive</MudSelectItem>
                <MudSelectItem Value="@WorkOrderSubType.Corrective">Corrective</MudSelectItem>
                <MudSelectItem Value="@WorkOrderSubType.Safety">Safety Critical</MudSelectItem>
                <MudSelectItem Value="@WorkOrderSubType.Environmental">Environmental</MudSelectItem>
                <MudSelectItem Value="@WorkOrderSubType.RegulatoryInspect">Regulatory Inspect</MudSelectItem>
                <MudSelectItem Value="@WorkOrderSubType.Turnaround">Turnaround</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.FilterList"
                       OnClick="LoadWorkOrders">Apply</MudButton>
        </MudStack>
    </MudStack>

    <MudAlert Severity="Severity.Info">Recorded WORK_ORDER headers identify work and dates; they do not establish workflow state, approval, costs or inspection acceptance.</MudAlert>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_state?.Confirmed == true)
    {
        <MudText>Company: @Company.Selection?.Scope.TenantId / @Company.Selection?.Scope.BusinessAssociateId</MudText>
        <WorkOrderQueuePanel Review="@_state" />
    }

    @if (!_loading && _state?.Confirmed!=true && _error is null)
    {
        <MudAlert Severity="Severity.Info">Select a company and FIELD, then reload. No work-order list is confirmed yet.</MudAlert>
    }
    @if (_creation?.IsBlocked(_state?.FieldId)==true)
    {
        <MudAlert Severity="Severity.Warning">A create attempt in this company and FIELD has an unconfirmed outcome. Review recorded orders. Repeating creation here is blocked for this page session; leaving the page does not resolve the outcome.</MudAlert>
    }
    @* ── Error snackbar ───────────────────────────────────────────────────── *@
    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" ShowCloseIcon="true"
                  CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
    }

</MudStack>

@* ── Create dialog ─────────────────────────────────────────────────────────── *@
<MudDialog @bind-IsVisible="_showCreate" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Create Work Order</MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info">Company @Company.Selection?.Scope.BusinessAssociateId · FIELD @_create.FieldId. A missing response leaves the creation outcome unconfirmed.</MudAlert>
        <MudForm @ref="_createForm" @bind-IsValid="_createValid" Disabled="_creating">
            <MudStack Spacing="2">
                <MudTextField @bind-Value="_create.WorkOrderNumber" Label="Recorded work-order number" Required="true" RequiredError="Recorded number is required" />
                <MudTextField @bind-Value="_create.InstanceName" Label="Title"
                              Required="true" RequiredError="Title is required" />
                <MudTextField @bind-Value="_create.Description" Label="Description"
                              Lines="3" />
                <MudSelect T="string" Label="Sub-type" @bind-Value="_create.WoSubType" Required="true">
                    <MudSelectItem Value="@WorkOrderSubType.Preventive">Preventive</MudSelectItem>
                    <MudSelectItem Value="@WorkOrderSubType.Corrective">Corrective</MudSelectItem>
                    <MudSelectItem Value="@WorkOrderSubType.Safety">Safety Critical</MudSelectItem>
                    <MudSelectItem Value="@WorkOrderSubType.Environmental">Environmental</MudSelectItem>
                    <MudSelectItem Value="@WorkOrderSubType.RegulatoryInspect">Regulatory Inspect</MudSelectItem>
                    <MudSelectItem Value="@WorkOrderSubType.Turnaround">Turnaround</MudSelectItem>
                </MudSelect>
                <MudTextField @bind-Value="_create.Jurisdiction" Label="Reported jurisdiction (stored with instructions)"
                              Required="true" RequiredError="Jurisdiction is required" HelperText="Enter the applicable authority; no country is assumed." />
                <MudTextField @bind-Value="_create.WellId" Label="Recorded well UWI (optional)" />
                <MudTextField @bind-Value="_create.EquipmentId" Label="Recorded equipment ID (optional)" />
                <MudAlert Severity="Severity.Info">This saves a header and FIELD relationship. Scheduling, inspection templates and workflow approval are separate recorded actions.</MudAlert>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showCreate = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(!_createValid || _creating || _creation?.IsBlocked(_state?.FieldId)==true)" OnClick="SubmitCreateAsync">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [SupplyParameterFromQuery(Name = "wellId")]
    public string? WellId { get; set; }

    [SupplyParameterFromQuery(Name = "openCreate")]
    public bool OpenCreate { get; set; }

    [SupplyParameterFromQuery(Name = "subType")]
    public string? SuggestedSubType { get; set; }

    [SupplyParameterFromQuery(Name = "title")]
    public string? SuggestedTitle { get; set; }

    [SupplyParameterFromQuery(Name = "description")]
    public string? SuggestedDescription { get; set; }

    [SupplyParameterFromQuery(Name = "linkAfe")]
    public bool LinkAfeOnCreate { get; set; }

    [SupplyParameterFromQuery(Name = "returnTo")]
    public string? ReturnTo { get; set; }

    private WorkOrderCreateState? _creation;
    private bool _creating;
    private WorkOrderListState? _state;
    private bool _disposed,_reloadRequested;
    private string?                _filterSubType;
    private bool                   _loading;
    private string?                _error;

    // Create dialog
    private bool                   _showCreate;
    private bool                   _createValid;
    private MudForm?               _createForm;
    private CreateWorkOrderRequest _create = new();
    private DialogOptions          _dialogOptions = new() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        _creation=new(Company);_state=new(Company);Company.Changed+=ContextChanged;DataManagement.CurrentFieldChanged+=FieldChanged;
        if (!string.IsNullOrWhiteSpace(SuggestedSubType))
            _filterSubType = SuggestedSubType;

        await LoadWorkOrders();

        if (OpenCreate && _state?.Confirmed==true)
            OpenCreateDialogFromRecommendation();
    }

    private async Task LoadWorkOrders()
    {
        if(_disposed)return;if(_loading){_state?.Clear();_reloadRequested=true;return;}_loading=true;
        try{do{
            _reloadRequested=false;_error=null;var scope=Company.Snapshot;var version=_state!.Version+1;
            try{await _state.LoadAsync(_filterSubType,()=>DataManagement.GetCurrentFieldIdAsync(),subtype=>WorkOrderService.GetWorkOrdersAsync(woSubType:subtype));}
            catch(Exception ex){var sentence=Calls.Explain(ex,"loading recorded work orders","Work orders could not be confirmed. Reload before continuing");if(!_disposed && scope==Company.Snapshot && version==_state.Version)_error=sentence;}
        }while(_reloadRequested && !_disposed);}finally{_loading=false;}
    }
    private void FilterChanged(string? value){_filterSubType=value;_state?.Clear();_error=null;}
    private void FieldChanged(string _) => ContextChanged();
    private void ContextChanged(){_state?.Clear();_error=null;_showCreate=false;if(!_disposed)_=InvokeAsync(async()=>{await LoadWorkOrders();if(!_disposed)StateHasChanged();});}
    public void Dispose(){_disposed=true;Company.Changed-=ContextChanged;DataManagement.CurrentFieldChanged-=FieldChanged;_state?.Dispose();}

    private void OpenDetail(string instanceId) =>
        NavigationManager.NavigateTo(WorkOrderNavigation.Detail(instanceId));

    private void OpenCreateDialog()
    {
        if(_state?.Confirmed!=true)return;
        _create     = new CreateWorkOrderRequest { FieldId=_state.FieldId!, WoSubType = WorkOrderSubType.Preventive };
        _showCreate = true;
    }

    private void OpenCreateDialogFromRecommendation()
    {
        if(_state?.Confirmed!=true)return;
        _create = new CreateWorkOrderRequest
        {
            FieldId=_state.FieldId!,
            WoSubType = !string.IsNullOrWhiteSpace(SuggestedSubType) ? SuggestedSubType : WorkOrderSubType.Corrective,
            InstanceName = SuggestedTitle ?? string.Empty,
            WellId = WellId ?? string.Empty,
            Description = SuggestedDescription ?? string.Empty
        };
        _showCreate = true;
    }

    private async Task SubmitCreateAsync()
    {
        if (_creating || _state?.Confirmed!=true || !_showCreate) return;
        var scope=Company.Snapshot;var field=_state.FieldId;var draft=_create;
        _creating=true;
        WorkOrderCreateState.Attempt? attempt=null;
        try
        {
            if (_createForm is not null) await _createForm.ValidateAsync();
            if (!_createValid || scope!=Company.Snapshot || field!=_state.FieldId || !ReferenceEquals(draft,_create) || !_showCreate) return;
            attempt=_creation!.Begin(draft,field!);
            var created=await WorkOrderService.CreateWorkOrderAsync(attempt.Request);
            _creation.Confirm(attempt,created);
            if (_disposed || !_creation.IsCurrent(attempt,_state.FieldId)) return;
            _showCreate=false;
            Snackbar.Add($"Recorded header {created!.InstanceId} returned. Review its detail before planning or financial actions.",Severity.Success);
            if(LinkAfeOnCreate) Snackbar.Add("Review and link the AFE from the recorded order detail.",Severity.Info);
            NavigationManager.NavigateTo(WorkOrderNavigation.Detail(created.InstanceId));
        }
        catch(Exception ex)
        {
            var message=Calls.Explain(ex,"creating a recorded work order","Creation could not be confirmed. Review recorded orders before retrying");
            if(!_disposed && scope==Company.Snapshot && field==_state?.FieldId) _error=message;
        }
        finally { _creating=false; }
    }

}
