@page "/drilling/workspace"
@page "/drilling/dashboard"
@using MudBlazor
@using Beep.OilandGas.Web.Components.Workflow
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Drilling engineer workspace</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">Drilling engineer workspace</MudText>
    <MudText Class="mb-4">Review assigned work, prepare design and investment evidence, then follow execution through handover.</MudText>

    <PersonaTaskInbox WorkspaceRoutes='@(new[]{"/drilling/workspace","/drilling/dashboard"})' />

    <MudAlert Severity="Severity.Info" Class="mb-4">Drilling performance, budget and downtime totals are unavailable here. Open the source screens to review recorded values, reporting periods, units and currency.</MudAlert>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="4">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Prepare design and program</MudText>
                    <MudText Class="mb-3">Review well evidence and design before preparing the development program.</MudText>
                    <MudStack Spacing="2">
                        <MudButton Href="/ppdm39/wells/search" Variant="Variant.Outlined">Find well evidence</MudButton>
                        <MudButton Href="/ppdm39/wells/compare" Variant="Variant.Outlined">Compare offset wells</MudButton>
                        <MudButton Href="/development/well-design" Variant="Variant.Outlined">Review well designs</MudButton>
                        <MudButton Href="/development/well-design/new" Variant="Variant.Outlined">Prepare funded program draft</MudButton>
                        <MudButton Href="/development/fdp" Variant="Variant.Outlined">Open development plans</MudButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Review investment and assignments</MudText>
                    <MudText Class="mb-3">Check the recorded AFE and open the assigned process to review its source and permitted next action.</MudText>
                    <MudStack Spacing="2">
                        <MudButton Href="/economics/afe" Variant="Variant.Outlined">Review AFE records</MudButton>
                        <MudButton Href="/tasks/inbox" Variant="Variant.Outlined">Open task inbox</MudButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Follow execution and handover</MudText>
                    <MudText Class="mb-3">Open the saved program and its recorded approval to inspect execution or report an actual start. From the recorded execution, review configured reporting responsibility; open your original receiving task in the company inbox. Ongoing responsibility counts do not imply a daily-report deadline or observed progress. Construction progress, well status and production handover remain separate recorded evidence.</MudText>
                    <MudStack Spacing="2">
                        <MudButton Href="/ppdm39/operations/drillingoperations" Variant="Variant.Outlined">Open drilling operations</MudButton>
                        <MudButton Href="/development/construction" Variant="Variant.Outlined">Review construction progress</MudButton>
                        <MudButton Href="/ppdm39/wells/wellbores" Variant="Variant.Outlined">Inspect wellbores</MudButton>
                        <MudButton Href="/ppdm39/well-details/status" Variant="Variant.Outlined">Review well status</MudButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>
