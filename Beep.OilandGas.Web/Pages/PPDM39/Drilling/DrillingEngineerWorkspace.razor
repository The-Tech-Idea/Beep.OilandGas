@page "/drilling/workspace"
@using MudBlazor
@inject ApiClient ApiClient
@inject OilGasCallFailures Calls

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true"><MudIcon Icon="@Icons.Material.Filled.Construction" Class="mr-2" Color="Color.Primary"/>Drilling Engineer Workspace</MudText>
    @if(_loadError is not null){<MudAlert Severity="Severity.Warning" Class="mb-4">@_loadError</MudAlert>}
    @if(_loading){<MudProgressLinear Indeterminate="true" Class="my-4"/>}else{
    @* A figure no record holds reads "Not recorded", never 0: the AFE budget is the drilling programmes' AFE cost against
       the cost their daily drilling reports state, and NPT is the hours those reports give this month. *@
    <MudGrid>
        <MudItem xs="6" md="3"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">Total Wells</MudText><MudText Typo="Typo.h4" Color="Color.Primary">@_kpi?.TotalWells.ToString("N0")</MudText><MudText Typo="Typo.caption">drilled</MudText></div><MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Color="Color.Primary" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
        <MudItem xs="6" md="3"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">Producing Wells</MudText><MudText Typo="Typo.h4" Color="Color.Success">@_kpi?.ProducingWells.ToString("N0")</MudText><MudText Typo="Typo.caption">status PRODUCING</MudText></div><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
        <MudItem xs="6" md="3"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">AFE Budget</MudText>@if(_kpi?.AfeBudget is decimal budget){<MudText Typo="Typo.h4" Color="Color.Info">@FormatAmount(budget)</MudText><MudText Typo="Typo.caption">@((_kpi.AfeSpent is decimal spent) ? $"vs {FormatAmount(spent)} reported" : "no cost reported")</MudText>}else{<MudText Typo="Typo.h6" Color="Color.Secondary">Not recorded</MudText><MudText Typo="Typo.caption">no programme AFE</MudText>}</div><MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Info" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
        <MudItem xs="6" md="3"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">NPT</MudText>@if(_kpi?.NptHours is decimal npt){<MudText Typo="Typo.h4" Color="@(npt>20?Color.Error:Color.Warning)">@($"{npt:F0}h")</MudText>}else{<MudText Typo="Typo.h6" Color="Color.Secondary">Not recorded</MudText>}<MudText Typo="Typo.caption">this month</MudText></div><MudIcon Icon="@Icons.Material.Filled.TimerOff" Color="Color.Warning" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
    </MudGrid>
    <MudGrid>
        <MudItem xs="12" md="5"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Build" Class="mr-1" Size="Size.Small"/>Drilling Tools</MudText></CardHeaderContent></MudCardHeader><MudCardContent Class="pa-2"><MudGrid>
        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/development/well-design">Well Design</MudButton></MudItem>
        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/ppdm39/operations/drillingoperations">Drilling Operations</MudButton></MudItem>
        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/ppdm39/wells/search">Offset Well Search</MudButton></MudItem>
        <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Href="/ppdm39/wells/compare">Compare Wells</MudButton></MudItem>
    </MudGrid></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" md="7"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.History" Class="mr-1" Size="Size.Small"/>Drilling Monitoring</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/development">Dev Dashboard</MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/development/fdp">FDP Wizard</MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/ppdm39/wells/wellbores">Wellbores</MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/ppdm39/well-details/status">Well Status</MudButton>
    </MudStack></MudCardContent></MudCard>
        @* No source of drilling attention items in the API (no AFE-spend alert, no completion-design approval queue): the "Attention Required" card's two alerts were constants and are gone. *@
    </MudItem></MudGrid>}
</MudContainer>

@code{private bool _loading=true;private DrillingEngineerKpi? _kpi;private string? _loadError;
protected override async Task OnInitializedAsync()
{
    // Through ApiClient, which carries the API's address and the person's token: the unnamed HttpClient this page used
    // has neither, so every load failed and the catch showed zeros.
    try{_kpi=await ApiClient.GetAsync<DrillingEngineerKpi>("/api/drilling/engineer/kpi")??new();}
    // A failed call says the figures did not load, rather than showing zeros; anything else reaches the page's error boundary.
    catch(Exception failure) when (OilGasCallFailures.IsCallFailure(failure)){_loadError=Calls.Explain(failure,"loading the drilling engineer workspace figures","The drilling engineer workspace figures could not be loaded");}
    finally{_loading=false;}
}
// The amount in the programmes' AFE currency when they record one; no currency is assumed (it had printed "$").
private string FormatAmount(decimal v)
{
    var amount=Math.Abs(v)>=1_000_000?$"{v/1_000_000m:F1}M":v.ToString("N0");
    return string.IsNullOrWhiteSpace(_kpi?.AfeCurrency)?amount:$"{amount} {_kpi.AfeCurrency}";
}
// The API's DrillingEngineerKpi: a null figure is one nothing records.
public class DrillingEngineerKpi{public int TotalWells{get;set;}public int ProducingWells{get;set;}public decimal? AfeBudget{get;set;}public decimal? AfeSpent{get;set;}public string? AfeCurrency{get;set;}public decimal? NptHours{get;set;}}}
