@page "/ppdm39/compliance/obligation/{ObligationId}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Beep.OilandGas.Client.App
@using Beep.OilandGas.Models.Data.Compliance
@using Beep.OilandGas.Web.Services
@using TheTechIdea.Data.OilGas
@implements IDisposable
@inject CompanyClientContext Company
@inject IFieldSelectionContext Fields
@inject IComplianceServiceClient ComplianceClient
@inject ILogger<ObligationDetail> Logger

<PageTitle>Compliance obligation</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    <MudButton Href="/ppdm39/compliance/obligations" Variant="Variant.Text">Back to obligations</MudButton>
    <MudText Typo="Typo.h5" HtmlTag="h1">Obligation detail</MudText>
    @if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
    else if (_detail is null)
    {
        <MudAlert Severity="Severity.Warning" Class="my-3">@_message</MudAlert>
        <MudButton OnClick="LoadAsync" Variant="Variant.Outlined">Reload obligation</MudButton>
    }
    else
    {
        <MudText Class="my-3">@_fieldName · @_detail.ObligationId</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6"><MudCard Outlined="true"><MudCardContent>
                <MudText Typo="Typo.h6" HtmlTag="h2">Recorded details</MudText>
                <MudSimpleTable Dense="true"><tbody>
                    <tr><td>Type</td><td>@_detail.ObligType</td></tr>
                    <tr><td>Jurisdiction</td><td>@_detail.JurisdictionCode</td></tr>
                    <tr><td>Status</td><td>@_detail.ObligStatus</td></tr>
                    <tr><td>Due date</td><td>@_detail.DueDate.ToString("yyyy-MM-dd")</td></tr>
                    <tr><td>Fulfilled</td><td>@(_detail.FulfillDate?.ToString("yyyy-MM-dd") ?? "Not recorded")</td></tr>
                    <tr><td>Period</td><td>@(_detail.ReportingPeriodStart?.ToString("yyyy-MM-dd") ?? "Not recorded") – @(_detail.ReportingPeriodEnd?.ToString("yyyy-MM-dd") ?? "Not recorded")</td></tr>
                    <tr><td>Description</td><td>@_detail.Description</td></tr>
                </tbody></MudSimpleTable>
            </MudCardContent></MudCard></MudItem>
            <MudItem xs="12" md="6"><MudCard Outlined="true"><MudCardContent>
                <MudText Typo="Typo.h6" HtmlTag="h2">Recorded payments</MudText>
                @if (_detail.Payments.Count == 0) { <MudText>No payments returned for this obligation.</MudText> }
                else { <MudTable T="ObligationPayment" Items="@_detail.Payments" Dense="true"><HeaderContent><MudTh>Date</MudTh><MudTh>Type</MudTh><MudTh>Currency</MudTh><MudTh>Amount</MudTh></HeaderContent><RowTemplate><MudTd>@context.PaymentDate.ToString("yyyy-MM-dd")</MudTd><MudTd>@context.PaymentType</MudTd><MudTd>@context.PaymentCurrency</MudTd><MudTd>@context.ActualAmt</MudTd></RowTemplate></MudTable> }
            </MudCardContent></MudCard></MudItem>
        </MudGrid>
        <MudAlert Severity="Severity.Info" Class="mt-3">Submission, waiver and payment changes require a reviewed obligation workflow.</MudAlert>
    }
</MudContainer>
@code {
    [Parameter] public string ObligationId { get; set; } = string.Empty;
    private string _loadedId = "", _fieldName = "", _message = "Select an obligation.";
    private ObligationDetailModel? _detail;
    private bool _loading, _disposed;
    private long _generation;
    protected override void OnInitialized() { Company.Changed += ContextChanged; Fields.CurrentFieldChanged += FieldChanged; }
    protected override async Task OnParametersSetAsync() { if (ObligationId != _loadedId) { _loadedId = ObligationId; await LoadAsync(); } }
    private async Task LoadAsync()
    {
        _detail = null; _fieldName = ""; _loading = true; var generation = ++_generation; var selected = Company.Snapshot; var id = ObligationId;
        bool Current() => !_disposed && generation == _generation && selected == Company.Snapshot && ObligationId == id;
        try
        {
            if (selected.Selection is null || !LeaseSummaryValidator.Identifier(id)) { _message = "Choose a company, FIELD and exact obligation."; return; }
            var before = await Fields.GetCurrentFieldSelectionAsync(); if (!Current()) return;
            FieldSelectionReviewValidator.RequireCurrent(before, selected.Selection.Scope, selected.Selection.UserId);
            if (!before.SelectionAvailable) { _message = "Choose an available FIELD."; return; }
            var detail = await ComplianceClient.GetObligationAsync(id); if (!Current()) return;
            var after = await Fields.GetCurrentFieldSelectionAsync(); if (!Current()) return;
            FieldSelectionReviewValidator.RequireCurrent(after, selected.Selection.Scope, selected.Selection.UserId);
            if (!after.SelectionAvailable || after.SelectionContext != before.SelectionContext || detail is not null && (detail.ObligationId != id || detail.FieldId != before.FieldId || detail.Payments is null || detail.Payments.Any(payment => payment.ObligationId != id)))
                throw new InvalidOperationException("The obligation, payment or selected FIELD could not be confirmed.");
            if (detail is null) { _message = "The obligation is unavailable in the current FIELD."; return; }
            _detail = detail; _fieldName = string.IsNullOrWhiteSpace(before.FieldName) ? before.FieldId : before.FieldName;
        }
        catch (Exception error) { if (Current()) { Logger.LogWarning(error, "Could not confirm obligation detail"); _message = "The obligation detail could not be confirmed for the current company and FIELD."; } }
        finally { if (Current()) _loading = false; }
    }
    private void FieldChanged(string _) => ContextChanged();
    private void ContextChanged() { ++_generation; _detail = null; _fieldName = ""; _loading = false; _message = "Company or FIELD changed. Reload the obligation for the current selection."; if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    public void Dispose() { _disposed = true; ++_generation; Company.Changed -= ContextChanged; Fields.CurrentFieldChanged -= FieldChanged; }
}
