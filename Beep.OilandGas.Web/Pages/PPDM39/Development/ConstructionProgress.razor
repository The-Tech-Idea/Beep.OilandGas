@using Beep.OilandGas.Models.Data.WorkOrder
@using Beep.OilandGas.PPDM39.DataManagement.Models
@using Beep.OilandGas.Models.Core.Interfaces
@using Beep.OilandGas.Models.Data.Company
@page "/development/construction"
@page "/development"
@page "/facilities/dashboard"
@page "/lifecycle/facilities/dashboard"
@page "/lifecycle/development/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Globalization
@using Beep.OilandGas.Client.App
@using Beep.OilandGas.Models.Data
@using Beep.OilandGas.PPDM39.Models
@using Beep.OilandGas.Web.Services
@using Beep.OilandGas.Web.Components.Workflow
@implements IDisposable
@inject CompanyClientContext Company
@inject IFieldSelectionContext Fields
@inject IDevelopmentServiceClient Development
@inject OilGasCallFailures Calls

<PageTitle>Construction and handover evidence</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    <MudText Typo="Typo.h4" HtmlTag="h1">Construction and handover evidence</MudText>
    <MudText Class="my-3">Review the recorded sources for your company and field before making a construction or handover decision.</MudText>
    <MudAlert Severity="Severity.Info" Class="mb-4" role="status">A qualified construction progress and handover record is not yet available here. Schedule, budget variance, safety totals, punch-list counts and first-oil dates cannot be determined from the available evidence.</MudAlert>
    <PersonaTaskInbox WorkspaceRoutes='@(new[]{"/development/construction", "/facilities/dashboard", "/lifecycle/facilities/dashboard", "/lifecycle/development/dashboard"})' />
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" HtmlTag="h2">Recorded facilities for this FIELD</MudText>
        <MudText Class="my-2">Use these source records to choose what to review. A facility row does not establish construction progress or handover acceptance.</MudText>
        @if(Company.Selection is null)
        {
            <MudAlert Severity="Severity.Info">Choose a company to review its facility records.</MudAlert>
        }
        else if(!CanViewFacilities())
        {
            <MudAlert Severity="Severity.Info">Your current company role does not have permission to view development facility records.</MudAlert>
        }
        else
        {
            <MudButton OnClick="ReloadFacilities" Disabled="@(_facilities?.Loading == true)" Variant="Variant.Outlined">Reload facility records</MudButton>
            @if(_facilities?.Loading==true){<MudProgressLinear Indeterminate="true" aria-label="Loading facility records" />}
            else if(_facilities?.Error is {} error){<MudAlert Severity="Severity.Error" role="alert">@error</MudAlert>}
            else if(_facilities?.NeedsField==true){<MudAlert Severity="Severity.Info">Choose an available FIELD, then reload facility records.</MudAlert>}
            else if(_facilities?.Loaded==true && _facilities.Review is {} review)
            {
                <MudText Class="my-2">Company @review.Company.BusinessAssociateId · FIELD @review.FieldId · @Recorded(_facilities.FieldName)</MudText>
                <MudText Typo="Typo.caption">Recorded facility source checked @_facilities.LoadedAtUtc?.ToString("u",CultureInfo.InvariantCulture) UTC</MudText>
                @if(_facilities.Rows.Count==0){<MudAlert Severity="Severity.Info">No facility rows were returned for this company and FIELD.</MudAlert>}
                else
                {
                    <MudTable T="FACILITY" Items="@_facilities.Rows" Dense="true" aria-label="Recorded facilities for the selected FIELD">
                        <HeaderContent><MudTh>Facility ID</MudTh><MudTh>Type</MudTh><MudTh>Recorded name</MudTh><MudTh>Recorded operator</MudTh><MudTh>Source details</MudTh></HeaderContent>
                        <RowTemplate><MudTd DataLabel="Facility ID">@context.FACILITY_ID</MudTd><MudTd DataLabel="Type">@context.FACILITY_TYPE</MudTd><MudTd DataLabel="Recorded name">@Recorded(context.FACILITY_LONG_NAME ?? context.FACILITY_SHORT_NAME)</MudTd><MudTd DataLabel="Recorded operator">@Recorded(context.CURRENT_OPERATOR)</MudTd><MudTd DataLabel="Source details"><MudButton OnClick="@(() => InspectEquipment(context.FACILITY_ID,context.FACILITY_TYPE))" Variant="Variant.Outlined" Size="Size.Small" aria-label="@($"Inspect equipment for {context.FACILITY_ID}, type {context.FACILITY_TYPE}")">Inspect equipment</MudButton><MudButton Href="@FacilityEvidenceRoute.For(review,context)" Variant="Variant.Outlined" Size="Size.Small" aria-label="@($"Open facility {context.FACILITY_ID}, type {context.FACILITY_TYPE}")">Open facility evidence</MudButton></MudTd></RowTemplate>
                    </MudTable>
                    @if(SelectedFacility() is {} facility)
                    {
                        <MudPaper Outlined="true" Class="pa-3 my-3">
                            <MudText Typo="Typo.h6" HtmlTag="h3">Equipment recorded for @facility.FACILITY_ID / @facility.FACILITY_TYPE</MudText>
                            <MudText>These are recorded active equipment rows, not proof of installation, testing or construction acceptance.</MudText>
                            <MudButton OnClick="@(() => InspectEquipment(facility.FACILITY_ID,facility.FACILITY_TYPE))" Disabled="@_facilities.EquipmentLoading" Variant="Variant.Outlined">Reload equipment evidence</MudButton>
                            @if(_facilities.EquipmentLoading){<MudProgressLinear Indeterminate="true" aria-label="Loading facility equipment" />}
                            else if(_facilities.EquipmentError is {} equipmentError){<MudAlert Severity="Severity.Error" role="alert">@equipmentError</MudAlert>}
                            else if(_facilities.EquipmentLoaded)
                            {
                                @if(_facilities.Equipment.Count==0){<MudAlert Severity="Severity.Info">No active equipment rows were returned for this facility.</MudAlert>}
                                else{<MudTable Items="@_facilities.Equipment" Dense="true" aria-label="Recorded facility equipment"><HeaderContent><MudTh>Equipment</MudTh><MudTh>Installation observation</MudTh><MudTh>Recorded source</MudTh></HeaderContent><RowTemplate><MudTd DataLabel="Equipment">@context.EquipmentId</MudTd><MudTd DataLabel="Installation observation">@context.InstallationObservation</MudTd><MudTd DataLabel="Recorded source">@Recorded(context.Source)</MudTd></RowTemplate></MudTable>}
                            }
                        </MudPaper>
                    }
                }
            }
            else{<MudAlert Severity="Severity.Info">Reload to confirm current facility records.</MudAlert>}
        }
    </MudPaper>
    <MudGrid Spacing="3">
        <MudItem xs="12" md="4">
            <MudCard Outlined="true"><MudCardContent>
                <MudText Typo="Typo.h6" HtmlTag="h2">Engineering and execution</MudText>
                <MudText Class="my-3">Open the original development plan, well evidence and drilling program to inspect recorded decisions and execution.</MudText>
                <MudStack Spacing="2">
                    <MudButton Href="/development/fdp" Variant="Variant.Outlined">Development plans</MudButton>
                    <MudButton Href="/development/well-design" Variant="Variant.Outlined">Well evidence and design</MudButton>
                    <MudButton Href="/ppdm39/operations/drillingoperations" Variant="Variant.Outlined">Drilling operations</MudButton>
                </MudStack>
            </MudCardContent></MudCard>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudCard Outlined="true"><MudCardContent>
                <MudText Typo="Typo.h6" HtmlTag="h2">Facilities and investment</MudText>
                <MudText Class="my-3">Review facility records and approved investment in their own source screens. Their status does not establish construction acceptance.</MudText>
                <MudStack Spacing="2">
                    <MudButton Href="/ppdm39/development/facilities" Variant="Variant.Outlined">Facility records</MudButton>
                    <MudButton Href="/economics/afe" Variant="Variant.Outlined">Investment records</MudButton>
                </MudStack>
            </MudCardContent></MudCard>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudCard Outlined="true"><MudCardContent>
                <MudText Typo="Typo.h6" HtmlTag="h2">Safety and assigned work</MudText>
                <MudText Class="my-3">Review recorded incidents and the current company's assigned work through their own authorization boundaries.</MudText>
                <MudStack Spacing="2">
                    <MudButton Href="/ppdm39/hse/incidents" Variant="Variant.Outlined">Incident records</MudButton>
                    <MudButton Href="/tasks/inbox" Variant="Variant.Outlined">Company inbox</MudButton>
                </MudStack>
            </MudCardContent></MudCard>
        </MudItem>
    </MudGrid>
    @if(CanViewInvestment())
    {
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-4">Investment evidence across accessible FIELDs</MudText>
        <MudText>These company-authorized requests may belong to a different FIELD from the selected facility list. Open the original request to review its source and decision.</MudText>
        <DevelopmentInvestmentQueuePanel />
    }
    <MudAlert Severity="Severity.Warning" Class="my-4">Recorded drilling completion and physical test acceptance do not by themselves accept construction or release production. These decisions require their own source-bound evidence and authorized owners.</MudAlert>
</MudContainer>

@code {
    private DevelopmentFacilityEvidenceState? _facilities;
    private string? selectedFacilityId,selectedFacilityType;
    private bool disposed;
    private static string Recorded(string? value)=>string.IsNullOrWhiteSpace(value)?"Not recorded":value;
    private FACILITY? SelectedFacility()=>_facilities?.Loaded==true?_facilities.Rows.SingleOrDefault(row=>row.FACILITY_ID==selectedFacilityId && row.FACILITY_TYPE==selectedFacilityType):null;
    private async Task InspectEquipment(string id,string type){_facilities!.ClearEquipment();selectedFacilityId=id;selectedFacilityType=type;await _facilities.LoadEquipmentAsync(id,type);}
    private bool CanViewInvestment()=>Company.Selection is {} selected && new[]{"Accounting.View","DevelopmentPlanning.View","Workflow.View"}.All(permission=>selected.Permissions.Contains(permission,StringComparer.Ordinal));
    private bool CanViewFacilities()=>Company.Selection is {} selected && selected.Permissions.Contains("DevelopmentPlanning.View",StringComparer.Ordinal);
    protected override void OnInitialized(){_facilities=new(Company,Fields,Development,Calls.Explain);_facilities.Changed+=Changed;}
    protected override Task OnAfterRenderAsync(bool firstRender)=>firstRender?ReloadFacilities():Task.CompletedTask;
    private Task ReloadFacilities()=>CanViewFacilities()?_facilities!.LoadAsync():Task.CompletedTask;
    private void Changed(){if(_facilities?.Loaded!=true){selectedFacilityId=null;selectedFacilityType=null;}if(!disposed)_=InvokeAsync(StateHasChanged);}
    public void Dispose(){disposed=true;if(_facilities is not null){_facilities.Changed-=Changed;_facilities.Dispose();}}
}
