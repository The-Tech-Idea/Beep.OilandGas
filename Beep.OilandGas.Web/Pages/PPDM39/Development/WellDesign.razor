@using Beep.OilandGas.PPDM39.DataManagement.Models
@using Beep.OilandGas.Models.Core.Interfaces
@using Beep.OilandGas.Models.Data.Company
@page "/development/well-design"
@page "/development/well-design/new"
@using MudBlazor
@using System.Globalization
@using Beep.OilandGas.Client.App
@using Beep.OilandGas.PPDM39.Models
@using Beep.OilandGas.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@inject CompanyClientContext Company
@inject IFieldSelectionContext Fields
@inject IDevelopmentServiceClient Development
@inject NavigationManager Navigation
@inject OilGasCallFailures Calls

<PageTitle>Development well evidence</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">Development well evidence</MudText>
    <MudText Class="mb-3">Inspect recorded wells before reviewing a design, drilling program or development handover.</MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-4">
        <MudButton Href="/drilling/workspace" Variant="Variant.Outlined">Drilling workspace</MudButton>
        <MudButton Href="/development/well-design" Variant="Variant.Outlined">Development well list</MudButton>
        <MudButton Href="/tasks/inbox" Variant="Variant.Outlined">Review assigned design work</MudButton>
        <MudButton OnClick="Reload" Disabled="@(_state?.Loading == true || _newRequested || _routeError is not null)" StartIcon="@Icons.Material.Filled.Refresh">Reload well evidence</MudButton>
    </MudStack>
    @if (_routeError is not null)
    {
        <MudAlert Severity="Severity.Error" role="alert">@_routeError</MudAlert>
    }
    else if (_newRequested)
    {
        <Beep.OilandGas.Web.Components.Workflow.DrillingProgramDraftPanel WellUwi="@WellUwi" />
    }
    else if (_state?.Loading == true)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading development well evidence" />
    }
    else if (_state?.Error is { } error)
    {
        <MudAlert Severity="Severity.Error" role="alert">@error</MudAlert>
    }
    else if (_state?.NeedsCompany != false)
    {
        <MudAlert Severity="Severity.Info">Choose a company in the header, then reload its development well evidence.</MudAlert>
    }
    else if (_state.NeedsField)
    {
        <MudAlert Severity="Severity.Info">Choose an available active field in the header, then reload well evidence.</MudAlert>
    }
    else if (_state.Loaded && _state.Review is { } review)
    {
        <MudPaper Class="pa-3 mb-4" Outlined="true">
            <MudText>Company: @review.Company.TenantId / @review.Company.BusinessAssociateId</MudText>
            <MudText>FIELD: @review.FieldId · @Recorded(_state.FieldName)</MudText>
            <MudText Typo="Typo.caption">Source: recorded development WELL data · Loaded at @_state.LoadedAtUtc?.ToString("O", CultureInfo.InvariantCulture)</MudText>
        </MudPaper>
        <MudAlert Severity="Severity.Info" Class="mb-4">Well status and dates below are source records. Design approval, AFE amounts, rig assignment and readiness for operations require their own recorded evidence.</MudAlert>
        @if (_state.NotFound)
        {
            <MudAlert Severity="Severity.Warning">The requested development well was not returned for this company and field. Return to the well list to choose a current record.</MudAlert>
        }
        else if (_state.Selected is { } well)
        {
            <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-3">@Recorded(well.WELL_NAME) · @well.UWI</MudText>
            <MudButton Href="@("/development/well-design/new?wellUwi="+Uri.EscapeDataString(well.UWI))" Variant="Variant.Outlined" Class="mb-3">Prepare a program with approved funding</MudButton>
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Outlined="true">
                        <MudText Typo="Typo.h6" HtmlTag="h3">Recorded identity and status</MudText>
                        <MudText>UWI: @well.UWI</MudText>
                        <MudText>Assigned FIELD: @well.ASSIGNED_FIELD</MudText>
                        <MudText>Current class: @Recorded(well.CURRENT_CLASS)</MudText>
                        <MudText>Current status: @Recorded(well.CURRENT_STATUS)</MudText>
                        <MudText>Status type: @Recorded(well.STATUS_TYPE)</MudText>
                        <MudText>Status date: @SourceDate(well.CURRENT_STATUS_DATE)</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Outlined="true">
                        <MudText Typo="Typo.h6" HtmlTag="h3">Recorded depths and dates</MudText>
                        <MudText>Final total depth: @Depth(well.FINAL_TD, well.FINAL_TD_OUOM)</MudText>
                        <MudText>Drilling total depth: @Depth(well.DRILL_TD, well.DRILL_TD_OUOM)</MudText>
                        <MudText>Spud date: @SourceDate(well.SPUD_DATE)</MudText>
                        <MudText>Completion date: @SourceDate(well.COMPLETION_DATE)</MudText>
                        <MudText Typo="Typo.caption">Depths retain their recorded units. Dates retain the source date and are not converted to the server's local time.</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
        else
        {
            <MudText Class="mb-3" role="status">@_state.Rows.Count recorded development wells returned for this company and field.</MudText>
            <MudTable T="WELL" Items="@_state.Rows" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>Well</MudTh><MudTh>UWI</MudTh><MudTh>Current class</MudTh><MudTh>Current status</MudTh><MudTh>Source evidence</MudTh>
                </HeaderContent>
                <RowTemplate Context="row">
                    <MudTd DataLabel="Well">@Recorded(row.WELL_NAME)</MudTd>
                    <MudTd DataLabel="UWI">@row.UWI</MudTd>
                    <MudTd DataLabel="Current class">@Recorded(row.CURRENT_CLASS)</MudTd>
                    <MudTd DataLabel="Current status">@Recorded(row.CURRENT_STATUS)</MudTd>
                    <MudTd DataLabel="Source evidence"><MudButton Href="@WellHref(row.UWI)" Variant="Variant.Outlined">Inspect well @row.UWI</MudButton></MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>No recorded development wells were returned for this company and field.</MudText></NoRecordsContent>
            </MudTable>
        }
    }
    else
    {
        <MudAlert Severity="Severity.Info">The company or field changed. Reload to review its current development well evidence.</MudAlert>
    }
</MudContainer>

@code {
    [Parameter, SupplyParameterFromQuery(Name="wellUwi")] public string? WellUwi { get; set; }
    private DevelopmentWellEvidenceState? _state;
    private bool _newRequested, _disposed;
    private string? _routeError;
    protected override void OnInitialized()
    {
        _state=new(Company,Fields,Development,Calls.Explain); _state.Changed+=Changed;
    }
    protected override Task OnParametersSetAsync()
    {
        var newRoute=new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').EndsWith("/well-design/new", StringComparison.Ordinal);
        _routeError=null;
        _newRequested=newRoute;
        if(_newRequested || _routeError is not null) { _state!.Clear(); return Task.CompletedTask; }
        return Reload();
    }
    private Task Reload() => _state!.LoadAsync(WellUwi);
    private void Changed() { if(!_disposed) _=InvokeAsync(StateHasChanged); }
    private static string Recorded(string? value) => string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    private static string SourceDate(DateTime? value) => value?.ToString("yyyy-MM-dd",CultureInfo.InvariantCulture) ?? "Not recorded";
    private static string Depth(decimal value, string? unit) => value > 0 ? value.ToString("0.############################",CultureInfo.InvariantCulture) + " " + (string.IsNullOrWhiteSpace(unit) ? "(unit not recorded)" : unit) : "Not available";
    private static string WellHref(string uwi) => "/development/well-design?wellUwi=" + Uri.EscapeDataString(uwi);
    public void Dispose() { _disposed=true; if(_state is not null) { _state.Changed-=Changed; _state.Dispose(); } }
}
