@page "/development/well-design"
@page "/development/well-design/{Id}"
@page "/development/well-design/new"
@using Beep.OilandGas.Models.Data.Process
@inject ApiClient ApiClient
@inject IDevelopmentServiceClient DevelopmentServiceClient
@inject IBusinessProcessServiceClient BusinessProcessClient
@inject ILifeCycleService LifeCycleService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject OilGasApiFailures Answers
@inject FailureNotifier Notifier

<PageTitle>@(_showDetail ? $"{_well.WellName} — Well Design" : "Development Well Design")</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">

    @* ── Header ──────────────────────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        @if (_showDetail)
        {
            <MudTooltip Text="Back to list">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                               OnClick="BackToList"
                               aria-label="Back to list" />
            </MudTooltip>
        }
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">@(_showDetail ? _well.WellName : "Development Well Design")</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_fieldName — @(_showDetail ? $"{_well.Type} · {_well.TargetZone}" : "Design, plan, and track development wells")
                </MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.Construction">Development</MudChip>
            </MudStack>
        </MudStack>
        <MudSpacer />
        @if (_showDetail)
        {
            <StatusBadge Status="@_well.Status" />
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="NewWell">
                New Well Design
            </MudButton>
        }
    </MudStack>

    @* ══════════════════════════════════════════════════════════════════════ *@
    @*  LIST VIEW                                                             *@
    @* ══════════════════════════════════════════════════════════════════════ *@
    @if (!_showDetail)
    {
        <MudDataGrid T="WellDesignRow"
                     Items="@_wells"
                     Dense="true"
                     Hover="true"
                     Striped="true"
                     Filterable="true"
                     SortMode="SortMode.Single"
                     RowClick="@OnRowClick">
            <Columns>
                <PropertyColumn Property="x => x.WellName" Title="Well Name" />
                <PropertyColumn Property="x => x.Type" Title="Type">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.Item.Type == "Producer" ? Color.Primary : context.Item.Type == "Injector" ? Color.Info : Color.Default)">
                            @context.Item.Type
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.TargetZone" Title="Target Zone" />
                <PropertyColumn Property="x => x.Status" Title="Status">
                    <CellTemplate><StatusBadge Status="@context.Item.Status" /></CellTemplate>
                </PropertyColumn>
                @* No AFE column: the development wells API carries no AFE amount for a well (an AFE row names a PROPERTY_ID, not a UWI). *@
                <PropertyColumn Property="x => x.RigAssigned" Title="Rig" />
                <TemplateColumn CellClass="d-flex justify-end">
                    <CellTemplate>
                        <MudTooltip Text="Open well design">
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" aria-label="Open well design" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => OpenDetail(context.Item.Id))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }

    @* ══════════════════════════════════════════════════════════════════════ *@
    @*  DETAIL VIEW (5 tabs + action panel)                                  *@
    @* ══════════════════════════════════════════════════════════════════════ *@
    else
    {
        <MudGrid Spacing="3">

            @* MAIN — 5 tabs *@
            <MudItem xs="12" md="8">
                <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true">

                    @* Tab 1: Well Design *@
                    <MudTabPanel Text="Well Design" Icon="@Icons.Material.Filled.Draw">
                        <MudGrid Spacing="3" Class="pa-4">
                            <MudItem xs="12" md="6">
                                <MudTextField Value="@_well.WellName" Label="Well Name" Variant="Variant.Outlined" ReadOnly="true" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField Value="@_well.Type" Label="Well Type" Variant="Variant.Outlined" ReadOnly="true" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField Value="@_well.SurfaceLatLon" Label="Surface Location (Lat/Lon)" Variant="Variant.Outlined" ReadOnly="true" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField Value="@_well.TargetZone" Label="Target Zone" Variant="Variant.Outlined" ReadOnly="true" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField Value="@_well.TargetDepthM.ToString()" Label="Planned TD (m)" Variant="Variant.Outlined" ReadOnly="true" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField Value="@_well.TrajectoryType" Label="Trajectory" Variant="Variant.Outlined" ReadOnly="true" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField Value="@_well.PlannedInclination.ToString()" Label="Max Inclination (°)" Variant="Variant.Outlined" ReadOnly="true" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">Casing Program</MudText>
                                <MudDataGrid T="CasingString" Items="@_well.CasingProgram" Dense="true" Hover="true" Striped="true">
                                    <Columns>
                                        <PropertyColumn Property="c => c.StringName" Title="String" />
                                        <PropertyColumn Property="c => c.SizeIn" Title="Size (in)" />
                                        <PropertyColumn Property="c => c.SetDepthM" Title="Set Depth (m)" />
                                        <PropertyColumn Property="c => c.Grade" Title="Grade" />
                                    </Columns>
                                </MudDataGrid>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    @* Tab 2: Drilling Program *@
                    <MudTabPanel Text="Drilling Program" Icon="@Icons.Material.Filled.Engineering">
                        <MudPaper Elevation="0" Class="pa-4">
                            <MudGrid Spacing="3">
                                <MudItem xs="12" md="6">
                                    <MudTextField Value="@_well.MudProgram" Label="Mud Program" Variant="Variant.Outlined" ReadOnly="true" Lines="3" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField Value="@_well.BhaSummary" Label="BHA Design Summary" Variant="Variant.Outlined" ReadOnly="true" Lines="3" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2">Formation Tops (prognosis)</MudText>
                                    <MudDataGrid T="FormationTop" Items="@_well.FormationTops" Dense="true" Hover="true" Striped="true">
                                        <Columns>
                                            <PropertyColumn Property="f => f.Name" Title="Formation" />
                                            <PropertyColumn Property="f => f.DepthM" Title="Prognosed Depth (m)" />
                                        </Columns>
                                    </MudDataGrid>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField Value="@_well.PlannedDays.ToString()" Label="Time Estimate (days)" Variant="Variant.Outlined" ReadOnly="true" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudTabPanel>

                    @* Tab 3: Completion Design *@
                    <MudTabPanel Text="Completion Design" Icon="@Icons.Material.Filled.Plumbing">
                        <MudPaper Elevation="0" Class="pa-4">
                            <MudStack Spacing="2">
                                <MudStack Row="true" Spacing="2">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-xl">Perforation Interval</MudText>
                                    <MudText Typo="Typo.body2">@_well.PerfInterval</MudText>
                                </MudStack>
                                <MudStack Row="true" Spacing="2">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-xl">Gravel Pack</MudText>
                                    <MudText Typo="Typo.body2">@_well.GravelPack</MudText>
                                </MudStack>
                                <MudStack Row="true" Spacing="2">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-xl">Artificial Lift</MudText>
                                    <MudText Typo="Typo.body2">@_well.ArtificialLift</MudText>
                                </MudStack>
                                <MudStack Row="true" Spacing="2">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-xl">Tubing Size</MudText>
                                    <MudText Typo="Typo.body2">@_well.TubingSize</MudText>
                                </MudStack>
                                <MudStack Row="true" Spacing="2">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-xl">Packer Type</MudText>
                                    <MudText Typo="Typo.body2">@_well.PackerType</MudText>
                                </MudStack>
                                <MudStack Row="true" Spacing="2">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-xl">Downhole Safety Valve</MudText>
                                    <MudText Typo="Typo.body2">@_well.Dhsv</MudText>
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    </MudTabPanel>

                    @* Tab 4: AFE *@
                    <MudTabPanel Text="AFE" Icon="@Icons.Material.Filled.AttachMoney">
                        <MudPaper Elevation="0" Class="pa-4">
                            @* No AFE lines for a well: the development wells API carries none, and an AFE row names a PROPERTY_ID, not a UWI. *@
                            <MudAlert Severity="Severity.Info">AFE lines for a development well are not available yet.</MudAlert>
                        </MudPaper>
                    </MudTabPanel>

                    @* Tab 5: Drilling Progress *@
                    <MudTabPanel Text="Progress" Icon="@Icons.Material.Filled.Speed">
                        @if (_well.Status is "PLANNED" or "APPROVED")
                        {
                            <MudPaper Elevation="0" Class="pa-4">
                                <MudAlert Severity="Severity.Info">Drilling has not started. Spud date not yet recorded.</MudAlert>
                            </MudPaper>
                        }
                        else
                        {
                            <MudGrid Spacing="3" Class="pa-4">
                                <MudItem xs="12" md="4">
                                    <KpiCard Label="Current Depth" Value="@_well.CurrentDepthM.ToString("N0")" Unit="m" ValueColor="Color.Primary" />
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <KpiCard Label="Days Drilling" Value="@_well.DaysDrilling.ToString()" Unit="@($"/ {_well.PlannedDays} planned")" ValueColor="@(_well.DaysDrilling <= _well.PlannedDays ? Color.Success : Color.Warning)" />
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <KpiCard Label="ROP" Value="@_well.RopMPerDay.ToString("N0")" Unit="m/day" ValueColor="Color.Info" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2">NPT Log</MudText>
                                    <MudDataGrid T="NptEntry" Items="@_well.NptLog" Dense="true" Hover="true" Striped="true">
                                        <Columns>
                                            <PropertyColumn Property="n => n.Date" Title="Date" />
                                            <PropertyColumn Property="n => n.Category" Title="Category" />
                                            <PropertyColumn Property="n => n.DurationHrs" Title="Duration (hrs)" />
                                            <PropertyColumn Property="n => n.Description" Title="Description" />
                                        </Columns>
                                    </MudDataGrid>
                                </MudItem>
                            </MudGrid>
                        }
                    </MudTabPanel>

                </MudTabs>
            </MudItem>

            @* SIDEBAR — State-based actions *@
            <MudItem xs="12" md="4">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1">Actions</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudStack Spacing="2">
                            @if (_designApproval is not null)
                            {
                                <MudStack Spacing="0">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudText Typo="Typo.body2">Well design approval</MudText>
                                        <StatusBadge Status="@_designApproval.Status" />
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@DescribeDesignApproval()</MudText>
                                </MudStack>
                            }
                            @if (_well.Status == "DRAFT" && !DesignApprovalOpen)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Send"
                                           FullWidth="true"
                                           Disabled="@(_submittingApproval || !_approvalLoaded || string.IsNullOrWhiteSpace(_well.Id))"
                                           OnClick="SubmitForApprovalAsync">
                                    @(_submittingApproval ? "Submitting…" : "Submit for Approval")
                                </MudButton>
                                @if (string.IsNullOrWhiteSpace(_well.Id))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">A saved well is required before its design can be submitted for approval.</MudText>
                                }
                                else if (!_approvalLoaded)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">The well design's approval state could not be read, so it cannot be submitted now.</MudText>
                                }
                            }
                            @if (_well.Status is "DRAFT" or "APPROVED")
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Info"
                                           StartIcon="@Icons.Material.Filled.DirectionsBoat"
                                           FullWidth="true" OnClick="AssignRig">
                                    Assign Rig
                                </MudButton>
                            }
                            @if (_well.Status is "APPROVED" or "DRILLING" or "TD_REACHED" or "COMPLETE")
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.PendingActions"
                                           FullWidth="true" OnClick="OpenConstructionProgress">
                                    Track Construction Progress
                                </MudButton>
                            }
                            @if (_well.Status is "APPROVED" or "DRILLING" or "TD_REACHED" or "COMPLETE")
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                                           StartIcon="@Icons.Material.Filled.Construction"
                                           FullWidth="true" OnClick="OpenDrillingWorkflow">
                                    @GetDrillingWorkflowActionLabel()
                                </MudButton>
                            }
                            @if (_well.Status == "APPROVED")
                            {
                                @* No endpoint records a development well's spud (WELL.SPUD_DATE) or moves it to drilling; a drilling operation is started without one. *@
                                <MudButton Variant="Variant.Filled" Color="Color.Success"
                                           StartIcon="@Icons.Material.Filled.PlayArrow"
                                           FullWidth="true" Disabled="true">
                                    Record Spud
                                </MudButton>
                                <MudAlert Severity="Severity.Info" Dense="true">Recording the spud from the well design is not available yet.</MudAlert>
                            }
                            @if (_well.Status == "DRILLING")
                            {
                                @* No endpoint records TD reached for a development well; the drilling tracker records only the depth drilled (UpdateDrillingOperation.CurrentDepth). *@
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.VerticalAlignBottom"
                                           FullWidth="true" Disabled="true">
                                    Record TD Reached
                                </MudButton>
                                <MudAlert Severity="Severity.Info" Dense="true">Recording TD from the well design is not available yet. The depth drilled is recorded in the drilling tracker.</MudAlert>
                            }
                            @if (_well.Status == "TD_REACHED")
                            {
                                @* No endpoint completes a development well: the drilling operation's "Completed" status sets the WELL row's ACTIVE_IND to 'N', which is a soft delete. *@
                                <MudButton Variant="Variant.Filled" Color="Color.Success"
                                           StartIcon="@Icons.Material.Filled.CheckCircle"
                                           FullWidth="true" Disabled="true">
                                    Complete Well
                                </MudButton>
                                <MudAlert Severity="Severity.Info" Dense="true">Marking the well complete is not available yet.</MudAlert>
                            }
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

        </MudGrid>
    }

</MudContainer>

@* ── Assign Rig dialog ────────────────────────────────────────────────────── *@
<MudDialog @bind-Visible="_showAssignRigDialog">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Engineering" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Assign Rig — @_well.WellName</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_rigName" Label="Rig Name / Contract Number"
                          Variant="Variant.Outlined" Required="true" />
            <MudDatePicker @bind-Date="_rigMobDate" Label="Mobilisation Date"
                           Variant="Variant.Outlined" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showAssignRigDialog = false)" Disabled="@_assigningRig">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Engineering"
                   Disabled="@_assigningRig"
                   OnClick="SubmitRigAssignmentAsync">
            @(_assigningRig ? "Saving…" : "Assign Rig")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string? Id { get; set; }

    private string _loadedId   = string.Empty;
    private string _fieldName  = string.Empty;
    private bool _showDetail;
    private WellDetail _well = new();
    private List<WellDesignRow> _wells = new();

    protected override async Task OnInitializedAsync()
    {
        _loadedId = Id ?? string.Empty;
        try
        {
            var summary = await LifeCycleService.GetFieldLifecycleSummaryAsync();
            if (summary != null)
                _fieldName = summary.FieldName ?? _fieldName;
        }
        // Only the field's name in the header depends on it; the person is told it could not be read.
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "loading the active field's name for well design", "The field's name could not be loaded"), Severity.Warning);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "loading the active field's name for well design", "The field's name could not be loaded", FailureSeverity.Degraded);
        }

        try
        {
            var wells = await DevelopmentServiceClient.GetWellsAsync();
            if (wells.Count > 0)
            {
                _wells = wells.Select(w => new WellDesignRow(
                    w.UWI ?? string.Empty,
                    w.WELL_NAME ?? w.UWI ?? "Unknown",
                    w.WELL_TYPE ?? w.CURRENT_CLASS ?? w.WELL_LEVEL_TYPE ?? "Producer",
                    string.Empty,
                    w.CURRENT_STATUS ?? w.STATUS_TYPE ?? "DRAFT",
                    string.Empty
                )).ToList();
            }
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "loading the development wells for well design", "The wells could not be loaded"), Severity.Warning);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "loading the development wells for well design", "The wells could not be loaded", FailureSeverity.Degraded);
        }

        if (!string.IsNullOrEmpty(Id) && Id != "new")
        {
            _showDetail = true;
            await LoadWellDetailAsync(Id);
        }
        else if (Id == "new")
        {
            _showDetail = true;
            _well = new WellDetail { WellName = "New Well", Status = "DRAFT" };
            ForgetDesignApproval();
        }
    }

    private async Task LoadWellDetailAsync(string id)
    {
        await LoadWellAsync(id);
        await LoadDesignApprovalAsync(id);
    }

    private async Task LoadWellAsync(string id)
    {
        try
        {
            var w = await DevelopmentServiceClient.GetWellAsync(id);
            if (w != null)
            {
                _well = new WellDetail
                {
                    Id           = w.UWI ?? id,
                    WellName     = w.WELL_NAME ?? w.UWI ?? id,
                    Type         = w.WELL_TYPE ?? w.CURRENT_CLASS ?? w.WELL_LEVEL_TYPE ?? "Producer",
                    Status       = w.CURRENT_STATUS ?? w.STATUS_TYPE ?? "DRAFT",
                    TargetZone   = string.Empty,
                    TargetDepthM = (int)(w.FINAL_TD),
                    CurrentDepthM = (int)(w.DRILL_TD),
                };
            }
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "loading a development well's design", "The well's details could not be loaded"), Severity.Warning);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "loading a development well's design", "The well's details could not be loaded", FailureSeverity.Degraded);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if ((Id ?? string.Empty) == _loadedId) return;
        _loadedId = Id ?? string.Empty;
        if (!string.IsNullOrEmpty(Id) && Id != "new")
        {
            _showDetail = true;
            await LoadWellDetailAsync(Id);
        }
        else if (Id == "new")
        {
            _showDetail = true;
            _well = new WellDetail { WellName = "New Well", Status = "DRAFT" };
            ForgetDesignApproval();
        }
        else
        {
            _showDetail = false;
        }
    }

    // The well design approval is the GATE_WELL_DESIGN gate review, started by POST /api/field/current/gates/submit/WELL_DESIGN
    // with the well's UWI; its state is read back from the field's process instances.
    private const string WellDesignGateId        = "WELL_DESIGN";
    private const string WellDesignGateProcessId = "GATE_WELL_DESIGN";

    private ProcessInstanceSummary? _designApproval;
    private string _designApprovalStep = string.Empty;
    private bool _approvalLoaded;
    private bool _submittingApproval;

    // A cancelled or failed review leaves the design free to be submitted again; any other state is an open review.
    private bool DesignApprovalOpen =>
        _designApproval is not null
        && !string.Equals(_designApproval.Status, "CANCELLED", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(_designApproval.Status, "FAILED", StringComparison.OrdinalIgnoreCase);

    private string DescribeDesignApproval()
    {
        if (_designApproval is null) return string.Empty;
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(_designApprovalStep)
            && !string.Equals(_designApproval.Status, "COMPLETED", StringComparison.OrdinalIgnoreCase))
            parts.Add($"Current step: {_designApprovalStep}");
        if (_designApproval.StartedAt.HasValue) parts.Add($"submitted {_designApproval.StartedAt.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}");
        return string.Join(" · ", parts);
    }

    private void ForgetDesignApproval()
    {
        _designApproval     = null;
        _designApprovalStep = string.Empty;
        _approvalLoaded     = false;
    }

    private async Task LoadDesignApprovalAsync(string uwi)
    {
        ForgetDesignApproval();
        try
        {
            var instances = await BusinessProcessClient.GetInstancesAsync();
            _designApproval = instances
                .Where(i => string.Equals(i.ProcessId, WellDesignGateProcessId, StringComparison.OrdinalIgnoreCase)
                         && string.Equals(i.EntityId, uwi, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(i => i.StartedAt)
                .FirstOrDefault();

            if (_designApproval is not null && !string.IsNullOrWhiteSpace(_designApproval.CurrentStepId))
            {
                var instance = await BusinessProcessClient.GetInstanceAsync(_designApproval.InstanceId);
                var step = instance?.StepInstances?.FirstOrDefault(s => s.StepId == _designApproval.CurrentStepId);
                _designApprovalStep = string.IsNullOrWhiteSpace(step?.StepName) ? _designApproval.CurrentStepId : step.StepName;
            }

            _approvalLoaded = true;
        }
        // The approval state decides whether the design may be submitted; without it the button stays disabled and says why.
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "loading a development well's design approval", "The well design's approval state could not be loaded"), Severity.Warning);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "loading a development well's design approval", "The well design's approval state could not be loaded", FailureSeverity.Degraded);
        }
    }

