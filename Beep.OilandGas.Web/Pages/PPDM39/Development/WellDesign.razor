    private async Task SubmitForApprovalAsync()
    {
        if (string.IsNullOrWhiteSpace(_well.Id))
        {
            Snackbar.Add("A saved well is required before its design can be submitted for approval.", Severity.Warning);
            return;
        }

        _submittingApproval = true;
        try
        {
            await BusinessProcessClient.SubmitForGateReviewAsync(WellDesignGateId, new GateReviewSubmitRequest
            {
                EntityId   = _well.Id,
                EntityType = "WELL",
                Comments   = $"Well design for {_well.WellName} submitted from the development well design page."
            });

            Snackbar.Add($"The design of {_well.WellName} was submitted for approval.", Severity.Success);
            await LoadDesignApprovalAsync(_well.Id);
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "submitting a development well's design for approval", "The well design was not submitted for approval"), Severity.Error);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "submitting a development well's design for approval", "The well design was not submitted for approval");
        }
        finally { _submittingApproval = false; }
    }

    private void AssignRig()
    {
        _rigName    = string.Empty;
        _rigMobDate = DateTime.Today;
        _showAssignRigDialog = true;
    }

    private void OpenDrillingWorkflow()
    {
        if (string.IsNullOrWhiteSpace(_well.Id))
        {
            Snackbar.Add("A saved well is required before launching drilling operations.", Severity.Warning);
            return;
        }

        NavigationManager.NavigateTo(BuildDrillingWorkflowHref());
    }

    private void OpenConstructionProgress()
    {
        if (string.IsNullOrWhiteSpace(_well.Id))
        {
            Snackbar.Add("A saved well is required before opening construction progress.", Severity.Warning);
            return;
        }

        NavigationManager.NavigateTo(BuildConstructionProgressHref());
    }

    // ── Rig assignment dialog state ─────────────────────────────────────
    private bool      _showAssignRigDialog = false;
    private bool      _assigningRig        = false;
    private string    _rigName             = string.Empty;
    private DateTime? _rigMobDate          = DateTime.Today;

    private async Task SubmitRigAssignmentAsync()
    {
        if (string.IsNullOrWhiteSpace(_rigName))
        {
            Snackbar.Add("Rig name is required.", Severity.Warning);
            return;
        }
        _assigningRig = true;
        try
        {
            await DevelopmentServiceClient.AssignRigAsync(_well.Id, new DevelopmentAssignRigRequest
            {
                RigName = _rigName,
                MobDate = _rigMobDate
            });

            _well.RigAssigned = _rigName;
            _showAssignRigDialog = false;
            Snackbar.Add($"Rig {_rigName} assigned to {_well.WellName}.", Severity.Success);
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "assigning a rig to a development well", "The rig was not assigned"), Severity.Error);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "assigning a rig to a development well", "The rig was not assigned");
        }
        finally { _assigningRig = false; }
    }

    private string GetDrillingWorkflowActionLabel() =>
        _well.Status == "APPROVED"
            ? "Launch Drilling Operation"
            : "Open Drilling Tracker";

    private string BuildDrillingWorkflowHref()
    {
        var query = new List<string>
        {
            $"wellUwi={Uri.EscapeDataString(_well.Id)}",
            $"wellName={Uri.EscapeDataString(_well.WellName)}",
            $"sourceProcess={Uri.EscapeDataString("DEVELOPMENT")}",
            $"returnTo={Uri.EscapeDataString(BuildWellDesignReturnTo())}"
        };

        if (_well.TargetDepthM > 0)
        {
            query.Add($"targetDepth={Uri.EscapeDataString(_well.TargetDepthM.ToString(System.Globalization.CultureInfo.InvariantCulture))}");
        }

        if (!string.IsNullOrWhiteSpace(_well.RigAssigned))
        {
            query.Add($"rigName={Uri.EscapeDataString(_well.RigAssigned)}");
        }

        if (_well.Status == "APPROVED")
        {
            query.Insert(0, "openCreate=true");
        }

        return "/ppdm39/operations/drillingoperations?" + string.Join("&", query);
    }

    private string BuildConstructionProgressHref()
    {
        var query = new List<string>
        {
            $"wellUwi={Uri.EscapeDataString(_well.Id)}",
            $"wellName={Uri.EscapeDataString(_well.WellName)}",
            $"sourceProcess={Uri.EscapeDataString("DEVELOPMENT")}",
            $"returnTo={Uri.EscapeDataString(BuildWellDesignReturnTo())}"
        };

        if (_well.TargetDepthM > 0)
        {
            query.Add($"targetDepth={Uri.EscapeDataString(_well.TargetDepthM.ToString(System.Globalization.CultureInfo.InvariantCulture))}");
        }

        if (!string.IsNullOrWhiteSpace(_well.RigAssigned))
        {
            query.Add($"rigName={Uri.EscapeDataString(_well.RigAssigned)}");
        }

        if (_well.Status == "APPROVED")
        {
            query.Add("openDrillingCreate=true");
        }

        return "/development/construction?" + string.Join("&", query);
    }

    private string BuildWellDesignReturnTo() =>
        string.IsNullOrWhiteSpace(_well.Id)
            ? "/development/well-design"
            : $"/development/well-design/{Uri.EscapeDataString(_well.Id)}";

