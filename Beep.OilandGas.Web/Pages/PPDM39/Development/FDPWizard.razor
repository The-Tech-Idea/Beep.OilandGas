@page "/development/fdp"
@page "/development/fdp/new"
@using Beep.OilandGas.Models.Data.Development
@using Beep.OilandGas.Models.Data
@inject ApiClient ApiClient
@inject IDevelopmentServiceClient DevelopmentServiceClient
@inject ILifeCycleService LifeCycleService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject OilGasApiFailures Answers
@inject FailureNotifier Notifier

<PageTitle>Build Field Development Plan</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">

    @* ── Header ──────────────────────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-6">
        <MudTooltip Text="Back to Development">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Href="@GetBackHref()"
                           aria-label="Back to Development" />
        </MudTooltip>
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Build Field Development Plan</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_fieldName — @(_wizardMode ? "Create new FDP document" : "Current FDP status and approvals")</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.Construction">Development</MudChip>
            </MudStack>
        </MudStack>
        <MudSpacer />
        @if (!_wizardMode)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="StartRevision">
                Revise FDP
            </MudButton>
        }
    </MudStack>

    @* ─────────────────────────────────────────────────────────────────────── *@
    @* VIEW MODE — Existing FDP                                                *@
    @* ─────────────────────────────────────────────────────────────────────── *@
    @if (!_wizardMode)
    {
        <MudGrid Spacing="3">

            @* FDP Status card *@
            <MudItem xs="12" md="4">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1">FDP Status</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudStack Spacing="2" AlignItems="AlignItems.Center">
                            <StatusBadge Status="@_fdp.Status" Size="Size.Large" />
                            @* No version number: nothing records an FDP's version (it showed a constant "1.0"); the date is the gate review's start. *@
                            @if (!string.IsNullOrEmpty(_fdp.LastUpdated))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Submitted @_fdp.LastUpdated</MudText>
                            }
                        </MudStack>
                        <MudDivider Class="my-3" />
                        <ProcessTimeline Steps="@_fdpStatusHistory" />
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.TrackChanges"
                                   OnClick="TrackRegulatorResponse">
                            Track Regulator Response
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            @* FDP Summary — the draft as submitted, kept with the gate review's drafting step *@
            <MudItem xs="12" md="8">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1">FDP Summary</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_fdpStatus is null)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">The FDP could not be loaded.</MudAlert>
                        }
                        else if (_fdpStatus.Draft is not { } plan)
                        {
                            @* A gate review started before drafts were stored kept none; its figures are not shown as zeros. *@
                            <MudAlert Severity="Severity.Info" Dense="true">
                                This FDP's contents were not kept when it was submitted; only its gate review was started. Revise the FDP to submit its contents.
                            </MudAlert>
                        }
                        else
                        {
                            <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="false">
                                <MudTabPanel Text="Reservoir">
                                    <MudStack Spacing="2" Class="pa-2">
                                        <MudStack Row="true" Spacing="2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-md">STOIIP</MudText>
                                            <MudText Typo="Typo.body2">@Figure(plan.StoiipMmbo, string.Empty, " MMBO")</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-md">GIIP</MudText>
                                            <MudText Typo="Typo.body2">@Figure(plan.GiipBcf, string.Empty, " BCF")</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-md">Recovery Factor</MudText>
                                            <MudText Typo="Typo.body2">@Figure(plan.RecoveryFactor, string.Empty, "%")</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-md">2P Reserves</MudText>
                                            <MudText Typo="Typo.body2">@Figure(plan.ReservesMmbo, string.Empty, " MMBO")</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-md">Reserves Classification</MudText>
                                            <MudText Typo="Typo.body2">@Entered(plan.ReservesClass)</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-md">Reservoir Description</MudText>
                                            <MudText Typo="Typo.body2">@Entered(plan.ReservoirDescription)</MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudTabPanel>
                                <MudTabPanel Text="Concept">
                                    <MudPaper Elevation="0" Class="pa-3">
                                        <MudText Typo="Typo.subtitle2" Class="mb-1">Selected Concept</MudText>
                                        <MudText Typo="Typo.body2">@Entered(plan.SelectedConcept)</MudText>
                                        <MudDivider Class="my-2" />
                                        <MudText Typo="Typo.subtitle2" Class="mb-1">Facility Type</MudText>
                                        <MudText Typo="Typo.body2">@Entered(plan.FacilityType)</MudText>
                                        <MudDivider Class="my-2" />
                                        <MudText Typo="Typo.subtitle2" Class="mb-1">Concept Selection Rationale</MudText>
                                        <MudText Typo="Typo.body2">@Entered(plan.ConceptRationale)</MudText>
                                    </MudPaper>
                                </MudTabPanel>
                                <MudTabPanel Text="Well Program">
                                    @if (plan.WellProgram.Count == 0)
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-2">No wells were planned in this draft.</MudText>
                                    }
                                    else
                                    {
                                        <MudDataGrid T="FdpWellProgramItem" Items="@plan.WellProgram" Dense="true" Hover="true" Striped="true">
                                            <Columns>
                                                <PropertyColumn Property="w => w.WellName" Title="Well Name" />
                                                <PropertyColumn Property="w => w.WellType" Title="Type" />
                                                <PropertyColumn Property="w => w.TargetZone" Title="Target Zone" />
                                                <PropertyColumn Property="w => w.PlannedYear" Title="Year" />
                                            </Columns>
                                        </MudDataGrid>
                                    }
                                </MudTabPanel>
                                <MudTabPanel Text="Economics">
                                    <MudStack Spacing="2" Class="pa-2">
                                        <MudStack Row="true" Spacing="2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-md">Total CAPEX</MudText>
                                            <MudText Typo="Typo.body2">@Figure(plan.CapexMm, "USD ", " MM")</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-md">Peak OPEX</MudText>
                                            <MudText Typo="Typo.body2">@Figure(plan.OpexMmPerYear, "USD ", " MM/yr")</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-md">NPV (10%)</MudText>
                                            <MudText Typo="Typo.body2" Color="@NpvColor(plan.Npv10Mm)">@Figure(plan.Npv10Mm, "USD ", " MM")</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-md">IRR</MudText>
                                            <MudText Typo="Typo.body2">@Figure(plan.Irr, string.Empty, "%")</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-md">Breakeven Price</MudText>
                                            <MudText Typo="Typo.body2">@Figure(plan.BreakevenUsd, "USD ", "/bbl")</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-md">Risked Economics Notes</MudText>
                                            <MudText Typo="Typo.body2">@Entered(plan.EconomicsNotes)</MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudTabPanel>
                                <MudTabPanel Text="Regulatory">
                                    <MudStack Spacing="2" Class="pa-2">
                                        <MudStack Row="true" Spacing="2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-md">Jurisdiction</MudText>
                                            <MudText Typo="Typo.body2">@Entered(plan.Jurisdiction)</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-md">Required Permits</MudText>
                                            <MudText Typo="Typo.body2">@Entered(plan.PermitList)</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-md">Planned Submission</MudText>
                                            <MudText Typo="Typo.body2">@(plan.SubmissionDate?.ToString("dd MMM yyyy") ?? NotEntered)</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-md">Expected Approval</MudText>
                                            <MudText Typo="Typo.body2">@(plan.ExpectedApprovalDate?.ToString("dd MMM yyyy") ?? NotEntered)</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="og-label-md">Regulatory Notes</MudText>
                                            <MudText Typo="Typo.body2">@Entered(plan.RegulatoryNotes)</MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudTabPanel>
                            </MudTabs>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

        </MudGrid>
    }

    @* ─────────────────────────────────────────────────────────────────────── *@
    @* WIZARD MODE — New / Revise FDP                                          *@
    @* ─────────────────────────────────────────────────────────────────────── *@
    else
    {
        <MudStepper @bind-ActiveIndex="_step" StepCompleteIcon="@Icons.Material.Filled.CheckCircle">

            @* Step 1: Reservoir Summary *@
            <MudStep Title="Reservoir Summary">
                <MudGrid Spacing="3" Class="pt-4">
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_draft.StoiipMmbo" Label="STOIIP (MMBO)" Variant="Variant.Outlined" Min="0" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_draft.GiipBcf" Label="GIIP (BCF)" Variant="Variant.Outlined" Min="0" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_draft.RecoveryFactor" Label="Recovery Factor (%)" Variant="Variant.Outlined" Min="0" Max="100" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_draft.ReservesMmbo" Label="2P Reserves (MMBO)" Variant="Variant.Outlined" Min="0" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="_draft.ReservesClass" Label="Reserves Classification" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("1P — Proved")">1P — Proved</MudSelectItem>
                            <MudSelectItem T="string" Value="@("2P — Proved+Probable")">2P — Proved+Probable</MudSelectItem>
                            <MudSelectItem T="string" Value="@("2C — Contingent")">2C — Contingent</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_draft.ReservoirDescription" Label="Reservoir Description" Lines="3" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NextStep">Continue →</MudButton>
                </MudStack>
            </MudStep>

            @* Step 2: Development Concept *@
            <MudStep Title="Development Concept">
                <MudGrid Spacing="3" Class="pt-4">
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Concept Options Considered</MudText>
                        <MudDataGrid T="ConceptOption" Items="@_draft.Concepts" Dense="true" Hover="true" Striped="true">
                            <Columns>
                                <PropertyColumn Property="c => c.Name" Title="Concept" />
                                <PropertyColumn Property="c => c.CapexMm" Title="CAPEX (MM)" />
                                <TemplateColumn Title="Recovery">
                                    <CellTemplate><MudText Typo="Typo.body2">@context.Item.Recovery%</MudText></CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Risk">
                                    <CellTemplate>
                                        <MudChip T="string" Size="Size.Small" Color="@GetConceptRiskColor(context.Item.Risk)">@context.Item.Risk</MudChip>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Selected">
                                    <CellTemplate>
                                        @if (context.Item.IsSelected)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_draft.SelectedConcept" Label="Selected Concept Name" Variant="Variant.Outlined" Required="true" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_draft.FacilityType" Label="Facility Type" Variant="Variant.Outlined"
                                      Placeholder="e.g. Floating Production Storage Offloading (FPSO)" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_draft.ConceptRationale" Label="Concept Selection Rationale" Lines="3" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-4">
                    <MudButton Variant="Variant.Text" OnClick="PrevStep">← Back</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NextStep">Continue →</MudButton>
                </MudStack>
            </MudStep>

            @* Step 3: Well Program *@
            <MudStep Title="Well Program">
                <MudPaper Elevation="0" Class="pt-4">
                    <MudStack Spacing="1" Class="mb-3">
                        <MudText Typo="Typo.subtitle2">Planned Wells</MudText>
                        @* No "Add Well": the rows cannot be edited here, so it could only add a fixed "New Well" placeholder, which is now kept with the plan. *@
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            The planned wells are the field's development wells. Adding a well that is not yet recorded is not available here.
                        </MudText>
                    </MudStack>
                    <MudDataGrid T="WellRow" Items="@_draft.WellProgram" Dense="true" Hover="true" Striped="true">
                        <Columns>
                            <PropertyColumn Property="w => w.WellName" Title="Well Name" />
                            <TemplateColumn Title="Type">
                                <CellTemplate>
                                    <MudChip T="string" Size="Size.Small" Color="@GetWellTypeColor(context.Item.WellType)">@context.Item.WellType</MudChip>
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="w => w.TargetZone" Title="Target Zone" />
                            <PropertyColumn Property="w => w.PlannedYear" Title="Year" />
                            <TemplateColumn Title="">
                                <CellTemplate>
                                    <MudTooltip Text="Remove well">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="Remove well" Size="Size.Small" Color="Color.Error"
                                                       OnClick="@(() => _draft.WellProgram.Remove(context.Item))" />
                                    </MudTooltip>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                        Total: @_draft.WellProgram.Count wells (@_draft.WellProgram.Count(w => w.WellType=="Producer") producers, @_draft.WellProgram.Count(w => w.WellType=="Injector") injectors)
                    </MudText>
                </MudPaper>
                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-4">
                    <MudButton Variant="Variant.Text" OnClick="PrevStep">← Back</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NextStep">Continue →</MudButton>
                </MudStack>
            </MudStep>

            @* Step 4: Economics *@
            <MudStep Title="Economics">
                <MudGrid Spacing="3" Class="pt-4">
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="_draft.CapexMm" Label="Total CAPEX (USD MM)" Variant="Variant.Outlined" Min="0" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="_draft.OpexMmPerYear" Label="Peak OPEX (USD MM/yr)" Variant="Variant.Outlined" Min="0" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_draft.Npv10Mm" Label="NPV 10% (USD MM)" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_draft.Irr" Label="IRR (%)" Variant="Variant.Outlined" Min="0" Max="100" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_draft.BreakevenUsd" Label="Breakeven (USD/bbl)" Variant="Variant.Outlined" Min="0" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_draft.EconomicsNotes" Label="Risked Economics Notes" Lines="3" Variant="Variant.Outlined"
                                      Placeholder="Describe key sensitivities, oil price assumptions, risked case…" />
                    </MudItem>
                </MudGrid>
                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-4">
                    <MudButton Variant="Variant.Text" OnClick="PrevStep">← Back</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NextStep">Continue →</MudButton>
                </MudStack>
            </MudStep>

            @* Step 5: Regulatory Plan *@
            <MudStep Title="Regulatory Plan">
                <MudGrid Spacing="3" Class="pt-4">
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_draft.Jurisdiction" Label="Jurisdiction / Regulatory Body" Variant="Variant.Outlined" Required="true" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_draft.PermitList" Label="Required Permits (comma-separated)" Variant="Variant.Outlined"
                                      Placeholder="FDP Approval, Environmental Permit, Well Consent…" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudDatePicker @bind-Date="_draft.SubmissionDate" Label="Planned Submission Date" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudDatePicker @bind-Date="_draft.ExpectedApprovalDate" Label="Expected Approval Date" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_draft.RegulatoryNotes" Label="Regulatory Notes" Lines="3" Variant="Variant.Outlined"
                                      Placeholder="Track record with this regulator, anticipated queries, pre-application meetings…" />
                    </MudItem>
                </MudGrid>
                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-4">
                    <MudButton Variant="Variant.Text" OnClick="PrevStep">← Back</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Send"
                               OnClick="SubmitFDPAsync"
                               Disabled="@(_submittingFdp || string.IsNullOrWhiteSpace(_draft.Jurisdiction))">
                        @(_submittingFdp ? "Submitting…" : "Submit FDP Draft")
                    </MudButton>
                </MudStack>
            </MudStep>

        </MudStepper>
    }

</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "jurisdiction")]
    public string? PrefillJurisdiction { get; set; }

    [SupplyParameterFromQuery(Name = "permitList")]
    public string? PrefillPermitList { get; set; }

    [SupplyParameterFromQuery(Name = "regulatoryNotes")]
    public string? PrefillRegulatoryNotes { get; set; }

    [SupplyParameterFromQuery(Name = "returnTo")]
    public string? ReturnTo { get; set; }

    private string _fieldName = string.Empty;
    private bool _wizardMode;
    private int _step;
    private string? _regulatoryPrefillKey;

    private FDPViewModel _fdp = new();
    private FDPDraft _draft = new();

    private FdpStatusResponse? _fdpStatus;
    private List<ProcessStep> _fdpStatusHistory = new();

    protected override async Task OnInitializedAsync()
    {
        _wizardMode = NavigationManager.Uri.EndsWith("/development/fdp/new", StringComparison.OrdinalIgnoreCase);

        try
        {
            var summary = await LifeCycleService.GetFieldLifecycleSummaryAsync();
            if (summary != null)
                _fieldName = summary.FieldName ?? _fieldName;
        }
        // Only the field's name in the header depends on it; the person is told it could not be read.
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "loading the active field's name for the development plan", "The field's name could not be loaded"), Severity.Warning);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "loading the active field's name for the development plan", "The field's name could not be loaded", FailureSeverity.Degraded);
        }

        await LoadFdpStatusAsync();

        try
        {
            var wells = await DevelopmentServiceClient.GetWellsAsync();
            if (wells.Count > 0)
            {
                _draft.WellProgram = wells
                    .Where(w => w.ACTIVE_IND == "Y")
                    .Select(w => new WellRow(
                        w.UWI ?? string.Empty,
                        w.WELL_TYPE ?? w.CURRENT_CLASS ?? string.Empty,
                        string.Empty,
                        null))
                    .ToList();
            }
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "loading the development wells for the plan's well program", "The development wells could not be loaded"), Severity.Warning);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "loading the development wells for the plan's well program", "The development wells could not be loaded", FailureSeverity.Degraded);
        }

        ApplyRegulatoryPrefill();
    }

    protected override void OnParametersSet()
    {
        ApplyRegulatoryPrefill();
    }

    // The field's current FDP gate review and the draft kept with it. What was shown before is cleared first, so a
    // failed load shows nothing rather than another submission's plan.
    private async Task LoadFdpStatusAsync()
    {
        _fdpStatus = null;
        _fdp = new();
        _fdpStatusHistory = new();
        try
        {
            _fdpStatus = await DevelopmentServiceClient.GetFdpStatusAsync();
            if (_fdpStatus?.HasFdp == true && _fdpStatus.Steps.Count > 0)
            {
                _fdp.Status = _fdpStatus.Status;
                _fdp.LastUpdated = _fdpStatus.StartDate?.ToString("MMM yyyy") ?? string.Empty;
                _fdpStatusHistory = _fdpStatus.Steps
                    .Select(s => new ProcessStep(s.StepName, s.CompletedDate, s.IsCompleted, s.IsActive))
                    .ToList();
            }
            else if (!_wizardMode)
            {
                _wizardMode = true;
            }
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "loading the field development plan's status", "The FDP status could not be loaded"), Severity.Warning);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "loading the field development plan's status", "The FDP status could not be loaded", FailureSeverity.Degraded);
        }
    }

    // A revision starts from the draft as submitted, when the gate review kept one.
    private void StartRevision()
    {
        if (_fdpStatus?.Draft is { } plan)
            _draft = FDPDraft.From(plan);
        _wizardMode = true;
        _step = 0;
    }

    private void NextStep() { if (_step < 4) _step++; }
    private void PrevStep() { if (_step > 0) _step--; }

    private void TrackRegulatorResponse() =>
        NavigationManager.NavigateTo($"/hse/compliance?returnTo={Uri.EscapeDataString("/development/fdp")}");

    private bool _submittingFdp;

    private async Task SubmitFDPAsync()
    {
        _submittingFdp = true;
        try
        {
            var request = new SubmitFdpDraftRequest
            {
                StoiipMmbo           = _draft.StoiipMmbo,
                GiipBcf              = _draft.GiipBcf,
                RecoveryFactor       = _draft.RecoveryFactor,
                ReservesMmbo         = _draft.ReservesMmbo,
                ReservesClass        = _draft.ReservesClass,
                ReservoirDescription = _draft.ReservoirDescription,
                SelectedConcept      = _draft.SelectedConcept,
                FacilityType         = _draft.FacilityType,
                ConceptRationale     = _draft.ConceptRationale,
                CapexMm              = _draft.CapexMm,
                OpexMmPerYear        = _draft.OpexMmPerYear,
                Npv10Mm              = _draft.Npv10Mm,
                Irr                  = _draft.Irr,
                BreakevenUsd         = _draft.BreakevenUsd,
                EconomicsNotes       = _draft.EconomicsNotes,
                Jurisdiction         = _draft.Jurisdiction,
                PermitList           = _draft.PermitList,
                SubmissionDate       = _draft.SubmissionDate,
                ExpectedApprovalDate = _draft.ExpectedApprovalDate,
                RegulatoryNotes      = _draft.RegulatoryNotes,
                WellProgram          = (_draft.WellProgram ?? new()).Select(w => new FdpWellProgramItem
                {
                    WellName    = w.WellName,
                    WellType    = w.WellType,
                    TargetZone  = w.TargetZone,
                    PlannedYear = w.PlannedYear
                }).ToList()
            };

            await DevelopmentServiceClient.SubmitFdpAsync(request);

            Snackbar.Add("The FDP draft was saved and its gate review started.", Severity.Success);
            _wizardMode = false;
            // The view shows the plan as the API kept it, read again rather than taken from the form.
            await LoadFdpStatusAsync();
            NavigationManager.NavigateTo("/development/fdp");
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "submitting the field development plan draft", "The FDP draft was not submitted"), Severity.Error);
        }
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "submitting the field development plan draft", "The FDP draft was not submitted");
        }
        finally { _submittingFdp = false; }
    }

    // The gate review's status; the plan's contents are the draft the API returns with it (_fdpStatus.Draft).
    private class FDPViewModel
    {
        public string Status { get; set; } = string.Empty;
        public string LastUpdated { get; set; } = string.Empty;
    }

    private const string NotEntered = "Not entered";

    private static string Entered(string? value) => string.IsNullOrWhiteSpace(value) ? NotEntered : value;

    private static string Figure(double? value, string before, string after) =>
        value is double figure ? $"{before}{figure.ToString("0.##", CultureInfo.CurrentCulture)}{after}" : NotEntered;

    private static Color NpvColor(double? npv) =>
        npv is not double value ? Color.Default : value >= 0 ? Color.Success : Color.Error;

    // A figure not entered stays empty (null) and is submitted as not entered, never as 0 or a preset estimate.
    private class FDPDraft
    {
        public double? StoiipMmbo { get; set; }
        public double? GiipBcf { get; set; }
        public double? RecoveryFactor { get; set; }
        public double? ReservesMmbo { get; set; }
        public string ReservesClass { get; set; } = "2P — Proved+Probable";
        public string ReservoirDescription { get; set; } = string.Empty;
        public List<ConceptOption> Concepts { get; set; } = new();
        public string SelectedConcept { get; set; } = string.Empty;
        public string FacilityType { get; set; } = string.Empty;
        public string ConceptRationale { get; set; } = string.Empty;
        public List<WellRow> WellProgram { get; set; } = new();
        public double? CapexMm { get; set; }
        public double? OpexMmPerYear { get; set; }
        public double? Npv10Mm { get; set; }
        public double? Irr { get; set; }
        public double? BreakevenUsd { get; set; }
        public string EconomicsNotes { get; set; } = string.Empty;
        public string Jurisdiction { get; set; } = string.Empty;
        public string PermitList { get; set; } = string.Empty;
        public DateTime? SubmissionDate { get; set; }
        public DateTime? ExpectedApprovalDate { get; set; }
        public string RegulatoryNotes { get; set; } = string.Empty;

        public static FDPDraft From(SubmitFdpDraftRequest plan) => new()
        {
            StoiipMmbo           = plan.StoiipMmbo,
            GiipBcf              = plan.GiipBcf,
            RecoveryFactor       = plan.RecoveryFactor,
            ReservesMmbo         = plan.ReservesMmbo,
            ReservesClass        = plan.ReservesClass,
            ReservoirDescription = plan.ReservoirDescription,
            SelectedConcept      = plan.SelectedConcept,
            FacilityType         = plan.FacilityType,
            ConceptRationale     = plan.ConceptRationale,
            WellProgram          = plan.WellProgram.Select(w => new WellRow(w.WellName, w.WellType, w.TargetZone, w.PlannedYear)).ToList(),
            CapexMm              = plan.CapexMm,
            OpexMmPerYear        = plan.OpexMmPerYear,
            Npv10Mm              = plan.Npv10Mm,
            Irr                  = plan.Irr,
            BreakevenUsd         = plan.BreakevenUsd,
            EconomicsNotes       = plan.EconomicsNotes,
            Jurisdiction         = plan.Jurisdiction,
            PermitList           = plan.PermitList,
            SubmissionDate       = plan.SubmissionDate,
            ExpectedApprovalDate = plan.ExpectedApprovalDate,
            RegulatoryNotes      = plan.RegulatoryNotes,
        };
    }

    private record ConceptOption(string Name, double CapexMm, double Recovery, string Risk, bool IsSelected);

    private static Color GetConceptRiskColor(string risk) => risk switch
    {
        "Low"    => Color.Success,
        "Medium" => Color.Warning,
        _        => Color.Error
    };
    private static Color GetWellTypeColor(string wellType) => wellType == "Producer" ? Color.Primary : Color.Info;
    private string GetBackHref() => string.IsNullOrWhiteSpace(ReturnTo) ? "/development" : ReturnTo;

    private void ApplyRegulatoryPrefill()
    {
        var key = string.Join("|",
            PrefillJurisdiction ?? string.Empty,
            PrefillPermitList ?? string.Empty,
            PrefillRegulatoryNotes ?? string.Empty,
            ReturnTo ?? string.Empty);

        if (string.Equals(_regulatoryPrefillKey, key, StringComparison.Ordinal))
            return;

        if (!string.IsNullOrWhiteSpace(PrefillJurisdiction) && string.IsNullOrWhiteSpace(_draft.Jurisdiction))
            _draft.Jurisdiction = PrefillJurisdiction;

        if (!string.IsNullOrWhiteSpace(PrefillPermitList) && string.IsNullOrWhiteSpace(_draft.PermitList))
            _draft.PermitList = PrefillPermitList;

        if (!string.IsNullOrWhiteSpace(PrefillRegulatoryNotes) && string.IsNullOrWhiteSpace(_draft.RegulatoryNotes))
            _draft.RegulatoryNotes = PrefillRegulatoryNotes;

        _regulatoryPrefillKey = key;
    }

    private class WellRow
    {
        public string WellName { get; set; }
        public string WellType { get; set; }
        public string TargetZone { get; set; }
        // Null until a year is planned: a well's record holds no planned year, and none is invented.
        public int? PlannedYear { get; set; }
        public WellRow(string n, string t, string z, int? y) { WellName=n; WellType=t; TargetZone=z; PlannedYear=y; }
    }
}
