@page "/development/fdp"
@page "/development/fdp/new"
@using System.Globalization
@using MudBlazor
@using Beep.OilandGas.Client.App
@using Beep.OilandGas.Models.Data.DevelopmentPlanning
@using Beep.OilandGas.Web.Services
@using TheTechIdea.Data.OilGas
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@inject CompanyClientContext Company
@inject IFieldSelectionContext Fields
@inject IDevelopmentServiceClient Development
@inject IDevelopmentDraftIntentStore Journal
@inject OilGasCallFailures Calls

<PageTitle>Field development drafts</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
    <MudText Typo="Typo.h4" HtmlTag="h1">Field development drafts</MudText>
    <MudText Class="mb-4">Review recorded drafts and prepare a field development concept for your company.</MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-4">
        <MudButton Href="/development" Variant="Variant.Outlined">Development workspace</MudButton>
        <MudButton Href="/development/well-design" Variant="Variant.Outlined">Inspect development wells</MudButton>
        <MudButton Href="/tasks/inbox" Variant="Variant.Outlined">Assigned review work</MudButton>
        <MudButton OnClick="Reload" Disabled="@(_state?.Busy==true || _state?.Loading==true)" StartIcon="@Icons.Material.Filled.Refresh">Reload drafts</MudButton>
    </MudStack>
    @if (_state?.NeedsCompany!=false)
    {
        <MudAlert Severity="Severity.Info">Choose a company to open its field development drafts.</MudAlert>
    }
    else if (!_state.CanView)
    {
        <MudAlert Severity="Severity.Info">Your current company role needs Development Planning View permission to open this workspace.</MudAlert>
    }
    else if (_state.Loading)
    {
        <MudProgressLinear Indeterminate="true" aria-label="Loading development drafts" />
    }
    else
    {
        @if (_state.Error is not null){<MudAlert Severity="Severity.Error" Class="mb-3">@_state.Error</MudAlert>}
        @if (_state.Confirmation is not null){<MudAlert Severity="Severity.Success" Class="mb-3">@_state.Confirmation</MudAlert>}
        @if (_state.NeedsField)
        {
            <MudAlert Severity="Severity.Info">Choose an available FIELD in the field selector, then reload drafts.</MudAlert>
        }
        else if (_state.Loaded)
        {
            <MudPaper Class="pa-4 mb-4" Outlined="true">
                <MudText>Company: @_state.Context!.Company.TenantId / @_state.Context.Company.BusinessAssociateId</MudText>
                <MudText>FIELD: @_state.FieldName (@_state.Context.FieldId)</MudText>
                <MudText Typo="Typo.caption">Source checked: @_state.CheckedAtUtc?.ToString("u",CultureInfo.InvariantCulture)</MudText>
            </MudPaper>
            @if (_state.Pending is {} pending)
            {
                <MudPaper Class="pa-4 mb-4" Outlined="true">
                    <MudText Typo="Typo.h6" HtmlTag="h2">Recover the original draft</MudText>
                    <MudText>@pending.PlanName</MudText>
                    <MudText>Original FIELD: @pending.FieldId</MudText>
                    <MudText>The saved outcome needs confirmation. Keep this tab session until recovery completes.</MudText>
                    @if (!_state.CanRecover){<MudAlert Severity="Severity.Info">Return to the original FIELD and database binding with Development Planning Create permission to recover this draft.</MudAlert>}
                    <MudButton OnClick="Recover" Disabled="@(!_state.CanRecover || _state.Busy)" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Check original draft outcome</MudButton>
                </MudPaper>
            }
            else if (_state.Review is {} review)
            {
                <MudPaper Class="pa-4 mb-4" Outlined="true">
                    <MudText Typo="Typo.h6" HtmlTag="h2">Review draft before saving</MudText>
                    <MudText>Plan: @review.PlanName</MudText>
                    <MudText>Description: @(string.IsNullOrEmpty(review.Description)?"Not recorded":review.Description)</MudText>
                    <MudText>Planned first production: @Date(review.PlannedFirstProductionDate)</MudText>
                    <MudText>Planned field life end: @Date(review.PlannedFieldLifeEndDate)</MudText>
                    <MudText>Estimated CAPEX: @Amount(review.EstimatedCapexMillions,review.CapexCurrency)</MudText>
                    <MudText Class="mb-3">Saving records a draft. Submission and approval require their separate review workflows.</MudText>
                    <MudStack Row="true" Wrap="Wrap.Wrap">
                        <MudButton OnClick="Edit" Disabled="@_state.Busy" Variant="Variant.Outlined">Edit inputs</MudButton>
                        <MudButton OnClick="Save" Disabled="@_state.Busy" Variant="Variant.Filled" Color="Color.Primary">Save reviewed draft</MudButton>
                    </MudStack>
                </MudPaper>
            }
            else if (_state.CanCreate)
            {
                <MudPaper Class="pa-4 mb-4" Outlined="true">
                    <MudText Typo="Typo.h6" HtmlTag="h2">Prepare a development draft</MudText>
                    <MudForm @ref="_form">
                        <MudGrid Class="mt-1">
                            <MudItem xs="12"><MudTextField T="string" @bind-Value="_name" Label="Plan name" Required="true" RequiredError="Enter a plan name." MaxLength="200" Variant="Variant.Outlined" Disabled="@(!_state.CanEdit)" /></MudItem>
                            <MudItem xs="12"><MudTextField T="string" @bind-Value="_description" Label="Development concept description" Lines="4" MaxLength="4000" Variant="Variant.Outlined" Disabled="@(!_state.CanEdit)" /></MudItem>
                            <MudItem xs="12" md="6"><MudDatePicker @bind-Date="_firstProduction" Label="Planned first production date" DateFormat="yyyy-MM-dd" MinDate="@(new DateTime(1900,1,1))" Editable="true" Variant="Variant.Outlined" Disabled="@(!_state.CanEdit)" HelperText="Company calendar date" /></MudItem>
                            <MudItem xs="12" md="6"><MudDatePicker @bind-Date="_lifeEnd" Label="Planned field life end date" DateFormat="yyyy-MM-dd" MinDate="@(new DateTime(1900,1,1))" Editable="true" Variant="Variant.Outlined" Disabled="@(!_state.CanEdit)" HelperText="Company calendar date" /></MudItem>
                            <MudItem xs="12" md="6"><MudNumericField T="decimal?" @bind-Value="_cost" Label="Estimated CAPEX (millions)" Min="0" Variant="Variant.Outlined" Disabled="@(!_state.CanEdit)" HelperText="Leave blank if no estimate is recorded." /></MudItem>
                            <MudItem xs="12" md="6"><MudSelect T="string" @bind-Value="_currency" Label="CAPEX currency" Clearable="true" Variant="Variant.Outlined" Disabled="@(!_state.CanEdit)">
                                @foreach(var currency in _state.Currencies){<MudSelectItem T="string" Value="@currency">@currency</MudSelectItem>}
                            </MudSelect></MudItem>
                        </MudGrid>
                        <MudButton OnClick="Review" Disabled="@(!_state.CanEdit)" Class="mt-4" Variant="Variant.Filled" Color="Color.Primary">Review draft inputs</MudButton>
                    </MudForm>
                </MudPaper>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">Your current company role can view drafts. Create permission is required to prepare a draft.</MudAlert>
            }
            @if (_state.Busy){<MudProgressLinear Indeterminate="true" aria-label="Checking original development draft" Class="mb-3" />}
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Recorded company FIELD drafts</MudText>
            <MudTable T="FIELD_DEVELOPMENT_PLAN" Items="@_state.Rows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent><MudTh>Plan</MudTh><MudTh>Draft identity</MudTh><MudTh>Estimated CAPEX</MudTh><MudTh>Planned dates</MudTh><MudTh>Recorded by</MudTh><MudTh>Source review</MudTh></HeaderContent>
                <RowTemplate Context="row">
                    <MudTd DataLabel="Plan">@row.FDP_NAME</MudTd>
                    <MudTd DataLabel="Draft identity" Class="development-draft-identity">@row.FDP_ID</MudTd>
                    <MudTd DataLabel="Estimated CAPEX">@Amount(row.TOTAL_CAPEX_MM,row.CAPEX_CURRENCY)</MudTd>
                    <MudTd DataLabel="Planned dates">First production: @SourceDate(row.FIRST_PRODUCTION_DATE)<br />Field life end: @SourceDate(row.FIELD_LIFE_END)</MudTd>
                    <MudTd DataLabel="Recorded by">@row.ROW_CREATED_BY<br />@row.ROW_CREATED_DATE?.ToString("u",CultureInfo.InvariantCulture)</MudTd>
                    <MudTd DataLabel="Source review"><MudButton Href="@("/development/fdp/review?planId="+Uri.EscapeDataString(row.FDP_ID))" Variant="Variant.Outlined">Open draft @row.FDP_NAME</MudButton></MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>No recorded development drafts were returned for this company FIELD.</MudText></NoRecordsContent>
            </MudTable>
        }
        else if (_state.Error is null)
        {
            <MudAlert Severity="Severity.Info">Reload to review the current company FIELD and its drafts.</MudAlert>
        }
    }
</MudContainer>

@code {
    private DevelopmentDraftWorkspaceState? _state;
    private MudForm? _form;
    private string _name="";
    private string? _description,_currency;
    private DateTime? _firstProduction,_lifeEnd;
    private decimal? _cost;
    private bool _disposed;
    protected override void OnInitialized(){_state=new(Company,Fields,Development,Journal,Calls.Explain);_state.Changed+=Changed;}
    // Protected browser storage is available after interactive rendering.
    protected override async Task OnAfterRenderAsync(bool firstRender){if(firstRender){await Reload();if(!_disposed)StateHasChanged();}}
    private async Task Reload(){ClearInputs();await _state!.LoadAsync();}
    private async Task Review(){if(_form is null)return;await _form.Validate();if(!_form.IsValid)return;_state!.ReviewInput(_name,_description,Calendar(_firstProduction),Calendar(_lifeEnd),_cost,_currency);}
    private void Edit()=>_state!.EditReview();
    private async Task Save(){await _state!.SaveAsync();if(_state.Confirmation is not null)ClearInputs();}
    private Task Recover()=>_state!.RecoverAsync();
    private void ClearInputs(){_name="";_description=null;_currency=null;_firstProduction=null;_lifeEnd=null;_cost=null;}
    private void Changed(){if(!_disposed){if(!_state!.Loaded)ClearInputs();_=InvokeAsync(StateHasChanged);}}
    private static DateOnly? Calendar(DateTime? value)=>value is {} date?DateOnly.FromDateTime(date):null;
    private static string Date(DateOnly? value)=>value?.ToString("yyyy-MM-dd",CultureInfo.InvariantCulture) ?? "Not recorded";
    private static string SourceDate(DateTime? value)=>value?.ToString("yyyy-MM-dd",CultureInfo.InvariantCulture) ?? "Not recorded";
    private static string Amount(decimal? value,string? currency)=>value is null?"Not recorded":value.Value.ToString("0.############################",CultureInfo.InvariantCulture)+" million "+currency;
    public void Dispose(){_disposed=true;if(_state is not null){_state.Changed-=Changed;_state.Dispose();}}
}
