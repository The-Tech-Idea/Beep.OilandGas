@page "/ppdm39/wells/compare"
@using Beep.OilandGas.Models.Data
@using Beep.OilandGas.Web.Services
@inject ApiClient ApiClient
@inject IDataManagementService DataManagementService
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@inject ISnackbar Snackbar
@inject IClientFileExportService ExportService
@inject OilGasCallFailures Calls

<PageTitle>Compare Well Properties</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">

    @* ─── Header ─── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Compare Well Properties</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Compare explicit well UWIs. Results are not filtered by the active field.</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                         Icon="@Icons.Material.Filled.CompareArrows">Well</MudChip>
            </MudStack>
        </MudStack>
        <MudButton Variant="Variant.Outlined" Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Download"
                   OnClick="ExportComparisonAsync"
                   Disabled="@(_comparison == null)">
            Export
        </MudButton>
    </MudStack>

    @* ─── UWI Input ─── *@
    <MudCard Elevation="1" Class="mb-4">
        <MudCardContent>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_well1Uwi" @bind-Value:after="InputsChanged" Immediate="true" Disabled="@_isLoading" Label="Well 1 UWI" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_well2Uwi" @bind-Value:after="InputsChanged" Immediate="true" Disabled="@_isLoading" Label="Well 2 UWI" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_well3Uwi" @bind-Value:after="InputsChanged" Immediate="true" Disabled="@_isLoading" Label="Well 3 UWI (Optional)" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.CompareArrows"
                       OnClick="PerformComparison"
                       Disabled="@_isLoading" Class="mt-3">Compare Wells</MudButton>
        </MudCardContent>
    </MudCard>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    @if (_state?.Error is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">@_state.Error</MudAlert>
    }
    @if (_comparison is not null && _comparison.ComparisonFields.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No comparable attributes were returned for these wells.</MudAlert>
    }

    @* Results Grid *@
    @if (_comparison != null)
    {
        <ComparisonGridCard TItem="ComparisonField"
                            Items="@_comparison.ComparisonFields"
                            Title="Comparison Results"
                            TitleTypo="Typo.h6">
            <ColumnContent>
                <PropertyColumn T="ComparisonField" TProperty="string" Property="f => f.DisplayLabel" Title="Field" />
                @foreach (var well in _comparison.Wells)
                {
                    var w = well;
                    <TemplateColumn T="ComparisonField" Title="@w.WellName">
                        <CellTemplate>
                            <MudText Typo="Typo.body2">
                                @(w.FieldValues.ContainsKey(context.Item.FieldName)
                                    ? w.FieldValues[context.Item.FieldName]?.ToString() ?? "—"
                                    : "—")
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                }
                <TemplateColumn T="ComparisonField" Title="Differences">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.Item.HasDifferences ? Color.Warning : Color.Success)">
                            @(context.Item.HasDifferences ? "Different" : "Same")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
            </ColumnContent>
        </ComparisonGridCard>
    }

</MudContainer>

@code {
    private string _well1Uwi = string.Empty;
    private string _well2Uwi = string.Empty;
    private string _well3Uwi = string.Empty;
    private WellComparisonState? _state;
    private WellComparisonData? _comparison => _state?.Result;
    private bool _isLoading => _state?.Loading == true;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _state = new(request => ApiClient.PostAsync<CompareWellsRequest, WellComparisonData>("/api/well/compare", request), Calls);
        DataManagementService.CurrentFieldChanged += FieldChanged;
    }

    private void InputsChanged() => _state?.Reset();
    private Task PerformComparison() => _state!.CompareAsync(_well1Uwi, _well2Uwi, _well3Uwi);

    private void FieldChanged(string fieldId)
    {
        if (!_disposed) _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            _state?.Reset();
            _well1Uwi = _well2Uwi = _well3Uwi = string.Empty;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        DataManagementService.CurrentFieldChanged -= FieldChanged;
        _state?.Dispose();
    }

    private async Task ExportComparisonAsync()
    {
        if (_comparison == null)
        {
            Snackbar.Add("Run a comparison before exporting.", Severity.Warning);
            return;
        }

        var payload = new
        {
            ExportType = "WellComparisonPackage",
            ExportedAtUtc = DateTime.UtcNow,
            RequestedWells = _state!.RequestedWells.ToArray(),
            Wells = _comparison.Wells.Select(well => new
            {
                well.WellIdentifier,
                well.WellName,
                well.DataSource,
                FieldValues = well.FieldValues.ToDictionary(entry => entry.Key, entry => entry.Value?.ToString())
            }).ToList(),
            ComparisonFields = _comparison.ComparisonFields.Select(field => new
            {
                field.FieldName,
                field.DisplayLabel,
                field.HasDifferences
            }).ToList()
        };

        try
        {
            await ExportService.DownloadJsonAsync($"well-comparison-{DateTime.UtcNow:yyyyMMdd-HHmmss}", payload);
            Snackbar.Add("Well comparison package exported.", Severity.Success);
        }
        catch
        {
            Snackbar.Add("The comparison could not be exported. Try again.", Severity.Error);
        }
    }
}

