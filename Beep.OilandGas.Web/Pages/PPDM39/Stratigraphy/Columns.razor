@page "/ppdm39/stratigraphy/columns"
@using Beep.OilandGas.PPDM39.Models
@inject ApiClient ApiClient
@inject ILifeCycleService LifeCycleService
@inject ISnackbar Snackbar
@inject OilGasCallFailures Calls

<PageTitle>Inspect Regional Stratigraphic Columns</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">

    @* ── Header *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Inspect Regional Stratigraphic Columns</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_fieldName — Regional column definitions and ordered strat units</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary"
                         Icon="@Icons.Material.Filled.ViewColumn">Geology</MudChip>
            </MudStack>
        </MudStack>
    </MudStack>

    @* ── Column ID Search *@
    <MudCard Elevation="1" Class="mb-4">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudTextField @bind-Value="_searchColumnId"
                              Label="Column ID"
                              Placeholder="Enter column identifier"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              OnAdornmentClick="SearchColumns"
                              Class="og-grow" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="SearchColumns">Search</MudButton>
            </MudStack>
        </MudCardContent>
    </MudCard>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    @* ── Columns Grid *@
    <MudCard Elevation="2">
        <MudCardContent Class="pa-0">
            @if (_columns != null && _columns.Any())
            {
                <MudDataGrid T="STRAT_COLUMN" Items="@_columns" Dense="true" Hover="true" Striped="true"
                             SortMode="SortMode.Multiple" Filterable="true">
                    <Columns>
                        <PropertyColumn Property="c => c.STRAT_COLUMN_ID" Title="Column ID" />
                        <PropertyColumn Property="c => c.STRAT_COLUMN_NAME" Title="Column Name" />
                        <TemplateColumn Title="Active">
                            <CellTemplate>
                                <MudChip T="string"
                                         Color="@(context.Item.ACTIVE_IND == "Y" ? Color.Success : Color.Default)"
                                         Size="Size.Small">
                                    @context.Item.ACTIVE_IND
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        @* The stratigraphy API only reads; a column is edited through Data Management's STRAT_COLUMN table
                           (the generic PPDM39 data API), opened at this row. The button had no handler. *@
                        <TemplateColumn Title="" Sortable="false">
                            <CellTemplate>
                                <MudTooltip Text="Edit column in Data Management">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                                   Href="@EditAddress(context.Item)"
                                                   aria-label="@($"Edit column {context.Item.STRAT_COLUMN_ID} in Data Management")" />
                                </MudTooltip>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudStack AlignItems="AlignItems.Center" Class="pa-6">
                            <MudIcon Icon="@Icons.Material.Filled.ViewColumn" Color="Color.Secondary" Class="og-icon-xl" />
                            <MudText Typo="Typo.body1">No columns match the current filter</MudText>
                        </MudStack>
                    </NoRecordsContent>
                </MudDataGrid>
            }
            else if (_loadError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="ma-4">@_loadError</MudAlert>
            }
            else if (!_isLoading)
            {
                <MudStack AlignItems="AlignItems.Center" Class="pa-8">
                    <MudIcon Icon="@Icons.Material.Filled.ViewColumn" Color="Color.Secondary" Class="og-icon-xl" />
                    <MudText Typo="Typo.h6">No stratigraphic columns found</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Search by Column ID or browse all records.</MudText>
                </MudStack>
            }
        </MudCardContent>
    </MudCard>

</MudContainer>

@code {
    private string _fieldName = string.Empty;
    private string _searchColumnId = string.Empty;
    private List<STRAT_COLUMN>? _columns;
    private bool _isLoading = false;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var summary = await LifeCycleService.GetFieldLifecycleSummaryAsync();
            if (summary != null)
                _fieldName = summary.FieldName ?? _fieldName;
        }
        catch (Exception failure) when (OilGasCallFailures.IsCallFailure(failure))
        {
            Snackbar.Add(Calls.Explain(failure, "loading the field name for the stratigraphic columns page", "The field name could not be loaded"), Severity.Warning);
        }

        await LoadColumns();
    }

    private async Task LoadColumns()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            _columns = await ApiClient.GetAsync<List<STRAT_COLUMN>>("/api/stratigraphy/columns") ?? new();        }
        // A list that did not load is not shown as "no records": the page says it did not load.
        catch (Exception failure) when (OilGasCallFailures.IsCallFailure(failure))
        {
            _columns = null;
            _loadError = Calls.Explain(failure, "loading stratigraphic columns", "The stratigraphic columns could not be loaded");
            Snackbar.Add(_loadError, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Data Management's STRAT_COLUMN table narrowed to this column, where the generic PPDM39 data API edits the row.
    /// </summary>
    private static string EditAddress(STRAT_COLUMN column) =>
        "/ppdm39/data-management/table/STRAT_COLUMN?parentKeyCol=STRAT_COLUMN_ID&parentKeyVal="
        + Uri.EscapeDataString(column.STRAT_COLUMN_ID ?? string.Empty);

    private async Task SearchColumns()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            var url = "/api/stratigraphy/columns";
            if (!string.IsNullOrWhiteSpace(_searchColumnId))
            {
                var columnId = _searchColumnId.Trim();
                // The API reads its filters as comma-separated COLUMN=VALUE pairs, so a comma would end the identifier early.
                if (columnId.Contains(','))
                {
                    _loadError = "A column ID cannot contain a comma.";
                    _columns = null;
                    return;
                }
                // The API's own filter form (?filters=COLUMN=VALUE). The indexed AppFilter form this sent was never bound by
                // the API, so every search answered with every column.
                url += "?filters=" + Uri.EscapeDataString($"STRAT_COLUMN_ID={columnId}");
            }
            _columns = await ApiClient.GetAsync<List<STRAT_COLUMN>>(url) ?? new();        }
        catch (Exception failure) when (OilGasCallFailures.IsCallFailure(failure))
        {
            _columns = null;
            _loadError = Calls.Explain(failure, "searching stratigraphic columns", "The column search did not complete");
            Snackbar.Add(_loadError, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}

