@page "/asset/portfolio"
@using MudBlazor
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true"><MudIcon Icon="@Icons.Material.Filled.Business" Class="mr-2" Color="Color.Primary"/>Asset Portfolio</MudText>
    <MudGrid>
        <MudItem xs="6" md="3"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">Active Fields</MudText><MudText Typo="Typo.h4" Color="Color.Primary">12</MudText><MudText Typo="Typo.caption">producing</MudText></div><MudIcon Icon="@Icons.Material.Filled.Map" Color="Color.Primary" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
        <MudItem xs="6" md="3"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">Total Reserves</MudText><MudText Typo="Typo.h4" Color="Color.Success">245</MudText><MudText Typo="Typo.caption">MMBOE (2P)</MudText></div><MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Success" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
        <MudItem xs="6" md="3"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">Portfolio NPV</MudText><MudText Typo="Typo.h4" Color="Color.Info">$1.2B</MudText><MudText Typo="Typo.caption">@ 10% discount</MudText></div><MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Info" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
        <MudItem xs="6" md="3"><MudCard Elevation="3"><MudCardContent><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.caption" Color="Color.Secondary">Active Leases</MudText><MudText Typo="Typo.h4" Color="Color.Warning">47</MudText><MudText Typo="Typo.caption">expiring < 1yr: 6</MudText></div><MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Warning" Class="og-icon-xl"/></MudStack></MudCardContent></MudCard></MudItem>
    </MudGrid>
    <MudGrid>
        <MudItem xs="12" md="5"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Field Performance</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap"><MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/ppdm39/production/fields">All Fields</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/ppdm39/production/pools">Pools</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/ppdm39/production/reporting">Production Reports</MudButton></MudStack></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" md="7"><MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Financial & Economics</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap"><MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/economics/evaluation">Economic Analysis</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/economics/afe">AFE Management</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/reservoir/reserves">Reserves Classification</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/ppdm39/operations/leaseacquisition">Lease Management</MudButton></MudStack></MudCardContent></MudCard></MudItem>
    </MudGrid>
    <MudCard Elevation="2" Class="mt-2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">⚠️ Lease Expirations (Next 12 Months)</MudText></CardHeaderContent></MudCardHeader><MudCardContent><MudAlert Severity="Severity.Warning" Dense="true">Lease L-2025-018 (Section 14, Block 3) — expires in 45 days. Review renewal options.</MudAlert><MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">Lease L-2024-092 (Section 7, Block 1) — expires in 90 days. Production holds lease.</MudAlert></MudCardContent></MudCard>
</MudContainer>
