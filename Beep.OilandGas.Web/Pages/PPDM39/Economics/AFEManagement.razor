@using Beep.OilandGas.PermitsAndApplications.Models
@using Beep.OilandGas.Models.Data.Company
@page "/economics/afe"
@using System.Globalization
@using Beep.OilandGas.Client.App
@using Microsoft.AspNetCore.Authorization
@using Beep.OilandGas.Web.Components.Workflow
@attribute [Authorize]
@implements IDisposable
@inject CompanyClientContext Company
@inject IPersonaContextService Personas
@inject IAfeServiceClient AfeClient
@inject IDevelopmentDraftIntentStore Journal
@inject OilGasCallFailures Calls

<PageTitle>Company AFE requests</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
    <MudText Typo="Typo.h4" HtmlTag="h1">@(InvestmentHandoff is null?"Company AFE requests":"Assigned investment review")</MudText>
    @if(InvestmentHandoff is not null)
    {<DevelopmentInvestmentAssignedPanel InstanceId="@InvestmentHandoff" />}
    else
    {
    <MudText Class="mb-3">Prepare an expenditure request from a recorded approved development baseline, using a configured company book.</MudText>
    @if(_state?.CanView!=true)
    {<MudAlert Severity="Severity.Info">Select a company with Accounting, Development Planning and Workflow view access.</MudAlert>}
    else
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-3">
            <MudButton Href="/development/fdp" Variant="Variant.Outlined">Development plans</MudButton>
            <MudButton Href="/ppdm39/workorder" Variant="Variant.Outlined">Work-order financial source</MudButton>
            <MudButton OnClick="Reload" Disabled="@_state.Busy" Variant="Variant.Outlined">Reload original AFE workspace</MudButton>
        </MudStack>
        @if(_state.Busy){<MudProgressLinear Indeterminate="true" aria-label="Confirming original company AFE evidence" />}
        @if(_state.Error is {} error){<MudAlert Severity="Severity.Error" Class="my-3">@error</MudAlert>}
        @if(_state.Confirmation is {} confirmation){<MudAlert Severity="Severity.Success" Class="my-3">@confirmation</MudAlert>}
        @if(_state.RetainedProcessId is {} retained)
        {
            <MudPaper Outlined="true" Class="pa-4 my-3">
                <MudText Typo="Typo.h6" HtmlTag="h2">Recover original AFE request</MudText>
                @if(_state.Pending is {} pending)
                {
                    <MudText>@pending.Number · @pending.Name · @Money(pending.Amount,pending.Book().FunctionalCurrency,pending.Book().CurrencyDecimals)</MudText>
                    <MudText>Book: @pending.Book().Name · Effective calendar date: @pending.EffectiveDate.ToString("yyyy-MM-dd")</MudText>
                    <MudText Class="development-draft-description">@pending.Rationale</MudText>
                    <MudButton OnClick="Recover" Disabled="@(!_state.CanRecover)" Variant="Variant.Outlined" Class="my-3">Recover original AFE</MudButton>
                }
                else{<MudButton Href="@("/economics/afe?processId="+Uri.EscapeDataString(retained))">Open retained AFE source</MudButton>}
            </MudPaper>
        }
        else if(_state.Review is {} review)
        {
            var baseline=review.Source.Baseline!;
            <MudPaper Outlined="true" Class="pa-4 my-3">
                <MudText Typo="Typo.h6" HtmlTag="h2">Approved FDP source · Version @baseline.FDP_VERSION</MudText>
                <MudText>@baseline.FDP_NAME · FIELD @review.Source.Review.Scope.FieldId</MudText>
                <MudText Class="development-draft-identity">Baseline: @baseline.FDP_ID · Original draft: @baseline.SOURCE_DRAFT_FDP_ID</MudText>
                <MudText>Approved by @baseline.APPROVED_BY · @baseline.APPROVAL_DATE?.ToString("u",CultureInfo.InvariantCulture) UTC</MudText>
                @if(baseline.TOTAL_CAPEX_MM is {} capex){<MudText>Planning estimate: @capex.ToString("0.############################",CultureInfo.InvariantCulture) million @baseline.CAPEX_CURRENCY</MudText>}
                <MudText Typo="Typo.caption">Request amount is entered separately in the selected book currency.</MudText>
            </MudPaper>
            @if(review.Afes.Count>0)
            {
                <MudText Typo="Typo.h6" HtmlTag="h2">Recorded AFE requests for this baseline</MudText>
                @foreach(var afe in review.Afes){<MudPaper Outlined="true" Class="pa-3 my-2" id="@afe.AfeId"><MudText>@afe.Number · @afe.Name · @afe.Status</MudText><MudText>@Money(afe.RequestedAmount,afe.CurrencyCode,afe.CurrencyDecimals) · Book @afe.BookId · Effective @afe.EffectiveDate.ToString("yyyy-MM-dd")</MudText><MudText>Recorded by @afe.CreatedBy · @afe.CreatedAtUtc.ToString("u",CultureInfo.InvariantCulture)</MudText><DevelopmentInvestmentPanel ProcessId="@review.Source.Review.InstanceId" AfeId="@afe.AfeId" /></MudPaper>}
            }
            @if(review.Books.Books.Count==0){<MudAlert Severity="Severity.Info">No company book is configured. Configure its currency, precision, calendar and time zone before preparing an AFE.</MudAlert>}
            else if(_state.Prepared is null && _state.CanPrepare)
            {
                <MudPaper Outlined="true" Class="pa-4 my-3">
                    <MudText Typo="Typo.h6" HtmlTag="h2">Prepare DRAFT AFE request</MudText>
                    <MudSelect T="string" Label="Company book" @bind-Value="_book" Required="true" Class="my-3">
                        @foreach(var book in review.Books.Books){<MudSelectItem T="string" Value="@book.BookId" Disabled="@(review.Afes.Any(row=>row.BookId==book.BookId))">@book.Name · @book.FunctionalCurrency</MudSelectItem>}
                    </MudSelect>
                    @if(review.Books.Books.SingleOrDefault(row=>row.BookId==_book) is {} selected){<MudText>Currency @selected.FunctionalCurrency · @selected.CurrencyDecimals decimal places · @selected.RoundingPolicy · Calendar @selected.CalendarId · Time zone @selected.TimeZoneId</MudText>}
                    <MudTextField T="string" Label="AFE number" @bind-Value="_number" Required="true" MaxLength="128" Class="my-3" />
                    <MudTextField T="string" Label="AFE name" @bind-Value="_name" Required="true" MaxLength="256" Class="my-3" />
                    <MudNumericField T="decimal?" Label="Requested amount in selected book currency" @bind-Value="_amount" Required="true" Min="0m" Class="my-3" />
                    <MudDatePicker Label="Effective calendar date" @bind-Date="_effectiveDate" Required="true" Class="my-3" />
                    <MudTextField T="string" Label="Budget basis and rationale" @bind-Value="_rationale" Required="true" MaxLength="4096" Lines="3" Class="my-3" />
                    <MudButton OnClick="Prepare" Variant="Variant.Outlined">Review AFE request</MudButton>
                </MudPaper>
            }
            else if(!_state.CanPrepare && _state.Prepared is null){<MudAlert Severity="Severity.Info">Current company development budget preparation permission and original FIELD write access are required to record a request.</MudAlert>}
        }
        else if(_state.Recorded is null && _state.RetainedProcessId is null && !_state.Busy && _state.Error is null)
        {<MudAlert Severity="Severity.Info">Open an approved baseline from its development review to prepare a source-bound AFE. Work-order budgets start from the work-order board.</MudAlert>}
        @if(_state.Prepared is {} command)
        {
            <MudPaper Outlined="true" Class="pa-4 my-3">
                <MudText Typo="Typo.h6" HtmlTag="h2">Confirm DRAFT AFE request</MudText>
                <MudText>@command.Number · @command.Name</MudText>
                <MudText>@Money(command.Amount,command.Book().FunctionalCurrency,command.Book().CurrencyDecimals) · Book @command.Book().Name · Effective @command.EffectiveDate.ToString("yyyy-MM-dd")</MudText>
                <MudText>Approved FDP @command.Review.Source.Baseline!.FDP_NAME · FIELD @command.Review.Source.Review.Scope.FieldId</MudText>
                <MudText Class="development-draft-description">@command.Rationale</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Class="my-3"><MudButton OnClick="Submit" Disabled="@(!_state.CanPrepare)" Variant="Variant.Filled" Color="Color.Primary">Confirm AFE request</MudButton><MudButton OnClick="Cancel" Disabled="@_state.Busy" Variant="Variant.Outlined">Edit request</MudButton></MudStack>
            </MudPaper>
        }
        @if(_state.Recorded is {} recorded)
        {<MudPaper Outlined="true" Class="pa-4 my-3"><MudText Typo="Typo.h6" HtmlTag="h2">Recorded @recorded.Status AFE request</MudText><MudText>@recorded.Number · @recorded.Name · @Money(recorded.RequestedAmount,recorded.CurrencyCode,recorded.CurrencyDecimals)</MudText><MudText>Book @recorded.BookId · Effective @recorded.EffectiveDate.ToString("yyyy-MM-dd")</MudText><MudText>Recorded by @recorded.CreatedBy · @recorded.CreatedAtUtc.ToString("u",CultureInfo.InvariantCulture)</MudText><DevelopmentInvestmentPanel ProcessId="@(ProcessId!)" AfeId="@recorded.AfeId" /></MudPaper>}
        @if(string.IsNullOrWhiteSpace(ProcessId)){<DevelopmentInvestmentQueuePanel />}
        <MudAlert Severity="Severity.Info" Class="my-3">A DRAFT AFE records a request. Investment approval, committed funds and actual expenditure require their own recorded decisions and transactions.</MudAlert>
    }
    }
</MudContainer>
@code{
    [SupplyParameterFromQuery(Name="investmentHandoff")]public string? InvestmentHandoff{get;set;}
    private string? loadedHandoff;
    [SupplyParameterFromQuery(Name="processId")]public string? ProcessId{get;set;}
    private DevelopmentAfeState? _state;private string? _loadedProcess,_book;private string _number="",_name="",_rationale="";private decimal? _amount;private DateTime? _effectiveDate;private bool disposed;
    protected override void OnInitialized(){_state=new(Company,Personas,AfeClient,Journal,Calls.Explain);_state.Changed+=Changed;Company.Changed+=ContextChanged;Personas.Changed+=ContextChanged;}
    protected override async Task OnParametersSetAsync(){if(loadedHandoff!=InvestmentHandoff){loadedHandoff=InvestmentHandoff;_loadedProcess=ProcessId;if(InvestmentHandoff is null)await Reload();return;}if(InvestmentHandoff is not null)return;if(_loadedProcess!=ProcessId || _state!.Review is null){_loadedProcess=ProcessId;await Reload();}}
    private async Task Reload(){_book=null;_number="";_name="";_rationale="";_amount=null;_effectiveDate=null;await _state!.LoadAsync(ProcessId);}
    private static string Money(decimal amount,string currency,int decimals)=>amount.ToString("N"+decimals,CultureInfo.InvariantCulture)+" "+currency;
    private void Prepare()=>_state!.Prepare(_book,_number,_name,_amount,_effectiveDate,_rationale);
    private Task Submit()=>_state!.SubmitAsync();private Task Recover()=>_state!.RecoverAsync();private void Cancel()=>_state!.Cancel();
    private void Changed(){if(!disposed)_=InvokeAsync(StateHasChanged);}
    private void ContextChanged(){if(!disposed && InvestmentHandoff is null)_=InvokeAsync(Reload);}
    public void Dispose(){disposed=true;Company.Changed-=ContextChanged;Personas.Changed-=ContextChanged;if(_state is not null){_state.Changed-=Changed;_state.Dispose();}}
}
