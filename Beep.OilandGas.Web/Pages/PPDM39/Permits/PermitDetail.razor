@using Beep.OilandGas.Models.Data.Lease
@using Beep.OilandGas.Models.Data.Field
@using Beep.OilandGas.PermitsAndApplications.Models
@using Beep.OilandGas.PPDM39.DataManagement.Models
@using Beep.OilandGas.Models.Core.Interfaces
@using Beep.OilandGas.Models.Data.Company
@page "/ppdm39/permits/detail"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Beep.OilandGas.Client.App
@using Beep.OilandGas.Models.Data.Security
@implements IDisposable
@inject IPermitApplicationIntentStore Originals
@inject IPermitServiceClient PermitClient
@inject CompanyClientContext Company
@inject IFieldSelectionContext Fields
@inject AuthenticationStateProvider Authentication
@inject ILogger<PermitDetail> Logger

<PageTitle>Recorded permit application</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    <MudText Typo="Typo.h5" HtmlTag="h1">Recorded permit application</MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" Class="my-3">
        <MudButton Href="/ppdm39/permits" Variant="Variant.Text">Permit applications</MudButton>
        <MudButton OnClick="LoadAsync" Disabled="@(_loading || _workflow?.Busy==true)" Variant="Variant.Outlined">Reload recorded application</MudButton>
    </MudStack>
    @if (_loading) { <MudProgressLinear Indeterminate="true" aria-label="Loading recorded permit application" /> }
    else if (_detail is null) { <MudAlert Severity="Severity.Warning">@_message</MudAlert> }
    else
    {
        var application = _detail.Application;
        <MudText Typo="Typo.body2">Company @Company.Selection?.Scope.BusinessAssociateId · FIELD @_fieldName · application @application.PermitApplicationId</MudText>
        <MudText Typo="Typo.caption">Read checked @_checkedAt?.ToString("u"). Source dates below are displayed as recorded; their time zones are not established here.</MudText>
        <MudPaper Outlined="true" Class="pa-4 my-3">
            <MudText Typo="Typo.h6" HtmlTag="h2">Application details</MudText>
            <MudText>Type: @Recorded(application.ApplicationType)</MudText>
            <MudText>Authority: @Recorded(application.RegulatoryAuthority)</MudText>
            <MudText>Applicant: @Recorded(application.ApplicantName)</MudText>
            <MudText>Status: @Recorded(application.Status)</MudText>
            <MudText>Decision: @Recorded(application.Decision)</MudText>
            <MudText>Created: @Date(application.CreatedDate) · Submitted: @Date(application.SubmittedDate) · Decision date: @Date(application.DecisionDate)</MudText>
        </MudPaper>
        <MudPaper Outlined="true" Class="pa-4 my-3">
            <MudText Typo="Typo.h6" HtmlTag="h2">Recorded status history</MudText>
            @if (_detail.StatusHistory.Count == 0) { <MudText>No status history was returned for this application.</MudText> }
            @foreach (var entry in _detail.StatusHistory.OrderByDescending(row => row.StatusDate).ThenBy(row => row.HistoryId, StringComparer.Ordinal))
            {
                <MudText>@entry.HistoryId · @Recorded(entry.Status) · @Date(entry.StatusDate) · account @Recorded(entry.UpdatedBy)</MudText>
                <MudText Typo="Typo.body2">@Recorded(entry.Remarks)</MudText>
            }
        </MudPaper>
        <MudPaper Outlined="true" Class="pa-4 my-3">
            <MudText Typo="Typo.h6" HtmlTag="h2">Automated checker result</MudText>
            @if (_detail.ComplianceResult is { } check)
            {
                <MudText>Checked @check.CheckedAtUtc.ToString("u") · application @check.ApplicationId · FIELD @check.FieldId</MudText>
                <MudText>Checker signal: @(check.IsCompliant ? "Passed" : "Not passed") · score @check.ComplianceScore.ToString("0.##")%</MudText>
                @foreach (var finding in check.Violations) { <MudText>Finding: @finding</MudText> }
                @foreach (var warning in check.Warnings) { <MudText>Warning: @warning</MudText> }
                <MudText Typo="Typo.caption">This checker output does not record regulator approval or permission to operate.</MudText>
            }
            else { <MudText>No automated checker result was returned.</MudText> }
        </MudPaper>
        @if(_workflow is not null)
        {<Beep.OilandGas.Web.Components.Workflow.PermitApplicationWorkflow State="_workflow" ApplicationId="@application.PermitApplicationId" OnConfirmed="LoadAsync" />}
    }
</MudContainer>
@code {
    [SupplyParameterFromQuery(Name = "applicationId")] public string? ApplicationId { get; set; }
    private string? _loadedId, _message;
    private string _fieldName = "";
    private PermitApplicationDetail? _detail;
    private DateTime? _checkedAt;
    private bool _loading, _disposed;
    private PermitApplicationCommandState? _workflow;
    private long _generation;
    private static string Recorded(string? value) => string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    private static string Date(DateTime? value) => value is null || value == default(DateTime) ? "Not recorded" : value.Value.ToString("yyyy-MM-dd HH:mm");
    protected override void OnInitialized() { _workflow=new(Company,Fields,Authentication,PermitClient,Originals);Company.Changed += ContextChanged; Fields.CurrentFieldChanged += FieldChanged; Authentication.AuthenticationStateChanged += AuthenticationChanged; }
    protected override async Task OnParametersSetAsync() { if (_loadedId == ApplicationId && _generation != 0) return; _loadedId = ApplicationId; _workflow?.SetApplication(ApplicationId); await LoadAsync(); }
    private async Task LoadAsync()
    {
        _detail = null; _fieldName = ""; _checkedAt = null; _message = null; _loading = true;
        var generation = ++_generation; var selected = Company.Snapshot; var id = ApplicationId;
        bool Current() => !_disposed && generation == _generation && selected == Company.Snapshot && id == ApplicationId;
        async Task RequireAuthority()
        {
            var user = (await Authentication.GetAuthenticationStateAsync()).User;
            if (!Current() || selected.Selection is not { } company || user.Identity?.IsAuthenticated != true ||
                user.FindFirst("party_id")?.Value != company.UserId || !company.Roles.Any(user.IsInRole) || !company.Permissions.Contains(PermissionConstants.HSE.ViewPermits))
                throw new UnauthorizedAccessException("Current company permit view authority is required.");
        }
        try
        {
            if (!LeaseSummaryValidator.Identifier(id)) throw new InvalidOperationException("Choose an exact recorded application.");
            await RequireAuthority(); var before = await Fields.GetCurrentFieldSelectionAsync(); if (!Current()) return;
            FieldSelectionReviewValidator.RequireCurrent(before, selected.Selection!.Scope, selected.Selection.UserId);
            if (!before.SelectionAvailable) throw new InvalidOperationException("Choose an available FIELD.");
            var detail = await PermitClient.GetByIdAsync(id!); if (!Current()) return;
            var after = await Fields.GetCurrentFieldSelectionAsync(); if (!Current()) return;
            FieldSelectionReviewValidator.RequireCurrent(after, selected.Selection.Scope, selected.Selection.UserId);
            if (!after.SelectionAvailable || after.SelectionContext != before.SelectionContext) throw new InvalidOperationException("The selected FIELD changed.");
            await RequireAuthority(); PermitApplicationReadValidator.Require(detail, id!, before.FieldId);
            _detail = detail; _fieldName = string.IsNullOrWhiteSpace(before.FieldName) ? before.FieldId : before.FieldName; _checkedAt = DateTime.UtcNow;
        }
        catch (Exception error) { if (Current()) { Logger.LogWarning(error, "Recorded permit application could not be confirmed"); _message = "The permit application could not be confirmed for the current company, account and FIELD."; } }
        finally { if (Current()) _loading = false; }
    }
    private void FieldChanged(string _) => ContextChanged();
    private void AuthenticationChanged(Task<AuthenticationState> _) => ContextChanged();
    private void ContextChanged() { ++_generation; _detail = null; _checkedAt = null; _fieldName = ""; _loading = false; _message = "Company, account or FIELD changed. Reload the recorded application."; if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    public void Dispose() { _disposed = true; _workflow?.Dispose(); ++_generation; Company.Changed -= ContextChanged; Fields.CurrentFieldChanged -= FieldChanged; Authentication.AuthenticationStateChanged -= AuthenticationChanged; }
}
