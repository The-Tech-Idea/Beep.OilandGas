@page "/decommissioning/facility"
@inject ISnackbar Snackbar
@inject OilGasCallFailures Calls
@inject ApiClient ApiClient
@inject IDecommissioningServiceClient DecommissioningService
@inject ILifeCycleService LifeCycleService

<PageTitle>Facility Decommissioning</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">

    @if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" /> }

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Decommission Field Facilities</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@_fieldName — Facility decommissioning project management</MudText>
        </MudStack>
        @* No decommissioning report export in the API: the button announced "Report export queued" and queued nothing. *@
        <MudStack Spacing="0" AlignItems="AlignItems.End">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Download"
                       Disabled="true">
                Export Report
            </MudButton>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Exporting a decommissioning report is not available yet.</MudText>
        </MudStack>
    </MudStack>

    @* KPIs *@
    <MudGrid Class="mb-4" Spacing="3">
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Total Facilities" Value="@_facilities.Count.ToString()" Unit="units"
                     ValueColor="Color.Default" Icon="@Icons.Material.Filled.Apartment"
                     TrendIcon="@Icons.Material.Filled.TrendingFlat" TrendColor="Color.Default" TrendText="In programme" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="In Execution" Value="@_facilities.Count(f => IsExecutionPhase(f.Phase)).ToString()" Unit="units"
                     ValueColor="Color.Warning" Icon="@Icons.Material.Filled.BuildCircle"
                     TrendIcon="@Icons.Material.Filled.TrendingFlat" TrendColor="Color.Default" TrendText="Active" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Total DECOM Cost" Value="@_totalCostMm.ToString("N0")" Unit="$MM"
                     ValueColor="Color.Info" Icon="@Icons.Material.Filled.AttachMoney"
                     TrendIcon="@Icons.Material.Filled.TrendingFlat" TrendColor="Color.Default" TrendText="Committed + est." />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            @* Counted from each record's regulatory approval fields; it counted facilities in a planning phase as "submissions awaiting approval", which no record says. *@
            <KpiCard Label="Regulatory Approval" Value="@_facilities.Count(f => !HasRegulatoryApproval(f.Record)).ToString()" Unit="not recorded"
                     ValueColor="Color.Error" Icon="@Icons.Material.Filled.Policy"
                     TrendIcon="@Icons.Material.Filled.TrendingFlat" TrendColor="Color.Default" TrendText="No approval on record" />
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3">

        @* Facilities table *@
        <MudItem xs="12" md="8">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent><MudText Typo="Typo.subtitle1">Facility Decommissioning Projects</MudText></CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-0">
                    <MudDataGrid T="FacilityItem" Items="@_facilities" Dense="true" Hover="true" Striped="true"
                                 RowClick="OnFacilitySelected">
                        <Columns>
                            <PropertyColumn Property="f => f.FacilityId"   Title="Facility" />
                            <PropertyColumn Property="f => f.FacilityType" Title="Type" />
                            <PropertyColumn Property="f => f.DecomStart"   Title="DECOM Start" />
                            <PropertyColumn Property="f => f.DecomEnd"     Title="Target Complete" />
                            <PropertyColumn Property="f => f.CostMm"       Title="Cost ($MM)" Format="N1" />
                            <TemplateColumn Title="Phase">
                                <CellTemplate><StatusBadge Status="@context.Item.Phase" /></CellTemplate>
                            </TemplateColumn>
                            @* No percent complete is recorded for a facility decommissioning: the "% Done" column was a figure guessed from the phase (10, 35, 60 or 100). *@
                        </Columns>
                    </MudDataGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Right panel — cost chart / detail *@
        <MudItem xs="12" md="4">
            <MudStack Spacing="3">

                @if (_selectedFacility is not null)
                {
                    <MudCard Elevation="2">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.subtitle1">@_selectedFacility.FacilityId</MudText>
                                    <StatusBadge Status="@_selectedFacility.Phase" />
                                </MudStack>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            @* What the facility's decommissioning record says. The panel showed an invented six-step activity plan
                               with progress bars and an overall percentage guessed from the phase; no activity or progress record
                               exists in the API for a facility, so only the record's own milestones are shown. *@
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Recorded milestones</MudText>
                                @foreach (var milestone in Milestones(_selectedFacility.Record))
                                {
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudText Typo="Typo.body2">@milestone.Name</MudText>
                                        @if (milestone.Recorded is null)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Not recorded</MudText>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2">@milestone.Recorded</MudText>
                                        }
                                    </MudStack>
                                }
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Outlined" FullWidth="true"
                                       OnClick='@(() => _selectedFacility = null)'>
                                Back to List
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                }
                else
                {
                    <MudCard Elevation="2">
                        <MudCardHeader>
                            <CardHeaderContent><MudText Typo="Typo.subtitle1">Cost by Phase ($MM)</MudText></CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudAlert Severity="Severity.Info" Dense="true">
                                Cost by phase loads from the Accounting module once cost records are linked to these facilities.
                            </MudAlert>
                        </MudCardContent>
                    </MudCard>
                }

                @* Each facility's regulatory approval as its decommissioning record holds it. The card listed four invented
                   submissions with invented statuses; the API keeps no submission list, only the approval on each record. *@
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.subtitle1">Regulatory Approvals</MudText></CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-2">
                        @if (_facilities.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-2">No facility decommissioning records are loaded.</MudText>
                        }
                        else
                        {
                            <MudList T="string" Dense="true">
                                @foreach (var facility in _facilities)
                                {
                                    <MudListItem T="string">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.body2">@facility.FacilityId</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@ApprovalSummary(facility.Record)</MudText>
                                            </MudStack>
                                            @if (HasRegulatoryApproval(facility.Record))
                                            {
                                                <StatusBadge Status="APPROVED" />
                                            }
                                        </MudStack>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                    </MudCardContent>
                </MudCard>

            </MudStack>
        </MudItem>

    </MudGrid>
</MudContainer>

@code {
    private string _fieldName = string.Empty;
    private FacilityItem? _selectedFacility;
    private double _totalCostMm;
    private bool _loading = true;

    private record FacilityItem(string DecommissioningId, string FacilityId, string FacilityType, string DecomStart,
        string DecomEnd, double CostMm, string Phase, FacilityDecommissioningResponse Record);

    private List<FacilityItem> _facilities = new();

    /// <summary>A milestone a facility's decommissioning record holds; <c>Recorded</c> is null when the record has none.</summary>
    private sealed record Milestone(string Name, string? Recorded);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var summary = await LifeCycleService.GetFieldLifecycleSummaryAsync();
            if (summary != null)
                _fieldName = summary.FieldName ?? _fieldName;
        }
        catch (Exception failure) when (OilGasCallFailures.IsCallFailure(failure))
        {
            Snackbar.Add(Calls.Explain(failure, "loading the field name for the facility decommissioning page", "The field name could not be loaded"), Severity.Warning);
        }

        _loading = true;
        try
        {
            var raw = await DecommissioningService.GetDecommissionedFacilitiesAsync();
            var estimate = await DecommissioningService.EstimateCostsAsync();

            _facilities = raw.Select(r => new FacilityItem(
                r.DecommissioningId,
                r.FacilityId ?? r.DecommissioningId,
                r.DecommissioningType ?? "Facility",
                FormatMonth(r.DecommissioningStartDate, "—"),
                FormatMonth(r.DecommissioningEndDate, "TBD"),
                (double)(r.TotalCost ?? r.DecommissioningCost ?? 0m) / 1_000_000d,
                // A record with no status says so; it was shown as PLANNED.
                r.Status ?? "NOT RECORDED",
                r)).ToList();

            var actualCostMm = _facilities.Sum(f => f.CostMm);
            var estimatedCostMm = (double)(estimate?.EstimatedFacilityDecommissioningCost ?? 0m) / 1_000_000d;
            _totalCostMm = actualCostMm > 0 ? actualCostMm : estimatedCostMm;

            if (_selectedFacility is not null)
            {
                _selectedFacility = _facilities.FirstOrDefault(f => f.DecommissioningId == _selectedFacility.DecommissioningId);
            }
        }
        catch (Exception failure) when (OilGasCallFailures.IsCallFailure(failure))
        {
            Snackbar.Add(Calls.Explain(failure, "loading decommissioned facilities", "The facilities could not be loaded"), Severity.Warning);
        }
        finally { _loading = false; }
    }

    private void OnFacilitySelected(DataGridRowClickEventArgs<FacilityItem> args)
    {
        _selectedFacility = args.Item;
    }

    private static string FormatMonth(DateTime? value, string fallback) =>
        value?.ToLocalTime().ToString("MMM yyyy") ?? fallback;

    // A recorded day as stored: converting it to the server's zone in a circuit could move it to the day before.
    private static string? FormatDay(DateTime? value) =>
        value?.ToString("dd MMM yyyy", CultureInfo.InvariantCulture);

    private static bool IsExecutionPhase(string? phase)
    {
        var normalized = NormalizePhase(phase);
        return normalized is "EXECUTION" or "INPROGRESS" or "ACTIVE";
    }

    private static string NormalizePhase(string? phase) =>
        string.IsNullOrWhiteSpace(phase)
            ? string.Empty
            : phase.Trim().Replace(" ", string.Empty).Replace("_", string.Empty).ToUpperInvariant();

    /// <summary>Whether the record holds a regulatory approval: its approval number or its approval date.</summary>
    private static bool HasRegulatoryApproval(FacilityDecommissioningResponse record) =>
        !string.IsNullOrWhiteSpace(record.RegulatoryApprovalNumber) || record.RegulatoryApprovalDate.HasValue;

    /// <summary>The record's regulatory approval in words — authority, number and date, as far as they are recorded.</summary>
    private static string ApprovalSummary(FacilityDecommissioningResponse record)
    {
        if (!HasRegulatoryApproval(record))
            return "No regulatory approval recorded";

        var parts = new[]
        {
            string.IsNullOrWhiteSpace(record.RegulatoryAuthority) ? null : record.RegulatoryAuthority.Trim(),
            string.IsNullOrWhiteSpace(record.RegulatoryApprovalNumber) ? null : record.RegulatoryApprovalNumber.Trim(),
            FormatDay(record.RegulatoryApprovalDate),
        };
        return "Approved — " + string.Join(" · ", parts.Where(part => part is not null));
    }

    /// <summary>The milestones the facility's decommissioning record holds, each with its recorded value or none.</summary>
    private static IReadOnlyList<Milestone> Milestones(FacilityDecommissioningResponse record)
    {
        var restoration = string.IsNullOrWhiteSpace(record.RestorationStatus)
            ? FormatDay(record.RestorationCompletionDate)
            : record.RestorationCompletionDate.HasValue
                ? $"{record.RestorationStatus.Trim()} · {FormatDay(record.RestorationCompletionDate)}"
                : record.RestorationStatus.Trim();

        return new[]
        {
            new Milestone("Decommissioning started", FormatDay(record.DecommissioningStartDate)),
            new Milestone("Equipment removed", FormatDay(record.RemovalDate)),
            new Milestone("Site cleared", FormatDay(record.SiteClearanceDate)),
            new Milestone("Site restoration", restoration),
            new Milestone("Regulatory approval", HasRegulatoryApproval(record) ? ApprovalSummary(record) : null),
        };
    }
}
