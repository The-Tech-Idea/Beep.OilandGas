@page "/ppdm39/data-import"
@using MudBlazor
@inject ApiClient ApiClient
@inject ISnackbar Snackbar
@inject OilGasApiFailures Answers
@inject FailureNotifier Notifier

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true"><MudIcon Icon="@Icons.Material.Filled.Upload" Class="mr-2" />Data Import</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Quality-validated CSV import into PPDM tables.</MudText>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudCard Elevation="2"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Upload CSV</MudText></CardHeaderContent></MudCardHeader>
            <MudCardContent>
                <MudSelect T="string" Label="Target Table" @bind-Value="_tableName" Variant="Variant.Outlined" Class="mb-3">
                    <MudSelectItem T="string" Value='@("WELL")'>WELL</MudSelectItem><MudSelectItem T="string" Value='@("FIELD")'>FIELD</MudSelectItem>
                    <MudSelectItem T="string" Value='@("FACILITY")'>FACILITY</MudSelectItem><MudSelectItem T="string" Value='@("PDEN_VOL_SUMMARY")'>Production</MudSelectItem>
                    <MudSelectItem T="string" Value='@("PROSPECT")'>PROSPECT</MudSelectItem>
                </MudSelect>
                <MudFileUpload T="IBrowserFile" FilesChanged="OnFileChanged" Accept=".csv" DragAndDrop="true" Disabled="_importing" Class="mb-3" />
                @if(_selectedFile!=null){<MudChip T="string" Color="Color.Info" Size="Size.Small">@_selectedFile.Name (@($"{_selectedFile.Size/1024.0/1024.0:F1} MB"))</MudChip>}
            </MudCardContent>
            <MudCardActions><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UploadAndImport" Disabled="@(_selectedFile==null||_importing||string.IsNullOrEmpty(_tableName))">@if(_importing){<MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>}Import with Validation</MudButton></MudCardActions></MudCard>
            @if(_result!=null){<MudCard Elevation="2" Class="mt-3"><MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Result</MudText></CardHeaderContent><CardHeaderActions><MudChip T="string" Color="@(_result.Success?Color.Success:Color.Error)" Size="Size.Small">@(_result.Success?"Success":"Failed")</MudChip></CardHeaderActions></MudCardHeader>
            <MudCardContent><MudStack Row="true" Justify="Justify.SpaceAround"><div><MudText Typo="Typo.caption">Read</MudText><MudText Typo="Typo.h6">@_result.RecordsRead.ToString("N0")</MudText></div><div><MudText Typo="Typo.caption">Inserted</MudText><MudText Typo="Typo.h6" Color="Color.Success">@_result.RecordsInserted.ToString("N0")</MudText></div><div><MudText Typo="Typo.caption">Failed</MudText><MudText Typo="Typo.h6" Color="@(_result.RecordsFailed>0?Color.Error:Color.Default)">@_result.RecordsFailed.ToString("N0")</MudText></div></MudStack></MudCardContent></MudCard>}
        </MudItem>
        @* No quality-rules card: POST /api/data-import/csv/{table} takes no quality rules (DataImportService's options can carry
           NotNull, Range and AcceptedValues rules, but no endpoint passes any), so the "Require non-null values" switch was read
           by nothing and "more quality rules available via API" was not so. Each row is still checked against its column's
           type, and a row the store refuses is counted as failed. *@
    </MudGrid>
</MudContainer>

@code {
    private IBrowserFile? _selectedFile;private string _tableName="";private bool _importing;
    private ImportResultDto? _result;
    private void OnFileChanged(IBrowserFile? file){_selectedFile=file;_result=null;}
    private async Task UploadAndImport(){
        if(_selectedFile==null||string.IsNullOrEmpty(_tableName))return;_importing=true;StateHasChanged();
        try{using var c=new MultipartFormDataContent();var s=new StreamContent(_selectedFile.OpenReadStream(100_000_000));s.Headers.ContentType=new System.Net.Http.Headers.MediaTypeHeaderValue("text/csv");c.Add(s,"file",_selectedFile.Name);
        _result=await ApiClient.PostAsync<ImportResultDto>($"/api/data-import/csv/{Uri.EscapeDataString(_tableName)}",c);Snackbar.Add($"Imported {_result?.RecordsInserted??0:N0} records",Severity.Success);}
        // The API's refusal is said in its words; a failure as what did not happen, with its reference — never the answer's body.
        catch(OilGasApiException answer){Snackbar.Add(Answers.Explain(answer,"importing a CSV file into a PPDM table","The file was not imported"),Severity.Error);}
        // A page answers every failure it meets with a sentence; the store keeps the exception.
        catch(Exception ex){Notifier.Failure(ex,"importing a CSV file into a PPDM table","The file was not imported");}
        finally{_importing=false;}
    }
    // The API answers the counts and a message, not a success flag: an import with no failed rows succeeded.
    public class ImportResultDto{public bool Success=>RecordsFailed==0;public string? Message{get;set;}public int RecordsRead{get;set;}public int RecordsInserted{get;set;}public int RecordsFailed{get;set;}}
}
