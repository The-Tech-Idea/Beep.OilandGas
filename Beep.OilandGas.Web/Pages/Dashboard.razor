@page "/dashboard"
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ILifeCycleService LifeCycleService
@inject IDataManagementService DataManagementService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject Beep.OilandGas.Web.Theme.IThemeProvider ThemeProvider
@inject Beep.OilandGas.Web.Services.IPersonaContextService PersonaContext
@using Beep.OilandGas.Web.Theme
@using Beep.OilandGas.Models.Data

<PageTitle>Dashboard - @(_branding.AppName ?? "Beep Oil & Gas")</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">

    @* ── Header ──────────────────────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Monitor Field Operations</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Asset performance at a glance</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            @if (_personaLoaded && !string.IsNullOrWhiteSpace(_personaLabel))
            {
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Badge" Size="Size.Small">
                    Persona: @_personaLabel
                </MudChip>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Explore"
                       OnClick="@(() => NavigationManager.NavigateTo("/ppdm39/production/fields"))">View Fields</MudButton>
            <MudChip T="string" Color="Color.Primary" Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small">
                @(_branding.AppName ?? "Beep Oil &amp; Gas")
            </MudChip>
        </MudStack>
    </MudStack>

    @* ── KPI Row ─────────────────────────────────────────────────────────── *@
    <MudButton OnClick="Reload" Disabled="@(_state?.Loading ?? true)" StartIcon="@Icons.Material.Filled.Refresh" Class="mb-3">Refresh field data</MudButton>
    @if (_state?.Loading == true)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading field dashboard" />
        <MudText Class="my-3">Loading selected field…</MudText>
    }
    else if (_state?.NeedsField == true)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">Select a field to see its operational data.</MudAlert>
    }
    else if (_state?.Error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_state.Error</MudAlert>
    }
    else if (_state?.Dashboard is { } dashboard)
    {
        <MudText Typo="Typo.h6" Class="mb-3">@(string.IsNullOrWhiteSpace(dashboard.FieldName) ? dashboard.FieldId : dashboard.FieldName)</MudText>
        <MudGrid Spacing="3" Class="mb-4">
            @foreach (var phase in Phases(dashboard))
            {
                <MudItem xs="12" sm="6" md="3">
                    <KpiCard Label="@phase.Label" Value="@(phase.Summary?.EntityCount.ToString("N0") ?? "Not available")" ValueColor="Color.Primary" />
                </MudItem>
            }
        </MudGrid>
        <MudText Typo="Typo.h6" Class="mb-3">Reported performance</MudText>
        @if (dashboard.PerformanceMetrics is not { Count: > 0 })
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">No performance metrics have been reported for this field.</MudAlert>
        }
        else
        {
            <MudGrid Spacing="3" Class="mb-4">
                @foreach (var metric in dashboard.PerformanceMetrics)
                {
                    <MudItem xs="12" sm="6" md="3">
                        <KpiCard Label="@(string.IsNullOrWhiteSpace(metric.MetricLabel) ? metric.MetricName : metric.MetricLabel)"
                                 Value="@FieldDashboardState.MetricValue(metric.CurrentValue)" Unit="@(metric.Unit ?? string.Empty)" ValueColor="Color.Info" />
                    </MudItem>
                }
            </MudGrid>
        }
    }

    @* ── Workflow Entry Points ────────────────────────────────────────────── *@
    <MudText Typo="Typo.h6" Class="mb-3">Start Work</MudText>
    <MudGrid Spacing="3" Class="mb-6">
        <MudItem xs="12" sm="6" md="2"><MudButton Href="/exploration" FullWidth="true" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Explore">Exploration</MudButton></MudItem>
        <MudItem xs="12" sm="6" md="2"><MudButton Href="/development" FullWidth="true" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Construction">Development</MudButton></MudItem>
        <MudItem xs="12" sm="6" md="2"><MudButton Href="/production" FullWidth="true" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.OilBarrel">Production</MudButton></MudItem>
        <MudItem xs="12" sm="6" md="2"><MudButton Href="/reservoir" FullWidth="true" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Water">Reservoir</MudButton></MudItem>
        <MudItem xs="12" sm="6" md="2"><MudButton Href="/economics/afe" FullWidth="true" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AccountBalance">Economics</MudButton></MudItem>
        <MudItem xs="12" sm="6" md="2"><MudButton Href="/ppdm39/data-management" FullWidth="true" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Storage">Data management</MudButton></MudItem>
    </MudGrid>

    @* ── Recent Activity ─────────────────────────────────────────────────── *@
    @if (_state?.Dashboard is { } activityDashboard)
    {
        <MudText Typo="Typo.h6" Class="mb-3">Recent activity</MudText>
        @if (activityDashboard.RecentEvents is not { Count: > 0 })
        {
            <MudAlert Severity="Severity.Info">No recent activity was reported for this field.</MudAlert>
        }
        else
        {
            <MudTable T="FieldTimelineEvent" Items="@activityDashboard.RecentEvents.OrderByDescending(e => e.EventDate)" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent><MudTh>Type</MudTh><MudTh>Description</MudTh><MudTh>Date</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Type">@context.EventType</MudTd>
                    <MudTd DataLabel="Description">@context.EventDescription</MudTd>
                    <MudTd DataLabel="Date">@context.EventDate.ToString("dd MMM yyyy HH:mm")</MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager /></PagerContent>
            </MudTable>
        }
    }

</MudContainer>
@code {
    private BrandingConfig _branding = new();
    private FieldDashboardState? _state;
    private bool _personaLoaded;
    private string _personaLabel = string.Empty;
    private bool _disposed;
    protected override void OnInitialized()
    {
        _branding = ThemeProvider.GetBranding();
        _state = new(LifeCycleService.GetFieldDashboardAsync);
        PersonaContext.Changed += PersonaChanged;
        DataManagementService.CurrentFieldChanged += FieldChanged;
    }
    protected override async Task OnInitializedAsync()
    {
        await Reload();
        try { await PersonaContext.EnsureLoadedAsync(); }
        catch { Snackbar.Add("Persona settings could not be loaded. Use Retry personas to refresh them.", Severity.Warning); }
        UpdatePersonaLabel();
    }
    private Task Reload() => _state!.LoadAsync(() => DataManagementService.GetCurrentFieldIdAsync());
    private void FieldChanged(string fieldId)
    {
        if (!_disposed) _ = InvokeAsync(async () => {
            if (_disposed) return;
            var load = _state!.LoadAsync(() => Task.FromResult<string?>(fieldId));
            StateHasChanged(); await load;
            if (!_disposed) StateHasChanged();
        });
    }
    private void UpdatePersonaLabel() { _personaLoaded = true; _personaLabel = PersonaContext.CurrentPersona?.Name ?? string.Empty; }
    private void PersonaChanged() { if (!_disposed) _ = InvokeAsync(() => { if (_disposed) return; UpdatePersonaLabel(); StateHasChanged(); }); }
    private static IEnumerable<(string Label, FieldDashboardPhaseSummary? Summary)> Phases(FieldDashboard dashboard) => new[] {
        ("Exploration records", dashboard.ExplorationSummary), ("Development records", dashboard.DevelopmentSummary),
        ("Production records", dashboard.ProductionSummary), ("Decommissioning records", dashboard.DecommissioningSummary)
    };
    public void Dispose()
    {
        _disposed = true; _state?.Dispose();
        PersonaContext.Changed -= PersonaChanged;
        DataManagementService.CurrentFieldChanged -= FieldChanged;
    }
}
