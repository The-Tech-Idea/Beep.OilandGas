@page "/landing"
@page "/"
@using TheTechIdea.Data.OilGas
@using Beep.OilandGas.Web.Services
@using Beep.Foundation.IdentityServer.Shared.Identity
@inject PersonaClient IdentityClient
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject ILogger<Landing> Logger

@if (_isLoading)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex justify-center align-center" Style="height: 100vh;">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.h6">Loading personalized dashboard...</MudText>
        </MudStack>
    </MudContainer>
}
else if (_errorMessage != null)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex justify-center align-center" Style="height: 100vh;">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" Color="Color.Error" />
            <MudText Typo="Typo.h6" Color="Color.Error">@_errorMessage</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Nav.NavigateTo("/dashboard"))">
                Go to Dashboard
            </MudButton>
        </MudStack>
    </MudContainer>
}

@code {
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _userId;
    private AppUserPersona? _currentProfile;
    private AppPersona? _currentPersona;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Get current user
            var authState = await AuthProvider.GetAuthenticationStateAsync();

            // Somebody signed out is sent to sign in and brought back here.
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                Nav.NavigateTo(BeepClientEndpoints.LoginWithReturn(new Uri(Nav.Uri).PathAndQuery), forceLoad: true);
                return;
            }

            // Signed in, but the OilGas API did not resolve their account for this request (an outage: a refused account is
            // signed out by the identity server's client library). Sending them to sign in would sign them straight back.
            _userId = PartyIdClaims.Find(authState.User);
            if (string.IsNullOrEmpty(_userId))
            {
                _errorMessage = "Your OilGas account could not be loaded just now. Try again shortly.";
                return;
            }

            // Load user's profile and available personas
            _currentProfile = await IdentityClient.GetAsync(_userId);
            
            if (_currentProfile == null)
            {
                Nav.NavigateTo("/dashboard");
                return;
            }

            // Get the list of available personas to find the current one's definition
            var allPersonas = await IdentityClient.CatalogAsync();
            _currentPersona = allPersonas.FirstOrDefault(p => p.Code == _currentProfile.PersonaCode);

            // Redirect to the persona's default landing route if defined
            if (!string.IsNullOrEmpty(_currentPersona?.DefaultRoute))
            {
                Nav.NavigateTo(_currentPersona.DefaultRoute);
            }
            else
            {
                // Fallback to dashboard if no default landing route is set
                Nav.NavigateTo("/dashboard");
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException or InvalidOperationException)
        {
            // Handled: the persona settings could not be read from the API; the page says so and offers the dashboard.
            Logger.LogWarning(exception, "The signed-in person's persona settings could not be loaded.");
            _errorMessage = "Persona settings could not be loaded.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
