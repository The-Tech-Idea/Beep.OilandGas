@inject TheTechIdeaWeb.Diagnostics.IFailureReporter HandledFailures
@using Beep.OilandGas.Models.Data.Company
@using Beep.OilandGas.PPDM39.DataManagement.Models
@page "/setup/drivers"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator")]
@inject ApiClient Api
@inject ILogger<SetupDrivers> Logger

@if (!Embedded) { <PageTitle>Database drivers</PageTitle> }
<MudContainer MaxWidth="MaxWidth.Large" Class="@(Embedded ? "pa-0 py-3" : "py-8")">
    <MudText Typo="@(Embedded ? Typo.h6 : Typo.h4)" HtmlTag="@(Embedded ? "h2" : "h1")">Database drivers and connectors</MudText>
    <MudText Class="my-3">Install a registered Beep driver or datasource package on the API server before creating a connection. The server uses its configured package sources and version.</MudText>
    @if (_message is not null) { <MudAlert Severity="Severity.Info" Class="my-3" role="status">@_message</MudAlert> }
    <MudTooltip Text="Refresh drivers"><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Reload" Disabled="@_busy" Color="Color.Primary" aria-label="Refresh drivers" /></MudTooltip>
    @if (!Embedded) { <MudLink Href="/ppdm39/database-management" Class="mx-2">Create and test connections</MudLink> }
    @if (_busy) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-3" /> }
    @if (!_busy && !MatchingDrivers.Any()) { <MudText Class="my-3">No registered driver packages are available@(DataSourceType is null ? "" : $" for {DataSourceType}"). Check the API server's Beep driver catalog.</MudText> }
    @if (!_busy && Embedded && MatchingDrivers.Any())
    {
        <MudAlert Severity="@(DriverReady ? Severity.Success : Severity.Warning)" Class="my-3" role="status">@(DriverReady ? $"Driver ready for {DataSourceType}. Continue to connection details." : $"Driver required for {DataSourceType}. Download and load the missing packages before continuing.")</MudAlert>
    }
    @if (!Embedded && _items.Count > 0)
    {
        <MudTextField T="string" @bind-Value="_driverSearch" Immediate="true" Label="Find a database or package" Disabled="@_busy" />
        @if (!VisibleDrivers.Any()) { <MudText Class="my-2">No drivers match this search. Clear it to see the catalog.</MudText> }
    }
    @foreach (var item in VisibleDrivers)
    {
        <MudPaper Outlined="true" Class="pa-3 my-2 driver-package-details">
            <MudText>@item.DataSourceType · @item.Category</MudText>
            <MudText Typo="Typo.body2">Beep connector: @(item.BundledConnector ? "bundled with the API server" : item.ConnectorPackage ?? "not configured") — @(item.ConnectorLoaded ? "loaded" : "not loaded")</MudText>
            @if (!item.BundledConnector && item.ConnectorPackage is not null) { <MudText Typo="Typo.body2">Connector version: @(item.ConnectorVersion ?? "not specified")</MudText> }
            <MudText Typo="Typo.body2">Database provider: @item.Package (@(item.PackageVersion ?? "not specified")) — @(item.ProviderLoaded ? "loaded" : "not loaded")</MudText>
            @if (item.SqlServerOwnedTransactionContract == false)
            {
                <MudAlert Severity="Severity.Warning" Class="my-2">This SQL Server connector lacks the owned transaction contract required for the shared system repository. Configure a current connector from a trusted feed and restart the API server before setting up that repository.</MudAlert>
            }
            @if (!item.CanInstall) { <MudText Typo="Typo.body2">Configure exact package names and versions for the missing connector and provider on the API server before installing.</MudText> }
            <MudTooltip Text="@(item.Cached ? "Load driver" : "Download and load")"><MudIconButton Icon="@Icons.Material.Filled.Download" OnClick="@(() => Install(item))" Disabled="@(_busy || item.Loaded || !item.CanInstall)" Color="Color.Primary" aria-label="@(item.Cached ? "Load driver" : "Download and load")" /></MudTooltip>
        </MudPaper>
    }
    @if (!Embedded) { <MudLink Href="/setup/repository" Class="mt-4">Back to setup</MudLink> }
</MudContainer>

@code {
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public string? DataSourceType { get; set; }
    [Parameter] public EventCallback<string?> ReadyTypeChanged { get; set; }
    [Parameter] public EventCallback<bool> BusyChanged { get; set; }
    private string? _observedType;
    private bool _initialized;
    private List<SetupDriverItem> _items = [];
    private string _driverSearch = "";
    private IEnumerable<SetupDriverItem> MatchingDrivers => _items.Where(item => DataSourceType is null || item.DataSourceType == DataSourceType);
    private bool DriverReady => MatchingDrivers.Any(item => item.Loaded && item.ConnectorLoaded && item.ProviderLoaded);
    private IEnumerable<SetupDriverItem> VisibleDrivers => MatchingDrivers.Where(item => string.IsNullOrWhiteSpace(_driverSearch) ||
        new[] { item.DataSourceType, item.Category, item.Package, item.ConnectorPackage }.Any(value =>
            value?.Contains(_driverSearch.Trim(), StringComparison.OrdinalIgnoreCase) == true));
    private bool _busy;
    private string? _message;
    protected override async Task OnParametersSetAsync()
    {
        if (_initialized && _observedType == DataSourceType) return;
        _initialized = true; _observedType = DataSourceType; _items = [];
        await ReadyTypeChanged.InvokeAsync(null);
        await Reload();
    }
    private Task ReportReadiness() => ReadyTypeChanged.InvokeAsync(DriverReady ? DataSourceType : null);
    private async Task Reload()
    {
        if (_busy) return; _busy = true; _message = null;
        var requestedType = DataSourceType;
        await BusyChanged.InvokeAsync(true); await ReadyTypeChanged.InvokeAsync(null);
        try
        {
            var items = await Api.GetAsync<List<SetupDriverItem>>("/api/setup/drivers") ?? throw new InvalidOperationException("The driver catalog response is unavailable.");
            if (requestedType == DataSourceType) _items = items;
        }
        catch (Exception error) { HandledFailures.ReportHandled(error, "SetupDrivers.Reload", "the operation is unconfirmed; the existing handler retains its refusal, cancellation or recovery state", TheTechIdeaWeb.Diagnostics.FailureSeverity.Error);  Logger.LogWarning(error, "Beep driver catalog could not be loaded"); _items = []; _message = "The driver catalog could not be loaded. Check the API server."; }
        finally
        {
            _busy = false; await ReportReadiness(); await BusyChanged.InvokeAsync(false);
            if (requestedType != DataSourceType) await Reload();
        }
    }
    private async Task Install(SetupDriverItem item)
    {
        if (_busy || item.Loaded || !item.CanInstall || !MatchingDrivers.Contains(item)) return;
        _busy = true; _message = null;
        await BusyChanged.InvokeAsync(true); await ReadyTypeChanged.InvokeAsync(null);
        try
        {
            var result = await Api.PostAsync<SetupDriverItem, SetupDriverItem>($"/api/setup/drivers/{Uri.EscapeDataString(item.Id)}/install", item);
            if (result is null || result.Id != item.Id || result.DataSourceType != item.DataSourceType || result.Category != item.Category || result.Package != item.Package || result.PackageVersion != item.PackageVersion || result.ConnectorPackage != item.ConnectorPackage || result.ConnectorVersion != item.ConnectorVersion || !result.Loaded || !result.ProviderLoaded || !result.ConnectorLoaded)
                throw new InvalidOperationException("The loaded driver was not confirmed.");
            _items = _items.Select(x => x.Id == item.Id ? result : x).ToList();
            _message = "Driver loaded. Create or test a connection before applying a migration.";
        }
        catch (Exception error)
        { HandledFailures.ReportHandled(error, "SetupDrivers.Install", "the operation is unconfirmed; the existing handler retains its refusal, cancellation or recovery state", TheTechIdeaWeb.Diagnostics.FailureSeverity.Error);
            Logger.LogWarning(error, "Beep driver installation was not confirmed");
            // The server may have loaded one or both packages before the response failed.
            _items = [];
            _message = "The driver installation was not confirmed. Refresh the catalog before trying again. If it still fails, ask the server operator to check the package cache, feeds and server logs.";
        }
        finally { _busy = false; await ReportReadiness(); await BusyChanged.InvokeAsync(false); }
    }
}
