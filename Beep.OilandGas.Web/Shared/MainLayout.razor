@using Beep.OilandGas.Models.Data.Company
@using Beep.OilandGas.PPDM39.DataManagement.Models
@using Beep.OilandGas.Repository.Models
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject Beep.OilandGas.Web.Theme.IThemeProvider ThemeProvider
@inject ThemeState Theme
@inject Beep.OilandGas.Web.Services.RepositoryAccountClient RepositoryClient
@inject TheTechIdeaWeb.Diagnostics.IFailureReporter Failures
@inject Beep.OilandGas.Client.App.CompanyClientContext Company
@using Microsoft.AspNetCore.Components.Authorization
@using Beep.OilandGas.Web.Theme
@using TheTechIdeaWeb.Diagnostics.Components
@implements IDisposable

@* The theme and MudBlazor's providers are the router's (Routes.razor), drawn from this circuit's ThemeState. Sign-in,
   registration, the account page and sign-out are the identity server's client library's (/account/*): this layout
   linked /login, /register and /profile — pages that no longer exist or never did — and signed out by navigating to a GET
   the library does not map, inside a catch that ignored its failure (S3-06 §3). *@

<MudLayout>
    @if (!_isLandingPage)
    {
        <MudAppBar Elevation="1" Color="Color.Primary">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Class="app-logo-link">
                <img src="@(_branding.LogoUrl ?? "/imgs/BeepOGDM.png")" 
                     alt="@(_branding.AppName ?? "Beep Oil & Gas")" 
                     class="app-logo" 
                     onerror="this.style.display='none';" />
            </MudNavLink>
            <MudSpacer />
            @if (_isAuthenticated) { <CompanySelector /> }
            @if (_companyMatchesAccount) { <CompanyEnvironmentIndicator @key="Company.Version" OnEnvironmentChanged="SetCompanyEnvironment" /> }
            <!-- Horizontal Navigation Menu -->
            <div class="og-nav-wrapper">
                <NavMenu />
            </div>
            <MudSpacer />
            
            <!-- Persona Selector (W11-07) -->
            @if (_companyMatchesAccount)
            {
            <div class="persona-selector-container">
                <PersonaSelector @key="Company.Version" />
            </div>
            }
            <MudSpacer />
            
            <!-- User Actions - Single Icon with Menu -->
            @if (_companyMatchesAccount)
            {
                <NotificationCenter />
            }
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="me-2">
                @* MudBlazor 9: custom activator content opens its menu itself, through the menu's context — the wrapper no
                   longer does, so without OnClick nobody could reach sign-in, the account page or sign-out. *@
                <ActivatorContent>
                    <MudIconButton Icon="@(_isAuthenticated ? Icons.Material.Filled.AccountCircle : Icons.Material.Filled.Login)"
                                   Color="Color.Inherit"
                                   aria-label="@(_isAuthenticated ? "Your account" : "Sign in")"
                                   OnClick="@context.ToggleAsync" />
                </ActivatorContent>
                <ChildContent>
                    @if (_isAuthenticated)
                    {
                        <MudMenuItem Href="@BeepClientEndpoints.Manage" Icon="@Icons.Material.Filled.Person">My account</MudMenuItem>
                        @* DIAG-01. In this menu rather than the navigation's, whose menus do not open (MudBlazor 9's activator). *@
                        <AuthorizeView Roles="Administrator" Context="failuresAdmin">
                            <MudMenuItem Href="/setup/repository" Icon="@Icons.Material.Filled.Settings">First-time setup</MudMenuItem>
                            <MudMenuItem Href="/admin/failures" Icon="@Icons.Material.Filled.ReportProblem">Failures</MudMenuItem>
                        </AuthorizeView>
                        <MudDivider />
                        <div class="pa-2">
                            <SignOutButton FullWidth="true" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout">Sign out</SignOutButton>
                        </div>
                    }
                    else
                    {
                        <MudMenuItem Href="@BeepClientEndpoints.LoginWithReturn(CurrentPath)" Icon="@Icons.Material.Filled.Login">Sign in</MudMenuItem>
                        <MudMenuItem Href="@BeepClientEndpoints.RegisterWithReturn(CurrentPath)" Icon="@Icons.Material.Filled.PersonAdd">Create account</MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>

            <!-- Theme Toggle -->
            <MudIconButton Icon="@(Theme.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           Class="me-4"
                           OnClick="@(() => Theme.SetDarkModeAsync(!Theme.IsDarkMode))"
                           aria-label="@(Theme.IsDarkMode ? "Switch to light mode" : "Switch to dark mode")" />
        </MudAppBar>
    }
    
    <MudMainContent>
        <div class="og-main-content">
            <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
                @if (_companyMatchesAccount && !_isLandingPage)
                {
                    <MudPaper Outlined="true" Class="pa-3 mb-4">
                        <FieldSelector @key="Company.Version" />
                    </MudPaper>
                }
                @* DIAG-01. A page that fails is reported and says so with its reference, instead of ending the circuit. *@
                <ReportingErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        <div @key="Company.Version">
                            @if (!_setupGateAllowed)
                            {
                                <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Checking repository readiness" />
                            }
                            else if (_isAuthenticated && !_isLandingPage && !_companyMatchesAccount &&
                                !CompanyUiRoutes.IsRepositorySurface(new Uri(NavigationManager.Uri).AbsolutePath))
                            {
                                <MudAlert Severity="Severity.Info">Select an available company to open this workspace.</MudAlert>
                            }
                            else
                            {
                                <CascadingValue Value="@CurrentCompanyEnvironment" IsFixed="false">@Body</CascadingValue>
                            }
                        </div>
                    </ChildContent>
                    <ErrorContent>
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
                            Something went wrong on this page. Try again; if it keeps happening, quote reference
                            <strong data-error-reference>@_errorBoundary?.Reference</strong> when you report it.
                        </MudAlert>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => _errorBoundary?.Recover())">
                            Try again
                        </MudButton>
                    </ErrorContent>
                </ReportingErrorBoundary>
            </MudContainer>
        </div>
        
        <!-- Footer -->
        <MudPaper Elevation="0" Class="og-footer">
            <MudContainer MaxWidth="MaxWidth.False" Class="py-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @(_branding.Copyright ?? $"© {DateTime.Now.Year} {(_branding.AppName ?? "Beep Oil & Gas")}. All rights reserved.")
                    </MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <img src="/imgs/companylogo.svg" alt="The Tech Idea" class="og-footer-logo" onerror="this.style.display='none';" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Powered by <strong>The Tech Idea</strong>™
                        </MudText>
                    </MudStack>
                </MudStack>
            </MudContainer>
        </MudPaper>
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool _isAuthenticated;
    private string? _authenticatedActor;
    private Task<AuthenticationState>? _lastAuthenticationState;
    private long _authenticationGeneration;
    private bool _isLandingPage;
    private bool _setupGateAllowed, _disposed;
    private long _setupGateGeneration;
    private ReportingErrorBoundary? _errorBoundary;
    private BrandingConfig _branding = new();
    private Beep.OilandGas.Web.Services.CompanyEnvironmentDisplay? _companyEnvironment;
    private Beep.OilandGas.Web.Services.CompanyEnvironmentDisplay? CurrentCompanyEnvironment =>
        _companyMatchesAccount && !_isLandingPage && _companyEnvironment?.Matches(Company) == true ? _companyEnvironment : null;
    private bool _companyMatchesAccount => _isAuthenticated && _authenticatedActor is not null && Company.Selection?.UserId == _authenticatedActor;
    private void SetCompanyEnvironment(Beep.OilandGas.Web.Services.CompanyEnvironmentDisplayUpdate value) => _companyEnvironment =
        _companyMatchesAccount ? value.Apply(Company, _companyEnvironment) : null;

    private string CurrentPath => new Uri(NavigationManager.Uri).PathAndQuery;

    protected override async Task OnInitializedAsync()
    {
        _branding = ThemeProvider.GetBranding();
        Company.Changed += CompanyChanged;
        CheckIfLandingPage();
        NavigationManager.LocationChanged += OnLocationChanged;
        await EnsureFirstRunSetupGateAsync(new Uri(NavigationManager.Uri).AbsolutePath);
    }

    protected override async Task OnParametersSetAsync()
    {
        var generation = Interlocked.Increment(ref _authenticationGeneration);
        var task = AuthenticationState;
        if (!ReferenceEquals(task, _lastAuthenticationState))
        {
            _lastAuthenticationState = task; _isAuthenticated = false; _authenticatedActor = null; _companyEnvironment = null;
        }
        var principal = task is null ? null : (await task).User;
        if (_disposed || generation != Interlocked.Read(ref _authenticationGeneration)) return;
        _isAuthenticated = principal?.Identity?.IsAuthenticated == true;
        _authenticatedActor = _isAuthenticated ? Beep.Foundation.IdentityServer.Shared.Identity.PartyIdClaims.Find(principal) : null;
    }

    private void CheckIfLandingPage()
    {
        var path = new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/');
        _isLandingPage = path.Length == 0 || path.Equals("/index", StringComparison.OrdinalIgnoreCase);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(() => HandleLocationChangedAsync(e.Location));

    private async Task HandleLocationChangedAsync(string location)
    {
        // The navigation event returns void, so nothing awaits this: every failure is reported here, never left to end
        // the circuit (it was an async void handler with no catch).
        try
        {
            var gate = EnsureFirstRunSetupGateAsync(new Uri(location).AbsolutePath);
            StateHasChanged();
            if (!await gate)
            {
                return;
            }

            CheckIfLandingPage();
            StateHasChanged();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            // Broad on purpose: the readiness check crosses the network and the renderer; the page stays as it is.
            Failures.ReportHandled(exception, "checking the repository is set up after navigating",
                consequence: "the page stays as it is; the setup gate is asked again at the next navigation",
                TheTechIdeaWeb.Diagnostics.FailureSeverity.Degraded);
        }
    }

    private void CompanyChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _disposed = true; ++_setupGateGeneration; Interlocked.Increment(ref _authenticationGeneration);
        Company.Changed -= CompanyChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async Task<bool> EnsureFirstRunSetupGateAsync(string currentPath)
    {
        var generation = ++_setupGateGeneration;
        _setupGateAllowed = false;
        if (IsSetupExemptPath(currentPath))
        {
            _setupGateAllowed = true;
            return true;
        }

        var status = await RepositoryClient.GetReadinessAsync();
        if (_disposed || generation != _setupGateGeneration ||
            !string.Equals(currentPath, new Uri(NavigationManager.Uri).AbsolutePath, StringComparison.OrdinalIgnoreCase))
            return false;
        if (status == Beep.OilandGas.Repository.Models.RepositoryReadiness.Ready)
        {
            _setupGateAllowed = true;
            return true;
        }

        NavigationManager.NavigateTo("/setup/repository", forceLoad: false);
        return false;
    }

    /// <summary>
    /// The pages that must render while the repository is not ready: its own setup page, and the account pages this
    /// application hosts for the identity server's client library — none of them reads the repository. The library's own
    /// endpoints are not pages and never reach this layout.
    /// </summary>
    private static bool IsSetupExemptPath(string currentPath)
    {
        if (string.IsNullOrWhiteSpace(currentPath)) return false;
        var path = currentPath.TrimEnd('/');
        return path.Equals("/setup/repository", StringComparison.OrdinalIgnoreCase)
            || path.Equals("/setup/bootstrap-drivers", StringComparison.OrdinalIgnoreCase)
            || path.Equals(BeepClientEndpoints.AccessDenied, StringComparison.OrdinalIgnoreCase)
            || path.Equals(BeepClientEndpoints.Manage, StringComparison.OrdinalIgnoreCase);
    }
}
