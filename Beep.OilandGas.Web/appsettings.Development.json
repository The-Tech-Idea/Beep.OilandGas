{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // This application's registration in the local identity server's console (a web application with
  // https://localhost:7066/signin-oidc, /signout-callback-oidc and /account/backchannel-logout, permitted the OilGas API
  // and the account scopes below). The client id and secret are secrets of this machine, so they go in user-secrets:
  //   dotnet user-secrets set "IdentityServer:ClientId" "<console-generated id>"
  //   dotnet user-secrets set "IdentityServer:ClientSecret" "<console-generated secret>"
  // ApiScopes: the OilGas API's identifier, registered under Admin > APIs (the API's IdentityServer:Audience).
  // AccountScopes: what the /account/manage page uses; the console must permit each or sign-in fails with invalid_scope.
  "IdentityServer": {
    "Authority": "https://localhost:7062/",
    "ApiScopes": [ "https://localhost:7001/api" ],
    "AccountScopes": [
      "account.read",
      "account.manage",
      "account.security",
      "account.export",
      "account.delete"
    ]
  },
  "ApiService": {
    "BaseUrl": "https://localhost:7001"
  },
  // The failure store the Web and the API share (DIAG-01). The API applies its schema; this host only writes and reads.
  "Diagnostics": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=BeepOilGasDiagnostics;Integrated Security=true;TrustServerCertificate=true"
  }
}
