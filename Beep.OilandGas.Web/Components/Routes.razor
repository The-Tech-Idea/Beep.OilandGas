@implements IDisposable
@inject ThemeState Theme

@* One MudThemeProvider and one set of MudBlazor providers for the whole application, drawn from this circuit's choice
   (ThemeState). Each layout had its own, so the account pages ignored the dark mode chosen on the others (S3-06 §8). No
   MudRTLProvider: OilGas is English only, so no right-to-left culture is offered. *@
<MudThemeProvider Theme="@Theme.Theme" IsDarkMode="@Theme.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<Router AppAssembly="@typeof(Routes).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized Context="authenticationState">
                @if (authenticationState.User.Identity?.IsAuthenticated == true)
                {
                    @* The access-denied page itself, so the refusal a signed-in person meets here and the one the cookie
                       sends them to say the same thing. *@
                    <Beep.OilandGas.Web.Components.Pages.Account.AccessDenied />
                }
                else
                {
                    <Beep.OilandGas.Web.Components.Account.Shared.RedirectToLogin />
                }
            </NotAuthorized>
            <Authorizing>
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
                <MudPaper Elevation="2" Class="pa-6">
                    <MudStack AlignItems="AlignItems.Center" Spacing="3">
                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Class="og-icon-xl" />
                        <MudText Typo="Typo.h5">Page Not Found</MudText>
                        <MudText Typo="Typo.body1" Class="text-center">
                            Sorry, there's nothing at this address.
                        </MudText>
                        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-2">
                            Go Home
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudContainer>
        </LayoutView>
    </NotFound>
</Router>

@code {
    protected override void OnInitialized() => Theme.Changed += OnThemeChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Local storage is reachable only once the circuit has rendered.
        if (firstRender)
        {
            await Theme.RestoreAsync();
        }
    }

    private Task OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Theme.Changed -= OnThemeChanged;
}
