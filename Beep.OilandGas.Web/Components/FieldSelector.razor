@implements IDisposable
@inject IDataManagementService DataManagementService
@inject ApiClient ApiClient
@inject OilGasCallFailures Calls

<MudGrid AlignItems="AlignItems.Center" Spacing="2">
    <MudItem xs="12" sm="8" md="6">
        <MudSelect T="string" Label="Active field" Variant="Variant.Outlined" Margin="Margin.Dense"
                   Value="@_state?.SelectedId" ValueChanged="Select" Disabled="@(_state is null || _state.Loading || _state.Saving || !_state.Loaded || _state.Fields.Count == 0)"
                   HelperText="Sets the field used by dashboards and field workbenches.">
            @if (_state is not null)
            {
                @foreach (var field in _state.Fields)
                {
                    <MudSelectItem T="string" Value="@field.FieldId">@(string.IsNullOrWhiteSpace(field.FieldName) ? field.FieldId : field.FieldName)</MudSelectItem>
                }
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="4" md="3">
        <MudButton OnClick="Reload" Disabled="@(_state is null || _state.Loading || _state.Saving)" StartIcon="@Icons.Material.Filled.Refresh">Refresh fields</MudButton>
    </MudItem>
</MudGrid>
@if (_state?.Loading == true || _state?.Saving == true)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Updating field selection" />
}
@if (_state?.Error is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mt-2">@_state.Error</MudAlert>
}
else if (_state?.Loaded == true && _state.Fields.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mt-2">No fields are available to select. Contact your administrator if you expect access to a field.</MudAlert>
}
@if (_state?.Confirmation is not null)
{
    <MudText Typo="Typo.caption" role="status">@_state.Confirmation</MudText>
}

@code {
    private FieldSelectionState? _state;
    private bool _disposed;
    protected override async Task OnInitializedAsync()
    {
        _state = new(ApiClient, DataManagementService, Calls);
        _state.Changed += Changed;
        await Reload();
    }
    private Task Reload() => _state!.LoadAsync();
    private Task Select(string id) => _state!.SelectAsync(id);
    private void Changed() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    public void Dispose() { _disposed = true; if (_state is not null) { _state.Changed -= Changed; _state.Dispose(); } }
}
