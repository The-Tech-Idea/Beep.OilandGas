@using Beep.OilandGas.Client.App
@using Beep.OilandGas.Models.Data
@using Beep.OilandGas.Web.Services
@inject CompanyClientContext Company
@inject AssetHierarchyState State
@implements IDisposable

<MudPaper Elevation="2" Class="pa-4" aria-busy="@State.Loading.ToString().ToLowerInvariant()">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h6">Asset Hierarchy</MudText>
        <MudButton OnClick="Reload" Disabled="@(State.Loading || State.NeedsCompany)" StartIcon="@Icons.Material.Filled.Refresh">Refresh</MudButton>
    </MudStack>
    @if (State.Loading)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" aria-label="Loading asset hierarchy" />
    }
    else if (State.Error is not null)
    {
        <MudAlert Severity="Severity.Error">@State.Error</MudAlert>
    }
    else if (State.NeedsCompany)
    {
        <MudAlert Severity="Severity.Info">Select a company to view its assets.</MudAlert>
    }
    else if (State.Hierarchy is { } hierarchy && (hierarchy.AssetType != "ORGANIZATION" || hierarchy.Children.Count != 0))
    {
        <ul class="asset-hierarchy-list asset-hierarchy-root">
            @RenderTreeNode(hierarchy)
        </ul>
    }
    else
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No assets available for this selection.</MudText>
    }
</MudPaper>

@code {
    [Parameter] public string? OrganizationId { get; set; }
    [Parameter] public string? RootAssetId { get; set; }
    [Parameter] public string? RootAssetType { get; set; }
    [Parameter] public string? RootFacilityType { get; set; }
    [Parameter] public EventCallback<AssetHierarchyNode> OnAssetSelected { get; set; }
    [Parameter] public EventCallback OnSelectionInvalidated { get; set; }
    private (string?, string?, string?, string?) _parameters;
    private bool _initialized;
    private bool _disposed;

    protected override void OnInitialized()
    {
        State.Changed += StateChanged;
        Company.Changed += CompanyChanged;
    }
    protected override async Task OnParametersSetAsync()
    {
        var parameters = (OrganizationId, RootAssetId, RootAssetType, RootFacilityType);
        if (_initialized && parameters == _parameters) return;
        _initialized = true; _parameters = parameters;
        await Reload();
    }
    private async Task Reload()
    {
        State.Invalidate();
        await OnSelectionInvalidated.InvokeAsync();
        await State.LoadAsync(OrganizationId, RootAssetId, RootAssetType, RootFacilityType);
    }
    private void StateChanged() { if (!_disposed) _ = InvokeAsync(() => { if (!_disposed) StateHasChanged(); }); }
    private void CompanyChanged() { if (!_disposed) _ = InvokeAsync(async () => { if (!_disposed) await Reload(); }); }

    private RenderFragment RenderTreeNode(AssetHierarchyNode node) => builder =>
    {
        builder.OpenElement(0, "li");
        builder.AddAttribute(1, "class", "asset-hierarchy-node");
        var label = node.AssetName ?? node.AssetId;
        if (node.LevelName is not null) label = $"{node.LevelName}: {label}";
        if (node.AssetType == "FACILITY") label += $" ({node.FacilityType})";
        if (node.AssetType == "ORGANIZATION")
        {
            builder.OpenComponent<MudText>(2);
            builder.AddAttribute(3, "Typo", Typo.subtitle1);
            builder.AddAttribute(4, "ChildContent", (RenderFragment)(content => content.AddContent(0, label)));
            builder.CloseComponent();
        }
        else
        {
            builder.OpenComponent<MudButton>(5);
            builder.AddAttribute(6, "Disabled", !State.CanSelect(node));
            builder.AddAttribute(7, "OnClick", EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, () => HandleNodeClick(node)));
            builder.AddAttribute(8, "StartIcon", node.AssetType switch
            {
                "FIELD" => Icons.Material.Filled.Map, "POOL" => Icons.Material.Filled.WaterDrop,
                "FACILITY" => Icons.Material.Filled.Business, "WORK_ORDER" => Icons.Material.Filled.Assignment, _ => Icons.Material.Filled.PrecisionManufacturing
            });
            builder.AddAttribute(9, "ChildContent", (RenderFragment)(content => content.AddContent(0, label)));
            builder.CloseComponent();
        }
        if(node.AssetType=="EQUIPMENT")
        {
            builder.OpenComponent<MudText>(17);
            builder.AddAttribute(18,"Typo",Typo.caption);
            builder.AddAttribute(19,"ChildContent",(RenderFragment)(content=>content.AddContent(0,"Equipment location requires separate installation evidence.")));
            builder.CloseComponent();
        }
        if(node.AssetType=="WORK_ORDER")
        {
            builder.OpenComponent<MudText>(13);
            builder.AddAttribute(14,"Typo",Typo.caption);
            builder.AddAttribute(15,"ChildContent",(RenderFragment)(content=>content.AddContent(0,"Recorded FIELD components; these references do not grant access to related assets.")));
            builder.CloseComponent();
            builder.OpenElement(16,"ul");builder.AddAttribute(17,"class","asset-hierarchy-list");
            foreach(var component in node.WorkOrderComponents)
            {
                builder.OpenElement(18,"li");
                builder.AddContent(19,$"Component {component.ComponentId} · FIELD {component.FieldId}");
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        if (node.Children.Count != 0)
        {
            builder.OpenElement(10, "ul");
            builder.AddAttribute(11, "class", "asset-hierarchy-list");
            foreach (var child in node.Children) builder.AddContent(12, RenderTreeNode(child));
            builder.CloseElement();
        }
        builder.CloseElement();
    };
    private async Task HandleNodeClick(AssetHierarchyNode node)
    {
        if (State.CanSelect(node)) await OnAssetSelected.InvokeAsync(node);
    }
    public void Dispose()
    {
        _disposed = true; Company.Changed -= CompanyChanged; State.Changed -= StateChanged; State.Dispose();
    }
}
