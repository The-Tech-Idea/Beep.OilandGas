<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="og-h-full">
    <!-- Production Menu - Primary focus for Petroleum Engineers -->
    <MudMenu Icon="@Icons.Material.Filled.OilBarrel" Color="Color.Inherit">
        <ActivatorContent>
            <MudButton Variant="Variant.Text" Class="og-nav-btn-legacy">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                    <MudIcon Icon="@Icons.Material.Filled.OilBarrel" Size="Size.Small" />
                    <MudText Class="og-nav-label-legacy">Production</MudText>
                </MudStack>
            </MudButton>
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem Href="/ppdm39/production/fields">
                <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" Class="mr-2" />
                Fields
            </MudMenuItem>
            <MudMenuItem Href="/ppdm39/production/pools">
                <MudIcon Icon="@Icons.Material.Filled.WaterDrop" Size="Size.Small" Class="mr-2" />
                Pools
            </MudMenuItem>
            <MudMenuItem Href="/ppdm39/production/reporting">
                <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Small" Class="mr-2" />
                Production Reporting
            </MudMenuItem>
        </ChildContent>
    </MudMenu>
    
    <!-- Well Analysis Menu -->
    <MudMenu Icon="@Icons.Material.Filled.PrecisionManufacturing" Color="Color.Inherit">
        <ActivatorContent>
            <MudButton Variant="Variant.Text" Class="og-nav-btn-legacy">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                    <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Size="Size.Small" />
                    <MudText Class="og-nav-label-legacy">Wells</MudText>
                </MudStack>
            </MudButton>
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem Href="/ppdm39/wells/wellbores">
                <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Size="Size.Small" Class="mr-2" />
                Wellbores
            </MudMenuItem>
            <MudMenuItem Href="/ppdm39/wells/logs">
                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-2" />
                Well Logs
            </MudMenuItem>
        </ChildContent>
    </MudMenu>
    
    <!-- Analysis & Forecasting Menu -->
    <MudMenu Icon="@Icons.Material.Filled.Analytics" Color="Color.Inherit">
        <ActivatorContent>
            <MudButton Variant="Variant.Text" Class="og-nav-btn-legacy">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                    <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="Size.Small" />
                    <MudText Class="og-nav-label-legacy">Analysis</MudText>
                </MudStack>
            </MudButton>
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem Href="/analysis/decline-curve">
                <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Small" Class="mr-2" />
                Decline Curve Analysis
            </MudMenuItem>
            <MudMenuItem Href="/analysis/production-forecasting">
                <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Small" Class="mr-2" />
                Production Forecasting
            </MudMenuItem>
            <MudMenuItem Href="/analysis/well-test">
                <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Small" Class="mr-2" />
                Well Test Analysis
            </MudMenuItem>
            <MudMenuItem Href="/analysis/nodal">
                <MudIcon Icon="@Icons.Material.Filled.Polyline" Size="Size.Small" Class="mr-2" />
                Nodal Analysis
            </MudMenuItem>
        </ChildContent>
    </MudMenu>

    <!-- Role-Based Dashboards (Phase 1-6: Role Enhancement Plan) -->
    <MudMenu Label="Dashboards" Icon="@Icons.Material.Filled.Dashboard" Color="Color.Secondary"
             AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
        <ChildContent>
            <MudMenuItem Href="/executive/dashboard">
                <MudIcon Icon="@Icons.Material.Filled.Insights" Class="mr-2" /> Executive
            </MudMenuItem>
            <MudMenuItem Href="/accounting/dashboard">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Class="mr-2" /> Accounting
            </MudMenuItem>
            <MudMenuItem Href="/production/operations">
                <MudIcon Icon="@Icons.Material.Filled.Speed" Class="mr-2" /> Production Ops
            </MudMenuItem>
            <MudMenuItem Href="/reservoir/workspace">
                <MudIcon Icon="@Icons.Material.Filled.Science" Class="mr-2" /> Reservoir
            </MudMenuItem>
            <MudMenuItem Href="/drilling/workspace">
                <MudIcon Icon="@Icons.Material.Filled.Construction" Class="mr-2" /> Drilling
            </MudMenuItem>
            <MudMenuItem Href="/production/engineer-workspace">
                <MudIcon Icon="@Icons.Material.Filled.Engineering" Class="mr-2" /> Production Eng
            </MudMenuItem>
            <MudMenuItem Href="/hse/dashboard">
                <MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" Class="mr-2" /> HSE
            </MudMenuItem>
            <MudMenuItem Href="/admin/dashboard">
                <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Class="mr-2" /> Admin
            </MudMenuItem>
        </ChildContent>
    </MudMenu>

    <!-- Data Manager Menu — full Beep.Razor.Components + PPDM data tools -->
    <MudMenu Label="Data Manager" Icon="@Icons.Material.Filled.Storage" Color="Color.Secondary"
             AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
        <ChildContent>
            @* ── Connections & Drivers ── *@
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-2 pt-1">Connections &amp; Setup</MudText>
            <MudMenuItem Href="/uc_dataconnection"><MudIcon Icon="@Icons.Material.Filled.Cable" Class="mr-2"/>Connection Editor</MudMenuItem>
            <MudMenuItem Href="/uc_connectiondrivers"><MudIcon Icon="@Icons.Material.Filled.Usb" Class="mr-2"/>Driver Manager</MudMenuItem>
            <MudMenuItem Href="/uc_createlocaldb"><MudIcon Icon="@Icons.Material.Filled.CreateNewFolder" Class="mr-2"/>Create Local DB</MudMenuItem>
            <MudMenuItem Href="/ppdm39/setup"><MudIcon Icon="@Icons.Material.Filled.AutoFixHigh" Class="mr-2"/>Setup Wizard</MudMenuItem>
            <MudDivider Class="my-1"/>
            @* ── Import / Export ── *@
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-2 pt-1">Import &amp; Export</MudText>
            <MudMenuItem Href="/ppdm39/data-import"><MudIcon Icon="@Icons.Material.Filled.Upload" Class="mr-2"/>Data Import (CSV)</MudMenuItem>
            <MudMenuItem Href="/uc_exportmanagement"><MudIcon Icon="@Icons.Material.Filled.Download" Class="mr-2"/>Export Management</MudMenuItem>
            <MudMenuItem Href="/uc_importmanagement"><MudIcon Icon="@Icons.Material.Filled.Publish" Class="mr-2"/>Import Management</MudMenuItem>
            <MudDivider Class="my-1"/>
            @* ── Schema & Migration ── *@
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-2 pt-1">Schema &amp; Migration</MudText>
            <MudMenuItem Href="/migration-viewer"><MudIcon Icon="@Icons.Material.Filled.Schema" Class="mr-2"/>Migration Viewer</MudMenuItem>
            <MudMenuItem Href="/uc_entityeditor"><MudIcon Icon="@Icons.Material.Filled.TableChart" Class="mr-2"/>Entity Editor</MudMenuItem>
            <MudMenuItem Href="/assembly-registration"><MudIcon Icon="@Icons.Material.Filled.Extension" Class="mr-2"/>Assembly Registration</MudMenuItem>
            <MudDivider Class="my-1"/>
            @* ── Data Operations ── *@
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-2 pt-1">Data Operations</MudText>
            <MudMenuItem Href="/uc_dataedit"><MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2"/>Data Edit (CRUD)</MudMenuItem>
            <MudMenuItem Href="/data-promotion"><MudIcon Icon="@Icons.Material.Filled.MoveUp" Class="mr-2"/>Data Promotion</MudMenuItem>
            <MudMenuItem Href="/ppdm39/sync"><MudIcon Icon="@Icons.Material.Filled.Sync" Class="mr-2"/>Sync Dashboard</MudMenuItem>
            <MudDivider Class="my-1"/>
            @* ── Tools & Quality ── *@
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-2 pt-1">Tools &amp; Quality</MudText>
            <MudMenuItem Href="/uc_nuggetsmanage"><MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="mr-2"/>NuGet Manager</MudMenuItem>
            <MudMenuItem Href="/ppdm39/data-quality"><MudIcon Icon="@Icons.Material.Filled.Verified" Class="mr-2"/>Data Quality</MudMenuItem>
            <MudMenuItem Href="/data/validation"><MudIcon Icon="@Icons.Material.Filled.Checklist" Class="mr-2"/>Validation</MudMenuItem>
            <MudMenuItem Href="/uc_dataset_studio"><MudIcon Icon="@Icons.Material.Filled.Hub" Class="mr-2"/>DataSet Studio Hub</MudMenuItem>
        </ChildContent>
    </MudMenu>

    @* ── Task Inbox (Phase 5) ── *@
    <MudNavLink Href="/tasks/inbox" Match="NavLinkMatch.Prefix" Class="og-nav-btn-legacy">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Small" />
            <MudText Class="og-nav-label-legacy">Tasks</MudText>
            <NotificationBadge />
        </MudStack>
    </MudNavLink>
</MudStack>
