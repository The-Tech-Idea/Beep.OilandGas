@* Checks if setup is required on every navigation and redirects to the wizard *@
@using System.Net.Http.Json
@inject NavigationManager Nav
@inject HttpClient Http
@implements IDisposable

@if (_setupRequired)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-12">
        <MudPaper Elevation="3" Class="pa-6" Style="text-align:center">
            <MudIcon Icon="@Icons.Material.Filled.Construction" Size="Size.Large" Color="Color.Primary" Class="mb-3"/>
            <MudText Typo="Typo.h4" Class="mb-2">Setup Required</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                The PPDM39 database has not been configured yet. Complete the setup wizard to get started.
            </MudText>
            <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
                1. Install database drivers → 2. Create PPDM39 connection → 3. Run setup wizard
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="/ppdm39/setup/beep-wizard">
                Open Setup Wizard
            </MudButton>
        </MudPaper>
    </MudContainer>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool _setupRequired;
    private PeriodicTimer? _timer;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        await CheckSetupAsync();
        // Check periodically for when setup completes in another tab
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        _ = MonitorSetupAsync();
    }

    private async Task CheckSetupAsync()
    {
        try
        {
            var preflight = await Http.GetFromJsonAsync<SetupStatus>("/api/setup/wizard/preflight");
            _setupRequired = preflight?.isFirstRun == true || preflight?.hasExistingDatasource != true;
        }
        catch { _setupRequired = false; /* API unavailable — let it through */ }
    }

    private async Task MonitorSetupAsync()
    {
        while (!_disposed && _timer != null && await _timer.WaitForNextTickAsync())
        {
            if (_disposed || !_setupRequired) break;
            await CheckSetupAsync();
            if (!_setupRequired) { StateHasChanged(); break; }
        }
    }

    public void Dispose() { _disposed = true; _timer?.Dispose(); }

    public class SetupStatus { public bool isFirstRun { get; set; } public bool hasExistingDatasource { get; set; } }
}
