@using Beep.OilandGas.Models.Data.Accounting.Royalty
@using Beep.OilandGas.Models.Data.ProductionAccounting

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2">Preview oil royalties using recorded allocations, lease interests and ticket prices. Previewing does not post obligations or journal entries.</MudText>
            <MudDatePicker @bind-Date="_productionDate" Label="Production ticket date" Required="true" Disabled="_busy" Variant="Variant.Outlined" />
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }
            @if (_preview is not null)
            {
                @foreach (var row in _preview)
                {
                    <MudPaper Class="pa-3">
                        <MudText Typo="Typo.subtitle2">Lease @row.PROPERTY_OR_LEASE_ID — Owner @row.ROYALTY_OWNER_ID</MudText>
                        <MudText Typo="Typo.body2">Source allocation detail: @row.ALLOCATION_DETAIL_ID</MudText>
                        <MudText Typo="Typo.body2">Volume: @row.GROSS_VOLUME BBL; recorded rate: @row.ROYALTY_INTEREST%</MudText>
                        <MudText Typo="Typo.body2">Calculated royalty amount: @row.ROYALTY_AMOUNT?.ToString("N2")</MudText>
                    </MudPaper>
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Disabled="_busy">Close</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Preview" Disabled="_busy">Preview royalties</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] IAccountingServiceClient AccountingServiceClient { get; set; } = default!;
    [Parameter] public string FieldId { get; set; } = string.Empty;
    private DateTime? _productionDate = DateTime.Today;
    private List<ROYALTY_CALCULATION>? _preview;
    private string? _error;
    private bool _busy;
    private void Close() => MudDialog.Cancel();

    private async Task Preview()
    {
        _preview = null;
        _error = null;
        if (!_productionDate.HasValue || string.IsNullOrWhiteSpace(FieldId))
        {
            _error = "Select an active field and production date.";
            return;
        }
        _busy = true;
        try
        {
            _preview = await AccountingServiceClient.PreviewRoyaltiesAsync(new PreviewRoyaltiesRequest
                { FieldId = FieldId, ProductionDate = DateOnly.FromDateTime(_productionDate.Value) });
            if (_preview.Count == 0) _error = "No royalty preview was returned.";
        }
        catch (Exception)
        {
            _error = "Royalty preview failed. Verify recorded allocations, effective lease interests, ticket prices and deductions.";
        }
        finally { _busy = false; }
    }
}
