        try{Query.Require();var user=(await Authentication.GetAuthenticationStateAsync()).User;if(snapshot.Selection is not {} selected || user.Identity?.IsAuthenticated!=true || user.FindFirst("party_id")?.Value!=selected.UserId || !selected.Roles.Any(user.IsInRole) || !selected.Permissions.Contains("Maintenance.ReturnToService",StringComparer.Ordinal) || await Fields.GetCurrentFieldIdAsync()!=Query.Task.FieldId || snapshot!=Company.Snapshot || generation!=_generation)throw new UnauthorizedAccessException("Current original company/account/standard role/FIELD and return evidence authority are required.");State.Attach(Query);if(recorded)await State.ReadReturnStatusAsync(Workflows);else await State.ReadAsync(Workflows);}
