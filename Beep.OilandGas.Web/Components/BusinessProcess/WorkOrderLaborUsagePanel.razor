@using TheTechIdea.Data.OilGas
@using Beep.OilandGas.Web.Services
@using Microsoft.AspNetCore.WebUtilities
@inject WorkOrderLaborUsageState State
@inject ICompanyMaintenanceHandoffClient Workflows
@inject IFieldSelectionContext Fields
@inject Beep.OilandGas.Client.App.CompanyClientContext Company
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject OilGasCallFailures Calls
@implements IDisposable

<MudPaper Class="pa-4 my-3" Outlined="true">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6">Record actual labor</MudText>
        @if(_error is not null){<MudAlert Severity="Severity.Error">@_error</MudAlert>}
        <MudButton OnClick="ReviewAsync" Disabled="@(!_authorized || !State.CanReview)">Review original start and employee duty</MudButton>
        @if(_authorized && State.Review is {} review)
        {
            <MudText>Employee @review.Assignment.EmployeeBaId · duty @review.Assignment.DutyCode · assignment @review.Assignment.AssignmentId</MudText>
            <MudText>Original actual start UTC @review.Execution.Start.StartedAtUtc.ToString("O") · compared UTC @review.ComparedAtUtc.ToString("O")</MudText>
            <MudText>@review.Occupancies.Count recorded time intervals checked for overlap</MudText>
            @if(review.AssignmentReleasedAtUtc is {} released){<MudAlert Severity="Severity.Warning">Duty canceled at UTC @released.ToString("O"). Report only time that occurred before cancellation.</MudAlert>}
            <MudTextField @bind-Value="_from" Label="Actual labor from UTC (ISO timestamp ending Z)" Required="true" Disabled="@State.Busy" />
            <MudTextField @bind-Value="_to" Label="Actual labor to UTC (ISO timestamp ending Z)" Required="true" Disabled="@State.Busy" />
            <MudNumericField T="decimal?" @bind-Value="_quantity" Label="Actual elapsed quantity" Required="true" Disabled="@State.Busy" />
            <MudSelect T="WorkOrderLaborTimeUnit" @bind-Value="_unit" Label="Elapsed time unit" Required="true" Disabled="@State.Busy">
                <MudSelectItem Value="WorkOrderLaborTimeUnit.Second">Second</MudSelectItem>
                <MudSelectItem Value="WorkOrderLaborTimeUnit.Minute">Minute</MudSelectItem>
                <MudSelectItem Value="WorkOrderLaborTimeUnit.Hour">Hour</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_work" Label="Work performed" Lines="3" Required="true" Disabled="@State.Busy" />
            <MudTextField @bind-Value="_reason" Label="Labor report rationale" Required="true" Disabled="@State.Busy" />
            <MudCheckBox @bind-Value="_confirm" Label="I confirm this exact elapsed time was worked on my original employee duty" Disabled="@State.Busy" />
            <MudButton OnClick="RecordAsync" Disabled="@(!State.CanRecord || !_confirm)" Color="Color.Primary">Retain original reference and record labor</MudButton>
        }
        <MudTextField @bind-Value="_reference" Label="Original labor intent reference" Disabled="@State.Busy" />
        <MudButton OnClick="RecoverAsync" Disabled="@(!_authorized || State.Busy)">Read original labor without replay</MudButton>
        @if(_authorized && State.VisibleReference is {} saved){<MudText>Retained original labor reference @saved</MudText>}
        @if(_authorized && State.Receipt is {} receipt)
        {
            <MudAlert Severity="Severity.Success">Recorded labor @receipt.Recorded.LABOR_ID · @receipt.Command.Quantity @receipt.Command.Unit · UTC @receipt.Command.FromUtc.ToString("O") to @receipt.Command.ToUtc.ToString("O").</MudAlert>
        }
        <MudAlert Severity="Severity.Info">The explicit quantity and unit must exactly match the UTC interval. Overlapping employee time is refused. Labor rates, currency and financial posting require their own reviewed financial evidence. Recover an uncertain report using its retained original reference.</MudAlert>
    </MudStack>
</MudPaper>
@code {
    [Parameter] public CompanyWorkOrderExecutionStartReference? Start{get;set;}
    private CompanyWorkOrderExecutionStartReference? _attached;
    private decimal? _quantity;
    private string _from="",_to="",_work="",_reason="",_reference="";
    private WorkOrderLaborTimeUnit _unit;
    private string? _error;
    private bool _confirm,_authorized,_disposed;
    protected override void OnInitialized(){State.Changed+=Changed;Company.Changed+=CompanyChanged;Fields.CurrentFieldChanged+=FieldChanged;Authentication.AuthenticationStateChanged+=AuthenticationChanged;}
    protected override async Task OnParametersSetAsync()
    {
        if(_attached!=Start){_attached=Start;CompanyChanged();_reference="";}
        State.Attach(Start);var query=QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        if(query.TryGetValue("laborUsage",out var ids) && ids.Count==1 && Guid.TryParse(ids[0],out var id))_reference=id.ToString("D");
        try{await Authority();_authorized=true;}catch(Exception error) when(error is UnauthorizedAccessException or InvalidOperationException){_authorized=false;}
    }
    private async Task Authority()
    {
        var snapshot=Company.Snapshot;var user=(await Authentication.GetAuthenticationStateAsync()).User;
        if(_disposed || Start is null || snapshot.Selection is not {} selected || user.Identity?.IsAuthenticated!=true ||
            user.FindFirst("party_id")?.Value!=selected.UserId || !selected.Roles.Any(user.IsInRole) ||
            !selected.Permissions.Contains("Maintenance.ExecuteWork",StringComparer.Ordinal) ||
            await Fields.GetCurrentFieldIdAsync()!=Start.Permit.Task.FieldId || snapshot!=Company.Snapshot)
            throw new UnauthorizedAccessException("Current standard execution authority, company/account and original FIELD/start are required.");
        if(State.Review is {} review && (!selected.Roles.Contains(review.Execution.Start.AssignedRole,StringComparer.Ordinal) || !user.IsInRole(review.Execution.Start.AssignedRole)))
            throw new UnauthorizedAccessException("The original configured execution role is required.");
    }
    private void Changed(){if(!_disposed)_=InvokeAsync(StateHasChanged);}
    private void CompanyChanged(){_authorized=false;_quantity=null;_from="";_to="";_work="";_unit=WorkOrderLaborTimeUnit.Unspecified;_reason="";_reference="";_confirm=false;_error=null;Changed();}
    private void FieldChanged(string _){State.Attach(null);CompanyChanged();}
    private void AuthenticationChanged(Task<AuthenticationState> _){State.Attach(null);CompanyChanged();}
    private Task Retain(Guid id){_reference=id.ToString("D");Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("laborUsage",_reference),replace:true);return Task.CompletedTask;}
    private Task ReviewAsync()=>RunAsync(async()=>{await Authority();await State.ReviewAsync(Workflows);_quantity=null;_from="";_to="";_work="";_unit=WorkOrderLaborTimeUnit.Unspecified;_reason="";_confirm=false;},"reviewing original labor eligibility");
    private Task RecordAsync()=>RunAsync(async()=>
    {
        await Authority();if(!_confirm || _quantity is not {} quantity || State.Review is not {} review)throw new ArgumentException("Confirm the actual elapsed quantity/unit and original employee duty.");
        DateTime ParseUtc(string value)
        {
            if(!DateTime.TryParseExact(value,new[]{"yyyy-MM-dd'T'HH:mm:ss'Z'","yyyy-MM-dd'T'HH:mm:ss.FFFFFFF'Z'"},System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.AssumeUniversal|System.Globalization.DateTimeStyles.AdjustToUniversal,out var utc))throw new ArgumentException("Enter explicit ISO UTC labor timestamps ending in Z.");
            return utc;
        }
        await State.RecordAsync(Workflows,ParseUtc(_from),ParseUtc(_to),quantity,_unit,_work,_reason,Retain);
    },"recording original labor report");
    private Task RecoverAsync()=>RunAsync(async()=>{await Authority();if(!Guid.TryParse(_reference,out var id) || id==Guid.Empty)throw new ArgumentException("Enter the original labor intent reference.");await State.RecoverAsync(Workflows,id,Retain);},"reading original labor history");
    private async Task RunAsync(Func<Task> action,string operation)
    {
        if(State.Busy || _disposed)return;_error=null;var snapshot=Company.Snapshot;
        try{await action();}catch(Exception error){if(!_disposed && snapshot==Company.Snapshot)_error=Calls.Explain(error,operation,"Original labor report is unconfirmed");}
        finally{if(!_disposed)await InvokeAsync(StateHasChanged);}
    }
    public void Dispose(){if(_disposed)return;_disposed=true;State.Changed-=Changed;Company.Changed-=CompanyChanged;Fields.CurrentFieldChanged-=FieldChanged;Authentication.AuthenticationStateChanged-=AuthenticationChanged;}
}
