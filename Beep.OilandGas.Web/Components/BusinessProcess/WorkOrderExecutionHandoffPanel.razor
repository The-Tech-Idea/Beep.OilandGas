@using Beep.OilandGas.Models.Data.WorkOrder
@using Beep.OilandGas.PPDM39.DataManagement.Models
@using Beep.OilandGas.Models.Core.Interfaces
@using Beep.OilandGas.Models.Data.Company
@using Beep.OilandGas.Web.Services
@using Microsoft.AspNetCore.WebUtilities
@inject WorkOrderExecutionHandoffState State
@inject ICompanyMaintenanceHandoffClient Workflows
@inject IFieldSelectionContext Fields
@inject Beep.OilandGas.Client.App.CompanyClientContext Company
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject OilGasCallFailures Calls
@implements IDisposable
<MudPaper Class="pa-3 my-3" Outlined="true">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6">Hand recorded work to the configured independent reviewer</MudText>
        @if(_error is not null){<MudAlert Severity="Severity.Error">@_error</MudAlert>}
        @if(Query is null)
        {
            <MudTextField @bind-Value="_process" @bind-Value:after="InputsChanged" Label="Original maintenance process identity" Disabled="@State.Busy" Required="true" />
            <MudTextField @bind-Value="_submission" @bind-Value:after="InputsChanged" Label="Original recorded work report identity" Disabled="@State.Busy" Required="true" />
        }
        <MudButton OnClick="ReviewAsync" Disabled="@(!State.CanReview)">Review original report and next configured role</MudButton>
        @if(State.Review is {} review)
        {
            <MudText>Original report @review.Report.Query.SubmissionId · completed UTC @review.Report.CompletedAtUtc.ToString("O")</MudText>
            <MudText>Current execution role @review.Stage.AssignedRole · independent review role @review.NextRole · step @review.NextStepId</MudText>
            <MudTextField @bind-Value="_reason" Label="Explicit report handoff reason" Lines="3" Required="true" Disabled="@State.Busy" />
            <MudCheckBox @bind-Value="_confirm" Label="I confirm this is my recorded report and the displayed configured review role" Disabled="@State.Busy" />
            <MudButton OnClick="RecordAsync" Disabled="@(!State.CanRecord || !_confirm)" Color="Color.Primary">Retain reference and open independent review assignment</MudButton>
        }
        <MudTextField @bind-Value="_reference" Label="Original report handoff intent reference" Disabled="@State.Busy" />
        <MudButton OnClick="RecoverAsync" Disabled="@State.Busy">Read original handoff without closing tasks again</MudButton>
        @if(State.VisibleReference is {} id){<MudText>Retained original report handoff @id</MudText>}
        @if(State.Receipt is {} saved)
        {
            <MudAlert Severity="Severity.Success">Recorded report handoff · reviewer role @saved.Receipt.ReviewerRole · tasks @saved.Receipt.ReviewerTaskIds.Count</MudAlert>
            <MudButton Href="@("/ppdm39/process/instances/"+Uri.EscapeDataString(saved.Receipt.InstanceId))">Open recorded process and role handoff</MudButton>
            <MudButton Href="/tasks/inbox">Open current assigned work</MudButton>
        }
        <MudText>The handoff closes the executor assignment and opens the configured review role. Independent verification and return acceptance require their own recorded decisions.</MudText>
    </MudStack>
</MudPaper>
@code {
    [Parameter] public CompanyWorkOrderCompletionQuery? Query{get;set;}
    [Parameter] public string WorkOrderId{get;set;}="";
    [Parameter] public string FieldId{get;set;}="";
    private CompanyWorkOrderCompletionQuery? _attached;
    private string _resource="",_reason="",_reference="",_process="",_submission="";
    private bool _confirm,_disposed;
    private string? _error;
    protected override void OnInitialized(){State.Changed+=Changed;Company.Changed+=Invalidate;Fields.CurrentFieldChanged+=FieldChanged;Authentication.AuthenticationStateChanged+=AuthenticationChanged;}
    protected override void OnParametersSet()
    {
        var resource=WorkOrderId+"\n"+FieldId;if(_attached!=Query || _resource!=resource){Invalidate();_attached=Query;_resource=resource;}if(Query is not null)State.Attach(Query);
        var values=QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);if(values.TryGetValue("reportHandoff",out var ids) && ids.Count==1 && Guid.TryParse(ids[0],out var id))_reference=id.ToString("D");
        if(values.TryGetValue("handoffProcess",out var process) && process.Count==1)_process=process[0]??"";if(values.TryGetValue("handoffSubmission",out var submission) && submission.Count==1)_submission=submission[0]??"";
    }
    private CompanyWorkOrderCompletionQuery CurrentQuery()=>Query??new(new(_process,FieldId,WorkOrderId),_submission);
    private void InputsChanged(){State.Attach(null);_confirm=false;_error=null;}
    private async Task Authority()
    {
        var snapshot=Company.Snapshot;var user=(await Authentication.GetAuthenticationStateAsync()).User;
        var query=CurrentQuery();query.Require();
        if(_disposed || snapshot.Selection is not {} selected || user.Identity?.IsAuthenticated!=true || user.FindFirst("party_id")?.Value!=selected.UserId || !selected.Roles.Any(user.IsInRole) ||
            !selected.Permissions.Contains("Maintenance.ExecuteWork",StringComparer.Ordinal) || !selected.Permissions.Contains("Workflow.Execute",StringComparer.Ordinal) ||
            State.Review is {} review && !user.IsInRole(review.Stage.AssignedRole) || await Fields.GetCurrentFieldIdAsync()!=query.Task.FieldId || snapshot!=Company.Snapshot)throw new UnauthorizedAccessException("Original standard executor role/company/account/FIELD and physical/workflow capabilities are required.");
    }
    private Task Retain(Guid id){var query=State.VisibleCommand?.Review.Report.Query??CurrentQuery();_reference=id.ToString("D");Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string,object?>{{"reportHandoff",_reference},{"handoffProcess",query.Task.InstanceId},{"handoffSubmission",query.SubmissionId}}),replace:true);return Task.CompletedTask;}
    private Task ReviewAsync()=>Run(async()=>{await Authority();State.Attach(CurrentQuery());await State.ReviewAsync(Workflows);_reason="";_confirm=false;},"reviewing the original report handoff");
    private Task RecordAsync()=>Run(async()=>{await Authority();if(!_confirm || State.Review?.Report.Query!=CurrentQuery())throw new ArgumentException("Confirm the exact reviewed report and configured reviewer role; reload changed source identities.");await State.RecordAsync(Workflows,_reason,Retain);},"recording the original report handoff");
    private Task RecoverAsync()=>Run(async()=>{await Authority();State.Attach(CurrentQuery());if(!Guid.TryParse(_reference,out var id) || id==Guid.Empty)throw new ArgumentException("Use the original report handoff intent reference.");await State.RecoverAsync(Workflows,id,Retain);},"reading the original report handoff");
    private async Task Run(Func<Task> action,string operation){if(State.Busy || _disposed)return;_error=null;var snapshot=Company.Snapshot;try{await action();}catch(Exception error){if(!_disposed && snapshot==Company.Snapshot)_error=Calls.Explain(error,operation,"Original report handoff is unconfirmed");}finally{if(!_disposed)await InvokeAsync(StateHasChanged);}}
    private void Invalidate(){State.Attach(null);_process="";_submission="";_reason="";_reference="";_confirm=false;_error=null;Changed();}
    private void FieldChanged(string _) => Invalidate();
    private void AuthenticationChanged(Task<AuthenticationState> _) => Invalidate();
    private void Changed(){if(!_disposed)_=InvokeAsync(StateHasChanged);}
    public void Dispose(){if(_disposed)return;_disposed=true;State.Changed-=Changed;Company.Changed-=Invalidate;Fields.CurrentFieldChanged-=FieldChanged;Authentication.AuthenticationStateChanged-=AuthenticationChanged;}
}
