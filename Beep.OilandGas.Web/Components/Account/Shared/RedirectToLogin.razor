@inject NavigationManager Navigation

@* Starts sign-in at the identity server and returns to the page that asked. The library's endpoint accepts only a local
   return address, so the page's own path and query are what is sent. It went to /login, an application page that then
   started a sign-in of its own through an endpoint that passed any return address on (S3-06 §3). *@

@code {
    protected override void OnInitialized() =>
        Navigation.NavigateTo(
            BeepClientEndpoints.LoginWithReturn(new Uri(Navigation.Uri).PathAndQuery),
            forceLoad: true);
}
