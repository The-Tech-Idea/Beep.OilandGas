@using Beep.OilandGas.Models.Data.Company
@using Beep.OilandGas.PPDM39.DataManagement.Models
@using Beep.OilandGas.Models.Data.DataManagement
@using Beep.OilandGas.Models.Data
@using TheTechIdea.Beep.ConfigUtil
@inject IDataManagementService DataManagementService

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.h5">Module database connection</MudText>
            <MudText Typo="Typo.body2">Connect to an existing database or create a new LocalDB database. Install module tables separately after binding this connection to a module.</MudText>
            <MudStepper @bind-ActiveIndex="_activeStep" OnPreviewInteraction="PreviewStep">
                <ChildContent>
                    <MudStep Title="Target">
                        <MudStack Spacing="3" Class="py-4">
                            <MudSelect T="string" Label="Database type" Variant="Variant.Outlined" @bind-Value="_selectedDatabaseType" @bind-Value:after="TypeChanged" Disabled="@InputsLocked">
                                @foreach (var type in _availableDatabaseTypes) { <MudSelectItem Value="@type">@type</MudSelectItem> }
                            </MudSelect>
                            @if (_selectedDatabaseType == "SQL Server")
                            {
                                <MudRadioGroup T="bool" @bind-Value="_newLocalDb" @bind-Value:after="ModeChanged">
                                    <MudRadio Value="false" Disabled="@InputsLocked">Existing database</MudRadio>
                                    <MudRadio Value="true" Disabled="@InputsLocked">New LocalDB database</MudRadio>
                                </MudRadioGroup>
                            }
                            <MudAlert Severity="Severity.Info">The default administration repository keeps users, roles and personas. This connection is for module data.</MudAlert>
                        </MudStack>
                    </MudStep>
                    <MudStep Title="Driver" Disabled="@(string.IsNullOrWhiteSpace(_selectedDatabaseType))">
                        <Beep.OilandGas.Web.Pages.SetupDrivers @key="SelectedDriverType" Embedded="true" DataSourceType="@SelectedDriverType" ReadyTypeChanged="DriverReadinessChanged" BusyChanged="DriverBusyChanged" />
                    </MudStep>
                    <MudStep Title="Connection" Disabled="@(!DriverReady)">
                        <MudGrid Class="py-4">
                            <MudItem xs="12" md="6"><MudTextField T="string" Label="Connection name" Variant="Variant.Outlined" @bind-Value="_connectionName" @bind-Value:after="SettingsChanged" Immediate Required Disabled="@InputsLocked" HelperText="Start with a letter or underscore; use letters, digits and underscores." /></MudItem>
                            @if (_selectedDatabaseType != "SQLite")
                            {
                                <MudItem xs="12" md="6"><MudTextField T="string" Label="Server" Variant="Variant.Outlined" @bind-Value="_host" @bind-Value:after="SettingsChanged" Immediate Required Disabled="@InputsLocked" /></MudItem>
                            }
                            <MudItem xs="12" md="6"><MudTextField T="string" Label="@(_selectedDatabaseType == "SQLite" ? "Database file path" : "Database name")" Variant="Variant.Outlined" @bind-Value="_database" @bind-Value:after="SettingsChanged" Immediate Required Disabled="@InputsLocked" /></MudItem>
                            @if (_newLocalDb || IsLocalDb)
                            {
                                <MudItem xs="12"><MudAlert Severity="Severity.Info">Windows integrated authentication · LocalDB uses no TCP port.</MudAlert></MudItem>
                            }
                            else if (_selectedDatabaseType != "SQLite")
                            {
                                <MudItem xs="12" md="6"><MudNumericField T="int?" Label="Port" Variant="Variant.Outlined" @bind-Value="_port" @bind-Value:after="SettingsChanged" Immediate Disabled="@InputsLocked" /></MudItem>
                                <MudItem xs="12" md="6"><MudTextField T="string" Label="Schema (optional)" Variant="Variant.Outlined" @bind-Value="_schema" @bind-Value:after="SettingsChanged" Immediate Disabled="@InputsLocked" /></MudItem>
                                <MudItem xs="12" md="6"><MudTextField T="string" Label="Username" Variant="Variant.Outlined" @bind-Value="_username" @bind-Value:after="SettingsChanged" Immediate Disabled="@InputsLocked" /></MudItem>
                                <MudItem xs="12" md="6"><MudTextField T="string" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" @bind-Value="_password" @bind-Value:after="SettingsChanged" Immediate Disabled="@InputsLocked" /></MudItem>
                            }
                        </MudGrid>
                    </MudStep>
                    <MudStep Title="Review" Disabled="@(!CanTestConnection())">
                        <MudStack Spacing="3" Class="py-4">
                            <MudText Typo="Typo.h6">@_connectionName</MudText>
                            <MudText>Server: @_host</MudText><MudText>Database: @_database</MudText>
                            @if (_newLocalDb)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ReviewTarget" Disabled="@Busy">@(_creationAttempted ? "Review creation outcome" : "Review target")</MudButton>
                                @if (_review is not null)
                                {
                                    <MudAlert Severity="@(_review.OwnershipConfirmed ? Severity.Success : Severity.Info)">@_review.Message</MudAlert>
                                    @if (_review.CanCreate && !_creationAttempted && ReviewMatches())
                                    {
                                        <MudCheckBox T="bool" @bind-Value="_confirmed" Disabled="@Busy" Label="Create this empty module database on the reviewed server. This does not install module tables." />
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateTarget" Disabled="@(!_confirmed || Busy)">Create database</MudButton>
                                    }
                                }
                                @if (_creationAttempted && !OwnershipMatches())
                                {
                                    <MudAlert Severity="Severity.Warning">Creation was attempted. Keep this target unchanged and review its outcome. It will not be retried automatically.</MudAlert>
                                }
                            }
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="TestConnection" Disabled="@(Busy || !CanTestConnection() || (_newLocalDb && !OwnershipMatches()))">Test connection</MudButton>
                            @if (_message is not null) { <MudAlert Severity="Severity.Info">@_message</MudAlert> }
                            @if (_connectionTestResult is not null)
                            {
                                <MudAlert Severity="@(_connectionTestResult.Success ? Severity.Success : Severity.Error)">@_connectionTestResult.Message</MudAlert>
                            }
                        </MudStack>
                    </MudStep>
                    <MudStep Title="Save" Disabled="@(!TestMatches())">
                        <MudStack Spacing="3" Class="py-4">
                            <MudAlert Severity="Severity.Success">Connection tested for @_connectionName / @_database.</MudAlert>
                            <MudText>Save this connection, then choose it in Module databases. Review and approve the module table plan there.</MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveConnection" Disabled="@(Busy || !TestMatches() || _saveResult?.Success == true)">Save connection</MudButton>
                            @if (_saveResult is not null)
                            {
                                <MudAlert Severity="@(_saveResult.Success ? Severity.Success : Severity.Error)">@_saveResult.Message</MudAlert>
                            }
                            @if (_saveResult?.Success == true) { <MudLink Href="/admin/module-databases">Open Module databases</MudLink> }
                        </MudStack>
                    </MudStep>
                </ChildContent>
                <ActionContent>
                    <MudStack Row Class="mt-4"><MudButton OnClick="Previous" Disabled="@(Busy || _activeStep == 0)">Back</MudButton><MudSpacer /><MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="Next" Disabled="@(Busy || !CanAdvance())">Continue</MudButton></MudStack>
                </ActionContent>
            </MudStepper>
            @if (Busy) { <MudProgressLinear Indeterminate Color="Color.Primary" aria-label="Database operation in progress" /> }
        </MudStack>
    </DialogContent>
    <DialogActions><MudButton OnClick="Close" Disabled="@Busy">@(_saveResult?.Success == true ? "Done" : "Close")</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public EventCallback OnConnectionCreated { get; set; }
    [Inject] private ApiClient ApiClient { get; set; } = default!;
    [Inject] private OilGasCallFailures Calls { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    private int _activeStep;
    private string? _selectedDatabaseType = "SQL Server";
    private readonly string[] _availableDatabaseTypes = ["SQL Server", "PostgreSQL", "MySQL", "Oracle", "SQLite"];
    private bool _newLocalDb;
    private string _connectionName = "", _host = @"(localdb)\MSSQLLocalDB", _database = "", _schema = "", _username = "", _password = "";
    private int? _port;
    private bool _isTestingConnection, _isSavingConnection, _isReviewing, _isCreating, _confirmed, _creationAttempted, _isDriverBusy;
    private string? _readyDriverType;
    private string SelectedDriverType => new ConnectionConfig { DatabaseType = _selectedDatabaseType ?? "" }.ToConnectionProperties().DatabaseType.ToString();
    private bool DriverReady => _readyDriverType == SelectedDriverType;
    private void DriverBusyChanged(bool busy) => _isDriverBusy = busy;
    private void DriverReadinessChanged(string? readyType)
    {
        if (readyType is not null && readyType != SelectedDriverType) return;
        _readyDriverType = readyType;
        if (!DriverReady) { _tested = null; _connectionTestResult = null; }
    }
    private string? _message;
    private LocalDbDatabaseTargetReview? _review;
    private LocalDbDatabaseTargetRequest? _owned;
    private ConnectionTestResult? _connectionTestResult;
    private SaveConnectionResult? _saveResult;
    private sealed record TestedConnection(string? Type, string Name, string Host, int? Port, string Database, string Schema, string Username, string Password);
    private TestedConnection? _tested;
    private bool Busy => _isTestingConnection || _isSavingConnection || _isReviewing || _isCreating || _isDriverBusy;
    private bool InputsLocked => Busy || _creationAttempted || _saveResult?.Success == true;
    private bool IsLocalDb => _selectedDatabaseType == "SQL Server" && _host.StartsWith(@"(localdb)\", StringComparison.OrdinalIgnoreCase);
    private TestedConnection Snapshot() => new(_selectedDatabaseType, _connectionName, _host, _port, _database, _schema, _username, _password);
    private LocalDbDatabaseTargetRequest Target() => new(_connectionName, _host, _database);
    private bool ReviewMatches() => _review?.Target == Target();
    private bool OwnershipMatches() => _owned == Target();
    private bool TestMatches() => DriverReady && _connectionTestResult?.Success == true && _tested == Snapshot() && (!_newLocalDb || OwnershipMatches());
    private bool CanTestConnection() => DriverReady && !string.IsNullOrWhiteSpace(_selectedDatabaseType) && BeepConnectionName.IsValid(_connectionName) && (_selectedDatabaseType == "SQLite" || !string.IsNullOrWhiteSpace(_host)) && !string.IsNullOrWhiteSpace(_database) && (!_newLocalDb || IsLocalDb);
    private void SettingsChanged()
    {
        _review = null; _owned = null; _confirmed = false; _tested = null;
        _connectionTestResult = null; _saveResult = null; _message = null;
    }
    private void TypeChanged()
    {
        _readyDriverType = null;
        _newLocalDb = false; _port = null; _username = ""; _password = "";
        _host = _selectedDatabaseType == "SQL Server" ? @"(localdb)\MSSQLLocalDB" : "localhost";
        SettingsChanged();
    }
    private void ModeChanged()
    {
        if (_newLocalDb) { _host = @"(localdb)\MSSQLLocalDB"; _port = null; _username = ""; _password = ""; _schema = ""; }
        SettingsChanged();
    }
    private bool CanAdvance() => _activeStep switch { 0 => !string.IsNullOrWhiteSpace(_selectedDatabaseType), 1 => DriverReady, 2 => CanTestConnection(), 3 => TestMatches(), 4 => false, _ => false };
    private void Next() { if (!Busy && CanAdvance()) _activeStep++; }
    private void Previous() { if (!Busy && _activeStep > 0) _activeStep--; }
    private Task PreviewStep(StepperInteractionEventArgs args)
    {
        args.Cancel = Busy || args.Action != StepAction.Activate || args.StepIndex > _activeStep;
        return Task.CompletedTask;
    }
    private async Task ReviewTarget()
    {
        if (Busy || !CanTestConnection() || !_newLocalDb) return;
        _isReviewing = true; _message = null; _confirmed = false;
        try
        {
            var target = Target();
            var result = await ApiClient.PostAsync<LocalDbDatabaseTargetRequest, LocalDbDatabaseTargetReview>("/api/ppdm39/setup/database-target/review", target);
            if (target != Target() || result?.Target != target || string.IsNullOrWhiteSpace(result.ReviewToken)) throw new InvalidOperationException("The database review did not acknowledge the requested target.");
            _review = result; _owned = result.OwnershipConfirmed ? target : null;
        }
        catch (Exception ex) { _message = Calls.Explain(ex, "reviewing a module database target", "The database target could not be reviewed"); }
        finally { _isReviewing = false; }
    }
    private async Task CreateTarget()
    {
        if (Busy || !DriverReady || !_confirmed || _creationAttempted || !ReviewMatches() || _review?.CanCreate != true) return;
        _isCreating = true; _creationAttempted = true; _message = null;
        try
        {
            var request = new LocalDbDatabaseTargetCreate(Target(), _review.ReviewToken);
            var result = await ApiClient.PostAsync<LocalDbDatabaseTargetCreate, LocalDbDatabaseTargetResult>("/api/ppdm39/setup/database-target/create", request);
            if (result?.Target != request.Target || result.ReviewToken != request.ReviewToken || !result.OwnershipConfirmed) throw new InvalidOperationException("Database creation did not acknowledge the exact target and review.");
            _owned = request.Target; _review = null;
            _message = "Database ownership confirmed. Test the connection before saving.";
        }
        catch (Exception ex) { _message = Calls.Explain(ex, "creating a LocalDB module database", "Creation could not be confirmed. Review the creation outcome"); }
        finally { _isCreating = false; }
    }
    private ConnectionConfig BuildConnectionConfig() => new()
    {
        DatabaseType = _selectedDatabaseType ?? "", ConnectionName = _connectionName, Host = _host,
        Port = IsLocalDb ? 0 : _port ?? (_selectedDatabaseType switch { "SQL Server" => 1433, "PostgreSQL" => 5432, "MySQL" => 3306, "Oracle" => 1521, "SQLite" => 0, null => 0, _ => 0 }),
        Database = _database, Schema = _schema, Username = _username, Password = _password,
        ConnectionString = _selectedDatabaseType == "SQLite" ? new System.Data.Common.DbConnectionStringBuilder { ["Data Source"] = _database }.ConnectionString : null
    };
    private async Task TestConnection()
    {
        if (Busy || !CanTestConnection() || (_newLocalDb && !OwnershipMatches())) return;
        _isTestingConnection = true; _tested = null; _connectionTestResult = null;
        try
        {
            var snapshot = Snapshot();
            var result = await ApiClient.PostAsync<ConnectionProperties, ConnectionTestResult>("/api/ppdm39/setup/test-connection", BuildConnectionConfig().ToConnectionProperties());
            _connectionTestResult = snapshot == Snapshot() ? result : new() { Success = false, Message = "Settings changed. Test the connection again." };
            if (_connectionTestResult?.Success == true) { _tested = snapshot; _activeStep = 4; }
        }
        catch (Exception ex) { _connectionTestResult = new() { Success = false, Message = Calls.Explain(ex, "testing a module database connection", "The connection could not be tested") }; }
        finally { _isTestingConnection = false; }
    }
    private async Task SaveConnection()
    {
        if (Busy || !TestMatches() || _saveResult?.Success == true) return;
        _isSavingConnection = true;
        try
        {
            _saveResult = await ApiClient.PostAsync<SaveConnectionRequest, SaveConnectionResult>("/api/ppdm39/setup/save-connection", new() { Connection = BuildConnectionConfig().ToConnectionProperties(), TestAfterSave = false, OpenAfterSave = false });
            if (_saveResult?.Success == true)
            {
                try { await DataManagementService.RefreshConnectionsAsync(); }
                catch (Exception ex) { Snackbar.Add(Calls.Explain(ex, "refreshing the saved connection list", "Connection saved, but the list could not be refreshed"), Severity.Warning); }
                await OnConnectionCreated.InvokeAsync();
            }
        }
        catch (Exception ex) { _saveResult = new() { Success = false, Message = Calls.Explain(ex, "saving a module database connection", "The connection was not saved") }; }
        finally { _isSavingConnection = false; }
    }
    private void Close()
    {
        if (Busy) return;
        if (_saveResult?.Success == true) MudDialog.Close(DialogResult.Ok(true)); else MudDialog.Cancel();
    }
}
