@using Beep.OilandGas.Models.Data
@using Beep.OilandGas.Models.Data.DataManagement
@inject ApiClient ApiClient
@inject OilGasCallFailures Calls

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-3">Edit database connection</MudText>
        <MudAlert Severity="Severity.Info" Class="mb-3">Stored passwords and connection strings are not returned to this screen. If this connection uses credentials, enter them again before testing and saving.</MudAlert>
        <MudText Typo="Typo.body2">Database type: @_databaseType</MudText>
        <MudTextField T="string" @bind-Value="_name" Label="Connection name" Disabled="@_busy" />
        <MudTextField T="string" @bind-Value="_host" Label="Server or host" Disabled="@_busy" />
        <MudNumericField T="int" @bind-Value="_port" Label="Port" Min="0" Max="65535" Disabled="@_busy" />
        <MudTextField T="string" @bind-Value="_database" Label="Database or file" Disabled="@_busy" />
        <MudTextField T="string" @bind-Value="_username" Label="Username" Disabled="@_busy" />
        <MudTextField T="string" @bind-Value="_password" Label="Password" InputType="InputType.Password" Disabled="@_busy" />
        @if (_message is not null) { <MudAlert Severity="@(_confirmed && TestMatches ? Severity.Success : Severity.Info)" Class="my-3" role="status">@_message</MudAlert> }
        <MudButton OnClick="Test" Disabled="@(_busy || !CanTest)" Variant="Variant.Outlined" Class="mt-3">Test connection</MudButton>
        <MudButton OnClick="Save" Disabled="@(_busy || !TestMatches)" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3 mx-2">Save connection</MudButton>
    </DialogContent>
    <DialogActions><MudButton OnClick="Cancel" Disabled="@_busy">Cancel</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ConnectionConfig? Connection { get; set; }
    private string _original = "", _databaseType = "", _name = "", _host = "", _database = "", _username = "", _password = "";
    private int _port;
    private bool _busy, _confirmed;
    private string? _message;
    private ConnectionSnapshot? _tested;
    private sealed record ConnectionSnapshot(string Type, string Name, string Host, int Port, string Database, string Username, string Password);
    private ConnectionSnapshot Snapshot() => new(_databaseType, _name, _host, _port, _database, _username, _password);
    private bool CanTest => TheTechIdea.Data.OilGas.BeepConnectionName.IsValid(_name) &&
        !string.IsNullOrWhiteSpace(_database) && (_databaseType.Equals("SqlLite", StringComparison.OrdinalIgnoreCase) || !string.IsNullOrWhiteSpace(_host));
    private bool TestMatches => _tested is not null && _tested == Snapshot();
    protected override void OnInitialized()
    {
        if (Connection is null) return;
        _original = Connection.ConnectionName; _name = Connection.ConnectionName; _databaseType = Connection.DatabaseType;
        _host = Connection.Host ?? ""; _port = Connection.Port; _database = Connection.Database ?? ""; _username = Connection.Username ?? "";
    }
    private ConnectionConfig Build() => new() { DatabaseType = _databaseType, ConnectionName = _name, Host = _host,
        Port = _port, Database = _database, Username = _username, Password = _password,
        ConnectionString = _databaseType.Equals("SqlLite", StringComparison.OrdinalIgnoreCase)
            ? new System.Data.Common.DbConnectionStringBuilder { ["Data Source"] = _database }.ConnectionString : null };
    private async Task Test()
    {
        if (_busy || !CanTest) return;
        var snapshot = Snapshot(); _tested = null; _confirmed = false; _message = null; _busy = true;
        try
        {
            var result = await ApiClient.PostAsync<TheTechIdea.Beep.ConfigUtil.ConnectionProperties, ConnectionTestResult>(
                "/api/ppdm39/setup/test-connection", Build().ToConnectionProperties());
            if (result?.Success == true && snapshot == Snapshot()) { _tested = snapshot; _confirmed = true; _message = "Connection test succeeded. You can save these settings."; }
            else _message = "The connection could not be confirmed. Check the settings and test again.";
        }
        catch (Exception error) { _message = Calls.Explain(error, "testing a database connection", "The connection could not be tested"); }
        finally { _busy = false; }
    }
    private async Task Save()
    {
        if (_busy || !TestMatches || string.IsNullOrEmpty(_original)) return;
        var snapshot = Snapshot(); _tested = null; _confirmed = false; _busy = true;
        try
        {
            var request = new UpdateConnectionRequest { OriginalConnectionName = _original, Connection = Build().ToConnectionProperties() };
            var result = await ApiClient.PutAsync<UpdateConnectionRequest, SaveConnectionResult>("/api/ppdm39/setup/connection", request);
            if (result?.Success == true && snapshot == Snapshot()) { _password = ""; MudDialog.Close(DialogResult.Ok(result)); return; }
            _message = "The connection update could not be confirmed. Refresh the connection list before trying again.";
        }
        catch (Exception error) { _message = Calls.Explain(error, "updating a database connection", "The connection update could not be confirmed; refresh the connection list before retrying"); }
        finally { _password = ""; _busy = false; }
    }
    private void Cancel() { _password = ""; MudDialog.Cancel(); }
}
