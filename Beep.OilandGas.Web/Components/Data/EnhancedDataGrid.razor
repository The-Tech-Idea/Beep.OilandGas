@typeparam TItem
@using MudBlazor
@using System.Linq.Expressions
@using System.Reflection

<MudCard Elevation="@Elevation" Class="@($"enhanced-data-grid {Class}")">
    <MudCardContent>
        <MudStack Spacing="3">
            <!-- Header -->
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h6">@Title</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    @if (ShowSearch)
                    {
                        <MudTextField @bind-Value="@_searchText" 
                                     @bind-Value:after="@OnSearchTextChanged"
                                     Placeholder="Search..." 
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     Immediate="true"
                                     Class="og-search-sm" />
                    }
                    @* Export and Refresh are the host's to do; without its callback the button would do nothing. *@
                    @if (ShowExport && OnExport.HasDelegate)
                    {
                        <MudButton Variant="Variant.Outlined" 
                                  Size="Size.Small"
                                  StartIcon="@Icons.Material.Filled.FileDownload"
                                  OnClick="@ExportData">
                            Export
                        </MudButton>
                    }
                    @if (ShowRefresh && OnRefresh.HasDelegate)
                    {
                        <MudTooltip Text="Refresh data">
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" 
                                          Size="Size.Small"
                                          OnClick="@RefreshData"
                                          aria-label="Refresh data" />
                        </MudTooltip>
                    }
                </MudStack>
            </MudStack>

            <!-- Filters -->
            @if (ShowFilters && _filters.Any())
            {
                <MudExpansionPanels>
                    <MudExpansionPanel Text="Filters" @bind-Expanded="_filtersExpanded">
                        <MudGrid Spacing="2">
                            @foreach (var filter in _filters)
                            {
                                <MudItem xs="12" sm="6" md="4">
                                    <MudTextField @bind-Value="@filter.Value" 
                                                 Label="@filter.Label" 
                                                 Variant="Variant.Outlined"
                                                 Clearable="true" />
                                </MudItem>
                            }
                            <MudItem xs="12">
                                <MudStack Row="true" Spacing="2">
                                    <MudButton Variant="Variant.Filled" 
                                              Color="Color.Primary"
                                              Size="Size.Small"
                                              OnClick="@ApplyFilters">
                                        Apply Filters
                                    </MudButton>
                                    <MudButton Variant="Variant.Text" 
                                              Size="Size.Small"
                                              OnClick="@ClearFilters">
                                        Clear
                                    </MudButton>
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
            @if (_applied.Count > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @_filteredItems.Count of @Items.Count rows match the filters.
                </MudText>
            }

            <!-- Data Grid -->
            @if (_isLoading)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else
            {
                <MudDataGrid T="@TItem" 
                           Items="@_filteredItems"
                           Hover="true"
                           Striped="true"
                           Dense="true"
                           SortMode="SortMode.Multiple"
                           FilterMode="DataGridFilterMode.Simple"
                           QuickFilter="@_quickFilter">
                    <Columns>
                        @Columns
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="@TItem" />
                    </PagerContent>
                </MudDataGrid>
            }
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string Title { get; set; } = "Data Grid";
    [Parameter] public RenderFragment? Columns { get; set; }
    [Parameter] public List<TItem> Items { get; set; } = new();
    [Parameter] public bool ShowSearch { get; set; } = true;
    [Parameter] public bool ShowFilters { get; set; } = true;
    [Parameter] public bool ShowExport { get; set; } = true;
    [Parameter] public bool ShowRefresh { get; set; } = true;
    [Parameter] public int Elevation { get; set; } = 2;
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }

    /// <summary>
    /// The filter panel's fields. Each names, in <see cref="FilterDefinition.Field"/>, a public property of
    /// <typeparamref name="TItem"/>; Apply keeps the rows whose value of that property contains the text typed, ignoring
    /// case, for every filled filter at once. A field the item type does not have stops the component, naming it.
    /// </summary>
    [Parameter] public List<FilterDefinition> Filters { get; set; } = new();

    private List<TItem> _filteredItems = new();
    private List<FilterDefinition> _filters = new();

    /// <summary>
    /// The filters Apply took, kept apart from the fields so that what is shown changes only on Apply and Clear, and so
    /// that new items from the host are filtered the same way rather than shown whole.
    /// </summary>
    private List<AppliedFilter> _applied = new();
    private string _searchText = string.Empty;
    private Func<TItem, bool>? _quickFilter;
    private bool _isLoading = false;
    private bool _filtersExpanded = false;

    protected override void OnParametersSet()
    {
        _filters = Filters;
        // A filter naming a field the items lack is the host's mistake: it stops here, when the host hands it over, not
        // when a person presses Apply.
        foreach (var filter in _filters)
        {
            PropertyOf(filter);
        }
        _filteredItems = Filtered();
        UpdateQuickFilter();
    }

    private void UpdateQuickFilter()
    {
        if (string.IsNullOrWhiteSpace(_searchText))
        {
            _quickFilter = null;
        }
        else
        {
            _quickFilter = item => 
            {
                // Simple search - check if any property contains the search text (an indexer has no value of its own)
                var properties = typeof(TItem).GetProperties().Where(p => p.GetIndexParameters().Length == 0);
                return properties.Any(p =>
                {
                    var value = p.GetValue(item);
                    return value?.ToString()?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) == true;
                });
            };
        }
    }

    private void OnSearchTextChanged()
    {
        UpdateQuickFilter();
        StateHasChanged();
    }

    // Apply filtered nothing: it re-rendered the same rows, so the filters were a control that only looked like one.
    private void ApplyFilters()
    {
        _applied = _filters
            .Where(filter => !string.IsNullOrWhiteSpace(filter.Value))
            .Select(filter => new AppliedFilter(PropertyOf(filter), filter.Value!.Trim()))
            .ToList();
        _filteredItems = Filtered();
    }

    private void ClearFilters()
    {
        foreach (var filter in _filters)
        {
            filter.Value = string.Empty;
        }
        _applied = new();
        _filteredItems = Filtered();
    }

    private List<TItem> Filtered() =>
        _applied.Count == 0 ? Items : Items.Where(item => _applied.All(filter => filter.Matches(item))).ToList();

    private static PropertyInfo PropertyOf(FilterDefinition filter) =>
        typeof(TItem).GetProperty(filter.Field, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase)
            is { CanRead: true } property && property.GetIndexParameters().Length == 0
            ? property
            : throw new InvalidOperationException(
                $"The filter '{filter.Label}' names the field '{filter.Field}', which {typeof(TItem).Name} does not have.");

    private sealed record AppliedFilter(PropertyInfo Property, string Text)
    {
        public bool Matches(TItem item) =>
            Property.GetValue(item)?.ToString()?.Contains(Text, StringComparison.OrdinalIgnoreCase) == true;
    }

    private async Task RefreshData()
    {
        _isLoading = true;
        StateHasChanged();
        
        await OnRefresh.InvokeAsync();
        
        _isLoading = false;
        StateHasChanged();
    }

    private async Task ExportData()
    {
        await OnExport.InvokeAsync();
    }

    public class FilterDefinition
    {
        public string Label { get; set; } = string.Empty;
        public string? Value { get; set; }
        public string Field { get; set; } = string.Empty;
    }
}

<style>
    .enhanced-data-grid {
        height: 100%;
    }
</style>

