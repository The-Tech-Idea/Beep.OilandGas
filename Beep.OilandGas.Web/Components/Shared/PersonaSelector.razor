@using TheTechIdea.Data.OilGas
@using System.Security.Claims
@inject PersonaClient Client
@inject IPersonaContextService PersonaContext
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject ISnackbar Snackbar

@if (_userId is not null && _personas.Count > 0)
{
    <MudSelect T="string" Label="Persona" Value="@_profile?.PersonaCode" ValueChanged="SwitchPersona"
               Disabled="@_busy" Margin="Margin.Dense" Class="persona-selector">
        @foreach (var persona in _personas)
        {
            <MudSelectItem T="string" Value="@persona.Code">@persona.Name</MudSelectItem>
        }
    </MudSelect>
}

@code {
    private string? _userId;
    private AppUserPersona? _profile;
    private List<AppPersona> _personas = [];
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
        _userId = user.Identity?.IsAuthenticated == true ? user.FindFirstValue(ClaimTypes.NameIdentifier) : null;
        if (_userId is null) return;
        try
        {
            _profile = await Client.GetAsync(_userId);
            _personas = await Client.CatalogAsync();
        }
        catch { Snackbar.Add("Persona settings could not be loaded.", Severity.Warning); }
    }

    private async Task SwitchPersona(string code)
    {
        if (_busy || _userId is null || code == _profile?.PersonaCode) return;
        _busy = true;
        try
        {
            _profile = await Client.SaveAsync(_userId, new(code, _profile?.Locale, _profile?.TimeZone,
                _profile?.UnitSystem, _profile?.DefaultFieldId, _profile?.ConcurrencyStamp));
            await PersonaContext.ReloadAsync();
            var route = _personas.FirstOrDefault(x => x.Code == code)?.DefaultRoute;
            Nav.NavigateTo(string.IsNullOrWhiteSpace(route) ? "/dashboard" : route);
        }
        catch
        {
            Snackbar.Add("Persona was not changed. Reload settings before retrying.", Severity.Error);
            try { _profile = await Client.GetAsync(_userId); } catch { }
        }
        finally { _busy = false; }
    }
}
