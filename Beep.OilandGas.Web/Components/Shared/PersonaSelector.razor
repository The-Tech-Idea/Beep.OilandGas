@inject IPersonaContextService PersonaContext
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDataManagementService DataManagement
@inject INotificationService Notifications
@implements IDisposable

@if (_error is not null)
{
    <MudButton OnClick="Reload" Disabled="@_busy" StartIcon="@Icons.Material.Filled.Refresh">Retry personas</MudButton>
    <MudText Typo="Typo.caption" role="status">@_error</MudText>
}
else if (PersonaContext.Catalog.Count > 0)
{
    <MudSelect T="string" Label="Workspace persona" Value="@PersonaContext.CurrentProfile?.PersonaCode" ValueChanged="SwitchPersona"
               Disabled="@_busy" Margin="Margin.Dense" Class="persona-selector" HelperText="Personalizes your workspace; access follows your app roles.">
        @foreach (var persona in PersonaContext.Catalog)
        {
            <MudSelectItem T="string" Value="@persona.Code">@persona.Name</MudSelectItem>
        }
    </MudSelect>
}

@code {
    private bool _busy;
    private bool _disposed;
    private string? _error;
    protected override async Task OnInitializedAsync()
    {
        PersonaContext.Changed += Changed;
        await Reload();
    }
    private async Task Reload()
    {
        _busy = true; _error = null;
        try { await PersonaContext.ReloadAsync(); }
        catch { _error = "Persona settings could not be loaded."; }
        finally { _busy = false; }
    }
    private async Task SwitchPersona(string code)
    {
        if (_busy || code == PersonaContext.CurrentProfile?.PersonaCode) return;
        _busy = true;
        try
        {
            try { await PersonaContext.SwitchAsync(code); }
            catch
            {
                if (!_disposed) _error = "The change could not be confirmed. Reload persona settings before retrying.";
                return;
            }
            if (_disposed || PersonaContext.CurrentPersona is not { } persona) return;
            Snackbar.Add($"Workspace changed to {persona.Name}.", Severity.Success);
            try { await Notifications.SubscribeToPersonaAsync(persona.Code, await DataManagement.GetCurrentFieldIdAsync() ?? string.Empty); }
            catch { if (!_disposed) Snackbar.Add("Your persona is saved. Notifications could not reconnect; refresh the page to retry.", Severity.Warning); }
            if (!_disposed && PersonaContext.CurrentPersona?.Code == persona.Code)
                Nav.NavigateTo(PersonaNavigation.HomeRoute(persona.DefaultRoute));
        }
        finally { _busy = false; }
    }
    private void Changed() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    public void Dispose() { _disposed = true; PersonaContext.Changed -= Changed; }
}
