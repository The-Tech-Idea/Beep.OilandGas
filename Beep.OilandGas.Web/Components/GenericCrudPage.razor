@using Beep.OilandGas.Models.Data.Company
@using Beep.OilandGas.Models.Data.WorkOrder
@using System.Text
@using System.Text.Json
@using System.Reflection
@using System.Globalization
@using Beep.OilandGas.PPDM39.Core.Tree
@using Beep.OilandGas.PPDM39.Core.Metadata
@using MudBlazor
@using Beep.OilandGas.Web.Components.Shared

@* ───── Category-Browse Mode ───── *@
@if (_categoryMode)
{
    <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Color="Color.Primary" />
            <MudText Typo="Typo.h5">@CategoryName</MudText>
            <MudSpacer />
            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">
                @_filteredCategoryTables.Count tables
            </MudChip>
        </MudStack>

        <MudTextField @bind-Value="_tableSearch"
                      Label="Filter tables"
                      Placeholder="Type to search..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Clearable="true"
                      Class="mb-4 og-search-md" />

        @if (_filteredCategoryTables.Count == 0)
        {
            <MudText Typo="Typo.body1" Class="pa-4 mud-text-secondary">No tables match your filter.</MudText>
        }
        else
        {
            <MudGrid Spacing="2">
                @foreach (var tbl in _filteredCategoryTables)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="1" Class="cursor-pointer og-card-fill"
                                 @onclick="@(() => OpenTableFromCategory(tbl))">
                            <MudCardContent Class="pa-3">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@GetTableIcon(tbl)" Color="@GetTableIconColor(tbl)" Size="Size.Small" />
                                    <MudText Typo="Typo.body2" Class="og-mono-text">@tbl</MudText>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudContainer>
}
@* ───── Table CRUD Mode ───── *@
else if (TableNode == null)
{
    <MudAlert Severity="Severity.Warning">No table selected. Please select a table from the tree.</MudAlert>
}
else
{
<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
    @if (_fromCategory)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Spacing="1">
            <MudTooltip Text="@($"Back to {CategoryName}")">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                               Size="Size.Small"
                               OnClick="ReturnToCategory"
                               aria-label="@($"Back to {CategoryName}")" />
            </MudTooltip>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@CategoryName</MudText>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
            <MudText Typo="Typo.caption">@(TableNode?.Text ?? "")</MudText>
        </MudStack>
    }
    <MudText Typo="Typo.h5" Class="mb-4">@GetTableDisplayName()</MudText>
    
    <MudButtonGroup Class="mb-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="CreateNew"
                   Disabled="@(_entityType is null)">
            New Record
        </MudButton>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadData">
            Refresh
        </MudButton>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Success" 
                   StartIcon="@Icons.Material.Filled.FileDownload"
                   OnClick="ExportToCsv"
                   Disabled="@(_data == null || !_data.Any())">
            Export CSV
        </MudButton>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Success" 
                   StartIcon="@Icons.Material.Filled.Upload"
                   OnClick="ShowImportDialog">
            Import CSV
        </MudButton>
    </MudButtonGroup>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }

    @if (_showEditForm && _editingRecord != null)
    {
        <MudCard Class="mb-4">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-3">
                    @(_editingKey is null ? "Create New Record" : "Edit Record")
                </MudText>
                <PPDMEntityForm Entity="@_editingRecord"
                               TableMetadata="@_tableMetadata"
                               DefaultValues="@_defaultValues"
                               GetDefaultValue="@((fieldName) => GetDefaultValue(fieldName))"
                               FieldOptions="@_foreignKeyFieldOptions"
                               FieldReadOnly="@_keyFieldsReadOnly"
                               OnValidSubmit="SaveRecord"
                               OnCancel="CancelEdit"
                               ShowCancel="true"
                               SubmitText="Save"
                               CancelText="Cancel" />
            </MudCardContent>
        </MudCard>
    }

    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="my-4">@_loadError</MudAlert>
    }
    else if (_data != null && _data.Any())
    {
        @* No View action: it opened the same editable form as Edit, with its Save button, under the name of a view. *@
        <PPDMDataGrid Items="@_data"
                     Title="@GetTableDisplayName()"
                     TableMetadata="@_tableMetadata"
                     IsLoading="@_isLoading"
                     ShowActions="true"
                     ShowExport="true"
                     ShowSearch="true"
                     ShowPagination="true"
                     MaxDisplayColumns="10"
                     OnEdit="EditRecord"
                     OnDelete="DeleteRecord"
                     OnExport="ExportToCsv">
            <ToolbarActions>
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Upload"
                           OnClick="ShowImportDialog"
                           Size="Size.Small">
                    Import CSV
                </MudButton>
            </ToolbarActions>
        </PPDMDataGrid>
    }
    else if (!_isLoading)
    {
        <MudText Typo="Typo.body1" Class="pa-4">No records found.</MudText>
    }
</MudContainer>
}

@code {
    [Parameter] public PPDMTreeNode? TableNode { get; set; }

    // ── Category-browse mode parameters ──
    [Parameter] public int CategoryId { get; set; }
    [Parameter] public string? CategoryName { get; set; }
    [Parameter] public List<string>? CategoryTables { get; set; }

    private bool _categoryMode => CategoryTables != null && CategoryTables.Count > 0 && TableNode == null;
    private bool _fromCategory => CategoryTables != null && CategoryTables.Count > 0 && TableNode != null;

    // Category table search/filter
    private string _tableSearch = string.Empty;
    private List<string> _filteredCategoryTables =>
        CategoryTables == null ? new() :
        string.IsNullOrWhiteSpace(_tableSearch)
            ? CategoryTables
            : CategoryTables.Where(t => t.Contains(_tableSearch, StringComparison.OrdinalIgnoreCase)).ToList();

    private async Task OpenTableFromCategory(string tableName)
    {
        // Switch to table-crud mode while keeping category context for back button
        var node = new PPDMTreeNode
        {
            Id = tableName,
            Text = tableName,
            NodeType = PPDMTreeNodeType.Table,
            IsSelected = true
        };
        TableNode = node;
        await OnParametersSetAsync();
        StateHasChanged();
    }

    private void ReturnToCategory()
    {
        TableNode = null;
        _data = null;
        _editingRecord = null;
        _editingKey = null;
        _showEditForm = false;
        _tableMetadata = null;
        _entityType = null;
        _tableSearch = string.Empty;
        StateHasChanged();
    }

    private static string GetTableIcon(string tableName) =>
        tableName.StartsWith("R_", StringComparison.OrdinalIgnoreCase) ||
        tableName.StartsWith("RA_", StringComparison.OrdinalIgnoreCase)
            ? Icons.Material.Filled.BookmarkBorder
            : Icons.Material.Filled.TableChart;

    private static Color GetTableIconColor(string tableName) =>
        tableName.StartsWith("R_", StringComparison.OrdinalIgnoreCase) ||
        tableName.StartsWith("RA_", StringComparison.OrdinalIgnoreCase)
            ? Color.Warning
            : Color.Primary;

    // The rows are read as the table's entity class (PPDMEntityTypes, the API's own answer), so each one is a record the page
    // can name by its key. Read as untyped JSON, no row had a key: Delete returned before it asked anything, and Edit posted a
    // copy of the row as a new record.
    private Type? _entityType;
    private List<object>? _data;
    private object? _editingRecord;
    // The key (PPDMRecordKey) of the record the form edits, which its update is sent under; null while it creates a record.
    private string? _editingKey;
    // The key columns: read-only while a record is edited, since its key is what the update names; editable while one is created.
    private Dictionary<string, bool>? _keyFieldsReadOnly;
    private bool _isLoading = false;
    private string? _loadError;
    private bool _showEditForm = false;
    private string _searchString = string.Empty;
    private PPDMTableMetadata? _tableMetadata;
    private Dictionary<string, object>? _defaultValues;
    private Dictionary<string, Dictionary<string, string>>? _foreignKeyFieldOptions;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (TableNode != null)
            {
                _data = null;
                _editingRecord = null;
                _editingKey = null;
                _showEditForm = false;
                _tableMetadata = null;

                await LoadTableMetadata();
                _entityType = _tableMetadata is null
                    ? null
                    : PPDMEntityTypes.Find(_tableMetadata.EntityTypeName, _tableMetadata.TableName);

                if (_tableMetadata != null)
                    await LoadData();
                else
                    Snackbar?.Add($"Could not load metadata for table: {TableNode?.Text ?? "Unknown"}", Severity.Warning);

                StateHasChanged();
            }
            else
            {
                _data = null;
                _tableMetadata = null;
                _entityType = null;
                StateHasChanged();
            }
        }
        // Loading reports its own failures; anything reaching here is a fault, told with its reference.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "opening a table", $"The table {TableNode?.Text} could not be opened");
            _data = null;
            _tableMetadata = null;
            _entityType = null;
            StateHasChanged();
        }
    }

    private async Task LoadTableMetadata()
    {
        if (TableNode == null) return;
        try
        {
            // 1. Check if metadata is already embedded in the node
            if (TableNode.Data != null && TableNode.Data.TryGetValue("TableMetadata", out var cached))
            {
                _tableMetadata = cached as PPDMTableMetadata;
                if (_tableMetadata != null) return;
            }

            // 2. Fetch from API by table name
            var tableName = TableNode.Text ?? TableNode.Id ?? string.Empty;
            if (string.IsNullOrWhiteSpace(tableName)) return;

            _tableMetadata = await ApiClient.GetAsync<PPDMTableMetadata>(
                $"/api/datamanagement/metadata/{Uri.EscapeDataString(tableName)}");
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "loading a table's metadata", $"The metadata for {TableNode?.Text} could not be loaded"), Severity.Warning);
            _tableMetadata = null;
        }
        // A component answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "loading a table's metadata", $"The metadata for {TableNode?.Text} could not be loaded", FailureSeverity.Degraded);
            _tableMetadata = null;
        }
    }

    private async Task LoadData()
    {
        if (_tableMetadata == null) return;

        _isLoading = true;
        _loadError = null;
        try
        {
            var tableName = _tableMetadata.TableName;
            if (_entityType is null)
            {
                // The API answers a table with no entity class as not found, through the same owner, so it has no rows to send.
                _data = null;
                _loadError = $"The {tableName} records cannot be shown here: no record class is known for the table.";
                return;
            }

            var rows = await ApiClient.GetAsync($"/api/{GetApiEndpoint(tableName)}", typeof(List<>).MakeGenericType(_entityType));
            _data = rows is System.Collections.IEnumerable records ? records.Cast<object>().ToList() : new List<object>();
        }
        // A component answers every failure it meets with a sentence; the store keeps the exception. The page says the
        // records did not load, rather than that there are none.
        catch (Exception ex)
        {
            _data = null;
            _loadError = Calls.Explain(ex, "loading a table's records", $"The {_tableMetadata.TableName} records could not be loaded");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateNew()
    {
        if (_entityType is null) return;

        _editingRecord = Activator.CreateInstance(_entityType);
        _editingKey = null;
        _keyFieldsReadOnly = KeyFields(readOnly: false);
        await PrepareDefaultsAndForeignKeyOptions();
        _showEditForm = true;
    }
    
    private async Task PrepareDefaultsAndForeignKeyOptions()
    {
        // Prepare default values dictionary
        _defaultValues = new Dictionary<string, object>();
        if (_editingRecord != null)
        {
            var properties = _editingRecord.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance);
            foreach (var prop in properties)
            {
                if (prop.CanWrite)
                {
                    var currentValue = prop.GetValue(_editingRecord);
                    if (currentValue == null || (currentValue is string str && string.IsNullOrWhiteSpace(str)))
                    {
                        var defaultValue = GetDefaultValue(prop.Name);
                        if (defaultValue != null)
                        {
                            var convertedValue = ConvertDefaultValue(defaultValue, prop.PropertyType);
                            if (convertedValue != null)
                            {
                                _defaultValues[prop.Name] = convertedValue;
                                prop.SetValue(_editingRecord, convertedValue);
                            }
                        }
                    }
                }
            }
        }
        
        // Prepare foreign key options
        await PreloadForeignKeyOptions();
    }

    // This method is replaced by PrepareDefaultsAndForeignKeyOptions which works with PPDMEntityForm

    private async Task EditRecord(object record)
    {
        var key = PPDMRecordKey.Of(record, _tableMetadata);
        if (key is null)
        {
            Snackbar.Add(Unaddressable("edited"), Severity.Warning);
            return;
        }

        // The form edits a copy: the grid's row keeps what is stored until the saved record is read back, and Cancel leaves
        // it as it was. Edited in place, a cancelled change stayed on the row as though it had been saved.
        _editingRecord = CopyOf(record);
        _editingKey = key;
        _keyFieldsReadOnly = KeyFields(readOnly: true);
        await PreloadForeignKeyOptions();
        _defaultValues = null; // No defaults when editing existing record
        _showEditForm = true;
    }

    private async Task SaveRecord()
    {
        if (_editingRecord == null || _tableMetadata == null) return;

        try
        {
            var tableName = _tableMetadata.TableName;
            var apiEndpoint = GetApiEndpoint(tableName);

            // Whether this is a new record is what the person opened, not whether the record has a key: PPDM keys are typed
            // in (a UWI), so a new record with its key filled in was sent as an update of a record that did not exist.
            if (_editingKey is null)
            {
                await ApiClient.PostAsync<object, object>($"/api/{apiEndpoint}", _editingRecord);
                Snackbar.Add("Record created successfully", Severity.Success);
            }
            else
            {
                // The update goes under the key the record was opened with; the form keeps its key fields read-only.
                await ApiClient.PutAsync<object, object>($"/api/{apiEndpoint}/{Uri.EscapeDataString(_editingKey)}", _editingRecord);
                Snackbar.Add("Record updated successfully", Severity.Success);
            }

            _showEditForm = false;
            _editingRecord = null;
            _editingKey = null;
            await LoadData();
        }
        catch (OilGasApiException answer)
        {
            Snackbar.Add(Answers.Explain(answer, "saving a table record", "The record was not saved"), Severity.Error);
        }
        // A component answers every failure it meets with a sentence; the store keeps the exception.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "saving a table record", "The record was not saved");
        }
    }

    private async Task DeleteRecord(object record)
    {
        if (_tableMetadata == null) return;

        // A row the page cannot name is said so: it returned here before asking, so Delete did nothing and said nothing.
        var key = PPDMRecordKey.Of(record, _tableMetadata);
        if (key is null)
        {
            Snackbar.Add(Unaddressable("deleted"), Severity.Warning);
            return;
        }

        // The API's delete is PPDM's soft delete, so the record stays in the list, marked inactive; the person is told so.
        var result = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            $"Delete the {_tableMetadata.TableName} record {KeyText(key)}? It is marked inactive (ACTIVE_IND = N) and stays in the table.",
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            try
            {
                var apiEndpoint = GetApiEndpoint(_tableMetadata.TableName);
                await ApiClient.DeleteAsync($"/api/{apiEndpoint}/{Uri.EscapeDataString(key)}");

                Snackbar.Add($"The record {KeyText(key)} was deleted: it is marked inactive.", Severity.Success);
                await LoadData();
            }
            catch (OilGasApiException answer)
            {
                Snackbar.Add(Answers.Explain(answer, "deleting a table record", "The record was not deleted"), Severity.Error);
            }
            // A component answers every failure it meets with a sentence; the store keeps the exception.
            catch (Exception ex)
            {
                Notifier.Failure(ex, "deleting a table record", "The record was not deleted");
            }
        }
    }

    private void CancelEdit()
    {
        _showEditForm = false;
        _editingRecord = null;
        _editingKey = null;
    }

    private string GetTableDisplayName()
    {
        return TableNode?.Text ?? "Select a Table";
    }

    private static string GetApiEndpoint(string tableName) =>
        $"datamanagement/{Uri.EscapeDataString(tableName)}";

    /// <summary>The key columns, each read-only or not, for the form.</summary>
    private Dictionary<string, bool> KeyFields(bool readOnly) =>
        PPDMRecordKey.Columns(_tableMetadata).ToDictionary(column => column, _ => readOnly, StringComparer.OrdinalIgnoreCase);

    /// <summary>A key as the person reads it: each key column with its value.</summary>
    private string KeyText(string key) =>
        string.Join(", ", (PPDMRecordKey.Read(key, _tableMetadata) ?? Array.Empty<KeyValuePair<string, string>>())
            .Select(part => $"{part.Key} {part.Value}"));

    /// <summary>
    /// Why a row cannot be named to the API: its table names no key, it has no value for a key column, or a key value has a
    /// comma in it.
    /// </summary>
    private string Unaddressable(string whatCannotHappen)
    {
        var columns = PPDMRecordKey.Columns(_tableMetadata);
        return columns.Count == 0
            ? $"Records of this table cannot be {whatCannotHappen} here: the table names no key to find one by."
            : $"This record cannot be {whatCannotHappen} here: it needs a value for each key column ({string.Join(", ", columns)}), and none may contain a comma.";
    }

    /// <summary>A copy of a row, of its own class, for the form to edit.</summary>
    private static object? CopyOf(object record)
    {
        var type = record.GetType();
        return JsonSerializer.Deserialize(JsonSerializer.Serialize(record, type), type);
    }

    /// <summary>
    /// The columns a CSV export writes: every column of the table's class but the audit columns. It wrote the first ten
    /// columns only, and read them off the first row — an untyped JSON value, whose own members it wrote, until the export
    /// failed on one of them.
    /// </summary>
    private List<PropertyInfo> GetDisplayProperties()
    {
        if (_entityType is null) return new List<PropertyInfo>();

        return _entityType
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .Where(p => p.CanRead && p.GetIndexParameters().Length == 0 && !IsSystemProperty(p))
            .ToList();
    }
    
    private bool IsSystemProperty(PropertyInfo prop)
    {
        var systemProps = new[] { "PPDM_GUID", "ROW_CREATED_BY", "ROW_CREATED_DATE", "ROW_CHANGED_BY", "ROW_CHANGED_DATE" };
        return systemProps.Contains(prop.Name, StringComparer.OrdinalIgnoreCase);
    }
    
    private string GetPropertyDisplayName(PropertyInfo prop)
    {
        return prop.Name.Replace("_", " ");
    }

    private object? GetPropertyValue(object? obj, string propertyName)
    {
        if (obj == null) return null;
        var prop = obj.GetType().GetProperty(propertyName);
        return prop?.GetValue(obj);
    }

    /// <returns>Whether the property took the value.</returns>
    private bool SetPropertyValue(object obj, string propertyName, object? value)
        => Services.ValueConverter.SetPropertyValue(obj, propertyName, value);

    /// <returns>Whether the property took the value: false when its type cannot hold it, and the property keeps its value.</returns>
    private bool SetPropertyValueFromString(object obj, PropertyInfo prop, string value)
    {
        if (prop == null || !prop.CanWrite) return false;
        if (!Services.ValueConverter.TryConvertValue(value, prop.PropertyType, out var converted)) return false;
        prop.SetValue(obj, converted);
        return true;
    }

    private async Task ExportToCsv()
    {
        if (_data == null || !_data.Any() || _tableMetadata == null)
        {
            Snackbar.Add("No data to export", Severity.Warning);
            return;
        }

        try
        {
            var csv = GenerateCsv(_data);
            var fileName = $"{_tableMetadata.TableName}_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            await DownloadFile(fileName, csv, "text/csv");
            Snackbar.Add($"Exported {_data.Count} records to {fileName}", Severity.Success);
        }
        // The browser's download (JS interop) or building the file failed; the person is told with the reference.
        catch (Exception ex)
        {
            Notifier.Failure(ex, "exporting a table to CSV", "The export was not downloaded");
        }
    }

    private string GenerateCsv(List<object> data)
    {
        if (data == null || !data.Any()) return string.Empty;

        var properties = GetDisplayProperties();
        var csv = new StringBuilder();

        // Header row
        var headers = properties.Select(p => GetPropertyDisplayName(p));
        csv.AppendLine(string.Join(",", headers.Select(h => EscapeCsvField(h))));

        // Data rows
        foreach (var record in data)
        {
            var values = properties.Select(p =>
            {
                var value = GetPropertyValue(record, p.Name);
                return value?.ToString() ?? string.Empty;
            });
            csv.AppendLine(string.Join(",", values.Select(v => EscapeCsvField(v))));
        }

        return csv.ToString();
    }

    private string EscapeCsvField(string field)
    {
        if (string.IsNullOrEmpty(field)) return string.Empty;

        // If field contains comma, quote, or newline, wrap in quotes and escape quotes
        if (field.Contains(',') || field.Contains('"') || field.Contains('\n') || field.Contains('\r'))
        {
            return "\"" + field.Replace("\"", "\"\"") + "\"";
        }

        return field;
    }

    private async Task DownloadFile(string fileName, string content, string contentType)
    {
        var bytes = Encoding.UTF8.GetBytes(content);
        var base64 = Convert.ToBase64String(bytes);
        var dataUrl = $"data:{contentType};base64,{base64}";

        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, dataUrl);
    }

    private async Task ShowImportDialog()
    {
        if (_tableMetadata == null)
        {
            Snackbar.Add("Please select a table first", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["TableName"] = _tableMetadata.TableName,
            ["TableMetadata"] = _tableMetadata
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ImportCsvWizard>("Import CSV Wizard", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadData();
        }
    }

    // Foreign key cache
    private Dictionary<string, List<Dictionary<string, string>>> _foreignKeyCache = new();
    private Dictionary<string, List<KeyValuePair<string, string>>> _foreignKeyOptionsCache = new();

    private bool IsForeignKey(string propertyName)
    {
        if (_tableMetadata?.ForeignKeys == null) return false;
        return _tableMetadata.ForeignKeys.Any(fk => 
            fk.ForeignKeyColumn.Equals(propertyName, StringComparison.OrdinalIgnoreCase));
    }

    private PPDMForeignKey? GetForeignKeyInfo(string propertyName)
    {
        if (_tableMetadata?.ForeignKeys == null) return null;
        return _tableMetadata.ForeignKeys.FirstOrDefault(fk => 
            fk.ForeignKeyColumn.Equals(propertyName, StringComparison.OrdinalIgnoreCase));
    }

    private async Task PreloadForeignKeyOptions()
    {
        if (_tableMetadata?.ForeignKeys == null) return;

        _foreignKeyFieldOptions = new Dictionary<string, Dictionary<string, string>>();
        
        foreach (var fk in _tableMetadata.ForeignKeys)
        {
            var cacheKey = $"{fk.ReferencedTable}_{fk.ReferencedPrimaryKey}";
            if (!_foreignKeyOptionsCache.ContainsKey(cacheKey))
            {
                var options = await LoadForeignKeyOptions(fk);
                _foreignKeyOptionsCache[cacheKey] = options;
            }
            
            // Build field options dictionary for PPDMEntityForm
            var fieldOptions = new Dictionary<string, string>();
            if (_foreignKeyOptionsCache.ContainsKey(cacheKey))
            {
                foreach (var option in _foreignKeyOptionsCache[cacheKey])
                {
                    fieldOptions[option.Key] = option.Value;
                }
            }
            _foreignKeyFieldOptions[fk.ForeignKeyColumn] = fieldOptions;
        }
    }

    private async Task<List<KeyValuePair<string, string>>> LoadForeignKeyOptions(PPDMForeignKey fkInfo)
    {
        var cacheKey = $"{fkInfo.ReferencedTable}_{fkInfo.ReferencedPrimaryKey}";
        
        if (!_foreignKeyCache.ContainsKey(cacheKey))
        {
            // A failed load is not cached: the dropdown is empty this time, the person is told, and the next form asks again.
            try
            {
                var apiEndpoint = GetApiEndpoint(fkInfo.ReferencedTable);
                if (!string.IsNullOrEmpty(apiEndpoint))
                {
                    // The referenced rows are read as JSON objects and their columns by name, in any case (the API writes
                    // them camel-cased). They were read by reflecting over the JSON value itself, which has no columns and
                    // failed on its indexer, so no foreign key ever had choices.
                    var data = await ApiClient.GetAsync<List<JsonElement>>($"/api/{apiEndpoint}");
                    if (data != null)
                    {
                        _foreignKeyCache[cacheKey] = data
                            .Where(row => row.ValueKind == JsonValueKind.Object)
                            .Select(ColumnTexts)
                            .ToList();
                    }
                }
            }
            catch (OilGasApiException answer)
            {
                Snackbar.Add(Answers.Explain(answer, "loading a foreign key's options", $"The choices for {fkInfo.ForeignKeyColumn} from {fkInfo.ReferencedTable} could not be loaded"), Severity.Warning);
                return new List<KeyValuePair<string, string>>();
            }
            // A component answers every failure it meets with a sentence; the store keeps the exception.
            catch (Exception ex)
            {
                Notifier.Failure(ex, "loading a foreign key's options", $"The choices for {fkInfo.ForeignKeyColumn} from {fkInfo.ReferencedTable} could not be loaded", FailureSeverity.Degraded);
                return new List<KeyValuePair<string, string>>();
            }
        }

        if (!_foreignKeyCache.TryGetValue(cacheKey, out var cachedData))
        {
            return new List<KeyValuePair<string, string>>();
        }
        var result = new List<KeyValuePair<string, string>>();

        foreach (var item in cachedData)
        {
            var pkValue = item.ContainsKey(fkInfo.ReferencedPrimaryKey) 
                ? item[fkInfo.ReferencedPrimaryKey] 
                : string.Empty;

            if (string.IsNullOrEmpty(pkValue)) continue;

            // Find name field (SHORT_NAME, LONG_NAME, NAME, etc.)
            var nameValue = GetNameValue(item);
            var displayText = !string.IsNullOrEmpty(nameValue) 
                ? $"{nameValue} ({pkValue})" 
                : pkValue;

            result.Add(new KeyValuePair<string, string>(pkValue, displayText));
        }

        return result.OrderBy(kvp => kvp.Value).ToList();
    }

    /// <summary>A JSON row's columns as text, found by name in any case.</summary>
    private static Dictionary<string, string> ColumnTexts(JsonElement row)
    {
        var texts = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var column in row.EnumerateObject())
        {
            texts[column.Name] = column.Value.ValueKind switch
            {
                JsonValueKind.String => column.Value.GetString() ?? string.Empty,
                JsonValueKind.Null => string.Empty,
                JsonValueKind.Undefined => string.Empty,
                JsonValueKind.Number => column.Value.GetRawText(),
                JsonValueKind.True => column.Value.GetRawText(),
                JsonValueKind.False => column.Value.GetRawText(),
                JsonValueKind.Object => column.Value.GetRawText(),
                JsonValueKind.Array => column.Value.GetRawText()
            };
        }
        return texts;
    }

    private string GetNameValue(Dictionary<string, string> item)
    {
        // Try common name fields in order of preference
        var nameFields = new[] { "SHORT_NAME", "LONG_NAME", "NAME", "STATUS", "DESCRIPTION" };
        
        foreach (var nameField in nameFields)
        {
            if (item.ContainsKey(nameField) && !string.IsNullOrWhiteSpace(item[nameField]))
            {
                return item[nameField];
            }
        }

        return string.Empty;
    }

    private string? GetDefaultValue(string propertyName)
    {
        // Map property names to default values
        var defaults = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            { "ACTIVE_IND", "Y" },
            { "ROW_QUALITY", "GOOD" },
            { "PREFERRED_IND", "N" },
            { "CERTIFIED_IND", "N" },
            { "HIERARCHY_TYPE", "PARENT_CHILD" },
            { "STRAT_COLUMN_TYPE", "STANDARD" },
            { "STRAT_TYPE", "LITHOSTRATIGRAPHIC" },
            { "STRAT_UNIT_TYPE", "FORMATION" },
            { "STRAT_STATUS", "VALID" },
            { "AREA_TYPE", "FIELD" },
            { "DEPTH_OUOM", "M" },
            { "PICK_DEPTH_OUOM", "M" },
            { "AZIMUTH_NORTH_TYPE", "TRUE_NORTH" },
            { "CONFORMITY_RELATIONSHIP", "CONFORMABLE" },
            { "STRAT_INTERPRET_METHOD", "LOG_INTERPRETATION" },
            { "PICK_QUALITY", "GOOD" },
            { "PICK_VERSION_TYPE", "CURRENT" },
            { "TVD_METHOD", "STANDARD" },
            { "SOURCE", "SYSTEM" }
        };

        return defaults.TryGetValue(propertyName, out var value) ? value : null;
    }

    private object? ConvertDefaultValue(string defaultValue, Type targetType)
    {
        if (string.IsNullOrEmpty(defaultValue))
        {
            var underlyingType = Nullable.GetUnderlyingType(targetType) ?? targetType;
            if (underlyingType.IsValueType && Nullable.GetUnderlyingType(targetType) == null)
                return Activator.CreateInstance(underlyingType);
            return null;
        }

        var underlying = Nullable.GetUnderlyingType(targetType) ?? targetType;

        if (underlying == typeof(string))
            return defaultValue;
        if (underlying == typeof(int))
            return int.TryParse(defaultValue, out var i) ? i : 0;
        if (underlying == typeof(bool))
            return defaultValue.Equals("Y", StringComparison.OrdinalIgnoreCase) ||
                   defaultValue.Equals("Yes", StringComparison.OrdinalIgnoreCase) ||
                   defaultValue.Equals("1", StringComparison.OrdinalIgnoreCase) ||
                   defaultValue.Equals("True", StringComparison.OrdinalIgnoreCase);

        return Convert.ChangeType(defaultValue, underlying, CultureInfo.InvariantCulture);
    }

