@* SVG-based Directed Acyclic Graph renderer for process instances.
    Renders completed (green), current (blue pulsing), pending (grey), failed (red) steps.
    Part of Phase 5 experience & integration. *@

<svg width="100%" height="@(_svgHeight)px" style="min-height:300px; font-family:Roboto,sans-serif">
    <defs>
        <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
            <polygon points="0 0, 10 3.5, 0 7" fill="#999" />
        </marker>
        <marker id="arrowhead-active" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
            <polygon points="0 0, 10 3.5, 0 7" fill="#1976D2" />
        </marker>
    </defs>

    @* Render edges first (behind nodes) *@
    @foreach (var edge in _edges)
    {
        <line x1="@edge.X1" y1="@edge.Y1" x2="@edge.X2" y2="@edge.Y2"
              stroke="@(edge.IsActive ? "#1976D2" : "#CCC")"
              stroke-width="@(edge.IsActive ? 3 : 1.5)"
              stroke-dasharray="@(edge.IsConditional ? "5,3" : "")"
              marker-end="@(edge.IsActive ? "url(#arrowhead-active)" : "url(#arrowhead)")" />
    }

    @* Render nodes *@
    @foreach (var node in _nodes)
    {
        <g transform="translate(@node.X, @node.Y)" style="cursor:pointer" @onclick="@(() => OnNodeClick(node))">
            @if (node.Shape == "diamond")
            {
                <polygon points="0,-20 45,0 0,20 -45,0"
                         fill="@node.FillColor" stroke="@node.StrokeColor"
                         stroke-width="@(node.IsCurrent ? 3 : 1.5)" />
            }
            else
            {
                <rect x="-70" y="-20" width="140" height="40" rx="6"
                      fill="@node.FillColor" stroke="@node.StrokeColor"
                      stroke-width="@(node.IsCurrent ? 3 : 1.5)" />
            }
            <text text-anchor="middle" dy=".35em" font-size="11"
                  fill="@(node.Status == "PENDING" ? "#999" : "#333")"
                  style="font-weight:@(node.IsCurrent ? "600" : "400")">
                @Truncate(node.Label, 16)
            </text>
            @if (node.IsCurrent)
            {
                <animate attributeName="opacity" values="1;0.6;1" dur="1.5s" repeatCount="indefinite" />
            }
        </g>
    }
</svg>

@if (_selectedNode is not null)
{
    <MudPaper Elevation="2" Class="pa-3 mt-2">
        <MudText Typo="Typo.h6">@_selectedNode.Label</MudText>
        <MudStack Row="true" Spacing="2" Class="mt-1">
            <MudChip T="string" Size="Size.Small" Color="@NodeColor(_selectedNode)">@_selectedNode.Status</MudChip>
            @if (!string.IsNullOrWhiteSpace(_selectedNode.AssignedTo))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />
                    @_selectedNode.AssignedTo
                </MudChip>
            }
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public List<DagNode> Nodes { get; set; } = new();
    [Parameter] public EventCallback<DagNode> NodeClicked { get; set; }

    private List<DagEdge> _edges = new();
    private List<DagNode> _nodes = new();
    private DagNode? _selectedNode;
    private int _svgHeight = 300;

    protected override void OnParametersSet()
    {
        _nodes = Nodes;
        LayoutNodes();
    }

    private void LayoutNodes()
    {
        // Simple vertical layout: nodes stacked, edges drawn between sequential nodes
        _edges.Clear();
        const int startY = 30;
        const int spacing = 70;
        const int centerX = 150;

        for (var i = 0; i < _nodes.Count; i++)
        {
            _nodes[i].X = centerX;
            _nodes[i].Y = startY + i * spacing;
        }

        for (var i = 0; i < _nodes.Count - 1; i++)
        {
            _edges.Add(new DagEdge
            {
                X1 = _nodes[i].X, Y1 = _nodes[i].Y + 20,
                X2 = _nodes[i + 1].X, Y2 = _nodes[i + 1].Y - 20,
                IsActive = _nodes[i].Status == "COMPLETED",
                IsConditional = _nodes[i].HasConditional,
            });
        }

        _svgHeight = Math.Max(300, startY + _nodes.Count * spacing + 30);
    }

    private async Task OnNodeClick(DagNode node)
    {
        _selectedNode = node;
        await NodeClicked.InvokeAsync(node);
    }

    private static Color NodeColor(DagNode n) => n.Status switch
    {
        "COMPLETED" => Color.Success,
        "IN_PROGRESS" => Color.Primary,
        "FAILED" => Color.Error,
        "SKIPPED" => Color.Warning,
        _ => Color.Default,
    };

    private static string Truncate(string text, int maxLen) =>
        (text?.Length ?? 0) > maxLen ? text![..(maxLen - 2)] + "…" : text ?? "";
}

@code {
public class DagNode
{
    public string StepId { get; set; } = string.Empty;
    public string Label { get; set; } = string.Empty;
    public string Status { get; set; } = "PENDING";    // COMPLETED, IN_PROGRESS, PENDING, FAILED, SKIPPED
    public string Shape { get; set; } = "rect";        // rect or diamond (approval steps)
    public string? AssignedTo { get; set; }
    public bool IsCurrent { get; set; }
    public bool HasConditional { get; set; }
    public string FillColor => Status switch
    {
        "COMPLETED" => "#C8E6C9", "IN_PROGRESS" => "#BBDEFB",
        "FAILED" => "#FFCDD2", "SKIPPED" => "#FFF9C4",
        _ => "#F5F5F5"
    };
    public string StrokeColor => Status switch
    {
        "COMPLETED" => "#4CAF50", "IN_PROGRESS" => "#1976D2",
        "FAILED" => "#F44336", "SKIPPED" => "#FFC107",
        _ => "#BDBDBD"
    };
    public double X { get; set; }
    public double Y { get; set; }
}

public class DagEdge
{
    public double X1 { get; set; } public double Y1 { get; set; }
    public double X2 { get; set; } public double Y2 { get; set; }
    public bool IsActive { get; set; }
    public bool IsConditional { get; set; }
}
}
