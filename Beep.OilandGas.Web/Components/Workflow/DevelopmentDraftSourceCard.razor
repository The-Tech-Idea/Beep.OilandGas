@using Beep.OilandGas.Models.Data.Company
@using System.Globalization
@using MudBlazor
@using Beep.OilandGas.Models.Data.DevelopmentPlanning

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudText Typo="Typo.h5" HtmlTag="h2">@Plan.FDP_NAME</MudText>
    <MudChip T="string" Color="Color.Info">Recorded draft · Version @Plan.FDP_VERSION</MudChip>
    <MudText Class="development-draft-identity">Draft identity: @Plan.FDP_ID</MudText>
    <MudText>Recorded by: @Plan.ROW_CREATED_BY</MudText>
    <MudText>Created (UTC): @Plan.ROW_CREATED_DATE?.ToString("u",CultureInfo.InvariantCulture)</MudText>
    <MudDivider Class="my-3" />
    <MudText Typo="Typo.h6" HtmlTag="h3">Development concept</MudText>
    <MudText Class="development-draft-description">@(string.IsNullOrEmpty(Plan.DEVELOPMENT_CONCEPT_DESC)?"No description recorded.":Plan.DEVELOPMENT_CONCEPT_DESC)</MudText>
    <MudDivider Class="my-3" />
    <MudGrid>
        <MudItem xs="12" md="6"><MudText>Planned first production: @Calendar(Plan.FIRST_PRODUCTION_DATE)</MudText></MudItem>
        <MudItem xs="12" md="6"><MudText>Planned field life end: @Calendar(Plan.FIELD_LIFE_END)</MudText></MudItem>
        <MudItem xs="12"><MudText>Estimated CAPEX: @(Plan.TOTAL_CAPEX_MM is {} cost?cost.ToString("0.############################",CultureInfo.InvariantCulture)+" million "+Plan.CAPEX_CURRENCY:"Not recorded")</MudText></MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter,EditorRequired]public FIELD_DEVELOPMENT_PLAN Plan{get;set;}=default!;
    private static string Calendar(DateTime? value)=>value?.ToString("yyyy-MM-dd",CultureInfo.InvariantCulture) ?? "Not recorded";
}
