// Template for appsettings.Production.json — the real file lives ON THE SERVER ONLY, beside the application, and is never
// published (the project excludes it and this template). Copy it there and replace every REPLACE_ME: a value left as
// REPLACE_ME is refused at startup, naming the key.
{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // IdentityServer: ClientId and ClientSecret are the pair the identity server's console generated for this application
  // (a web application: https://<host>/signin-oidc, /signout-callback-oidc, /account/backchannel-logout). ApiScopes is the
  // OilGas API's identifier as registered under Admin > APIs; AccountScopes are the account scopes the console permitted.
  // The FIRST person to sign in becomes the OilGas administrator — nobody is seeded and no address is configured.
  "IdentityServer": {
    "Authority": "REPLACE_ME",
    "ClientId": "REPLACE_ME",
    "ClientSecret": "REPLACE_ME",
    "ApiScopes": [ "REPLACE_ME" ],
    "AccountScopes": [ "account.read", "account.manage", "account.security", "account.export", "account.delete" ]
  },
  // The OilGas API, over https.
  "ApiService": {
    "BaseUrl": "REPLACE_ME"
  },
  // The failure store (DIAG-01): the same Provider and ConnectionString as the API's Diagnostics section. The API applies
  // its schema; this host writes into it and the administrator reads it at /admin/failures.
  "Diagnostics": {
    "Provider": "REPLACE_ME",
    "ConnectionString": "REPLACE_ME"
  },
  "AllowedHosts": "REPLACE_ME"
}
